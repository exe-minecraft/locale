{
  "plugins": {
    "world-manager": {
      "commands": {
        "world": {
          "list": "&7Mundos: &f{world_names}",
          "list-title": "&bMundos disponíveis:",
          "list-entry": "&a- {world_name}",
          "list-current": "&a- {world_name} &8(atual)",
          "list-empty": " &7Nenhum mundo carregado.",
          "list-hover": "&eClique para teleportar",
          "list-footer": "&7Clique em um mundo para entrar. &8| &b/world ajuda",
          "list-footer-console": "&7Use &b/world ajuda &7para ver os comandos.",
          "help-hover": "&bClique para ver os comandos de mundos.",
          "usage": {
            "teleport": { "syntax": "<mundo>", "description": "ir para o spawn de um mundo" },
            "list": { "syntax": "list", "description": "listar os mundos carregados" }
          },
          "not-loaded": "&cMundo não encontrado ou não carregado.",
          "player-only": "&cEntre no servidor para teleportar para um mundo.",
          "teleported": "&aTeleportado para o mundo {world_name}.",
          "teleport-failed": "&cO teleporte foi cancelado. Tente novamente.",
          "loading": "&7Preparando &f{world_name}&7...",
          "invalid-name": "Use um nome de até 48 caracteres, com letras, números, hífen ou sublinhado, começando por letra ou número.",
          "invalid-type": "Tipo inválido. Este servidor suporta os tipos vazio e plano.",
          "already-exists": "Já existe um mundo ou uma pasta com esse nome. Para carregar uma pasta existente, use /world importar.",
          "not-on-disk": "Não foi encontrada uma pasta de mundo com level.dat para esse nome neste servidor.",
          "already-loaded": "Esse mundo já está carregado e no catálogo. Não havia nada para importar.",
          "busy": "O world-manager ainda está carregando ou já existe uma operação para esse mundo. Aguarde a conclusão.",
          "error": "Não foi possível concluir a operação do mundo. A falha foi registrada para a equipe técnica.",
          "create": {
            "description": "criar um mundo novo",
            "arguments": {
              "name": {
                "name": "nome",
                "description": "Nome do novo mundo"
              },
              "type": {
                "name": "vazio|plano",
                "description": "Tipo de geração, vazio por padrão"
              }
            },
            "success": "&aMundo &f{world_name} &acriado. Use &f/world {world_name} &apara entrar."
          },
          "import": {
            "description": "carregar um mundo que já está no disco",
            "arguments": {
              "name": {
                "name": "nome",
                "description": "Nome da pasta do mundo neste servidor"
              },
              "type": {
                "name": "vazio|plano",
                "description": "Gerador dos chunks novos, vazio por padrão"
              }
            },
            "success": "&aMundo &f{world_name} &acarregado. Use &f/world {world_name} &apara entrar."
          },
          "delete": {
            "description": "apagar um mundo deste servidor, sem volta",
            "arguments": {
              "name": {
                "name": "nome",
                "description": "Nome do mundo neste servidor"
              },
              "confirm": {
                "name": "confirmar",
                "description": "Confirma a exclusão"
              }
            },
            "confirm": "&eO mundo &f{world_name} &eserá apagado do disco, sem volta. Quem estiver nele vai para o spawn. Para confirmar, use &f/world apagar {world_name} confirmar &eem até {confirm_seconds} segundos.",
            "no-confirmation": "&cNada foi apagado. Use &f/world apagar {world_name} &cprimeiro e confirme em seguida.",
            "main-world": "&cO mundo principal do servidor não pode ser apagado.",
            "unload-failed": "&cO servidor recusou descarregar o mundo, e nada foi apagado. Confira se ainda há alguém nele e tente novamente.",
            "success": "&aMundo &f{world_name} &aapagado e retirado do catálogo."
          }
        },
        "border": {
          "arguments": {
            "size": {
              "name": "tamanho",
              "description": "Lado da borda em blocos, de 1 a 60000000"
            },
            "time": {
              "name": "segundos",
              "description": "Tempo para a borda chegar ao tamanho, até 86400"
            }
          },
          "main-world": "&cNão é possível usar este comando no mundo principal!",
          "instant": "&aBorda definida para {size} {size_word}!",
          "timed": "&aBorda definida para {size} {size_word} em {seconds} {seconds_word}!",
          "unchanged": "&cA borda já está em {size} {size_word}.",
          "block": {
            "singular": "bloco",
            "plural": "blocos"
          },
          "invalid": "&cInsira um tamanho entre 1 e 60000000 e um tempo entre 0 e 86400 segundos."
        },
        "schematics": {
          "player-only": "&cEntre no servidor para visitar as builds.",
          "not-found": "&cA build {schematic_id} não está na lista. Use /schematics para ver as builds.",
          // O mundo das builds não está aberto aqui nem em outro servidor do mesmo modo.
          "world-not-loaded": "&cO mundo {world_name} das builds não está carregado agora.",
          "teleported": "&aVocê está na build {schematic_name}.",
          "teleport-failed": "&cO teleporte foi cancelado. Tente novamente.",
          // A visita de outro servidor confere o grupo do /schematics no servidor do mundo das builds.
          "denied": "&cVocê não tem o grupo do /schematics no servidor {app_id}, onde ficam as builds.",
          "visit": {
            "description": "ir até uma build",
            "arguments": {
              "id": {
                "name": "build",
                "description": "O nome da schematic da build, como aparece no /schematics"
              }
            }
          },
          "paste": {
            "description": "colar uma build de novo no lugar dela",
            "arguments": {
              "id": {
                "name": "build",
                "description": "O nome da schematic da build, como aparece no /schematics"
              }
            },
            "pasting": "&7Colando a build &f{schematic_name} &7no mundo {world_name}, em {x}, {y}, {z}...",
            "pasted": "&aBuild &f{schematic_name} &acolada em {duration}.",
            // O mundo das builds está aberto em outro servidor do modo, e só ele escreve no mundo.
            "elsewhere": "&cO mundo {world_name} das builds fica no servidor {app_id}. Cole a build de lá.",
            "file-missing": "&cO arquivo {schematic_id}.schematic não está na pasta de schematics do WorldEdit deste servidor.",
            "failed": "&cNão foi possível colar a build {schematic_name}. A falha foi registrada para a equipe técnica."
          }
        }
      },
      "views": {
        "schematics": {
          "title": "Builds",
          "items": {
            "build": {
              "name": "&a{schematic_name}",
              "lore": [
                "&7Tamanho: &f{width} x {height} x {length}",
                "&7Schematic: &f{schematic_id}",
                "",
                "&eClique para visitar."
              ]
            }
          },
          "empty": {
            "name": "&cNenhuma build",
            "lore": [
              "&7Este servidor não tem builds para visitar."
            ]
          }
        }
      }
    }
  }
}
