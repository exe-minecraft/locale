{
  "plugins": {
    "auth": {
      "commands": {
        "login": {
          "arguments": {
            "password": {
              "name": "senha",
              "description": "Insira a senha que você utiliza nessa conta"
            }
          },
          "already-logged": [
            "Você já se encontra autenticado."
          ],
          "not-registered": [
            "Você ainda não está registrado.",
            "Utilize /registrar <senha> <senha>"
          ],
          "invalid-password": [
            "Senha inválida!",
            "Utilize /logar <senha>"
          ],
          "kick-message": [
            "&cVocê excedeu o limite de tentativas!",
            "&cEspere 10 minutos e tente de novo."
          ],
          "too-many-logged-accounts": [
            "&cVocê está com muitas contas conectadas!"
          ],
          "reserved-name": [
            "Este nick é reservado para os bots da rede."
          ],
          "in-flight": [
            "Aguarde, estamos verificando sua senha."
          ]
        },
        "loginstaff": {
          "arguments": {
            "code": {
              "name": "código",
              "description": "Insira o seu código de loginstaff para se autenticar"
            }
          },
          "already-logged": [
            "Você já se logou como staff!"
          ],
          "not-logged": [
            "Você precisa se autenticar primeiro!"
          ],
          "code-not-registered": [
            "Código de login staff não registrado!"
          ],
          "invalid-password": [
            "Senha inválida!",
            "Utilize /logar <senha>"
          ],
          "kick-message": [
            "&cO código de login inserido é inválido."
          ]
        },
        "register": {
          "arguments": {
            "password": {
              "name": "senha",
              "description": "Digite uma senha que você irá se lembrar."
            },
            "confirm-password": {
              "name": "senha",
              "description": "Confirme sua senha para se registrar."
            }
          },
          "already-registered": [
            "Você já está registrado!",
            "Utilize /logar <senha>"
          ],
          "password-minimum-length": [
            "Sua senha deve ter no mínimo 5 letras."
          ],
          "password-maximum-length": [
            "Sua senha deve ter no máximo 32 letras."
          ],
          "password-invalid-pattern": [
            "Você precisa utilizar caracteres válidos em sua senha."
          ],
          "passwords-not-equals": [
            "As senhas não são iguais.",
            "Confirme a senha corretamente.",
            "Utilize /registrar <senha> <senha>"
          ],
          "too-many-logged-accounts": [
            "&cVocê está com muitas contas conectadas!"
          ],
          "too-many-registered-accounts": [
            "&cVocê já registrou muitas contas.",
            "&cEntre em contato com nossa equipe.",
            "&cDiscord: &fdiscord.gg/exe"
          ],
          "reserved-name": [
            "Este nick é reservado para os bots da rede."
          ],
          "in-flight": [
            "Aguarde, seu registro ainda está sendo processado."
          ],
          "not-confirmed": [
            "Não foi possível confirmar o seu registro.",
            "Tente de novo: /registrar <senha> <senha>"
          ]
        }
      },
      "messages": {
        "auth": {
          "titles": {
            "request-auth": {
              "login": {
                "title": "&c&lEXE",
                "subtitle": "&fUtilize /logar <senha>"
              },
              "register": {
                "title": "&c&lEXE",
                "subtitle": "&fUtilize /registrar <senha> <senha>"
              },
              "staff": {
                "title": "&c&lEXE",
                "subtitle": "&fUtilize /loginstaff <código>"
              }
            },
            "authenticated": {
              "title": "&c&lAutenticado!",
              "subtitle": "&fSeja bem-vindo!"
            },
            "queue-position": {
              "title": "&c&lEXE",
              "subtitle": "&fVocê está na fila: &c{position}&f de &c{total}"
            },
            "preparing-server": {
              "title": "&c&lEXE",
              "subtitle": "&fEstamos preparando um servidor para você (&c{position}&f de &c{total}&f)"
            }
          },
          "chat": {
            "request-auth": {
              "login": [
                "",
                " &c&lEXE &8➟ &eSessão de Autenticação",
                " &7Seja bem-vindo ao EXE!",
                "",
                " &fUtilize &c/logar <senha>&f para se autenticar.",
                "",
                " &fAcompanhe o nosso discord e fique por dentro de tudo!",
                " &cDiscord: &fdiscord.gg/exe",
                ""
              ],
              "register": [
                "",
                " &c&lEXE &8➟ &eSessão de Autenticação",
                " &7Seja bem-vindo ao EXE!",
                "",
                " &fUtilize &c/registrar <senha> <senha>&f para se registrar.",
                "",
                " &fAcompanhe o nosso discord e fique por dentro de tudo!",
                " &cDiscord: &fdiscord.gg/exe",
                ""
              ]
            }
          },
          "timeout": {
            "kick-message": "&cVocê demorou demais para se autenticar.",
            "count": {
              "login": "&cVocê possui {remaining_time} para se autenticar.",
              "register": "&cVocê possui {remaining_time} para se registrar."
            }
          },
          "queue": {
            "no-lobbies": [
              "",
              " &cNão foram encontrados lobbies para conexão, você foi colocado na lista de espera!",
              ""
            ],
            "kick-message": [
              "&cTodos os servidores estão cheios ou indisponíveis agora.",
              "&cTente entrar de novo em alguns minutos."
            ]
          }
        }
      }
    }
  }
}
