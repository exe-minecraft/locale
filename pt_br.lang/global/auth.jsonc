{
  "plugins": {
    "auth": {
      "commands": {
        "login": {
          "arguments": {
            "password": {
              "name": "senha",
              "description": "Insira a senha que você utiliza nessa conta"
            }
          },
          "already-logged": [
            "Você já se encontra autenticado."
          ],
          "not-registered": [
            "Você ainda não está registrado.",
            "Utilize /registrar <senha> <senha>"
          ],
          "invalid-password": [
            "Senha inválida!",
            "Utilize /logar <senha>"
          ],
          "kick-message": [
            "&cVocê excedeu o limite de tentativas!",
            "&cEspere 10 minutos e tente de novo."
          ],
          "reserved-name": [
            "Este nick é reservado para os bots da rede."
          ],
          "in-flight": [
            "Aguarde, estamos verificando sua senha."
          ]
        },
        "original": {
          "kick-message": [
            "&aSua conta original entra direto, sem senha.",
            "&fEntre de novo no servidor."
          ],
          "not-available": [
            "&cEsta opção é só para um nick de conta original ainda sem registro aqui."
          ]
        },
        "register": {
          "arguments": {
            "password": {
              "name": "senha",
              "description": "Digite uma senha que você irá se lembrar."
            },
            "confirm-password": {
              "name": "senha",
              "description": "Confirme sua senha para se registrar."
            }
          },
          "already-registered": [
            "Você já está registrado!",
            "Utilize /logar <senha>"
          ],
          "password-minimum-length": [
            "Sua senha deve ter no mínimo 5 letras."
          ],
          "password-maximum-length": [
            "Sua senha deve ter no máximo 32 letras."
          ],
          "password-invalid-pattern": [
            "Você precisa utilizar caracteres válidos em sua senha."
          ],
          "passwords-not-equals": [
            "As senhas não são iguais.",
            "Confirme a senha corretamente.",
            "Utilize /registrar <senha> <senha>"
          ],
          "reserved-name": [
            "Este nick é reservado para os bots da rede."
          ],
          "in-flight": [
            "Aguarde, seu registro ainda está sendo processado."
          ],
          "not-confirmed": [
            "Não foi possível confirmar o seu registro.",
            "Tente de novo com /registrar <senha> <senha>"
          ]
        }
      },
      "messages": {
        "auth": {
          "titles": {
            "request-auth": {
              "login": {
                "title": "&c&lEXE",
                "subtitle": "&fUtilize /logar <senha>"
              },
              "register": {
                "title": "&c&lEXE",
                "subtitle": "&fUtilize /registrar <senha> <senha>"
              },
              "original": {
                "title": "&c&lEXE",
                "subtitle": "&fVocê tem Minecraft original? Responda no chat"
              }
            },
            "authenticated": {
              "title": "&c&lAutenticado!",
              "subtitle": "&fSeja bem-vindo!"
            },
            "queue-position": {
              "title": "&c&lEXE",
              "subtitle": "&fVocê está na posição &c{position}&f de &c{total} na fila"
            },
            "preparing-server": {
              "title": "&c&lEXE",
              "subtitle": "&fEstamos preparando um servidor para você (&c{position}&f de &c{total}&f)"
            }
          },
          "chat": {
            "request-auth": {
              "login": [
                "",
                " &c&lEXE &8➟ &eSessão de Autenticação",
                " &7Seja bem-vindo ao EXE!",
                "",
                " &fUtilize &c/logar <senha>&f para se autenticar.",
                "",
                " &fAcompanhe o nosso discord e fique por dentro de tudo!",
                " &cDiscord: &fdiscord.rede-exe.com",
                ""
              ],
              "register": [
                "",
                " &c&lEXE &8➟ &eSessão de Autenticação",
                " &7Seja bem-vindo ao EXE!",
                "",
                " &fUtilize &c/registrar <senha> <senha>&f para se registrar.",
                "",
                " &fAcompanhe o nosso discord e fique por dentro de tudo!",
                " &cDiscord: &fdiscord.rede-exe.com",
                ""
              ],
              "original": {
                "message": [
                  " &eEste nick é de uma conta original do Minecraft. Ela é sua?",
                  " &a&l{original}   &c&l{pirate}",
                  ""
                ],
                "original": "[Original]",
                "original-hover": "&fA conta é minha. Quero sair e entrar de novo direto, sem senha",
                "pirate": "[Pirata]",
                "pirate-hover": "&fNão tenho conta original. Quero registrar uma senha"
              }
            }
          },
          "timeout": {
            "kick-message": "&cVocê demorou demais para se autenticar.",
            "count": {
              "login": "&cVocê possui {remaining_time} para se autenticar.",
              "register": "&cVocê possui {remaining_time} para se registrar."
            }
          },
          "queue": {
            "no-lobbies": [
              "",
              " &cNão foram encontrados lobbies para conexão, você foi colocado na lista de espera!",
              ""
            ],
            "kick-message": [
              "&cTodos os servidores estão cheios ou indisponíveis agora.",
              "&cTente entrar de novo em alguns minutos."
            ]
          },
          "banned": {
            "hold": [
              "",
              " &c&lEXE &8➟ &cConta banida",
              "",
              " &fSua conta está banida, mas você pode comprar o &cUnban&f na loja.",
              " &f1. Entre em &brede-exe.com/entrar&f e digite o seu nick.",
              " &f2. Digite aqui &e/confirmar <código>&f com o código que o site mostrar.",
              " &f3. Compre o &cUnban&f em &brede-exe.com/loja&f.",
              "",
              " &7Você tem 5 minutos. Depois do pagamento, é só entrar de novo.",
              ""
            ],
            "kick-message": [
              "&cO tempo para confirmar o login do site acabou.",
              "&cSe você já comprou o Unban, é só entrar de novo."
            ]
          }
        }
      }
    }
  }
}
