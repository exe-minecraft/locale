{
  "plugins": {
    "core": {
      "proxy": {
        "motd": {
          // Como a da Hypixel: os espaços à esquerda centram cada linha nos 271 px da MOTD na lista do
          // cliente (305 da lista, menos 32 do ícone e 2). Texto novo recalcula os espaços.
          "highest-version": [
            "                           &4&lEXE &8[1.8.x]",
            "          &e&lTEMPORADA #1 &7&l| &f&lUM NOVO COMEÇO"
          ],
          "lowest-version": [
            "&c&lEXE &8➠ &cdiscord.gg/exe",
            "&c         Servidor disponível apenas na 1.8+"
          ],
          // No lugar das de cima enquanto o global.maintenance.group for acima de membro.
          "maintenance": [
            "&c&lEM MANUTENÇÃO",
            "&7Voltaremos em breve!"
          ]
        }
      }
    }
  }
}
