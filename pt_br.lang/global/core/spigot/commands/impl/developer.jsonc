{
  "plugins": {
    "core": {
      "commands": {
        "gmaintenance": {
          "arguments": {
            "group": {
              "name": "grupo",
              "description": "Grupo mínimo para entrar; default abre"
            },
            "server": {
              "name": "servidor",
              "description": "Servidor que deseja fechar; em branco = a rede toda"
            }
          },
          "success": "Manutenção da rede alterada para {group_display_name}.",
          "error": "Não foi possível definir a manutenção da rede, tente novamente mais tarde!",
          "server-success": "Manutenção de {server_id} alterada para {group_display_name} em {apps}.",
          "server-error": "Não foi possível alterar a manutenção de {apps} em {server_id}. Repita o comando, repetir é seguro.",
          "server-no-apps": "Nenhum app encontrado em {server_id}, ou a plataforma não respondeu. Tente novamente.",
          "server-scaled": "O {server_id} escala sozinho e o arion cuida da manutenção das instâncias dele. Para fechar a rede, use /gmanu sem servidor."
        },
        "settings": {
          "arguments": {
            "key": {
              "name": "chave",
              "description": "Chave do sistema que deseja definir"
            },
            "value": {
              "name": "valor",
              "description": "Valor do sistema que deseja definir"
            }
          },
          "success": "Chave aplicada com sucesso ao sistema {settings_key}",
          "error": "Não foi possivel definir a configuração agora, tente novamente mais tarde!"
        }
      }
    }
  }
}
