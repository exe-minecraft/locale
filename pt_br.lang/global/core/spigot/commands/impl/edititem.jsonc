{
  "plugins": {
    "core": {
      "commands": {
        "edititem": {
          "hideall": {
            "success": "Atributos removidos com sucesso!"
          },
          "lore": {
            "add": {
              "arguments": {
                "line": {
                  "name": "conteudo",
                  "description": "conteudo que deseja adicionar"
                }
              },
              "success": "Linha de lore adicionada com sucesso!"
            },
            "remove": {
              "arguments": {
                "index": {
                  "name": "posição",
                  "description": "posição que você deseja remover"
                }
              },
              "no-lore": "Este item não possui lore para remover.",
              "index-out-of-bounds": "Não existe nenhuma linha de lore nesse índice.",
              "success": "Linha de lore removida com sucesso!"
            },
            "set": {
              "arguments": {
                "index": {
                  "name": "posição",
                  "description": "posição que você deseja remover"
                },
                "content": {
                  "name": "conteudo",
                  "description": "conteudo que deseja definir"
                }
              },
              "no-lore": "Este item não possui lore para editar.",
              "index-out-of-bounds": "Não existe nenhuma linha de lore nesse índice.",
              "success": "Linha de lore editada com sucesso!"
            }
          },
          "rename": {
            "arguments": {
              "name": {
                "name": "nome",
                "description": "nome que deseja definir"
              }
            },
            "success": "Item renomeado com sucesso!"
          },
          "help": [
            "",
            "&6Comandos disponíveis do /item: ",
            "",
            "&e /item rename <nome>",
            "   &7● Renomeia o item que está em sua mão",
            "&e /item addlore <texto>",
            "   &7● Adiciona uma nova linha de lore ao item",
            "&e /item removelore <linha>",
            "   &7● Remove uma linha específica da lore",
            "&e /item hideflags",
            "   &7● Esconde todas as flags do item",
            "&e /item glow",
            "   &7● Ativa ou desativa o efeito de brilho",
            "&e /item copy",
            "   &7● Copia a lore do item atual",
            "&e /item paste",
            "   &7● Cola a lore copiada no item atual",
            "&e /item edit <linha> <texto>",
            "   &7● Edita uma linha específica da lore",
            "&e /item copylore",
            "   &7● Copia a lore do item e envia para o pastes.dev",
            ""
          ],
          "usage": "&cUso inválido. Consulte &f/item help&c.",
          "saving": "&cAguarde o salvamento do inventário.",
          "no-item": "&cVocê precisa segurar um item!",
          "updated": "&aItem modificado com sucesso!",
          "copied": "&aLore do item copiada com sucesso!",
          "no-lore": "&cEste item não possui lore!",
          "invalid-line": "&cLinha inválida!",
          "clipboard-empty": "&cNenhuma lore copiada anteriormente!",
          "text-limit": "&cUse até 512 caracteres por texto, sem quebras de linha.",
          "lore-limit": "&cO limite é de 64 linhas de lore.",
          "enchanted": "&7Esse item já brilha por seus encantamentos. Eles serão preservados.",
          "export-pending": "&7A exportação anterior ainda está em andamento.",
          "export-started": "&aEnviando lore para pastes.dev, aguarde...",
          "export-failed": "&cErro ao enviar para o pastes.dev.",
          "export-link": "&aLink do Paste: {url}",
          "export-hover": "&aClique para abrir a lore exportada."
        }
      }
    }
  }
}
