{
  "plugins": {
    "core": {
      "commands": {
        "change-password": {
          "arguments": {
            "password": {
              "name": "senha",
              "description": "Uma senha que você irá se lembrar"
            },
            "confirm-password": {
              "name": "senha",
              "description": "Confirme sua senha"
            },
            "target": {
              "name": "jogador",
              "description": "Jogador que deseja alterar a senha"
            }
          },
          "user-is-original-sender": "Você possui uma conta original, por isso não tem uma senha!",
          "user-is-original-target": "Esse jogador possui uma conta original!",
          "password-invalid-pattern": "Você precisa utilizar caracteres válidos em sua senha.",
          "password-minimum-length": "Sua senha deve ter no mínimo 5 letras.",
          "password-maximum-length": "Sua senha deve ter no máximo 32 letras.",
          "password-not-equals": [
            "As senhas não são iguais.",
            "Confirme a senha corretamente."
          ],
          "success": "Senha alterada com sucesso!",
          "not-confirmed": "A troca de senha não foi confirmada. Pode repetir o comando sem problema."
        },
        "confirm": {
          "arguments": {
            "code": {
              "name": "código",
              "description": "Verifique o site do EXE e introduza o código aqui."
            }
          },
          "error": {
            "cannot-find-code": "O código que você inseriu é inválido ou expirou."
          },
          "success": {
            "auth-confirmation": "Login no site aprovado: um navegador entrou na sua conta. Se outra pessoa te passou este código, use /trocarsenha agora para derrubar esse acesso (conta original: \"Sair de todos os outros navegadores\" no /perfil do site).",
            "auth-confirmation-origin": "O pedido veio da rede {flow_ip}."
          }
        }
      }
    }
  }
}
