{
  "plugins": {
    "core": {
      "commands": {
        "group": {
          "add": {
            "description": "dar um grupo a um jogador",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que será adicionado o grupo"
              },
              "group": {
                "name": "grupo",
                "description": "Group que você deseja adicionar ao jogador"
              },
              "server": {
                "name": "servidor",
                "description": "Servidor que você deseja adicionar o grupo ao jogador"
              },
              "days": {
                "name": "dias",
                "description": "Dias de duração; em branco ou 0 = permanente"
              }
            },
            "need-highest-group": "Você só pode adicionar grupos abaixo do seu nesse servidor!",
            "error": "Sua tentativa de adicionar o grupo falhou, tente novamente mais tarde!",
            "success": "Você adicionou o grupo {group_id} para o jogador {target_name} no servidor {server_id} por {days} {days_word}.",
            "success-permanent": "Você adicionou o grupo {group_id} para o jogador {target_name} no servidor {server_id} permanentemente.",
            // O mesmo grupo permanente de novo: nada mudou. Com dias, o prazo é trocado e vale o success.
            "already": "O jogador {target_name} já tem o grupo {group_id} permanente no servidor {server_id}."
          },
          "remove": {
            "need-highest-group": "Você só pode remover grupos abaixo do seu nesse servidor!",
            "description": "tirar um grupo de um jogador",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que será removido o grupo"
              },
              "group": {
                "name": "grupo",
                "description": "Group que você deseja remover ao jogador"
              },
              "server": {
                "name": "servidor",
                "description": "Servidor que você deseja remover o grupo do jogador"
              }
            },
            "error": "Sua tentativa de remover o grupo falhou, tente novamente mais tarde!",
            "success": "Você removeu o grupo {group_id} do jogador {target_name} no servidor {server_id}.",
            // Quem não tem o grupo nesse escopo (ou já venceu): nada foi tirado.
            "not-found": "O jogador {target_name} não tem o grupo {group_id} no servidor {server_id}."
          },
          "freeze": {
            "description": "congelar o tempo de VIP de um jogador (continua VIP, o prazo para)",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador cujo VIP será congelado"
              },
              "group": {
                "name": "grupo",
                "description": "Grupo de VIP a congelar"
              },
              "server": {
                "name": "servidor",
                "description": "Escopo do grupo (global para a rede toda)"
              }
            },
            "need-highest-group": "Você só pode congelar grupos abaixo do seu nesse servidor!",
            "error": "Sua tentativa de congelar o VIP falhou, tente novamente mais tarde!",
            "conflict": "{target_name} não tem {group_id} com prazo correndo em {server_id}. O grupo é permanente, venceu ou já está congelado.",
            "not-vip": "Só grupos de VIP podem ser congelados. {group_id} é staff ou o grupo padrão.",
            "success": "Você congelou o {group_id} de {target_name} em {server_id}. Restam {remaining}, com o prazo parado até descongelar."
          },
          "unfreeze": {
            "description": "descongelar o tempo de VIP de um jogador (o prazo volta a correr)",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador cujo VIP será descongelado"
              },
              "group": {
                "name": "grupo",
                "description": "Grupo de VIP a descongelar"
              },
              "server": {
                "name": "servidor",
                "description": "Escopo do grupo (global para a rede toda)"
              }
            },
            "need-highest-group": "Você só pode descongelar grupos abaixo do seu nesse servidor!",
            "error": "Sua tentativa de descongelar o VIP falhou, tente novamente mais tarde!",
            "conflict": "{target_name} não tem {group_id} congelado em {server_id}.",
            "not-vip": "Só grupos de VIP podem ser congelados. {group_id} é staff ou o grupo padrão.",
            "success": "Você descongelou o {group_id} de {target_name} em {server_id}. O prazo voltou a correr e restam {remaining}."
          },
          "freeze-all": {
            "description": "congelar todos os VIPs; os novos também entram congelados",
            "need-global-manager": "Congelar todos os VIPs afeta a rede inteira. Só manager global ou superior pode fazer isso.",
            "error": "Sua tentativa de congelar todos os VIPs falhou, tente novamente mais tarde!",
            "vips": {
              "singular": "VIP congelado",
              "plural": "VIPs congelados"
            },
            "success": "Congelamento geral ligado para {count} {vips}. VIP comprado ou dado a partir de agora também entra congelado."
          },
          "unfreeze-all": {
            "description": "descongelar todos os VIPs e desligar o congelamento geral",
            "need-global-manager": "Descongelar todos os VIPs afeta a rede inteira. Só manager global ou superior pode fazer isso.",
            "error": "Sua tentativa de descongelar todos os VIPs falhou, tente novamente mais tarde!",
            "vips": {
              "singular": "VIP descongelado",
              "plural": "VIPs descongelados"
            },
            "success": "Congelamento geral desligado para {count} {vips}. Os prazos voltaram a correr."
          }
        },
        // O /darvip (o /givevip do exe-p4free-core): dá VIP com anúncio na rede toda e registro para a staff.
        // Os dias somam ao que resta, a temporada é a do servidor onde o comando roda, e os dois VIPs convivem
        // na conta. O anúncio e o título vão para todos; o AQUI abre a loja.
        "give-vip": {
          "description": "dar VIP a um jogador, com anúncio na rede",
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador que vai receber o VIP"
            },
            "vip": {
              "name": "vip",
              "description": "O VIP a dar (samurai ou imperial)"
            },
            "duration": {
              "name": "dias|permanente|temporada",
              "description": "Dias somados ao que resta, permanente, ou até o fim da temporada deste servidor"
            }
          },
          "not-vip": "{vip} não é um VIP. Escolha entre {vips}.",
          "invalid-duration": "Use os dias (de 1 a {max_days}), permanente ou temporada.",
          "need-highest-group": "Você só pode dar VIP abaixo do seu grupo!",
          "self": "Só o master dá VIP para a própria conta.",
          "error": "A plataforma não confirmou o VIP de {target_name}. Confira no painel (Tempo de VIP) antes de repetir, pois ele pode ter sido gravado.",
          "already-permanent": "{target_name} já tem o {vip_tag} &cpermanente. Não há o que somar.",
          "success": "Você deu {days} {days_word} de {vip_tag} &apara {target_name}. O VIP vence em {expires_at} (restam {remaining}).",
          "success-frozen": "Você deu {days} {days_word} de {vip_tag} &apara {target_name}. O VIP está congelado e restam {remaining}, com o prazo parado até descongelar.",
          "success-permanent": "Você deu o {vip_tag} &apermanente para {target_name}.",
          "success-season": "Você deu o {vip_tag} &apara {target_name} até o fim da temporada de {server_id} ({ends_at}).",
          "season-pending": "A temporada de {server_id} está na virada. O {vip_tag} &ade {target_name} ficou gravado e entra quando a próxima abrir.",
          "season-already": "{target_name} já tem o {vip_tag} &cdesta temporada (comprado ou dado).",
          "no-season": "{server_id} não tem temporada aberta. O VIP de temporada segue a do servidor onde o comando roda.",
          "announce": {
            "days": [
              "",
              "{vip_color}&lNOVO VIP {vip_name} NA ÁREA!",
              "",
              "&fO jogador {target_name_with_color} &facabou de adquirir",
              "&fo VIP {vip_tag} &fpor {vip_color}{days} {days_word}&f!",
              "",
              "&fGaranta o seu clicando &a&lAQUI&f.",
              ""
            ],
            "permanent": [
              "",
              "{vip_color}&lNOVO VIP {vip_name} NA ÁREA!",
              "",
              "&fO jogador {target_name_with_color} &facabou de adquirir",
              "&fo VIP {vip_tag} {vip_color}permanente&f!",
              "",
              "&fGaranta o seu clicando &a&lAQUI&f.",
              ""
            ],
            "season": [
              "",
              "{vip_color}&lNOVO VIP {vip_name} NA ÁREA!",
              "",
              "&fO jogador {target_name_with_color} &facabou de adquirir",
              "&fo VIP {vip_tag} &faté o fim da temporada ({vip_color}{ends_at}&f)!",
              "",
              "&fGaranta o seu clicando &a&lAQUI&f.",
              ""
            ],
            // A linha de baixo do anúncio, uma mensagem à parte porque cada uma tem um AQUI só. Este roda o /gg do
            // nick e vale por 5 minutos.
            "cheer": [
              "&fDê os parabéns a {target_name_with_color} &fclicando &a&lAQUI&f.",
              ""
            ]
          },
          "title": {
            "title": "{target_name_with_color}",
            "subtitle": "&fTornou-se {vip_tag}"
          },
          "staff-log": {
            "days": "&8[VIP] &7{sender_name} deu {days} {days_word} de {vip_tag} &7para {target_name}.",
            "permanent": "&8[VIP] &7{sender_name} deu o {vip_tag} &7permanente para {target_name}.",
            "season": "&8[VIP] &7{sender_name} deu o {vip_tag} &7para {target_name} até o fim da temporada ({ends_at})."
          }
        },
        // O /gg, o AQUI do anúncio de VIP novo. A linha vai à rede toda, e cada um comemora uma vez por ativação.
        "cheer-vip": {
          "description": "dar os parabéns a quem acabou de ganhar VIP",
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Quem acabou de ganhar o VIP"
            }
          },
          "self": "Comemorar o próprio VIP não vale.",
          "closed": "A comemoração do VIP de {target_name} já passou.",
          "already": "Você já deu os parabéns a {target_name}.",
          // Uma sai sorteada a cada /gg.
          "phrases": [
            "gg!",
            "aeee!",
            "boa demais!",
            "parabéns!",
            "bem-vindo ao clube!",
            "farmou aura, 67!",
            "chegou chegando!"
          ],
          "message": "&a▸ {sender_name_with_color} &7para {target_name_with_color}&7: &a{phrase}"
        }
      }
    }
  }
}
