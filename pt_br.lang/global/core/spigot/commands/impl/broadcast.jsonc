{
  "plugins": {
    "core": {
      "commands": {
        "broadcast": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que deseja enviar para a rede toda."
            }
          },
          "message": "&c&lEXE &f{broadcast_message}"
        },
        "broadcast-announce": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que deseja ser divulgada."
            }
          },
          "message": [
            "",
            "&c&l[ANÚNCIO] &f{broadcast_announce_message}",
            ""
          ]
        },
        "broadcast-message": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que deseja enviar."
            }
          }
        },
        "broadcast-title": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que deseja enviar."
            }
          }
        }
      }
    }
  }
}
