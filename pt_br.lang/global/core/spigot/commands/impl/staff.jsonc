{
  "plugins": {
    "core": {
      "commands": {
        "account": {
          "arguments": {
            "target": {
              "name": "nome ou uuid",
              "description": "Insira o nome ou a uuid do jogador"
            }
          },
          "invalid-uuid-pattern": "Você precisa inserir um formato de uuid válido!",
          "invalid-name-pattern": "Você precisa inserir um formato de nome válido!",
          "message": {
            "identity": [
              "",
              " &eConta de {primary}{account_name}&e:",
              "",
              "  &fUUID: &7{account_uuid}",
              "  &fConta: &7{account_type}"
            ],
            "session": [
              "  &fÚltima entrada: &7{account_last_login}",
              "  &fÚltima saída: &7{account_last_quit}"
            ],
            "still-online": "ainda online",
            "type-original": "&aOriginal",
            "type-cracked": "&cPirata",
            "general": [
              "",
              "  &fGrupos: &7{account_groups}",
              "  &fCadastro: &7{account_registered}"
            ],
            "network": [
              "  &fNível de rede: &7{account_level}",
              "  &fConquistas: &7{account_achievements}"
            ],
            "unknown": "?",
            "no-groups": "nenhum",
            "associated": "  &fContas no mesmo IP: &7{account_associated}",
            "associated-entry": "{associated_name}",
            "associated-empty": "nenhuma",
            "status": [
              "",
              " {primary}Online agora:",
              "  &fProxy: &7{account_proxy}",
              "  &fOnline desde: &7{account_joined}",
              "  &fVersão: &7{account_version}"
            ],
            "status-staff": [
              "  &fServidor: &7{account_server}",
              "  &fIP: &7{account_ip}"
            ]
          }
        },
        "alts": {
          "arguments": {
            "target": {
              "name": "nome ou ip",
              "description": "Insira o nome do jogador (o IP é só do Manager para cima)"
            }
          },
          "invalid-name-pattern": "Você precisa inserir um formato de nome válido!",
          "invalid-address": "Esse IP não é um endereço válido!",
          "message": {
            "accounts": {
              "singular": "conta",
              "plural": "contas"
            },
            "ips": {
              "singular": "IP",
              "plural": "IPs"
            },
            "account": {
              "header": [
                "",
                " &eContas no mesmo IP de &f{alts_target}&e: &7{alts_total} {alts_accounts}",
                ""
              ],
              "empty": "Nenhuma conta divide IP com &f{alts_target}&e."
            },
            "address": {
              "header": [
                "",
                " &eContas que usaram o IP &f{alts_target}&e: &7{alts_total} {alts_accounts}",
                ""
              ],
              "empty": "Nenhuma conta usou o IP &f{alts_target}&e."
            },
            "entry": "  &f{alts_name}&7: {alts_state}{alts_punishments}",
            "online": "&aonline agora",
            "seen": "&7visto em {alts_seen}",
            "punishment": " &8[{alts_punishment_type}&8]",
            "unknown-type": "&cpunição",
            "remaining": "por mais {alts_punishment_remaining}",
            "permanent": "permanente",
            "more": "  &7e mais {alts_hidden} {alts_accounts}, de acesso mais antigo",
            "hover": "&7Clique para abrir o &f/account {alts_name}",
            "hover-addresses": "&7IPs em comum: &f{alts_addresses}",
            "hover-addresses-more": "&7e mais {alts_hidden} {alts_ips}",
            "hover-punishment": "{alts_punishment_type}&7, {alts_punishment_duration}: &f{alts_punishment_reason}",
            "no-reason": "&7sem motivo registrado"
          }
        },
        // O /brand: o cliente que cada jogador da rede anunciou ao entrar, contado e listado pelo proxy.
        "brand": {
          "arguments": {
            "filter": {
              "name": "cliente ou jogador",
              "description": "Um pedaço do nome do cliente (? para quem não mandou nenhum) ou o nick de um jogador"
            }
          },
          "no-proxy": "Nenhum proxy está online para dizer os clientes.",
          "proxy-silent": "Nem todo proxy respondeu a tempo, e os jogadores de quem não respondeu ficaram de fora.",
          "not-found": "Ninguém online usa um cliente com &f{brand_filter}&c no nome, e nenhum jogador com esse nick está online.",
          "message": {
            "players": {
              "singular": "jogador",
              "plural": "jogadores"
            },
            "empty": "Ninguém está online agora.",
            "summary-header": [
              "",
              " &eClientes conectados: &7{brand_total} {brand_players}",
              ""
            ],
            "summary-entry": "  &e➟ &f{brand_name} &7({brand_count} {brand_players}, {brand_percent}%)",
            "summary-footer": [
              "",
              " &7Clique num cliente para ver quem usa, ou use &f/brand <cliente|jogador>&7.",
              ""
            ],
            "unknown": "sem brand",
            "hover-name": "&f{brand_name}",
            "hover-more": "&7e mais {brand_hidden} {brand_players}",
            "hover-summary": "&eClique para ver quem usa este cliente",
            "filter-header": [
              "",
              " &eResultado para &f{brand_filter}&e: &7{brand_total} {brand_players}",
              ""
            ],
            "filter-entry": "  {brand_name} &8({brand_version}, {brand_server}) &7{brand_client}",
            "no-server": "trocando de servidor",
            "hover-filter": "&7Clique para abrir o &f/account {brand_name}",
            "more": "  &7e mais {brand_hidden} {brand_players}"
          }
        },
        "staff-chat": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que será enviada"
            }
          },
          "message": "&d&l[S] &7({sender_connected_server}) {sender_name_with_tag} &f{sender_message}"
        },
        "staff-high-chat": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que será enviada"
            }
          },
          "message": "&4&l[BUNKER] &7({sender_connected_server}) {sender_name_with_tag} &f{sender_message}"
        }
      }
    }
  }
}
