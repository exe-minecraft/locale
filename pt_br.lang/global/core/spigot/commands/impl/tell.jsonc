{
  "plugins": {
    "core": {
      "commands": {
        "toggletell": {
          "enabled": "Tell habilitado! Você voltará a receber mensagens privadas.",
          "disabled": "&cTell desabilitado! Você não receberá mais mensagens privadas. Use /tt para habilitar novamente."
        },
        "reply": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que deseja enviar de volta"
            }
          },
          "reply-not-found": "Não há pessoas para responder. :S",
          "sender-preference-disabled": "Você desabilitou suas mensagens privadas! Use /tt ou /preferencias para habilitar esta função novamente.",
          "target-preference-disabled": "O jogador {target_name} está com o recebimento de mensagens privadas desativado.",
          "sender-ignored-target": "Você não pode enviar mensagens para um jogador ignorado!",
          "target-ignored-sender": "Você não pode enviar mensagens para o jogador {target_name} pois ele te adicionou na lista de ignorados!",
          "message-sender": "&6Mensagem para {target_name_with_tag}&6: &f{target_message}",
          "message-target": "&6Mensagem de {sender_name_with_tag}&6: &f{sender_message}"
        },
        "tell": {
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador que você deseja enviar a mensagem"
            },
            "message": {
              "name": "mensagem",
              "description": "Mensagem que deseja enviar de volta"
            }
          },
          "sender-preference-disabled": "Você desabilitou suas mensagens privadas! Use /tt ou /preferencias para habilitar esta função novamente.",
          "target-preference-disabled": "O jogador {target_name} está com o recebimento de mensagens privadas desativado.",
          "sender-ignored-target": "Você não pode enviar mensagens para um jogador ignorado!",
          "target-ignored-sender": "Você não pode enviar mensagens para o jogador {target_name} pois ele te adicionou na lista de ignorados!",
          "message-sender": "&6Mensagem para {target_name_with_tag}&6: &f{target_message}",
          "message-target": "&6Mensagem de {sender_name_with_tag}&6: &f{sender_message}"
        }
      }
    }
  }
}
