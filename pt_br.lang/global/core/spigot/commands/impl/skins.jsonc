{
  "plugins": {
    "core": {
      "commands": {
        "skin": {
          "reset": {
            "description": "voltar para a skin da sua conta",
            "need-equipped-skin": "Você não está com nenhuma skin equipada, se quiser atualizar utiliza /skin atualizar",
            "loading": "Buscando sua skin...",
            "success": "Skin alterada com sucesso!"
          },
          "update": {
            "description": "atualizar a skin que você está usando",
            "need-equipped-skin": "Você não está com nenhuma skin equipada para atualizar. Para escolher uma, use /skin <nick>.",
            "loading": "Buscando sua skin...",
            "success": "Skin alterada com sucesso!",
            "not-found": "A conta original {skin_name} não existe mais ou está sem skin na Mojang, então nada foi alterado."
          },
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Nome do jogador com a skin que deseja"
            }
          },
          "cannot-use-self": "Você não pode selecionar sua própria skin, para equipá-la utilize /skin resetar",
          "need-original-account": "O jogador selecionado precisa ter um minecraft original!",
          "already-equipped": "Você já está utilizando essa skin!",
          "loading": "Buscando sua skin...",
          "success": "Skin alterada com sucesso!"
        }
      }
    }
  }
}
