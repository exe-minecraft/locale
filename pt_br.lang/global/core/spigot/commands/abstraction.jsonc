{
  "plugins": {
    "core": {
      "commands": {
        "abstraction": {
          "restriction": {
            "only-console": "Este comando só pode ser usado pelo console.",
            "only-player": "Este comando só pode ser usado por jogadores."
          },
          "command-in-delay": [
            "Você deve esperar {remaining_time} para usar esse comando novamente."
          ],
          // O template de toda ajuda de comando (CustomCommand#sendUsage e #sendUsageList). Nenhum
          // comando escreve o seu "Uso:" nem a sua lista à mão: o comando registra argumentos e
          // subcomandos (com <subcomando>.description), ou declara as formas que lê sozinho em
          // <comando>.usage.<forma>.syntax e .description.
          "usage": {
            // {usage}: o comando digitado e os argumentos, <obrigatório> e [opcional].
            "single": "&cUso: /{usage}",
            // {command}: o comando; {entries}: uma linha por forma, no formato de entry.
            "list": [
              "",
              "&eComandos do /{command}:",
              "",
              "{entries}",
              ""
            ],
            "entry": "&e/{usage}&7: {description}",
            "entry-without-description": "&e/{usage}"
          }
        }
      }
    }
  }
}
