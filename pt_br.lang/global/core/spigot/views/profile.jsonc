{
  "plugins": { "core": {
    // O /perfil (o vídeo do dono, 20/10). O "lore" é o do próprio jogador, o "lore-public" é o que os outros veem no
    // /perfil <jogador>, sem cash nem compras.
    // O /perfil no padrão dos menus da casa (o dono, 20/10), nos menus core/spigot/views/profile/own e public.
    "views": { "player-profile": {
      "title": "Seu perfil",
      "title-public": "Perfil de {target_name}",
      "unknown": "?",
      "items": {
        "profile": {
          "name": "&6{target_name}",
          "lore": [
            "&7Suas informações na rede.",
            "",
            "&8 ▸ &fGrupo: {target_group_name}",
            "&8 ▸ &fNível de rede: &b{level}",
            "&8 ▸ &fConquistas: &b{achievements}",
            "&8 ▸ &fCash: &6{cash}",
            "",
            "&8 ▸ &fCadastro: &7{registered}",
            "&8 ▸ &fÚltimo login: &7{last_login}",
            "",
            "&aClique para abrir seu perfil no site."
          ],
          "lore-public": [
            "&7O perfil público deste jogador.",
            "",
            "&8 ▸ &fGrupo: {target_group_name}",
            "&8 ▸ &fNível de rede: &b{level}",
            "&8 ▸ &fConquistas: &b{achievements}",
            "",
            "&8 ▸ &fCadastro: &7{registered}",
            "&8 ▸ &fÚltimo login: &7{last_login}"
          ]
        },
        "discord": {
          "name": "&9Discord",
          "linked": [
            "&7Novidades, sorteios e suporte",
            "&7ficam no nosso Discord.",
            "",
            "&8 ▸ &fConta: &b{discord_name}",
            "",
            "&aClique para receber o convite."
          ],
          "unlinked": [
            "&7Novidades, sorteios e suporte",
            "&7ficam no nosso Discord.",
            "",
            "&8 ▸ &fConta: &cnão vinculada",
            "",
            "&aClique para gerar o código de vínculo."
          ],
          "linked-public": [
            "&8 ▸ &fConta: &b{discord_name}"
          ],
          "unlinked-public": [
            "&8 ▸ &fConta: &7nenhuma vinculada"
          ]
        },
        "achievements": {
          "name": "&bConquistas",
          "lore": [
            "&7Cada conquista dá XP e sobe",
            "&7o seu nível de rede.",
            "",
            "&aClique para ver as suas conquistas."
          ]
        },
        "achievements-public": {
          "name": "&bConquistas",
          "lore": [
            "&7Cada conquista dá XP e sobe",
            "&7o nível de rede.",
            "",
            "&aClique para ver as de {target_name}."
          ]
        },
        // Os eventos que ele jogou (o dono, 24/10), no menu core/spigot/views/profile/events.
        "events": {
          "name": "&6Eventos",
          "lore": [
            "&7Gladiador, ClanFight, FastGlad e CxC.",
            "&7O seu desempenho em cada um e",
            "&7todas as partidas que você jogou.",
            "",
            "&aClique para ver os seus eventos."
          ]
        },
        "events-public": {
          "name": "&6Eventos",
          "lore": [
            "&7Gladiador, ClanFight, FastGlad e CxC.",
            "&7O desempenho em cada um e todas",
            "&7as partidas que este jogador jogou.",
            "",
            "&aClique para ver os de {target_name}."
          ]
        },
        "purchases": {
          "name": "&aSuas compras",
          "lore": [
            "&7O que você comprou na loja, para",
            "&7você ou de presente.",
            "",
            "&8 ▸ &fCompras: &b{purchases}",
            "",
            "&aClique para ver o histórico."
          ]
        },
        "store": {
          "name": "&eLoja",
          "lore": [
            "&7VIP e Cash ajudam a manter",
            "&7o servidor de pé.",
            "",
            "&8 ▸ &floja.rede-exe.com",
            "",
            "&aClique para receber o link."
          ]
        },
        "ignores": {
          "name": "&cJogadores ignorados",
          "lore": [
            "&7Veja os jogadores que você",
            "&7ignorou no servidor.",
            "",
            "&aClique para ver a lista."
          ]
        },
        "preferences": {
          "name": "&aPreferências",
          "lore": [
            "&7Ajuste o que a rede mostra",
            "&7para você.",
            "",
            "&aClique para ver as preferências."
          ]
        }
      },
      "store-link": "&aClique aqui para abrir a loja.",
      "discord-link": "&aClique aqui para entrar no Discord da rede.",
      "site-link": "&aLink pronto. &b&nClique para abrir o site&r &8(vale 1 minuto)",
      "site-link-hover": "&7Abre o site já logado. Não mande este link a ninguém.",
      "site-link-unavailable": "Não deu para gerar o link do site agora. Tente de novo em instantes."
    },
    // O botão "Eventos" do /perfil (o dono, 24/10): o desempenho somado e as partidas uma a uma, de quem foi aberto.
    // As partidas canceladas aparecem na lista e não entram em nenhum número do resumo.
    "player-events": {
      "title": "Eventos de {target_name}",
      "unknown": "?",
      "none": "&7nenhum",
      "match-link": "&aClique aqui para ver a partida completa no site.",
      "match-link-hover": "&7Abre a página da partida em rede-exe.com.",
      "hits": "&8 ▸ &fGolpes acertados: &b{hits}",
      "top-killer": "&8 ▸ &fMais abates: {player} &7({kills})",
      // No Gladiador o destaque é o Mito, o que mais abateu no clã vencedor.
      "top-killer-gladiator": "&8 ▸ &fMito: {player} &7({kills})",
      "summary-none": ["&7Nenhuma partida ainda.", ""],
      "summary-event": [
        "&e{event}",
        "&8 ▸ &fPartidas: &b{matches} &8| &fVitórias: &a{wins} &7({rate}%)",
        "&8 ▸ &fAbates: &b{kills} &8| &fMortes: &c{deaths}",
        ""
      ],
      "events": { "all": "Todos", "gladiator": "Gladiador", "clan-fight": "ClanFight", "fast-glad": "FastGlad", "cxc": "CxC" },
      // Como o jogador terminou a partida, o ParticipantState do jogo, como na página da partida no site.
      "states": {
        "ALIVE": "&aSobreviveu",
        "ELIMINATED": "&cEliminado",
        "LEFT": "&eSaiu",
        "WEB_LEFT": "&eSaiu na teia",
        "KICKED": "&eExpulso",
        "COMBAT_LOGGED": "&cDeslogou em combate",
        "WEB_LOGGED": "&cDeslogou na teia",
        "DISCONNECTED": "&7Caiu",
        "none": "&7Sem registro"
      },
      "filter": { "selected": "&f ▶ {filter}", "unselected": "&7 ▶ {filter}" },
      "items": {
        "summary": {
          "name": "&6Desempenho de {target_name}",
          "lore": [
            "&7A soma das partidas que valeram.",
            "",
            "{events}",
            "&7Clique numa partida para abrir",
            "&7a página dela no site."
          ],
          "loading": ["&7Carregando..."],
          "unavailable": ["&cNão deu para carregar o desempenho agora.", "&7Tente de novo em instantes."]
        },
        "match": {
          "name": {
            "won": "&a{event} &8» &aVitória",
            "lost": "&c{event} &8» &cDerrota",
            "cancelled": "&7{event} &8» &7Cancelado"
          },
          "lore": [
            "&7{date} &8(temporada {season})",
            "",
            "&8 ▸ &fComo terminou: {state}",
            "&8 ▸ &fAbates: &b{kills}",
            "&8 ▸ &fMortes: &c{deaths}",
            "{hits}",
            "",
            "&8 ▸ &fVencedor: {winner}",
            "&8 ▸ &fParticipantes: &b{participants} &8| &fClãs: &b{clans}",
            "{top_killer}",
            "&8 ▸ &fDuração: &7{duration}",
            "",
            "&aClique para ver a partida no site."
          ]
        },
        "previous": { "name": "&ePartidas mais recentes" },
        "next": { "name": "&ePartidas mais antigas" },
        "filter": { "name": "&bEscolha qual evento ver", "lore": ["", "{filters}", "", "&bClique para trocar."] }
      }
    } }
  } }
}
