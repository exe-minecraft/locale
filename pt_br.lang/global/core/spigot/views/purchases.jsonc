{
  "plugins": { "core": {
    "commands": { "purchases": { "description": "Consulta suas compras na loja." } },
    "views": { "purchases": {
      "title": "Minhas compras",
      "status": { "pending": "&eAguardando pagamento", "paid": "&aPago", "cancelled": "&cCancelado", "expired": "&cExpirado", "refunded": "&6Reembolsado" },
      "product": "&7{quantity}x &f{product}",
      "items": {
        "order": { "name": "&bPedido #{order_id}", "lore": ["", "&7Situação: {status}", "&7Data: &f{date}", "&7Total: &aR$ {total}", "&7Destinatário: &f{recipient}", "", "{products}", "", "&7Consulte os detalhes em Minhas compras", "&7no site rede-exe.com."] },
        "previous": { "name": "&eCompras anteriores" },
        "next": { "name": "&eMais compras" },
        "close": { "name": "&cFechar", "lore": ["&7Fecha o histórico de compras."] }
      }
    } }
  } }
}
