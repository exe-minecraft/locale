                " &fXP ganho: &7{achievements_xp}",
                ""
              ]
            },
            "summary-other": {
              "name": "&aConquistas de {target_name}",
              "lore": [
                "",
                " &fDesbloqueadas: &7{achievements_unlocked} de {achievements_total}",
                " &fXP ganho: &7{achievements_xp}",
                ""
              ]
            },
            "unlocked": {
              "name": "&a{achievement_name}",
              "lore": [
                "",
                " &fXP: &7+{achievement_xp}",
                " &fDesbloqueada em &7{achievement_unlocked_at}",
                ""
              ]
