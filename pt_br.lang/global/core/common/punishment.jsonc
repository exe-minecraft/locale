{
  "plugins": {
    "core": {
      "punishment": {
        "types": {
          "warn": {
            "name": "&eaviso"
          },
          "mute": {
            "name": "&esilenciamento"
          },
          "ban": {
            "name": "&cbanimento"
          },
          "ban_ip": {
            "name": "&cbanimento por ip"
          }
        },
        // As categorias do /punir, uma por regra do servidor. O tipo e a duração de cada uma não
        // vivem aqui: estão no catálogo da plataforma (docs/deploy/punir-catalogo-20261017 no monorepo).
        "categories": {
          "chat-disorder": {
            "name": "Desordem no chat",
            "description": [
              "&7Mensagens que atrapalham o",
              "&7desenvolvimento do bate-papo",
              "&7dentro do servidor."
            ]
          },
          "staff-or-server-offense": {
            "name": "Ofensa à equipe/servidor",
            "description": [
              "&7Qualquer desrespeito com a",
              "&7equipe e/ou com o servidor."
            ]
          },
          "discrimination": {
            "name": "Atitude de discriminação",
            "description": [
              "&7Ofender outro jogador por conta de",
              "&7seu sexo, cultura, cor, religião e",
              "&7outros, de maneira direta ou indireta."
            ]
          },
          "business": {
            "name": "Comércio externo",
            "description": [
              "&7Promover ou realizar transações",
              "&7comerciais fora dos canais",
              "&7oficiais permitidos."
            ]
          },
          "divulgation": {
            "name": "Divulgação simples",
            "description": [
              "&7Fazer promoções ou divulgações",
              "&7não autorizadas de forma",
              "&7não agressiva."
            ]
          },
          "disinformation": {
            "name": "Desinformação",
            "description": [
              "&7Disseminar informações falsas ou",
              "&7enganosas que podem prejudicar",
              "&7outros ou criar confusão."
            ]
          },
          "client-alternative": {
            "name": "Clientes alternativos",
            "description": [
              "&7Utilizar modificações ilegais que",
              "&7geram vantagem em relação aos",
              "&7outros jogadores."
            ]
          },
          "inappropriate-nickname": {
            "name": "Nome impróprio",
            "description": [
              "&7Escolher um nome de usuário",
              "&7ofensivo ou impróprio."
            ]
          },
          "falsification-evidence": {
            "name": "Falsificação de provas",
            "description": [
              "&7Falsificar evidências para",
              "&7fazer denúncias falsas."
            ]
          },
          "chargeback": {
            "name": "Estorno de pagamento (chargeback)",
            "description": [
              "&7Tentar reverter pagamentos de",
              "&7maneira fraudulenta ou injusta."
            ]
          },
          "server-divulgation": {
            "name": "Divulgação grave",
            "description": [
              "&7Divulgar outros servidores de",
              "&7Minecraft ou lojas do gênero para",
              "&7marketing e captação de jogadores,",
              "&7inclusive com endereços IP e links."
            ]
          },
          "abuse-bugs": {
            "name": "Abuso de bugs",
            "description": [
              "&7Explorar falhas no sistema para",
              "&7obter vantagens injustas."
            ]
          }
        }
      }
    }
  }
}
