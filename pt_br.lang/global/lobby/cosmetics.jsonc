{
  "plugins": {
    "lobby": {
      "items": {
        "lobby-cosmetics-item": {
          "name": "&dCosméticos",
          "lore": [
            "&7Clique com o botão direito para",
            "&7abrir o menu de cosméticos."
          ]
        }
      },
      "preferences": {
        "lobby-cosmetics": {
          "name": "&eCosméticos dos jogadores",
          "description": [
            "&7Mostra ou esconde as partículas, mascotes",
            "&7e balões dos outros jogadores."
          ]
        }
      },
      "commands": {
        "cosmetics": {
          "not-found": "&cO cosmético &f{cosmetic_id}&c não existe.",
          "give": {
            "description": "dar um cosmético a um jogador",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que vai receber o cosmético"
              },
              "cosmetic": {
                "name": "cosmético",
                "description": "Id do cosmético (veja a lista com o tab)"
              }
            },
            "success": "O cosmético {cosmetic_name}&a foi dado a {target_name_with_color}&a.",
            "already-owned": "{target_name_with_color}&c já possui {cosmetic_name}&c.",
            "error": "Não foi possível dar {cosmetic_name}&c a {target_name_with_color}&c. Tente novamente."
          },
          "remove": {
            "description": "tirar um cosmético de um jogador",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que vai perder o cosmético"
              },
              "cosmetic": {
                "name": "cosmético",
                "description": "Id do cosmético (veja a lista com o tab)"
              }
            },
            "success": "O cosmético {cosmetic_name}&a foi removido de {target_name_with_color}&a.",
            "not-owned": "{target_name_with_color}&c não possui {cosmetic_name}&c.",
            "error": "Não foi possível remover {cosmetic_name}&c de {target_name_with_color}&c. Tente novamente."
          }
        }
      },
      "cosmetics": {
        "categories": {
          "particles": "Partículas",
          "hats": "Chapéus",
          "gadgets": "Gadgets",
          "pets": "Mascotes",
          "balloons": "Balões",
          "armor": "Armaduras",
          "trails": "Rastros",
          "wings": "Asas"
        },
        "rarities": {
          "common": "&7Comum",
          "rare": "&9Raro",
          "epic": "&5Épico",
          "legendary": "&6Lendário"
        },
        "pet-name": "&7Mascote de &f{owner_name}",
        "pet-name-custom": "&f{pet_name} &7de &f{owner_name}",
        // A ficha que sai no chat quando alguém clica com o botão direito num mascote.
        "pet-card": {
          "title": "&eMascote de {owner_name_with_color}",
          "name": "&7Nome: &f{pet_name}",
          "unnamed": "&7Nome: &8nenhum ainda",
          "species": "&7Espécie: {cosmetic_name} &8({cosmetic_rarity}&8)",
          "since": "&7Adquirido em: &f{since_date}",
          "rename-hint": "&7Para dar um nome a ele por &6{rename_price} Cash&7, agache e clique nele com o botão direito."
        },
        "pet-rename": {
          "query": "&eQual vai ser o nome do seu mascote? Use de {min_length} a {max_length} letras ou números. Custa &6{rename_price} Cash&e.",
          "confirm": "&eConfirma o nome &f{pet_name}&e para o seu mascote por &6{rename_price} Cash&e?",
          "invalid": "Esse nome não serve. Use de {min_length} a {max_length} caracteres, só letras, números, espaço e . _ ' -",
          "not-equipped": "Você guardou ou trocou o mascote antes de terminar, então nada foi cobrado.",
          "same-name": "Seu mascote já se chama &f{pet_name}&c. Nada foi cobrado.",
          "in-progress": "Espere terminar o nome que você já está dando ao mascote.",
          "insufficient": "Você precisa de &6{rename_price} Cash&c para dar um nome ao mascote. Seu saldo: &6{user_balance} Cash&c.",
          "failed": "Não foi possível dar o nome ao mascote. Tente novamente em instantes.",
          "unconfirmed": "Não foi possível confirmar o nome &f{pet_name}&c. A falha foi registrada. Procure a equipe se o nome ou o Cash não aparecerem.",
          "renamed": "Agora seu mascote se chama &f{pet_name}&a! Foram &6{rename_price} Cash&a."
        },
        "gadget-lore": [
          "&7Clique com o botão direito",
          "&7para usar o gadget."
        ],
        "messages": {
          "purchase-unconfirmed": "Não foi possível confirmar a compra de {cosmetic_name}&c. A falha foi registrada. Procure a equipe se o cosmético ou o Cash não aparecerem.",
          "equipped": "Você equipou {cosmetic_name}&a.",
          "unequipped": "Você removeu o cosmético de {category_name}.",
          "unequipped-all": "Todos os seus cosméticos foram removidos.",
          "nothing-equipped": "Você não tem nenhum cosmético equipado.",
          "purchased": "Você comprou {cosmetic_name}&a por &6{cosmetic_price} Cash&a!",
          "insufficient": "Você precisa de &6{cosmetic_price} Cash&c para comprar {cosmetic_name}&c. Seu saldo: &6{user_balance} Cash&c.",
          "purchase-failed": "Não foi possível concluir a compra. Tente novamente em instantes.",
          "locked": "Este cosmético é exclusivo do grupo {cosmetic_group}&c.",
          "not-owned": "Você ainda não possui este cosmético.",
          "profile-unavailable": "Seus cosméticos ainda não foram carregados. Tente novamente em instantes.",
          // Quem perde o VIP (ou a staff) com o lobby aberto: o que não pode mais usar é removido na hora.
          "access-lost": "Você perdeu o acesso a cosméticos que estava usando, e eles foram removidos.",
          "gadget-cooldown": "&cAguarde &f{remaining_time}&c para usar o gadget novamente.",
          // Os fogos, a bola de neve, a pérola e o anzol são entidades que todos veem.
          "gadget-vanish": "&cOs gadgets ficam desligados enquanto você está no vanish."
        },
