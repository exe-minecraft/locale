{
  "plugins": {
    "lobby": {
      "servers": {
        "academic": {
          "name": "&cAcademic",
          "icon": {
            "name": "{server_name}",
            "description": [
              "&f{server_online_count} jogando.",
              "",
              "&7Descubra sistemas, desafios",
              "&7e uma experiência diferente.",
              "",
              "&cClique para conectar!"
            ]
          }
        },
        "p4free": {
          "name": "&cP4Free",
          "icon": {
            "name": "{server_name}",
            "description": [
              "&f{server_online_count} jogando.",
              "",
              " &7Um novo modo de jogo com diversos",
              " &7sistemas diferentes e únicos.",
              "",
              " &cConfira algumas novidades:",
              " &c► &fEspada Evolutiva;",
              " &c► &fGladiador;",
              " &c► &fSistema de Ligas;",
              " &c► &fAltar Divino;",
              " &c► &fClasses;",
              " &c► &fHabilidades Dinâmicas;",
              " &c► &fE muito mais!",
              "",
              "&cClique para conectar!"
            ]
          },
          "hologram": [
            "&c&lP4FREE",
            "&c{server_online_player_count} jogando...",
            "{server_state}"
          ]
        }
      },
      "server-state-types": {
        "offline": "&cOffline",
        "stopping": "&cDesligando",
        "restarting": "&cReiniciando",
        "maintenance": "&cEm manutenção",
        "vip": "&cSomente acesso VIP",
        "online": "&aClique para entrar"
      },
      "commands": {
        "fly": {
          // O success fica para o jar anterior, até o lobby novo subir.
          "success": "Seu modo de voo foi alterado com sucesso!",
          "enabled": "&aModo de voo ativado.",
          "disabled": "&cModo de voo desativado."
        },
        "join-all-queue": {
          "arguments": {
            "server": {
              "name": "servidor",
              "description": "Servidor que serão redirecionados os jogadores"
            }
          },
          "success": "Todos os jogadores desse lobby foram adicionados à fila do servidor &f{target_server_display_name}!",
          "nobody": "&cNenhum jogador desse lobby foi adicionado à fila do servidor &f{target_server_display_name}&c."
        },
        "set-p4free": {
          "success": "&aA entrada do P4Free foi movida para &f{x}, {y}, {z}&a."
        },
        "set-spawn": {
          "success": "&aO spawn do lobby foi movido para &f{x}, {y}, {z}&a e já vale para os próximos joins."
        }
      },
      "items": {
        "lobby-servers-item": {
          "name": "&aServidores",
          "lore": [
            "&7Clique com o botão direito para",
            "&7selecionar um servidor."
          ]
        },
        "lobby-hub-selector-item": {
          "name": "&dSelecionar Lobby",
          "lore": [
            "&7Clique com o botão direito para",
            "&7abrir a lista de lobbies."
          ]
        },
        "lobby-profile-item": {
          "name": "&bMeu Perfil",
          "lore": [
            "&7Clique com o botão direito para",
            "&7abrir ao menu de seu perfil."
          ]
        },
        "lobby-hide-players": {
          "name": "&fJogadores: &aON",
          "lore": [
            "&7Clique com o botão direito para",
            "&7esconder os jogadores do lobby."
          ]
        },
        "lobby-show-players": {
          "name": "&fJogadores: &cOFF",
          "lore": [
            "&7Clique com o botão direito para",
            "&7mostrar os jogadores do lobby."
          ]
        }
      },
      "scoreboard": {
        // A onda de vermelhos do exe-lobby-core antigo, um quadro a cada 600 ms.
        "title": [
          "&c&lEXE",
          "&4&lE&c&lXE",
          "&4&lE&4&lX&c&lE",
          "&4&lEXE",
          "&4&lEX&c&lE",
          "&4&lE&c&lXE",
          "&c&lEXE",
          "&4&lE&c&lXE",
          "&c&lE&4&lX&c&lE",
          "&c&lEX&4&lE",
          "&c&lE&4&lX&c&lE",
          "&4&lE&c&lXE"
        ],
        // No desenho da scoreboard do P4Free (plugins.essentials.scoreboards.lines).
        "lines": [
          "",
          "&f Cash: &6✪ {user_cash_formatted}",
          "&f Grupo: &c{user_group_name_with_color}",
          "",
          "&f Online: &a%network_online-count%",
          "",
          "&c O P4FREE",
          "&c está chegando!",
          "",
          "&ewww.rede-exe.com"
        ]
      },
      "preferences": {
        "lobby-visibility": {
          "name": "&eVisibilidade de jogadores",
          "description": [
            "&7Mostra ou esconde os outros",
            "&7jogadores no lobby."
          ]
        },
        "lobby-chat": {
          "name": "&eMensagens no chat",
          "description": [
            "&7Mostra ou esconde as",
            "&7mensagens do chat do lobby."
          ]
        },
        "lobby-flying": {
          "name": "&eModo vôo",
          "description": [
            "&7Voe livremente pelo lobby",
            "&7(exclusivo VIP)."
          ]
        }
      },
      "messages": {
        // As mensagens automáticas do lobby, em rodízio (a lista e o intervalo estão no config.yml do lobby).
        // O destaque é o da dica do exe-souls, como no P4Free. Tudo aqui tem de ser verdade no jogo: a fila
        // sai pelo cargo (UserQueueController), e o resto é a lista de vantagens dos VIPs de 16/10.
        "auto-messages": {
          "queue": [
            "",
            "&6&l VIP: &fQuem tem VIP passa à frente na fila do &aP4Free&f, e o",
            " &aImperial&f fica à frente do &aSamurai&f. Adquira em &arede-exe.com&f.",
            ""
          ],
          "vip": [
            "",
            "&6&l VIP: &fNo P4Free o &aSamurai&f e o &aImperial&f têm kit &aP4&f e &aP5&f,",
            " &fbaú do fim com &a5&f e &a6 linhas&f, &a2&f e &a3 perks&f e mais almas e tokens.",
            " &fAdquira em &arede-exe.com&f.",
            ""
          ],
          "lobby-perks": [
            "",
            "&6&l VIP: &fCom VIP você fala no chat do lobby, voa com &a/fly&f,",
            " &fentra com o servidor cheio e usa cosméticos exclusivos.",
            " &fAdquira em &arede-exe.com&f.",
            ""
          ],
          "cash": [
            "",
            "&6&l CASH: &fCom &aCash&f você compra caixas misteriosas, o",
            " &aIndestrutível&f e muito mais dentro do P4Free. Adquira em &arede-exe.com&f.",
            ""
          ]
        },
        "chat": {
          "in-delay": "&cVocê precisa esperar &f{remaining_time}&c para falar novamente.",
          "preference-off": "&cVocê não pode enviar mensagens nesse chat pois desabilitou as mensagens.",
          "need-highest-group": "&cVocê precisa ter o grupo &f{required_group_display_tag}&c ou superior para enviar mensagens no chat!",
          "message": "{message_owner_name_with_tag}&7: {message_content}",
          // A mensagem de Moderador para cima, em destaque com uma linha em branco antes e depois (LobbyEchoListener).
          "staff-message": [
            "",
            "{message_owner_name_with_tag}&7: {message_content}",
            ""
          ]
        },
        "on-join": {
          "user-notification": "{user_name_with_tag} &fentrou no lobby!"
        },
        "achievement-unlocked": "&a&lCONQUISTA! &fVocê desbloqueou &a{achievement_name}&f.",
        "visibility": {
          "on": "&aAgora todos os jogadores estão visíveis para você.",
          "off": "&cAgora todos os jogadores estão escondidos para você."
        },
        "queue": {
          "actionbar": "&c&lFILA! &fSua posição atual &c➟ &f&l{queue_position}º",
          "joined": "&aVocê entrou na fila do {queue_server_name}&a.",
          "already": "&cVocê já está na fila do {queue_server_name}&c, na posição &f{queue_position}º&c.",
          "bypass": "&aConectando ao {queue_server_name}&a sem passar pela fila.",
          "bypass-failed": "&cNão deu para conectar ao {queue_server_name} &cagora. Tente de novo em instantes.",
          "unavailable": "&cNão dá para entrar no {queue_server_name} &cagora ({server_state}&c)."
        },
        "views": {
          "lobby-selector": {
            "connect": {
              "already-connected": "&cVocê já está conectado a este lobby.",
              "unavailable": "&cEsse lobby está indisponível no momento.",
              "stopping": "&cEsse lobby está desligando no momento.",
              "restarting": "&cEsse lobby está reiniciando no momento.",
              "maintenance": "&cEsse lobby está em manutenção no momento.",
              "full": "&cEsse lobby está lotado no momento."
            }
          }
        }
      },
      "views": {
        "lobby-selector": {
          "title": "Selecione o lobby",
          "items": {
            "0": {
              "maintenance": {
                "name": "&c{app_display_name_stripped}",
                "lore": [
                  "",
                  "&cEsse lobby está em manutenção."
                ]
              },
              "stopping": {
                "name": "&c{app_display_name_stripped}",
                "lore": [
                  "",
                  "&cEsse lobby está desligando."
                ]
              },
              "restarting": {
                "name": "&c{app_display_name_stripped}",
                "lore": [
                  "",
                  "&cEsse lobby está reiniciando."
                ]
              },
              "current": {
                "name": "&a{app_display_name_stripped}",
                "lore": [
                  "",
                  " &fJogadores: &7{app_online_player_count}",
                  "",
                  "&eVocê está conectado a este lobby."
                ]
              },
              "available": {
                "name": "&a{app_display_name_stripped}",
                "lore": [
                  "",
                  " &fJogadores: &7{app_online_player_count}",
                  "",
                  "&aClique para conectar a este lobby."
                ]
              },
              "unavailable": {
                "name": "&c{app_display_name_stripped}",
                "lore": [
                  "",
                  "&cEsse lobby está indisponível."
                ]
              }
            }
          }
        },
        "profile": {
          "title": "Meu perfil",
          "discord-none": "Nenhum vinculado",
          "unknown": "?",
          "items": {
            "0": {
              "name": "&aSeu perfil",
              "lore": [
                "&fGrupo: &f{user_group_name_with_color}",
                "&fNível de rede: &f{account_level}",
                "",
                " &fData de registro: &7{user_registered_date_formated}",
                " &fÚltimo login: &7{account_last_login}",
                " &fConquistas: &7{account_achievements}",
                " &fDiscord: &7{user_discord_name}",
                " &fE-Mail: &7Nenhum vinculado",
                ""
              ]
            },
            "2": {
              "name": "&cJogadores ignorados",
              "lore": [
                "&7Veja os jogadores que você",
                "&7ignorou no servidor."
              ]
            },
            "3": {
              "name": "&aPreferências",
              "lore": [
                "&7Clique para visualizar suas preferências."
              ]
            }
          }
        },
        "servers": {
          "title": "Servidores"
        }
      }
    }
  }
}
