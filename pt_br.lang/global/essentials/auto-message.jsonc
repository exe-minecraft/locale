        // Na mensagem com clique, o "AQUI" é a âncora do link ou do comando.
        "auto-messages": {
          "vip": [
            "",
            "&6&l VIP: &fCom o &aSamurai&f ou o &aImperial&f você ganha kit",
            " &fmelhor, mais almas e tokens, baú maior e mais perks.",
            " &fConheça as vantagens clicando &a&lAQUI&f.",
            ""
          ],
          "souls": [
            "",
            "&e&l DICA: &fAcumule &a5 abates&f, sem morrer, no Gladiador ou no",
            " &fFastGlad para ativar o bônus de &a2x almas&f por &a5 minutos&f!",
            " &fCom VIP o bônus dura &a10 minutos&f. As almas compram perks no &a/perks&f.",
            ""
          ],
          "unbreakable": [
            "",
            "&e&l DICA: &fCompre o &aIndestrutível&f e a sua arma nunca mais",
            " &fquebra. Custa &a3.000 Cash&f no &a/espada&f e no &a/machado&f.",
            ""
          ],
          "boxes": [
            "",
            "&6&l CAIXAS: &fAs &aCaixas Misteriosas&f dão prêmios comuns, raros,",
            " &flendários e místicos. Compre clicando &a&lAQUI&f.",
            " &fNa caixa, agache e clique com o direito para ver os prêmios.",
            ""
          ],
          "tokens": [
            "",
            "&e&l DICA: &fCada golpe e cada abate rendem &atokens&f. Com eles você",
