{
  "plugins": {
    "essentials": {
      "messages": {
        // As mensagens de sempre do P4Free e do P4Free Eventos (a lista e a ordem estão no automessage/config.yml
        // de cada app). O destaque é o da dica do exe-souls, com o rótulo amarelo em negrito e o número em verde.
        // Na mensagem com clique, o "AQUI" é a âncora do link ou do comando.
        "auto-messages": {
          "vip": [
            "",
            "&6&l VIP: &fCom o &aSamurai&f ou o &4Imperial&f você ganha kit",
            " &fmelhor, mais almas e tokens, baú maior e mais perks.",
            " &fConheça as vantagens clicando &a&lAQUI&f.",
            ""
          ],
          // O upgrade do Samurai para o Imperial: o AQUI roda o /upgrade, que abre o menu com o preço de agora.
          "vip-upgrade": [
            "",
            "&4&l UPGRADE: &fJá tem o &aSamurai&f? Evolua para o &4Imperial&f pagando",
            " &fem Cash só os dias que faltam do seu VIP, e o preço desce",
            " &fconforme o tempo passa. Veja o seu clicando &a&lAQUI&f.",
            ""
          ],
          "souls": [
            "",
            "&e&l DICA: &fAcumule &a5 abates&f, sem morrer, no Gladiador ou no",
            " &fFastGlad para ativar o bônus de &a2x almas&f por &a5 minutos&f!",
            " &fCom VIP o bônus dura &a10 minutos&f. As almas compram perks no &a/perks&f.",
            ""
          ],
          "unbreakable": [
            "",
            "&e&l DICA: &fCompre o &aIndestrutível&f e a sua arma nunca mais",
            " &fquebra. Custa &a3.000 Cash&f no &a/espada&f e no &a/machado&f.",
            ""
          ],
          "boxes": [
            "",
            "&6&l CAIXAS: &fAs &aCaixas Misteriosas&f dão prêmios comuns, raros,",
            " &flendários e místicos. Compre no &a/shop&f ou clicando &a&lAQUI&f.",
            " &fNa caixa, agache e clique com o direito para ver os prêmios.",
            ""
          ],
          // A do events-1, que não tem a loja: sem clique, porque lá o /shop não existe, e o texto manda ao do P4Free.
          "boxes-events": [
            "",
            "&6&l CAIXAS: &fAs &aCaixas Misteriosas&f dão prêmios comuns, raros,",
            " &flendários e místicos. Compre no &a/shop&f do &aP4Free&f.",
            ""
          ],
          "tokens": [
            "",
            "&e&l DICA: &fCada golpe e cada abate rendem &atokens&f. Com eles você",
            " &fmelhora a espada e o machado no &a/espada&f e no &a/machado&f.",
            ""
          ],
          // A vantagem de quem impulsiona o Discord, que sai sozinha para quem tem a conta vinculada. Sem clique.
          "booster": [
            "",
            "&d&l BOOSTER: &fImpulsione o Discord da rede e ganhe a &dBerserker",
            " &fde &a2 minutos&f no &a/berserker&f, com espera própria. Basta ter",
            " &fa conta vinculada com o &a/discord&f.",
            ""
          ],
          "discord": [
            "",
            "&9&l DISCORD: &fNovidades, sorteios e suporte ficam no nosso",
            " &fDiscord. Entre clicando &a&lAQUI&f.",
            ""
          ],
          // Os sistemas que o jogador precisa conhecer e que não aparecem sozinhos. O AQUI roda o comando de cada um
          // (/clan listar, /correio, /ec e /conquistas), que existem no P4Free e no P4Free Eventos.
          "clans": [
            "",
            "&e&l DICA: &fSem clã? Veja os clãs clicando &a&lAQUI&f e peça para",
            " &fentrar com &a/clan pedido <tag>&f. Para montar o seu, use o",
            " &a/clan criar&f. O líder e os capitães anunciam o clã para",
            " &ftodo o P4Free no &a/clan recrutar&f.",
            ""
          ],
          "mail": [
            "",
            "&e&l DICA: &fInventário cheio? O item que você recebe não cai no",
            " &fchão. Ele fica guardado no &a/correio&f. Abra clicando &a&lAQUI&f.",
            ""
          ],
          "chests": [
            "",
            "&e&l DICA: &fGuarde os seus itens no &a/ec&f, que fica maior com VIP.",
            " &fPara guardar a espada e o machado, use o &a/cofre&f.",
            " &fAbra o seu &a/ec&f clicando &a&lAQUI&f.",
            ""
          ],
          "achievements": [
            "",
            "&e&l DICA: &fSuas conquistas ficam no &a/conquistas&f e no &a/perfil&f.",
            " &fAs de outro jogador aparecem no &a/perfil <jogador>&f.",
            " &fVeja as suas clicando &a&lAQUI&f.",
            ""
          ],
          // A menção com @ no chat (essentials, ChatMentions), no local e no global. Sem AQUI, porque não há comando
          // para rodar. O TAB do chat sem barra e o do /g completam o nick depois do @.
          "mention": [
            "",
            "&e&l DICA: &fPara chamar alguém, escreva &a@&f e o nick no chat.",
            " &fO nick sai em destaque, e a pessoa recebe um aviso",
            " &fcom som. O &aTAB&f completa o nick depois do &a@&f.",
            ""
          ],
          // O /cxc mapas (25/10), só na lista do p4free-1, que é onde o CxC roda. O AQUI abre a lista dos mapas.
          "cxc-maps": [
            "",
            "&e&l DICA: &fConheça os mapas do &aCxC&f antes de desafiar outro",
            " &fclã. Voe por cima de cada um, sem itens, clicando &a&lAQUI&f.",
            " &fPara sair da visita, use &a/cxc sair&f.",
            ""
          ],
          // Os líderes dos rankings, para provocar quem está atrás. O nome e o número vêm do %tops_<ranking>;<campo>[;weekly]%
          // do plugin tops; a entrada do automessage/config.yml leva o "requires" com o nome, e a mensagem só sai quando o
          // ranking tem alguém (sem isso sairia um nome em branco). Número só em rótulo, porque não passa pelo Plural.
          "top-elo-1v1": [
            "",
            "&b&l RANKING: &f%tops_duels_elo_1v1;name-with-color%&f está no topo do elo",
            " &fdo &ax1&f. Elo: &a%tops_duels_elo_1v1;amount-formatted-number%&f. Acha que consegue tomar",
            " &fo lugar? Desafie no &a/x1&f e acompanhe no &a/elo&f.",
            ""
          ],
          "top-elo-2v2": [
            "",
            "&b&l RANKING: &f%tops_duels_elo_2v2;name-with-color%&f está no topo do elo",
            " &fdo &a2v2&f. Elo: &a%tops_duels_elo_2v2;amount-formatted-number%&f. Chama um parceiro",
            " &fe vá buscar esse posto no &a/x1&f.",
            ""
          ],
          "top-duels-wins": [
            "",
            "&b&l RANKING: &f%tops_duels_wins;name-with-color%&f é quem mais venceu",
            " &fduelos na temporada. Vitórias: &a%tops_duels_wins;amount-formatted-number%&f.",
            " &fAlguém aí vai deixar barato? &a/x1&f",
            ""
          ],
          "top-gladiator-kills-weekly": [
            "",
            "&b&l RANKING: &f%tops_gladiator_player_kills;name-with-color;weekly%&f é quem mais",
            " &fmatou no Gladiador esta semana. Abates: &a%tops_gladiator_player_kills;amount-formatted-number;weekly%&f.",
            " &fA semana só vira na segunda, ainda dá tempo de passar.",
            ""
          ],
          "top-gladiator-rush-wins": [
            "",
            "&b&l RANKING: &fO clan &7[&f%tops_gladiator_rush_wins;name%&7]&f é o que mais venceu",
            " &frushes no Gladiador na temporada. Rushes vencidos: &a%tops_gladiator_rush_wins;amount-formatted-number%&f.",
            " &fQuem vai ser o clan que para eles?",
            ""
          ],
          "top-gladiator-clan-wins": [
            "",
            "&b&l RANKING: &fO clan &7[&f%tops_gladiator_clan_wins;name%&7]&f é o que mais",
            " &fvenceu o Gladiador na temporada. Vitórias: &a%tops_gladiator_clan_wins;amount-formatted-number%&f.",
            " &fO trono está em jogo a cada evento.",
            ""
          ]
        }
      }
    }
  }
}
