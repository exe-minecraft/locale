{
  "plugins": {
    "essentials": {
      // O /spawn <jogador> da staff (Moderador para cima). Nos eventos o app de eventos recusa: o blocked-other.
      "commands": {
        "spawn": {
          "success-other": "&aVocê mandou {target_name} para o spawn.",
          "blocked-other": "{target_name} está em um evento, e dentro de um evento não há /spawn."
        }
      },
      "messages": {
        "spawn": {
          "already-connect": "&cVocê já está conectado a um spawn.",
          "already-connect-queue": "&cJá existe um pedido de teleporte para o spawn, aguarde.",
          "cant-find-app": "&cNão foi possível encontrar um servidor de spawn aberto.",
          "void-rescue": "&cVocê caiu no vazio e voltou para o spawn.",
          "teleported": "&aVocê foi teleportado para o spawn.",
          // A chegada ao spawn (SpawnWelcome): o title se escreve quadro a quadro, um tique de nota por quadro, e fecha no
          // title com o subtitle e o rugido do dragão. O subtitle tem os placeholders de quem chega.
          "join": {
            "title": {
              "frames": ["&c&lP", "&c&lP4", "&c&lP4F", "&c&lP4FR", "&c&lP4FRE"],
              "title": "&c&lP4FREE",
              "subtitle": "&fBem-vindo, {player_name_with_color}&f!"
            },
            "chat": [
              "",
              " &c&lP4FREE &7Disponível nas últimas versões!",
              "",
              " &cAcompanhe as novidades:",
              " &c▸ &fDiscord: &7discord.rede-exe.com",
              " &c▸ &fNotícias: &7rede-exe.com/noticias",
              "",
              " &crede-exe.com",
              ""
            ]
          }
        },
        "fishing": {
          "cannot-fish-on-spawn": "&cVocê não pode pescar no spawn."
        }
      }
    }
  }
}
