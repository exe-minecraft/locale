{
  "plugins": {
    "essentials": {
      "timer": {
        "arguments": {
          "time": {
            "name": "segundos|cancelar",
            "description": "De 1 a 60 segundos, ou cancelar"
          }
        },
        "invalid-time": "&cInsira um número de 1 a 60 segundos.",
        "not-running": "&cNão há nenhum timer em andamento.",
        "cancel-confirmed": "&aTimer cancelado com sucesso!",
        "started": [
          "&c ",
          "",
          " &d&lTIMER INICIADO",
          " &fTimer de &5{time}&f foi iniciado!",
          "",
          "&c "
        ],
        "remaining": {
          "chat": [
            "&c ",
            " &d&lTIMER",
            " &f{verb} {time}.",
            "&c "
          ],
          "title": "&a{seconds}",
          "subtitle": "&7Prepare-se!"
        },
        "finished": {
          "chat": [
            "&c ",
            " &d&lTIMER FINALIZADO",
            " &fO timer terminou!",
            "&c "
          ],
          "title": "&cTimer Finalizado!",
          "subtitle": "&fO tempo acabou!"
        },
        "cancelled": {
          "chat": [
            "&c ",
            " &d&lTIMER CANCELADO",
            " &fO timer foi cancelado por um administrador!",
            "&c "
          ],
          "title": "&cTimer Cancelado!",
          "subtitle": "&fPor um administrador"
        },
        "time-one": "1 segundo",
        "time-seconds": "{seconds} segundos",
        "time-minute": "1 minuto",
        "remaining-one": "Resta",
        "remaining-many": "Restam",
        "countdown": {
          "5": {
            "title": "&a➎",
            "subtitle": "&fSegundos restantes"
          },
          "4": {
            "title": "&f➍",
            "subtitle": "&fSegundos restantes"
          },
          "3": {
            "title": "&6➌",
            "subtitle": "&fSegundos restantes"
          },
          "2": {
            "title": "&c➋",
            "subtitle": "&fSegundos restantes"
          },
          "1": {
            "title": "&4➊",
            "subtitle": "&fSegundo restante"
          }
        }
      }
    }
  }
}
