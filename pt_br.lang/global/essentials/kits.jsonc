{
  "plugins": {
    "essentials": {
      // Os nomes das categorias e dos kits (plugins.essentials.kits.categories.<id> e .types.<id>) ficam no bundle do
      // servidor que tem aqueles kits, ao lado do kits/config.yml dele. Hoje só o rankup tem (rankup/essentials/kits.jsonc).
      "commands": {
        "deletekit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será deletado"
            }
          },
          "cannot-find-with-id": "Não foi possível encontrar um kit com esse id!",
          "success": "Os itens do kit {kit_id} foram apagados. Ele segue no menu, indisponível até o /editkit.",
          // O kit vem do yml; o que se apaga são os itens gravados. Sem eles não havia nada a deletar.
          "already-empty": "O kit {kit_id} não tem itens gravados. Não havia nada para apagar."
        },
        "editkit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será editado"
            }
          },
          "cannot-find-with-id": "Não foi possível encontrar um kit com esse id!"
        },
        "givekit": {
          "arguments": {
            "id": {
              "name": "id",
              "description": "ID do kit que será enviado"
            },
            "target": {
              "name": "jogador",
              "description": "Jogador que irá receber o kit"
            }
          },
          "cannot-find-with-id": "Não foi possível encontrar um kit com esse id!",
          "success": "Você deu o kit {kit_id} para {target_name_with_color}&a."
        }
      },
      "messages": {
        "kits": {
          "on-collect": {
            "unavailable": "Este kit ainda não está disponível.",
            "dont-have-permission": "Você não possui permissão para coletar esse kit.",
            "in-delay": "Você precisa esperar mais {kit_cooldown_remaining} para coletar esse kit.",
            "success": "Você coletou o {kit_name}&a."
          }
        },
        "views": {
          "kit-edit": {
            "update-items": {
              "success": "&aOs itens do kit &f{kit_id}&a foram alterados.",
              "unchanged": "&eNada mudou nos itens do kit &f{kit_id}&e."
            }
          }
        }
      },
      "views": {
        "kit-edit": {
          "title": "Editando - {kit_name}"
        },
        "kit-visualization": {
          "title": "{kit_name}"
        },
        "kit-categories": {
          "title": "Categorias de Kits",
          "items": {
            "0": {
              "name": "{kit_category_name}",
              "lore": [
                "{kit_category_description}",
                "",
                "&aClique para acessar."
              ]
            }
          }
        },
        "kit-category": {
          "title": "{kit_category_name_stripped}",
          "items": {
            "0": {
              "name": "{kit_name}",
              "lore": [
                "&8➟ &fEspera entre coletas: &7{kit_cooldown}",
                "",
                "{kit_status}",
                "",
                "&7Clique direito para &fver os itens&7."
              ]
            }
          },
          // O que o jogador pode fazer com o kit agora, a mesma resposta que o clique obedece. O menu redesenha a cada
          // segundo, e a espera que falta desce no ícone.
          "status": {
            "ready": [
              "&aVocê pode coletar este kit.",
              "&7Clique esquerdo para &fcoletar&7."
            ],
            "in-delay": [
              "&cVocê já coletou este kit.",
              "&7Pode coletar de novo em &f{kit_cooldown_remaining}&7."
            ],
            "no-permission": [
              "&cVocê não possui permissão para coletar este kit."
            ],
            "unavailable": [
              "&cEste kit ainda não está disponível."
            ],
            "loading": [
              "&7Conferindo as suas coletas, aguarde."
            ]
          }
        }
      }
    }
  }
}
