{
  "plugins": {
    "essentials": {
      "pvp": {
        "arguments": {
          "state": {
            "name": "on|off|status",
            "description": "Ligar, desligar ou ver o PvP do mundo"
          }
        },
        "status-on": "&eO PvP está habilitado nesse mundo.",
        "status-off": "&eO PvP está desabilitado nesse mundo.",
        "enabled": [
          "&c ",
          "&4&l  PVP &fVocê &a&lhabilitou&f o PvP no mundo {world}!",
          "&c "
        ],
        "disabled": [
          "&c ",
          "&4&l  PVP &fVocê &c&ldesabilitou&f o PvP no mundo {world}!",
          "&c "
        ],
        "denied": "&c&lEXE &cNão é permitido PvP nessa área."
      }
    }
  }
}
