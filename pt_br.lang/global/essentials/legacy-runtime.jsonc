{
  "plugins": {
    "essentials": {
      "chat": {
        "preferences": {
          "global": {
            "name": "&eChat global",
            "description": ["&7Exibe as mensagens enviadas", "&7no chat global."]
          },
          "local": {
            "name": "&eChat local",
            "description": ["&7Exibe as mensagens enviadas", "&7por jogadores próximos."]
          }
        }
      },
      "messages": {
        "block-height-limit": {
          "exceeded": "&cVocê não pode construir acima da altura {limit}."
        },
        "clear-lag": {
          "countdown": "&5&lLIXEIRO &f{phrase}&d{time}&f!",
          "countdown-phrases": [
            "Prepare-se! Vou limpar o chão em ",
            "Hora da limpeza! Removendo itens em ",
            "Os lixos serão removidos em ",
            "Atenção! Itens no chão serão removidos em ",
            "Os itens indesejados serão varridos em ",
            "Faça suas malas, os lixos vão desaparecer em ",
            "Última chance para pegar seus itens antes da limpeza, ",
            "A limpeza está chegando, não deixe nada para trás, ",
            "Os lixos estão prestes a serem removidos, prepare-se, ",
            "O chão ficará limpo novamente em "
          ],
          "time": {
            "seconds": {
              "one": "&l1&d segundo",
              "many": "&l{count}&d segundos"
            },
            "minutes": {
              "one": "&l1&d minuto",
              "many": "&l{count}&d minutos"
            }
          },
          "clean": "&5&lLIXEIRO &fForam removidos &d&l{count}&f lixos do chão!",
          "clean-nothing": "&5&lLIXEIRO &cNenhum item a ser removido!"
        },
        "crops": {
          "need-sneak": "&cSegure SHIFT para quebrar esta plantação."
        },
        "fishing": {
          "cannot-fish-on-spawn": "&cVocê não pode pescar no spawn."
        },
        "inventory-full": "&cSeu inventário está cheio. Os itens ficaram no chão.",
        "redstone-limiter": {
          "too-many-redstone-circuits": "&cHá circuitos de redstone demais neste chunk."
        },
        "restrictions": {
          "command-disabled": "&cEste comando está desabilitado neste servidor.",
          "custom-item-disabled": "&cVocê não pode usar este item neste servidor.",
          "material-disabled": "&cVocê não pode usar este material neste servidor.",
          "action-disabled": "&cVocê não pode realizar esta ação neste servidor."
        },
        "views": {
          "kit-edit": {
            "update-items": {
              "success": "&aOs itens do kit &f{kit_id}&a foram alterados."
            }
          }
        }
      },
      "warps": {
        "shop": {
          "name": "&cLoja",
          "description": ["&7Acesse a loja de itens."]
        },
        "vip": {
          "name": "&cÁrea VIP",
          "description": ["&7Área exclusiva para jogadores VIP."]
        },
        "mundo": {
          "name": "&cMundo aberto",
          "description": ["&7Teleporta para um local aleatório."]
        },
        "cashshop": {
          "name": "&6Loja de Cash",
          "description": ["&7Acesse a loja de Cash."]
        },
        "arena": {
          "name": "&cArena",
          "description": ["&7Teleporta para a arena do servidor."]
        }
      }
    }
  }
}
