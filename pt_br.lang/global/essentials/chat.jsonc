{
  "plugins": {
    "essentials": {
      "commands": {
        "global": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que será enviada no chat"
            }
          },
          "in-cooldown": "Você precisa esperar mais {remaining_time} para enviar outra mensagem!",
          "message-cannot-be-empty": "Você não pode enviar uma mensagem vazia!",
          "chat-locked": "O chat global está desabilitado!",
          "too-similar": "Essa mensagem é quase igual à anterior. Escreva outra coisa.",
          "dont-have-requirements": "Você precisa ter no mínimo {chat_message_currency_value_formatted_requirement} para enviar uma mensagem no chat!",
          // {sender_tags}: as tags equipadas do P4Free (/tags), cada uma seguida de um espaço, ou vazio.
          // Entram antes do clã, como no exe-chats. Vale também para o local, abaixo.
          "message": {
            "with-space": {
              "with-clan": [
                "",
                "&7[G] {sender_tags}&7[{sender_clan_tag}&7] &f{sender_name_with_tag}&f: &7{chat_message}",
                ""
              ],
              "without-clan": [
                "",
                "&7[G] {sender_tags}&f{sender_name_with_tag}&f: &7{chat_message}",
                ""
              ]
            },
            "without-space": {
              "with-clan": [
                "&7[G] {sender_tags}&7[{sender_clan_tag}&7] &f{sender_name_with_tag}&f: &7{chat_message}"
              ],
              "without-clan": [
                "&7[G] {sender_tags}&f{sender_name_with_tag}&f: &7{chat_message}"
              ]
            }
          }
        },
        "local": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que será enviada no chat"
            }
          },
          "in-cooldown": "Você precisa esperar mais {remaining_time} para enviar outra mensagem!",
          "message-cannot-be-empty": "Você não pode enviar uma mensagem vazia!",
          "chat-locked": "O chat local está desabilitado!",
          "too-similar": "Essa mensagem é quase igual à anterior. Escreva outra coisa.",
          "dont-have-requirements": "Você precisa ter no mínimo {chat_message_currency_value_formatted_requirement} para enviar uma mensagem no chat!",
          "without-receivers": "&cParece que você está sozinho aqui :(",
          "message": {
            "with-space": {
              "with-clan": [
                "",
                "&e[L] {sender_tags}&7[{sender_clan_tag}&7] &f{sender_name_with_tag}&e: {chat_message}",
                ""
              ],
              "without-clan": [
                "",
                "&e[L] {sender_tags}&f{sender_name_with_tag}&e: {chat_message}",
                ""
              ]
            },
            "without-space": {
              "with-clan": [
                "&e[L] {sender_tags}&7[{sender_clan_tag}&7] &f{sender_name_with_tag}&e: {chat_message}"
              ],
              "without-clan": [
                "&e[L] {sender_tags}&f{sender_name_with_tag}&e: {chat_message}"
              ]
            }
          }
        },
        "superchat": {
          "arguments": {
            "message": {
              "name": "mensagem",
              "description": "Mensagem que será enviada no chat"
            }
          },
          "in-cooldown": "Você precisa esperar mais {remaining_time} para enviar outra mensagem!",
          "message-cannot-be-empty": "Você não pode enviar uma mensagem vazia!",
          "chat-locked": "O chat está desabilitado!",
          "message": [
            "",
            " &b&lTOP CHAT &fde {sender_name_with_tag}!",
            " &8➟ &f{chat_message}",
            ""
          ]
        },
        "toggle-chat": {
          "arguments": {
            "type": {
              "name": "tipo",
              "description": "Tipo do canal que você deseja mudar o status"
            }
          },
          "chat-type-not-found": "Não foi possível encontrar um chat com esse id",
          "success-locked": "O status do chat {chat_type_name} foi alterado para desabilitado.",
          "success-unlocked": "O status do chat {chat_type_name} foi alterado para habilitado."
        }
      },
      "chat": {
        "preferences": {
          "global": {
            "name": "&eChat global",
            "description": [
              "&7Exibe as mensagens enviadas",
              "&7no chat global."
            ]
          },
          "local": {
            "name": "&eChat local",
            "description": [
              "&7Exibe as mensagens enviadas",
              "&7por jogadores próximos."
            ]
          }
        },
        // As tags clicáveis da linha de chat. O texto é a âncora que a ação procura na
        // linha, por isso tem de ser igual ao rótulo do formato acima.
        "tags": {
          // O suggest é o que o clique no nick escreve no chat de quem lê: a menção com @ nos dois canais (o TAB do
          // /g completa o @); no local sem comando, porque o chat sem comando já é o local.
          "global": {
            "text": "&7[G]",
            "hover": "&7Mensagem enviada no chat global, visível em todos os servidores.",
            "suggest": "/g @{sender} "
          },
          "local": {
            "text": "&e[L]",
            "hover": "&7Mensagem local",
            "suggest": "@{sender} "
          },
          "sender": {
            "hover": "&eClique para mencionar {sender}."
          },
          // O que aparece ao passar o mouse sobre o resto da linha. Montado no servidor de quem
          // escreveu, porque a tag e o clã só existem lá; cada lista vira um hover de várias linhas.
          // {tag} e {description}: o nome e a descrição que a staff deu à tag no /tag criar.
          "tag": {
            "hover": ["{tag}", "&7{description}"]
          },
          // O clique roda o /clan info do clã.
          "clan": {
            "hover": ["&7Clã {clan_colored_tag} &f{clan_name}", "", "&eClique para ver o clã."]
          },
          // Um por grupo com tag (o Membro não tem). O clique na tag do VIP abre o store-url.
          "group": {
            "store-url": "https://loja.rede-exe.com",
            "master": ["{group_tag}", "&7Equipe da rede: direção."],
            "manager": ["{group_tag}", "&7Equipe da rede: gerência."],
            "developer": ["{group_tag}", "&7Equipe da rede: desenvolvimento."],
            "administrator": ["{group_tag}", "&7Equipe da rede: administração."],
            "moderator": ["{group_tag}", "&7Equipe da rede: moderação do chat e das regras."],
            "imperial": ["{group_tag}", "&7O VIP mais alto da rede.", "", "&eClique para ver as vantagens na loja."],
            "samurai": ["{group_tag}", "&7VIP da rede.", "", "&eClique para ver as vantagens na loja."]
          },
          // {sent_at}: a data e a hora no formato de plugins.core.time.date-time-pattern.
          "message": {
            "hover": "&7Enviada em &f{sent_at}"
          }
        }
      },
      "messages": {
        "chat": {
          "adapters": {
            "plot": "Ir para o Terreno #{plot_index} de {plot_owner_name}",
            "shop": "Ir para a loja de {shop_owner_name}"
          }
        }
      }
    }
  }
}
