{
  "plugins": {
    "essentials": {
      "commands": {
        "clearlag": {
          "request-sent": "&aSolicitação de limpeza enviada com sucesso.",
          "request-sent-silent": "&aSolicitação de limpeza silenciosa enviada com sucesso."
        }
      },
      "messages": {
        "clear-lag": {
          "countdown": "&5&lLIXEIRO &f{phrase}&d{time}&f!",
          "countdown-phrases": [
            "Prepare-se! Vou limpar o chão em ",
            "Hora da limpeza! Removendo itens em ",
            "Os lixos serão removidos em ",
            "Atenção! Itens no chão serão removidos em ",
            "Os itens indesejados serão varridos em ",
            "Faça suas malas, os lixos vão desaparecer em ",
            "Última chance para pegar seus itens antes da limpeza, ",
            "A limpeza está chegando, não deixe nada para trás, ",
            "Os lixos estão prestes a serem removidos, prepare-se, ",
            "O chão ficará limpo novamente em "
          ],
          "time": {
            "seconds": {
              "one": "&l1&d segundo",
              "many": "&l{count}&d segundos"
            },
            "minutes": {
              "one": "&l1&d minuto",
              "many": "&l{count}&d minutos"
            }
          },
          "clean": "&5&lLIXEIRO &fForam removidos &d&l{count}&f lixos do chão!",
          "clean-nothing": "&5&lLIXEIRO &cNenhum item a ser removido!"
        }
      }
    }
  }
}
