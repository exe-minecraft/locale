{
  "plugins": {
    "replay": {
      "commands": {
        "replay": {
          "record": {
            "already-recording": "&cVocê já está gravando um replay!",
            "preparing": {
              "header": "&ePreparando a gravação:",
              "name": "&8▸ &7Nome: &f{name}",
              "radius": "&8▸ &7Raio: &f{radius} chunks",
              "max-duration": "&8▸ &7Duração máxima: &f{duration}",
              "loading": "&bCarregando o mapa. A gravação começa sozinha.",
              "stop-hint": "&7Use &f/replay stop&7 para parar a gravação."
            },
            "error": "&cNão foi possível concluir. Tente novamente.",
            "description": "Inicia uma gravação na sua posição."
          },
          "stop": {
            "finished": {
              "header": "&aGravação finalizada:",
              "name": "&8▸ &7Nome: &f{name}",
              "duration": "&8▸ &7Duração: &f{duration}",
              "play-hint": "&7Use &f/replay play {name}&7 para assistir."
            },
            "error": "&cNão foi possível concluir. Tente novamente.",
            "not-active": "&cVocê não está gravando nenhum replay.",
            "description": "Encerra sua gravação."
          },
          "play": {
            "arguments": {
              "id": {
                "name": "id",
                "description": "ID da gravação"
              }
            },
            "not-found": "&cReplay não encontrado: &f{name}",
            "description": "Assiste a um replay pelo ID."
          },
          "list": {
            "arguments": {
              "page": {
                "name": "página",
                "description": "Número da página"
              }
            },
            "empty": "&eNenhum replay encontrado.",
            "header": "&eReplays &7(Página {page}):",
            "item": "&8▸ &f{name} &7- &b{duration}",
            "description": "Lista as gravações disponíveis."
          },
          "delete": {
            "arguments": {
              "id": {
                "name": "id",
                "description": "ID da gravação"
              }
            },
            "success": "&aReplay &f{name}&a deletado com sucesso!",
            "not-found": "&cReplay não encontrado: &f{name}",
            "description": "Exclui uma gravação."
          },
          "info": {
            "arguments": {
              "id": {
                "name": "id",
                "description": "ID da gravação"
              }
            },
            "header": "&eInformações do replay:",
            "name": "&8▸ &7Nome: &f{name}",
            "duration": "&8▸ &7Duração: &f{duration}",
            "world": "&8▸ &7Mundo: &f{world}",
            "center": "&8▸ &7Centro: &f{center}",
            "radius": "&8▸ &7Raio: &f{radius} chunks",
            "created-at": "&8▸ &7Criado em: &f{date}",
            "description": "Exibe os dados de uma gravação."
          },
          "usage": {
            "open": {
              "syntax": "ver <id>",
              "description": "Abre uma gravação pelo ID."
            },
            "pause": {
              "syntax": "pause",
              "description": "Pausa ou continua a reprodução."
            },
            "resume": {
              "syntax": "retomar",
              "description": "Continua a reprodução."
            },
            "seek": {
              "syntax": "tempo <segundos>",
              "description": "Vai para um instante da gravação."
            },
            "speed": {
              "syntax": "velocidade <0.25|0.5|1|2|4>",
              "description": "Altera a velocidade de reprodução."
            },
            "exit": {
              "syntax": "sair",
              "description": "Encerra a reprodução e volta ao servidor anterior."
            }
          },
          "target": {
            "description": "Destaca um jogador da gravação.",
            "arguments": {
              "alvo": {
                "name": "jogador|clear",
                "description": "Jogador da gravação ou clear para limpar o destaque"
              }
            }
          }
        },
        "replaycamera": {
          "arguments": {
            "target": {
              "name": "jogador|reset",
              "description": "Jogador da gravação ou reset para soltar a câmera"
            }
          },
          "not-watching": "&cVocê não está assistindo um replay.",
          "reset": "&aCâmera devolvida.",
          "not-found": "&cJogador não encontrado na gravação. Presentes: &f{players}",
          "not-in-scene": "&cEsse jogador ainda não está em cena neste tick.",
          "locked": "&aCâmera presa em &f{name}&a. F5 alterna a perspectiva; após um seek, rode o comando de novo. /rcam reset solta.",
          "description": "Prende ou solta a câmera em um jogador gravado."
        }
      },
      "scoreboard": {
        "lines": [
          "",
          "&f Cash: &6✪ {user_cash_formatted}",
          "&f Grupo: &c{user_group_name_with_color}",
          "",
          "&f Tempo: &a{replay_time}",
          "&f Duração: &a{replay_duration}",
          "",
          "&ewww.rede-exe.com"
        ]
      },
      "items": {
        "speed": {
          "name": "&eVelocidade: &f{speed}",
          "lore": [
            "",
            "&7Controla a velocidade do replay.",
            "",
            "&8▸ &7Velocidades: &b0.25x, 0.5x, 1x, 2x, 4x",
            "",
            "&eClique para alterar."
          ]
        },
        "pause": {
          "name": "&7Pausar",
          "lore": [
            "",
            "&7Pausa a reprodução do replay.",
            "",
            "&eClique para pausar."
          ]
        },
        "play": {
          "name": "&aReproduzir",
          "lore": [
            "",
            "&7Continua a reprodução do replay.",
            "",
            "&eClique para continuar."
          ]
        },
        "seek-backward": {
          "name": "&cRetroceder 10s",
          "lore": [
            "",
            "&7Retrocede 10 segundos no replay.",
            "",
            "&eClique para retroceder."
          ]
        },
        "seek-forward": {
          "name": "&bAvançar 10s",
          "lore": [
            "",
            "&7Avança 10 segundos no replay.",
            "",
            "&eClique para avançar."
          ]
        },
        "player-list": {
          "name": "&d Lista de Jogadores",
          "lore": [
            "",
            "&7Abre a lista de jogadores do replay.",
            "&7Você pode seguir um jogador específico.",
            "",
            "&eClique para abrir."
          ]
        },
        "exit": {
          "name": "&c Sair do Replay",
          "lore": [
            "",
            "&7Encerra o replay e volta",
            "&7para o servidor anterior.",
            "",
            "&eClique para sair."
          ]
        }
      },
      "views": {
        "list": {
          "title": "Gravações",
          "items": {
            "replay": {
              "name": "&eReplay &f{replay_short}",
              "lore": [
                "",
                "&8▸ &7Duração: &f{replay_duration}",
                "&8▸ &7Mundo: &f{replay_world}",
                "&8▸ &7Criado: &f{replay_date}",
                "",
                "&aClique para assistir."
              ]
            },
            "close": {
              "name": "&cFechar",
              "lore": [
                "",
                "&7Fecha o menu de gravações."
              ]
            }
          }
        },
        "player-list": {
          "title": "Jogadores no Replay",
          "items": {
            "player": {
              "name": "&e{player_name}",
              "lore": [
                "",
                "&8▸ &fVida: &c❤ {player_health}",
                "",
                "&aClique para seguir este jogador."
              ],
              "following": {
                "name": "&a▸ {player_name}",
                "lore": [
                  "",
                  "&8▸ &fVida: &c❤ {player_health}",
                  "",
                  "&bVocê está seguindo este jogador.",
                  "",
                  "&eClique para parar de seguir.",
                  "&7Ou pressione &fSHIFT&7 para sair."
                ]
              }
            },
            "close": {
              "name": "&cFechar",
              "lore": [
                "",
                "&7Fecha a lista de jogadores."
              ]
            }
          }
        }
      },
      "messages": {
        "connection": {
          "initializing": "&7Conectando ao servidor de replay...",
          "start-error": "&cErro ao iniciar replay: Tente novamente.",
          "errors": {
            "in-connection-delay": "&cAguarde um pouco antes de entrar em outro replay.",
            "already-have-request": "&eVocê já tem uma solicitação de replay pendente.",
            "replay-not-found": "&cReplay não encontrado: &f{replay_name}",
            "not-available-apps": "&cNenhum servidor de replay disponível no momento.",
            "internal": "&cErro interno ao conectar ao replay."
          }
        },
        "playback": {
          "stopped": "&eReplay encerrado.",
          "paused": "&ePausado",
          "resumed": "&aReproduzindo",
          "speed-changed": "&bVelocidade: {speed}x",
          "seek-forward": "&b{time} / {total}",
          "seek-backward": "&b{time} / {total}",
          "finished": "&6Replay finalizado! Use o item de sair para voltar.",
          "following": "&aSeguindo jogador...",
          "free-mode": "&eModo livre",
          "welcome": [
            "",
            "&6&lREPLAY &8 &f{replay_name} &8, &7{replay_duration}",
            "",
            "&7Você está assistindo a uma gravação. Nada aqui é ao vivo:",
            "&7os jogadores, os blocos e os itens são o que foram naquele momento.",
            "",
            "&fControles",
            "&8▸ &eHotbar&7 : velocidade, voltar 10s, pausar, avançar 10s,",
            "&7  lista de jogadores e sair.",
            "&8▸ &eSHIFT duas vezes&7 : alterna entre &fcriativo&7 (voa) e &fespectador&7 (atravessa blocos).",
            "&8▸ &eLista de jogadores&7 : clique num nome para a câmera segui-lo.",
            "&8▸ &eSHIFT&7 : solta a câmera de quem você está seguindo.",
            ""
          ],
          "welcome-staff": [
            "&fStaff",
            "&8▸ &eClique num jogador&7 : abre o inventário dele como estava naquele instante.",
            "&8▸ &eClique num baú&7 : abre o conteúdo gravado dele.",
            "&8▸ &7Os comandos que os jogadores digitaram aparecem flutuando sobre eles.",
            ""
          ],
          "status-paused": "Pausado",
          "status-playing": "Reproduzindo"
        }
      }
    }
  }
}
