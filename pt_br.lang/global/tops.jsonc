        "rows": {
          "1": "&6#1 &f{name} &7- &e{value}",
          "2": "&7#2 &f{name} &7- &e{value}",
          "3": "&c#3 &f{name} &7- &e{value}",
          "other": "&8#{position} &f{name} &7- &e{value}",
          "empty": "&8#{position} &7-/-"
        },
        "clan": "&7[{tag}&7] &f{name}",
        "rows-sem-valor": {
          "1": "&6#1 &f{name}",
          "2": "&7#2 &f{name}",
          "3": "&c#3 &f{name}",
          "other": "&8#{position} &f{name}"
        },
        "states": {
          "loading": "&7Carregando...",
          "failed": "&cRanking indisponível agora.",
          "empty": "&7Ninguém neste ranking ainda."
        },
        "hint": {
          "both": "&eEsquerdo: &7evento &8| &eDireito: &7período",
          "one": "&eClique para alterar!"
        },
        "selector": {
          "selected": "&e&l{option}",
          "unselected": "&7{option}"
        },
        "periods": {
          "weekly": "Semanal",
          "season": "Temporada",
          "total": "Total"
        }
      },
      "commands": {
        "hologram": {
          "loading": "Os hologramas de ranking deste servidor ainda estão carregando. Tente de novo em alguns segundos.",
          "not-found": "Não existe holograma de ranking chamado {hologram_name} neste servidor. Veja os que existem com /topholograma lista.",
          "create": {
            "description": "criar um holograma de ranking onde você está",
            "arguments": {
              "name": {
                "name": "nome",
                "description": "Use letras minúsculas, números, - ou _ no nome do holograma"
              },
              "rankings": {
                "name": "rankings",
                "description": "Até 6 ids de ranking separados por espaço, na ordem do clique esquerdo"
              }
            },
            "invalid-name": "O nome {hologram_name} é inválido. Use de 1 a 32 letras minúsculas, números, - ou _.",
            "already-exists": "Já existe um holograma de ranking chamado {hologram_name}.",
            "repeated-ranking": "O ranking {ranking} foi repetido. Cada ranking entra uma vez só.",
            "too-many-rankings": "Um holograma de ranking tem no máximo {max_rankings} rankings.",
            "rankings-unavailable": "Não foi possível conferir a lista de rankings agora. Tente de novo em alguns instantes.",
            "unknown-ranking": "Não existe o ranking {ranking}. Veja os ids no TAB do comando.",
            "success": "Holograma de ranking {hologram_name} criado em {hologram_world} {hologram_x}, {hologram_y}, {hologram_z}, com os rankings {hologram_rankings}."
          },
          "list": {
            "description": "ver os hologramas de ranking deste servidor",
            "empty": "Nenhum holograma de ranking neste servidor. Crie um com /topholograma criar <nome> <rankings>.",
            "header": "Hologramas de ranking deste servidor:",
            "entry": "&e{hologram_name}&7: {hologram_world} {hologram_x}, {hologram_y}, {hologram_z} ({hologram_rankings})"
          },
          "move": {
            "description": "trazer um holograma de ranking para onde você está",
            "arguments": {
              "name": {
                "name": "nome",
                "description": "Nome do holograma"
              }
            },
            "success": "Holograma de ranking {hologram_name} movido para {hologram_world} {hologram_x}, {hologram_y}, {hologram_z}."
          },
          "delete": {
            "description": "apagar um holograma de ranking de todos os servidores deste tipo",
            "arguments": {
              "name": {
                "name": "nome",
                "description": "Nome do holograma"
              }
            },
            "success": "Holograma de ranking {hologram_name} apagado."
          }
        }
      }
    }
