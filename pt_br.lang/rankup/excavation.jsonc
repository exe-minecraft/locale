{
  "plugins": {
    // O Mundo de Extração do rankup (o documento do dono de 12/11/2026, a próxima versão do mundo de
    // escavação do exe-rankup): quatro biomas que se escavam com a Pá Especial, com PvP à noite, e de
    // onde só se sai com os itens por um portal de extração. O comando segue /escavação, com o /mina.
    "excavation": {
      "units": {
        "second": { "singular": "segundo", "plural": "segundos" },
        "block": { "singular": "bloco", "plural": "blocos" }
      },
      // O nome de cada bioma (world.biomes no config.yml do excavation).
      "biomes": {
        "desert": "Deserto",
        "forest": "Floresta",
        "ice": "Gelo",
        "nether": "Nether"
      },
      // A seta do lado do portal de extração mais perto, em relação para onde o jogador olha: as do exe-rankup, a pedido do dono
      // (09/11). Saem pela fonte unicode do cliente 1.8, como saíam lá.
      "headings": {
        "front": "⬆",
        "front-right": "⬈",
        "right": "➡",
        "back-right": "⬊",
        "back": "⬇",
        "back-left": "⬋",
        "left": "⬅",
        "front-left": "⬉"
      },
      "time": {
        "day": "Dia",
        "night": "Noite",
        // O servidor de extração está fora ou reiniciando, e o menu do /escavação não sabe a hora de lá.
        "unknown": "Desconhecido"
      },
      "combat": {
        "on": "&cPvP ativo!",
        "off": "&aPvP desativado!",
        "unknown": "&7Desconhecido",
        // De noite, para quem ainda não tem a Pá Especial no nível que libera o PvP (o documento do dono de 12/11/2026,
        // à noite: "a partir do nível 10 da Pá Especial"). Curto: a linha da scoreboard do 1.8 corta em 32 caracteres,
        // com as cores e o "Combate:" dentro.
        "locked": "&eSó no nível {level}"
      },
      // A scoreboard do Mundo de Extração: a do rankup, com o horário, o combate, o bioma e os
      // blocos escavados com a pá, como no exe-rankup.
      "scoreboard": {
        "title": [
          " &c&lRANKUP PVP"
        ],
        "lines": [
          "",
          "  &fHorário: &7{excavation_time}",
          "  &fCombate: {excavation_combat}",
          "  &fBioma: &7{excavation_biome}",
          "  &fExtração: &e&l{excavation_heading} &7{excavation_distance} {excavation_distance_unit}",
          "",
          "  &fBlocos escavados: &b{excavation_blocks}",
          "  &fTokens: &e${currency_tokens_cached_account_value_formatted}",
          "",
          "{clan_scoreboard}",
          "",
          "&erede-exe.com"
        ]
      },
      "world": {
        // O mundo acabou de nascer e os portais ainda estão sendo colados: leva uns segundos.
        "preparing": "&cO Mundo de Extração está sendo preparado. Tente de novo em instantes."
      },
      "messages": {
        "build-limit": "Você não pode mexer em blocos acima da altura {limit}.",
        "extraction-blocked": "Você não pode mexer em blocos na proteção de um portal de extração.",
        "combat-day": "O combate fica desativado durante o dia.",
        // O PvP da noite só vale entre quem tem a Pá Especial no nível {level}, dos dois lados.
        "pvp-locked": "Você só pode lutar com outros jogadores com a sua Pá Especial no nível {level}.",
        "pvp-locked-target": "Este jogador ainda não tem a Pá Especial no nível {level} e não pode entrar em combate.",
        // Abaixo do nível, a lava, o fogo e a TNT, que só servem para machucar outro jogador aqui, não entram no mundo.
        "pvp-locked-tool": "Você só pode usar lava, fogo e TNT no Mundo de Extração com a sua Pá Especial no nível {level}.",
        // A poção boa jogada de noite por quem está abaixo do nível, que não pega em outro jogador (o dono, 13/11/2026).
        "pvp-locked-support": "De noite, você só pode ajudar outros jogadores com poções no Mundo de Extração com a sua Pá Especial no nível {level}. Em você a poção pega normalmente.",
        // O saque de quem morreu só sai do chão na mão de quem já pode lutar (a resposta do dono de 12/11/2026).
        "death-loot-locked": "Você só pode pegar os itens de quem morreu com a sua Pá Especial no nível {level}.",
        // A pá chegou ao nível que libera o PvP, no molde do aviso das conquistas.
        "pvp-unlocked": "&a&lCONQUISTA! &fVocê desbloqueou o &aPvP do Mundo de Extração&f com a sua Pá Especial no nível {level}. A partir de agora, você pode enfrentar outros jogadores nas suas extrações.",
        // O tronco e a folha só vêm das árvores do mundo: postos pelo jogador, dariam outra chance da Maçã Especial.
        "tree-block": "Você não pode colocar troncos nem folhas no Mundo de Extração.",
        "shovel-tip": [
          "",
          "&b&l DICA! &bUse uma &lPá Especial&r&b para conseguir recursos",
          "&b especiais ao escavar. &7(/pá)",
          ""
        ],
        "command-blocked": [
          "",
          " &cVocê não pode usar este comando no Mundo de Extração.",
          " &cPara sair, procure um &bPortal de Extração&c.",
          ""
        ],
        "join": [
          "",
          "&b&l Atenção! &fO PvP fica ativo durante a noite, entre quem",
          "&f tem a Pá Especial no nível {level} ou acima.",
          "&f Procure um &bPortal de Extração &fpara sair do mundo com os seus itens!",
          ""
        ],
        "portal-in-combat": "Você não pode sair do Mundo de Extração em combate.",
        "portal-failed": "Não deu para levar você de volta ao spawn agora. Tente o portal de novo em instantes.",
        // Baús, fornalhas, funis, molduras, suportes de armadura e carrinhos com baú: guardariam o saque fora da queda
        // na saída e da morte.
        "storage": "Você não pode guardar itens fora do inventário no Mundo de Extração.",
        // O item da rede com lote (o plantável das plantações, por exemplo) viraria um bloco comum aqui.
        "tracked-item": "Este item não pode ser colocado no Mundo de Extração.",
        // O resumo do que se escavou, quando o jogador para por uns segundos.
        "earnings": [
          "",
          " &b[Extração] &fVocê ganhou &e{tokens} {tokens_unit} &fem {duration} escavando!",
          ""
        ],
        // A noite chegou: vai a todo o rankup, com o som do wither.
        "night": [
          "",
          "&b [Extração] &fA &lnoite &fchegou no Mundo de Extração!",
          "&f O PvP está &cativo&f para quem tem a Pá Especial no nível {level}.",
          "&f Fique atento aos perigos!",
          ""
        ],
        // A invulnerabilidade de quem voltou ao lugar onde caiu acaba no primeiro golpe dele.
        "shield-ended": "&eSua invulnerabilidade acabou porque você atacou.",
        // O que vem por chance ao escavar ou ao quebrar uma árvore da Floresta.
        "found": {
          "apple": "&aVocê encontrou uma &lMaçã Especial&r&a nesta árvore!",
          "dig-drop": {
            "sand": "&aVocê encontrou &lAreia&r&a para as farms do seu terreno!",
            "soul_sand": "&aVocê encontrou &lAreia das Almas&r&a para as farms do seu terreno!"
          }
        }
      },
      // A barra de ação de quem está no mundo, com o portal de extração mais perto.
      "action-bar": {
        "portal": "&b&lPortal de Extração! &fEntre no &b&lPortal&f para sair do mundo com os seus itens.",
        "near": "&bVocê está perto de um portal de extração!",
        "far": "&bPortal de extração mais próximo a &f&l{distance} &f{distance_unit}&b de distância! &7(&e&l{heading}&7)"
      },
      "anti-camp": {
        "hologram": [
          "&6&lSISTEMA ANTI-CAMP",
          "&fPara evitar jogadores acampando",
          "&fnas áreas dos portais, existe",
          "&fuma explosão que empurra para",
          "&flonge a cada {seconds} {seconds_unit}.",
          "",
          "{timer}"
        ],
        // A última linha do holograma, de cada jogador: a contagem dele na área do portal, ou o tempo inteiro.
        "timer": {
          "idle": "&a{seconds} {seconds_unit}",
          "counting": "&c{seconds} {seconds_unit}",
          "boom": "&c&lBOOM!"
        },
        "blast": "&c&lBOOM! &fO anti-camp empurrou você para longe do portal."
      },
      "reset": {
        // Os blocos escavados voltaram ao lugar, sem reiniciar o mundo: vai a quem está nele.
        "blocks": "&b[Extração] &fOs blocos escavados do Mundo de Extração voltaram ao lugar.",
        "warning": [
          "",
          "&e O &lMundo de Extração&r&e será reiniciado em &l{duration}&r&e!",
          "&e Antes disso, todo mundo volta ao spawn do rankup com os itens.",
          ""
        ],
        // O mundo novo acabou de nascer: vai a todo o rankup.
        "done": [
          "",
          "&b&l O Mundo de Extração foi reiniciado!",
          "&e Um novo mundo foi gerado, com o relevo, as cavernas",
          "&e e as árvores sorteados de novo, e novas",
          "&e oportunidades de achados.",
          ""
        ]
      },
      // O /escavação, no rankup-1 e nos terrenos.
      "connector": {
        "preparing": "&aPrepare-se para ser teleportado para o Mundo de Extração...",
        "unavailable": "O Mundo de Extração está indisponível no momento.",
        "cooldown": "Aguarde um pouco antes de fazer isso de novo.",
        "in-combat": "Você não pode ir ao Mundo de Extração em combate.",
        "failed": "Não deu para levar você ao Mundo de Extração. Tente de novo em instantes.",
        // A espera do RTP: 10 minutos entre uma entrada e a seguinte (o documento do dono de 12/11/2026, à noite).
        "waiting": "Você entrou no Mundo de Extração há pouco tempo. Poderá entrar de novo em {time}.",
        "arrived": [
          "",
          "&b&l Mundo de Extração!",
          "&f Explore os diferentes biomas, encontre itens raros,",
          "&f evolua a sua Pá e progrida no servidor!",
          ""
        ]
      },
      // A volta de quem caiu dentro do mundo, e a espera do RTP na entrada.
      "stay": {
        // A entrada recusada pelo servidor de extração, no aviso do proxy.
        "cooldown": "&cVocê entrou no Mundo de Extração há pouco tempo. Poderá entrar de novo em {time}.",
        "unknown": "&cNão deu para conferir sua entrada no Mundo de Extração. Tente de novo em instantes.",
        "returned": "&aVocê voltou ao lugar onde estava no Mundo de Extração e tem {time} de invulnerabilidade.",
        // No spawn ou nos terrenos, quem caiu dentro do mundo volta para lá.
        "returning": "&eVocê saiu do jogo dentro do Mundo de Extração e está voltando ao lugar onde estava...",
        "locked": "Aguarde enquanto você volta ao Mundo de Extração.",
        "kick": {
          "unknown": "&cNão deu para conferir se você estava no Mundo de Extração. Entre de novo em instantes.",
          // A entrada não gravou: quem ainda não juntou nada sai do jogo.
          "entry-failed": "&cNão deu para registrar sua entrada no Mundo de Extração. Entre de novo em instantes.",
          // A viagem ao spawn depois de uma morte no mundo não saiu.
          "respawn-failed": "&cNão deu para levar você de volta ao spawn depois da sua morte. Entre de novo em instantes.",
          "send-failed": "&cNão deu para levar você de volta ao Mundo de Extração. Entre de novo em instantes."
        }
      },
      // Os itens do Mundo de Extração. Os nomes e as descrições são os dos baús de referência do Kekitoox (12/11/2026),
      // com o português corrigido.
      "items": {
        "apple": {
          "display-name": "Maçã Especial",
          "name": "&bMaçã Especial",
          "lore": [
            "&7Use esta maçã junto de ouro para",
            "&7fabricar a maçã dourada encantada."
          ]
        },
        "inverter": {
          "display-name": "Inversor",
          "name": "&bInversor",
          "lore": [
            "&7Troque de lugar com outro jogador ao",
            "&7arremessar o inversor contra ele.",
            "&7",
            "&eClique com o botão direito para arremessar!"
          ],
          "refused": {
            "elsewhere": "O Inversor só funciona no Mundo de Extração.",
            "day": "O Inversor só funciona durante a noite, com o PvP ativo.",
            "pvp-locked": "O Inversor só funciona com a sua Pá Especial no nível {level}, quando o PvP é liberado para você."
          },
          "swapped": {
            "thrower": "&aVocê trocou de lugar com {target_name_with_color}&a.",
            "target": "&c{thrower_name_with_color} &ctrocou de lugar com você usando um Inversor."
          }
        }
      },
      "commands": {
        "escavacao": {
          "description": "Abre o menu do Mundo de Extração"
        }
      },
      "views": {
        "connector": {
          "title": "Mundo de Extração",
          "loading": "carregando",
          "items": {
            "teleport": {
              "name": "&aTeleportar",
              "lore": [
                "&7Vá até o Mundo de Extração",
                "&7e use a sua pá!",
                "",
                "&f Jogadores no mundo: &7{players}",
                "&f Horário: &7{time}",
                "&f Combate: {combat}",
                "&f Entrada: {entry}",
                "",
                "&e &l[!] &eCuidado, você só consegue",
                "&e sair deste mundo pelos",
                "&e portais de extração.",
                "",
                "{state}"
              ]
            },
            "ranking": {
              "name": "&aRanking de Blocos Escavados",
              "lore": [
                "&7Veja quem mais escavou",
                "&7blocos com a Pá Especial.",
                "",
                "&aClique para visualizar."
              ]
            }
          },
          // A espera do RTP, na descrição do ícone de teleporte.
          "entry": {
            "ready": "&aDisponível",
            "waiting": "&cEm {time}",
            "unknown": "&7Desconhecida"
          },
          "states": {
            "loading": "&7Carregando...",
            "ready": "&aClique para teleportar.",
            // Só a equipe com o grupo da manutenção entra; o proxy avisa os outros.
            "maintenance": "&cEm manutenção no momento.",
            "unavailable": "&7Servidor indisponível no momento."
          }
        }
      }
    }
  }
}
