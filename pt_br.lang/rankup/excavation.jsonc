{
  "plugins": {
    // O mundo de escavação do rankup, o do exe-rankup: um mundo aberto de areia, terra e neve que se
    // escava com a Pá Especial, com PvP à noite, e de onde só se sai com os itens por um ponto de
    // extração. O texto é o de lá, sem os símbolos que o 1.8 não desenha.
    "excavation": {
      "units": {
        "second": { "singular": "segundo", "plural": "segundos" },
        "block": { "singular": "bloco", "plural": "blocos" }
      },
      // O nome de cada bioma (world.biomes no config.yml do excavation).
      "biomes": {
        "desert": "Deserto",
        "plains": "Planície",
        "mesa": "Mesa",
        "snow": "Neve"
      },
      // Para que lado fica o ponto de extração mais perto, em relação para onde o jogador olha.
      // A seta do lado do ponto de extração, em relação para onde o jogador olha: as do exe-rankup, a pedido do dono
      // (09/11). Saem pela fonte unicode do cliente 1.8, como saíam lá.
      "headings": {
        "front": "⬆",
        "front-right": "⬈",
        "right": "➡",
        "back-right": "⬊",
        "back": "⬇",
        "back-left": "⬋",
        "left": "⬅",
        "front-left": "⬉"
      },
      "time": {
        "day": "Dia",
        "night": "Noite",
        // O servidor de escavação está fora ou reiniciando, e o menu do /escavação não sabe a hora de lá.
        "unknown": "Desconhecido"
      },
      "combat": {
        "on": "&cPvP ativo!",
        "off": "&aPvP desativado!",
        "unknown": "&7Desconhecido"
      },
      // A scoreboard do mundo de escavação: a do rankup, com o horário, o combate, o bioma e os
      // blocos escavados com a pá, como no exe-rankup.
      "scoreboard": {
        "title": [
          " &c&lRANKUP PVP"
        ],
        "lines": [
          "",
          "  &fHorário: &7{excavation_time}",
          "  &fCombate: {excavation_combat}",
          "  &fBioma: &7{excavation_biome}",
          "",
          "  &fBlocos escavados: &b{excavation_blocks}",
          "  &fTokens: &e${currency_tokens_cached_account_value_formatted}",
          "",
          "{clan_scoreboard}",
          "",
          "&erede-exe.com"
        ]
      },
      "world": {
        // O mundo acabou de nascer e os portais ainda estão sendo colados: leva uns segundos.
        "preparing": "&cO mundo de escavação está sendo preparado. Tente de novo em instantes."
      },
      "messages": {
        "build-limit": "Você não pode mexer em blocos acima da altura {limit}.",
        "extraction-blocked": "Você não pode mexer em blocos num Ponto de Extração.",
        "combat-day": "O combate fica desativado durante o dia.",
        "shovel-tip": [
          "",
          "&b&l DICA! &bUse uma &lPá Especial&r&b para conseguir recursos",
          "&b especiais ao escavar. &7(/pá)",
          ""
        ],
        "command-blocked": [
          "",
          " &cVocê não pode usar este comando no mundo de escavação.",
          " &cPara sair, procure um &bPonto de Extração&c.",
          ""
        ],
        "join": [
          "",
          "&b&l Atenção! &fO PvP fica ativo durante a noite.",
          "&f Procure um &bPonto de Extração &fpara sair do mundo de escavação com segurança!",
          ""
        ],
        "portal-in-combat": "Você não pode sair do mundo de escavação em combate.",
        "portal-failed": "Não deu para levar você de volta ao spawn agora. Tente o portal de novo em instantes.",
        // Baús, fornalhas, funis, molduras, suportes de armadura e carrinhos com baú: guardariam o saque fora da queda
        // na saída e da morte.
        "storage": "Você não pode guardar itens fora do inventário no mundo de escavação.",
        // O resumo do que se escavou, quando o jogador para por uns segundos.
        "earnings": [
          "",
          " &b[Escavação] &fVocê ganhou &e{tokens} {tokens_unit} &fem {duration} escavando!",
          ""
        ],
        // A noite chegou: vai a todo o rankup, com o som do wither.
        "night": [
          "",
          "&b [Escavação] &fA &lnoite &fchegou no mundo de escavação!",
          "&f O PvP está &cativo&f. Fique atento aos perigos!",
          ""
        ],
        // Quem sai do jogo dentro do mundo deixa os itens no chão: vai a todo o rankup.
        "logout-drop": [
          "",
          "&b [Escavação] &f{player_name_with_color} &fsaiu do jogo no mundo de escavação!",
          "&f Os itens ficaram em &aX: {x} Y: {y} Z: {z}&f.",
          ""
        ],
        "drop-name": "&6Drop de {player_name_with_color}"
      },
      // A barra de ação de quem está no mundo, com o ponto de extração mais perto.
      "action-bar": {
        "portal": "&b&lPonto de Extração! &fEntre no &b&lPortal&f para sair do mundo com segurança.",
        "near": "&bVocê está perto de um ponto de extração!",
        "far": "&bPonto de extração mais próximo a &f&l{distance} &f{distance_unit}&b de distância! &7(&e&l{heading}&7)"
      },
      "anti-camp": {
        "hologram": [
          "&6&lSISTEMA ANTI-CAMP",
          "&fPara evitar jogadores acampando",
          "&fnas áreas dos portais, existe",
          "&fuma explosão que empurra para",
          "&flonge a cada {seconds} {seconds_unit}.",
          "",
          "{timer}"
        ],
        // A última linha do holograma, de cada jogador: a contagem dele na área do portal, ou o tempo inteiro.
        "timer": {
          "idle": "&a{seconds} {seconds_unit}",
          "counting": "&c{seconds} {seconds_unit}",
          "boom": "&c&lBOOM!"
        },
        "blast": "&c&lBOOM! &fO anti-camp empurrou você para longe do portal."
      },
      "reset": {
        "warning": [
          "",
          "&e O mundo de &lEscavação&r&e será reiniciado em &l{duration}&r&e!",
          "&e Antes disso, todo mundo volta ao spawn do rankup com os itens.",
          ""
        ],
        // O mundo novo acabou de nascer: vai a todo o rankup.
        "done": [
          "",
          "&b&l O mundo de Escavação foi reiniciado!",
          "&e Um novo mundo de escavação foi gerado, e os biomas foram",
          "&e sorteados de novo, com uma nova distribuição de terrenos",
          "&e e de oportunidades de achados.",
          ""
        ]
      },
      // O /escavação, no rankup-1 e nos terrenos.
      "connector": {
        "preparing": "&aPrepare-se para ser teleportado para o mundo de escavação...",
        "unavailable": "O mundo de escavação está indisponível no momento.",
        "cooldown": "Aguarde um pouco antes de fazer isso de novo.",
        "in-combat": "Você não pode ir ao mundo de escavação em combate.",
        "failed": "Não deu para levar você ao mundo de escavação. Tente de novo em instantes.",
        "arrived": [
          "",
          "&b&l Mundo de Escavação!",
          "&f Explore os diferentes biomas, encontre itens raros,",
          "&f evolua a sua Pá e progrida no servidor!",
          ""
        ]
      },
      "commands": {
        "escavacao": {
          "description": "Abre o menu do mundo de escavação"
        }
      },
      "views": {
        "connector": {
          "title": "Escavação",
          "loading": "carregando",
          "items": {
            "teleport": {
              "name": "&aTeleportar",
              "lore": [
                "&7Vá até o mundo de escavação",
                "&7e use a sua pá!",
                "",
                "&f Jogadores no mundo: &7{players}",
                "&f Horário: &7{time}",
                "&f Combate: {combat}",
                "",
                "&e &l[!] &eCuidado, você só consegue",
                "&e sair deste mundo pelos",
                "&e pontos de extração.",
                "",
                "{state}"
              ]
            },
            "ranking": {
              "name": "&aRanking de Blocos Escavados",
              "lore": [
                "&7Veja quem mais escavou",
                "&7blocos com a Pá Especial.",
                "",
                "&aClique para visualizar."
              ]
            }
          },
          "states": {
            "loading": "&7Carregando...",
            "ready": "&aClique para teleportar.",
            // Só a equipe com o grupo da manutenção entra; o proxy avisa os outros.
            "maintenance": "&cEm manutenção no momento.",
            "unavailable": "&7Servidor indisponível no momento."
          }
        }
      }
    }
  }
}
