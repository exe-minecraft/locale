            "0": {
              "name": "&a{enchant_name} &l{enchant_level}",
              "lore": [
                "{enchant_description}",
                "",
                "{enchant_progress}",
                "{enchant_effect}",
                "",
                " &fPreço: {enchant_currency_color}{enchant_price} {enchant_currency}",
                "",
                "{enchant_shop}",
                "&fBotão esquerdo: &aEvoluir",
                "{enchant_drops}"
              ]
            },
            // 2: o encantamento já no máximo.
            "2": {
              "name": "&a{enchant_name} &l{enchant_level}",
              "lore": [
                "{enchant_description}",
                "",
                "{enchant_progress}",
                "{enchant_effect}",
                "",
                "&eNível máximo atingido!",
                "{enchant_drops}"
              ]
            },
            // 3: o conserto, pago com diamantes do inventário.
            "3": {
              "name": "&aReparação",
              "lore": [
                "&7Use esta função para",
                "&7consertar sua pá em 100%.",
