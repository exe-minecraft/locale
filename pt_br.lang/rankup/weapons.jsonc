      "views": {
        // O menu da pá, que abre com Shift + botão direito com ela na mão.
        "weapon": {
          "title": "{weapon_name}",
          "items": {
            "4": {
              "name": "{prestige_title}",
              "lore": [
                "&7Resete os encantamentos para",
