                "",
                " &fEstado: &c&lDESATIVADA",
                "",
                "&aClique para ativar."
              ]
            },
            // 7: a exclusão da pá.
            "7": {
              "name": "&cExcluir item",
              "lore": [
                "&8Ação irreversível.",
                "",
                "&7Ao clicar neste item, sua pá será",
                "&7excluída, e todo o progresso e os",
                "&7encantamentos serão perdidos.",
                "",
                "&eClique para excluir a pá."
              ]
            },
            // 8: o encantamento que pede prestígio. A pá não tem prestígio hoje.
            "8": {
              "name": "&c{enchant_name} &l{enchant_level}",
              "lore": [
                "{enchant_description}",
                "",
                "{enchant_progress}",
                "{enchant_effect}",
                "",
                " &cRequisitos:",
                " &fPrestígio &b&l{enchant_prestige} &fnecessário.",
                "",
                "&cNão é possível evoluir este encantamento."
              ]
            },
            // 9: o encantamento que dá para evoluir, mas o saldo não chega.
            "9": {
              "name": "&c{enchant_name} &l{enchant_level}",
              "lore": [
                "{enchant_description}",
                "",
                "{enchant_progress}",
                "{enchant_effect}",
                "",
