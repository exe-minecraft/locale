{
  "plugins": {
    // A Pá Especial do rankup, o /pá do exe-rankup. É o mesmo plugin da espada e do machado
    // do P4Free (o weapons), e a diferença vive aqui e na seção shovel do config.yml dele.
    // O texto é o do exe-rankup, sem os símbolos que o 1.8 não desenha.
    "weapons": {
      // A espada e o machado da rede, os mesmos do P4Free (pedido do dono, 09/11/2026).
      "espada": {
        "item": {
          "name": "&cEspada Especial",
          "investment": "&fInvestimento: &e{tokens} Tokens",
          "enchant-owned": "&6 {enchant} &l{level}",
          "enchant-missing": "&8 {enchant}",
          "kills": "&fAbates: &c{kills}"
        },
        "broken": "&cA sua espada especial se partiu.",
        "plural": "Espadas"
      },
      "machado": {
        "item": {
          "name": "&cMachado Especial",
          "investment": "&fInvestimento: &e{tokens} Tokens",
          "enchant-owned": "&6 {enchant} &l{level}",
          "enchant-missing": "&8 {enchant}",
          "kills": "&fAbates: &c{kills}"
        },
        "broken": "&cO seu machado especial se partiu.",
        "plural": "Machados"
      },
      // As palavras que acompanham um número montado no código (o Plural do core): 1 no singular.
      "units": {
        "kill": { "singular": "abate", "plural": "abates" },
        "duplicate-weapon": { "singular": "pá duplicada", "plural": "pás duplicadas" },
        "entry": { "singular": "registro", "plural": "registros" },
        // O item que paga o conserto da pá (repair-item no config).
        "repair-item": {
          "diamond": { "singular": "diamante", "plural": "diamantes" }
        }
      },
      "pa": {
        // Os textos da pá que mudam de um tipo para outro: no rankup ela mora com a espada e o machado, que
        // usam os de plugins.weapons. O exe-weapons.jar lê estes pelo tipo (WeaponKind.text).
        "messages": {
          "profile-loading": "Seu perfil ainda está carregando. Tente de novo em instantes.",
          "duplicates-removed": "Removemos {amount} {amount_unit} do seu inventário.",
          "in-combat": "Você não pode abrir o menu da pá em combate.",
          "not-in-hand": "Segure a pá na mão para mexer nela.",
          "already-max-level": "Este encantamento já está no nível máximo.",
          "prestige-required": "Este encantamento pede prestígio {prestige}.",
          "not-enough": "Você não tem {currency} suficientes.",
          "not-enough-items": "Você precisa de {amount} {item} no inventário para consertar a pá.",
          "enchant-bought": "&bParabéns! &fO encantamento &6{enchant} &fsubiu para o nível &6{level}&f.",
          "free-upgrade": "&aParabéns! &f{enchant} &asubiu para o nível &f{level}&a de graça, pelo seu grupo.",
          "already-repaired": "Sua pá não precisa de conserto.",
          "repaired": "Sua pá foi consertada.",
          "cannot-drop": "Você não pode largar a Pá Especial no chão.",
          "cannot-move": "A Pá Especial não sai do seu inventário.",
          "deleted": "&cSua pá foi excluída.",
          "history": {
            "empty": "{player} não tem nada no histórico das armas.",
            "failed": "Não deu para carregar o histórico agora. Tente de novo em instantes."
          }
        },
        "units": {
          "duplicate-weapon": {
            "singular": "pá duplicada",
            "plural": "pás duplicadas"
          }
        },
        "enchants": {
          "unbreakable": {
            "description": [
              "&7Torna a pá inquebrável, deixando-a",
              "&7com durabilidade infinita."
            ]
          },
          "fortune": {
            "description": [
              "&7Dá a chance de dobrar o número",
              "&7de itens ao encontrar um recurso."
            ],
            "effect": "Chance"
          },
          "efficiency": {
            "description": [
              "&7Permite que sua pá quebre",
              "&7instantaneamente qualquer",
              "&7bloco compatível."
            ]
          },
          "explorer": {
            "description": [
              "&7Aumenta a chance de encontrar",
              "&7itens valiosos."
            ],
            "effect": "Chance"
          },
          "cactus": {
            "description": [
              "&7Dá a chance de conseguir itens",
              "&7para criar uma farm de cactos."
            ]
          },
          "diamond": {
            "description": [
              "&7Dá a chance de conseguir",
              "&7diamantes enquanto escava."
            ],
            "effect": "Chance"
          },
          "gold": {
            "description": [
              "&7Dá a chance de encontrar",
              "&7ouro enquanto escava."
            ],
            "effect": "Chance"
          },
          "durability": {
            "description": [
              "&7Dá a chance de não consumir",
              "&7durabilidade ao quebrar um bloco."
            ],
            "effect": "Chance"
          }
        },
        "views": {
          "weapon": {
            "title": "{weapon_name}",
            "items": {
              "0": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_progress}",
                  "{enchant_effect}",
                  "",
                  " &fPreço: {enchant_currency_color}{enchant_price} {enchant_currency}",
                  "",
                  "{enchant_shop}",
                  "&fBotão esquerdo: &aEvoluir",
                  "{enchant_drops}"
                ]
              },
              "2": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_progress}",
                  "{enchant_effect}",
                  "",
                  "&eNível máximo atingido!",
                  "{enchant_drops}"
                ]
              },
              "3": {
                "name": "&aReparação",
                "lore": [
                  "&7Use esta função para",
                  "&7consertar sua pá em 100%.",
                  "",
                  "&a Custo:",
                  "   &b{repair_cost} &f{repair_currency}",
                  "",
                  "&dDica: &fTorne a durabilidade",
                  "&fda sua pá infinita ao",
                  "&fcomprar Indestrutível.",
                  "",
                  "{repair_state}"
                ]
              },
              "5": {
                "name": "&aRanking de {weapon_plural}",
                "lore": [
                  "&7Acompanhe o ranking de pás e veja",
                  "&7quem mais escavou e quem mais",
                  "&7investiu tokens nelas!",
                  "",
                  "&f Sua posição:",
                  "&f  Blocos escavados: &e{blocks_position}",
                  "&f  Tokens investidos: &e{invested_position}",
                  "",
                  "&aClique para visualizar."
                ]
              },
              "6": {
                "name": "&a{enchant_name} &a&lATIVADA",
                "lore": [
                  "{enchant_description}",
                  "",
                  " &fEstado: &a&lATIVADA",
                  "",
                  "&cClique para desativar."
                ]
              },
              "11": {
                "name": "&7{enchant_name} &c&lDESATIVADA",
                "lore": [
                  "{enchant_description}",
                  "",
                  " &fEstado: &c&lDESATIVADA",
                  "",
                  "&aClique para ativar."
                ]
              },
              "7": {
                "name": "&cExcluir item",
                "lore": [
                  "&8Ação irreversível.",
                  "",
                  "&7Ao clicar neste item, sua pá será",
                  "&7excluída, e todo o progresso e os",
                  "&7encantamentos serão perdidos.",
                  "",
                  "&eClique para excluir a pá."
                ]
              },
              "8": {
                "name": "&c{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_progress}",
                  "{enchant_effect}",
                  "",
                  " &cRequisitos:",
                  " &fPrestígio &b&l{enchant_prestige} &fnecessário.",
                  "",
                  "&cNão é possível evoluir este encantamento."
                ]
              },
              "9": {
                "name": "&c{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_progress}",
                  "{enchant_effect}",
                  "",
                  " &fPreço: {enchant_currency_color}{enchant_price} {enchant_currency}",
                  "",
                  "{enchant_shop}",
                  "&cVocê não tem saldo suficiente.",
                  "{enchant_drops}"
                ]
              },
              "10": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_progress}",
                  "{enchant_effect}",
                  "",
                  "&aUpgrade VIP disponível!",
                  "&eClique para adquirir de graça."
                ]
              },
              "12": {
                "name": "&eInformações",
                "lore": [
                  "&7Evolua sua pá com encantamentos",
                  "&7que rendem itens na escavação!",
                  "",
                  "&7Escave com ela para ganhar tokens,",
                  "&7e use os tokens para evoluir",
                  "&7os encantamentos."
                ]
              },
              "13": {
                "name": "&aTokens",
