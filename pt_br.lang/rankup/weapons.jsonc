                "&f  Tokens investidos: &e{invested_position}",
                "",
                "&aClique para visualizar."
              ]
            },
            // 6 e 11: o que se liga e desliga em vez de se comprar. A pá não tem nenhum hoje.
            "6": {
              "name": "&a{enchant_name} &a&lATIVADA",
              "lore": [
                "{enchant_description}",
                "",
                " &fEstado: &a&lATIVADA",
