{
  "plugins": {
    // As armas do rankup: a espada e o machado da rede, com os textos do P4Free menos o /cofre e os tokens
    // dos golpes, que o rankup não tem, e a Pá Especial, o /pá do exe-rankup. Os textos da pá que mudam de
    // um tipo para outro ficam em "pa", com o texto do exe-rankup, sem os símbolos que o 1.8 não desenha.
    "weapons": {
      // A Enxada Especial, a /enxada, que colhe as plantações dos terrenos (10/11/2026). Os encantamentos e os textos
      // dos ícones são os dos baús de referência do Kekitoox; o resto segue o padrão da pá.
      "enxada": {
        "messages": {
          "profile-loading": "Seu perfil ainda está carregando. Tente de novo em instantes.",
          "duplicates-removed": "Removemos {amount} {amount_unit} do seu inventário.",
          "in-combat": "Você não pode abrir o menu da enxada em combate.",
          "not-in-hand": "Segure a enxada na mão para mexer nela.",
          "already-max-level": "Este encantamento já está no nível máximo.",
          "prestige-required": "Este encantamento pede prestígio {prestige}.",
          "not-enough": "Você não tem {currency} suficientes.",
          "charge-failed": "Não deu para confirmar a cobrança, e nada mudou na enxada. Se o valor saiu da sua conta, ele volta sozinho.",
          "not-enough-items": "Você precisa de {amount} {item} no inventário para consertar a enxada.",
          "not-purchasable": "Este encantamento não pode ser comprado.",
          "enchant-bought": "&bParabéns! &fO encantamento &6{enchant} &fsubiu para o nível &6{level}&f.",
          "free-upgrade": "&aParabéns! &f{enchant} &asubiu para o nível &f{level}&a de graça, pelo seu grupo.",
          "attribute-spent": "&bParabéns! &fO encantamento &6{enchant} &fsubiu para o nível &6{level}&f com um atributo.",
          "attribute-not-accepted": "Este encantamento não sobe com atributo.",
          "no-attributes": "Sua enxada não tem atributo para gastar. O próximo chega no nível {level} dela.",
          "no-attributes-maximum": "Sua enxada não tem atributo para gastar, e já ganhou todos os que podia.",
          "already-repaired": "Sua enxada não precisa de conserto.",
          "repaired": "Sua enxada foi consertada.",
          "cannot-drop": "Você não pode largar a Enxada Especial no chão.",
          "cannot-move": "A Enxada Especial não sai do seu inventário.",
          "deleted": "&cSua enxada foi excluída.",
          "history": {
            "empty": "{player} não tem nada no histórico das armas.",
            "failed": "Não deu para carregar o histórico agora. Tente de novo em instantes."
          }
        },
        "units": {
          "duplicate-weapon": {
            "singular": "enxada duplicada",
            "plural": "enxadas duplicadas"
          }
        },
        "enchants": {
          "efficiency": {
            "description": [
              "&7Permite que sua enxada quebre",
              "&7instantaneamente qualquer",
              "&7plantação compatível."
            ]
          },
          "fortune": {
            "description": [
              "&7Multiplica os drops que cada",
              "&7plantação gera ao colher."
            ],
            "effect": "Chance"
          },
          "durability": {
            "description": [
              "&7Aumenta a chance de não perder",
              "&7durabilidade ao colher as plantações."
            ],
            "effect": "Chance"
          },
          "unbreakable": {
            "description": [
              "&7Torna a enxada inquebrável, deixando-a",
              "&7com durabilidade infinita."
            ]
          },
          "explorer": {
            "description": [
              "&7Aumenta a chance de encontrar itens",
              "&7especiais ao colher as plantações."
            ],
            "effect": "Chance"
          },
          "intelligence": {
            "description": [
              "&7Aumenta a chance de dar mais",
              "&7XP ao colher as plantações."
            ],
            "effect": "Chance"
          }
        },
        "views": {
          "weapon": {
            "drops": [
              "&fBotão Direito: &eVer chances"
            ],
            // O {enchant_attribute} só aparece quando a enxada tem atributo para gastar e o encantamento aceita.
            "attribute": [
              "&fShift + Botão Esquerdo: &bUsar atributo &7({attributes})"
            ],
            // O {attributes_next} do ícone dos atributos: o nível em que chega o próximo, ou que não há mais.
            "attributes-next": {
              "level": "no nível {level}",
              "maximum": "todos já ganhos"
            },
            "title": "{weapon_name}",
            "items": {
              "0": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_levels}",
                  " &fPreço: {enchant_currency_color}{enchant_price} {enchant_currency}",
                  "",
                  "{enchant_shop}",
                  "&fBotão Esquerdo: &aEvoluir",
                  "{enchant_drops}"
                ]
              },
              "2": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_effect}",
                  "&e Nível máximo atingido! &7({enchant_level})",
                  "{enchant_drops}"
                ]
              },
              "9": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_levels}",
                  " &fPreço: {enchant_currency_color}{enchant_price} {enchant_currency}",
                  "",
                  "{enchant_shop}",
                  "&cVocê não tem saldo suficiente!",
                  "{enchant_drops}"
                ]
              },
              "15": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_progress}",
                  " {level_bar} &7({level_percent}%)",
                  "",
                  "&cA melhoria desse encantamento não é comprável!"
                ]
              },
              "16": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "&cVocê já adquiriu esse encantamento!"
                ]
              },
              "3": {
                "name": "&aReparação",
                "lore": [
                  "&7Use esta função para",
                  "&7consertar sua enxada em 100%.",
                  "",
                  "&a Custo:",
                  "   &b{repair_cost} &f{repair_currency}",
                  "",
                  "&dDica: &fTorne a durabilidade",
                  "&fda sua enxada infinita ao",
                  "&fcomprar Indestrutível.",
                  "",
                  "{repair_state}"
                ]
              },
              "5": {
                "name": "&aRanking de {weapon_plural}",
                "lore": [
                  "&7Acompanhe o ranking de enxadas e veja",
                  "&7quem mais colheu e quem mais",
                  "&7investiu tokens nelas!",
                  "",
                  "&f Sua posição:",
                  "&f  Plantações colhidas: &e{blocks_position}",
                  "&f  Tokens investidos: &e{invested_position}",
                  "",
                  "&aClique para visualizar."
                ]
              },
              "6": {
                "name": "&a{enchant_name} &a&lATIVADA",
                "lore": [
                  "{enchant_description}",
                  "",
                  " &fEstado: &a&lATIVADA",
                  "",
                  "&cClique para desativar."
                ]
              },
              "11": {
                "name": "&7{enchant_name} &c&lDESATIVADA",
                "lore": [
                  "{enchant_description}",
                  "",
                  " &fEstado: &c&lDESATIVADA",
                  "",
                  "&aClique para ativar."
                ]
              },
              "7": {
                "name": "&cExcluir item",
                "lore": [
                  "&8Ação irreversível.",
                  "",
                  "&7Ao clicar neste item, sua enxada será",
                  "&7excluída, e todo o progresso e os",
                  "&7encantamentos serão perdidos.",
                  "",
                  "&eClique para excluir a enxada."
                ]
              },
              "8": {
                "name": "&c{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_levels}",
                  " &cRequisitos:",
                  " &fPrestígio &b&l{enchant_prestige} &fnecessário.",
                  "",
                  "&cNão é possível evoluir este encantamento."
                ]
              },
              "10": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_levels}",
                  "&aUpgrade VIP disponível!",
                  "&eClique para adquirir de graça."
                ]
              },
              // Os atributos, a segunda forma de evoluir a enxada. De quantos em quantos níveis ela ganha um
              // fica no config (attributes), e por isso o texto não diz o número.
              "attributes": {
                "name": "&bAtributos",
                "lore": [
                  "&7Sua enxada ganha atributos conforme",
                  "&7sobe de nível. Cada atributo sobe um",
                  "&7nível de um encantamento à sua",
                  "&7escolha, sem gastar tokens.",
                  "",
                  "&f Disponíveis: &b{attributes_available}",
                  "&f Usados: &7{attributes_spent}",
                  "&f Próximo: &e{attributes_next}",
                  "",
                  "&7Use com &fShift + Botão Esquerdo",
                  "&7no encantamento que você quer."
                ]
              },
              "12": {
                "name": "&eInformações",
                "lore": [
                  "&7Evolua sua enxada com encantamentos",
                  "&7que rendem mais na colheita!",
                  "",
                  "&7Colha com ela as plantações maduras",
                  "&7do seu terreno, e use os tokens da",
                  "&7escavação para evoluir os encantamentos."
                ]
              },
              "13": {
                "name": "&aTokens",
                "lore": [
                  "&7Acompanhe a quantidade de",
                  "&7tokens que você possui.",
                  "",
                  "&f Saldo: &a{tokens_balance}"
                ]
              },
              "14": {
                "name": "&bRanking de Tokens",
                "lore": [
                  "&7Acompanhe o ranking de tokens",
                  "&7e veja os jogadores que mais",
                  "&7possuem essa moeda.",
                  "",
                  "&f Sua posição: &b{tokens_position}",
                  "",
                  "&aClique para visualizar."
                ]
              }
            },
            "position": {
              "ranked": "{position}º",
              "unranked": "fora do ranking",
              "unavailable": "indisponível"
            },
            "loading": "carregando",
            "progress": {
              "next": " &fNível &l{level} &8» &bNível &l{next}",
              "maximum": " &fNível Máximo!"
            },
            "effect": {
              "next": "  &f{effect}: &c&m{from}&7 » &b{to}",
              "current": "  &f{effect}: &7{from}",
              "varied": [
                "  &fChance: &7variadas"
              ]
            },
            "shop": [
              "&e Adquira &f&lCASH&e e outros",
              "&e produtos em nossa loja!",
              "&e Acesse &floja.rede-exe.com",
              ""
            ],
            "states": {
              "repair": {
                "ready": "&aClique para consertar.",
                "repaired": "&cA enxada já está com a durabilidade máxima.",
                "not-enough": "&cVocê não possui {repair_currency} suficientes.",
                "loading": "&eCarregando o seu perfil..."
              },
              "prestige": {
                "ready": [
                  "&aClique para prosseguir."
                ],
                "maximum": [
                  "&cNível máximo de prestígio atingido."
                ],
                "not-invested": [
                  "&cVocê não possui os requisitos necessários."
                ]
              },
              "prestige-title": {
                "ready": "&aPrestígio &l{prestige} &r&8» &b&l{next}",
                "maximum": "&cPrestígio &l{prestige}",
                "not-invested": "&cPrestígio &l{prestige}"
              }
            }
          },
          "drops": {
            "all-blocks": "Todas",
            "lore": [
              "{drop_lore}",
              "",
              "&f Chance de encontrar: &b{chance}%",
              "&f Plantação: &7{blocks}",
              "",
              "&7Este item é encontrado a partir",
              "&7do nível &a&l{min_level}&r&7 de {enchant_name}."
            ]
          },
          "delete": {
            "title": "Excluir a enxada"
          },
          "prestige": {
            "title": "Prestigiar a enxada"
          },
          "history": {
            "items": {
              "enchant-upgrade": {
                "name": "&aEncantamento melhorado",
                "lore": [
                  "",
                  "&7Item: {weapon}",
                  "&7Encantamento: {enchant} &f{level}",
                  "&7Por: &f{source}",
                  "&7Custo: {cost}",
                  "",
                  "&8{date}"
                ]
              },
              "prestige": {
                "name": "&6Prestígio",
                "lore": [
                  "",
                  "&7Item: {weapon}",
                  "&7Prestígio novo: &f{prestige}",
                  "&7Investido: &b{invested} {invested_currency}",
                  "",
                  "&8{date}"
                ]
              },
              "retrieve": {
                "name": "&ePegou a enxada pelo comando",
                "lore": [
                  "",
                  "&7Item: {weapon}",
                  "{retrieve}",
                  "",
                  "&8{date}"
                ]
              },
              "delete": {
                "name": "&4Excluiu a enxada",
                "lore": [
                  "",
                  "&7Item: {weapon}",
                  "&7Investido: &b{invested} {invested_currency}",
                  "",
                  "&7Encantamentos:",
                  "{enchants}",
                  "",
                  "&8{date}"
                ]
              },
              "repair": {
                "name": "&dConsertou a enxada",
                "lore": [
                  "",
                  "&7Item: {weapon}",
                  "&7Custo: {cost}",
                  "",
                  "&8{date}"
                ]
              },
              "broken": {
                "name": "&cA enxada quebrou",
                "lore": [
                  "",
                  "&7Item: {weapon}",
                  "&7Investido: &b{invested} {invested_currency}",
                  "",
                  "&7Encantamentos:",
                  "{enchants}",
                  "",
                  "&8{date}"
                ]
              },
              "truncated": {
                "name": "&eSó os mais recentes",
                "lore": [
                  "",
                  "&7Aqui aparecem os {limit} {limit_unit}",
                  "&7mais recentes. Os anteriores estão",
                  "&7nos Logs do painel."
                ]
              }
            },
            "sources": {
              "menu": "o menu da enxada",
              "book": "um livro de encantamento",
              "free": "o upgrade do grupo",
              "toggle": "o interruptor do menu",
              "attribute": "um atributo da enxada"
            },
            "retrieve": {
              "created": "&aEnxada nova, sem registro anterior.",
              "existing": "&eA enxada que ele já tinha."
            }
          }
        },
        "item": {
          "name": "&bEnxada Especial",
          "counter": "{name} &7[{blocks}]",
          "investment": "&fInvestimento: &a{tokens} Tokens",
          "enchant-owned": "&6 {enchant} &l{level}",
          "enchant-missing": "&8 {enchant}",
          "level": "&fNível: &b&l{level}",
          "progress": "{bar} &7({percent}%)",
          "hint": "&8Shift + Clique Direito para abrir o menu!"
        },
        "endless": "∞",
        "plural": "Enxadas"
      },
      // O que a enxada diz a cada plantação colhida.
      "hoe": {
        "worn-out": "Sua enxada está gasta. Conserte-a no menu (Shift + botão direito) para continuar colhendo.",
        "found": "&b&lColheita! &eO encantamento &l{enchant}&r&e te deu um item {rarity}&e!",
        "fortune": "&b&lColheita! &eO encantamento &l{enchant}&r&e dobrou o que você achou!",
        "level-up": "Sua enxada subiu para o nível {level}."
      },
      // A barra de dez segmentos do nível da pá e da enxada, no item e no menu. Cada segmento aceso vale 10%.
      "bar": {
        "symbol": "▬",
        "done-color": "&a",
        "left-color": "&7"
      },
      // A espada e o machado da rede, os mesmos do P4Free (pedido do dono, 09/11/2026).
      "espada": {
        "item": {
          "name": "&cEspada Especial",
          "investment": "&fInvestimento: &e{tokens} Tokens",
          "enchant-owned": "&6 {enchant} &l{level}",
          "enchant-missing": "&8 {enchant}",
          "kills": "&fAbates: &c{kills}"
        },
        "broken": "&cA sua espada especial se partiu.",
        "plural": "Espadas"
      },
      "machado": {
        "item": {
          "name": "&cMachado Especial",
          "investment": "&fInvestimento: &e{tokens} Tokens",
          "enchant-owned": "&6 {enchant} &l{level}",
          "enchant-missing": "&8 {enchant}",
          "kills": "&fAbates: &c{kills}"
        },
        "broken": "&cO seu machado especial se partiu.",
        "plural": "Machados"
      },
      // As palavras que acompanham um número montado no código (o Plural do core): 1 no singular.
      "units": {
        "kill": { "singular": "abate", "plural": "abates" },
        "duplicate-weapon": { "singular": "arma duplicada", "plural": "armas duplicadas" },
        "entry": { "singular": "registro", "plural": "registros" },
        // O item que paga o conserto da pá (repair-item no config).
        "repair-item": {
          "diamond": { "singular": "diamante", "plural": "diamantes" }
        }
      },
      "pa": {
        // O que aparece no lugar do número no encantamento sem nível para mostrar (a Eficiência, o Indestrutível).
        "endless": "∞",
        // Os textos da pá que mudam de um tipo para outro: no rankup ela mora com a espada e o machado, que
        // usam os de plugins.weapons. O exe-weapons.jar lê estes pelo tipo (WeaponKind.text).
        "messages": {
          "not-purchasable": "Este encantamento não pode ser comprado. Ele sobe com o nível da sua pá.",
          "profile-loading": "Seu perfil ainda está carregando. Tente de novo em instantes.",
          "duplicates-removed": "Removemos {amount} {amount_unit} do seu inventário.",
          "in-combat": "Você não pode abrir o menu da pá em combate.",
          "not-in-hand": "Segure a pá na mão para mexer nela.",
          "already-max-level": "Este encantamento já está no nível máximo.",
          "prestige-required": "Este encantamento pede prestígio {prestige}.",
          "not-enough": "Você não tem {currency} suficientes.",
          "charge-failed": "Não deu para confirmar a cobrança, e nada mudou na pá. Se o valor saiu da sua conta, ele volta sozinho.",
          // O conserto pago com itens do inventário: "Você precisa de 5 diamantes".
          "not-enough-items": "Você precisa de {amount} {item} no inventário para consertar a pá.",
          "enchant-bought": "&bParabéns! &fO encantamento &6{enchant} &fsubiu para o nível &6{level}&f.",
          "free-upgrade": "&aParabéns! &f{enchant} &asubiu para o nível &f{level}&a de graça, pelo seu grupo.",
          "already-repaired": "Sua pá não precisa de conserto.",
          "repaired": "Sua pá foi consertada.",
          "cannot-drop": "Você não pode largar a Pá Especial no chão.",
          "cannot-move": "A Pá Especial não sai do seu inventário.",
          "deleted": "&cSua pá foi excluída.",
          "history": {
            "empty": "{player} não tem nada no histórico das armas.",
            "failed": "Não deu para carregar o histórico agora. Tente de novo em instantes."
          }
        },
        "units": {
          "duplicate-weapon": {
            "singular": "pá duplicada",
            "plural": "pás duplicadas"
          }
        },
        // Os nomes e as descrições dos encantamentos da pá, no ícone do menu. O efeito é o rótulo
        // do número que o nível mexe; o que não tem número não tem efeito.
        "enchants": {
          "intelligence": {
            "description": [
              "&7Aumenta a quantidade de XP vanilla",
              "&7recebida ao escavar blocos."
            ]
          },
          "unbreakable": {
            "description": [
              "&7Torna a pá inquebrável, deixando-a",
              "&7com durabilidade infinita."
            ]
          },
          "fortune": {
            "description": [
              "&7Dá a chance de dobrar o número",
              "&7de itens ao encontrar um recurso."
            ],
            "effect": "Chance"
          },
          "efficiency": {
            "description": [
              "&7Permite que sua pá quebre",
              "&7instantaneamente qualquer",
              "&7bloco compatível."
            ]
          },
          "explorer": {
            "description": [
              "&7Aumenta a chance de encontrar itens",
              "&7especiais ao escavar blocos."
            ],
            "effect": "Chance"
          },
          "cactus": {
            "description": [
              "&7Dá a chance de conseguir itens",
              "&7para criar uma farm de cacto."
            ]
          },
          "diamond": {
            "description": [
              "&7Dá a chance de conseguir",
              "&7diamantes enquanto escava."
            ],
            "effect": "Chance"
          },
          "durability": {
            "description": [
              "&7Aumenta a chance de não perder",
              "&7durabilidade ao escavar blocos."
            ],
            "effect": "Chance"
          }
        },
        "views": {
          // A linha de cada item no menu dos achados, que abre no botão direito do ícone.
          "drops": {
            "all-blocks": "Todos",
            "lore": [
              "{drop_lore}",
              "",
              "&f Chance de encontrar: &b{chance}%",
              "&f Blocos: &7{blocks}",
              "&f Horário: &7{times}",
              "",
              "&7Este item é encontrado a partir",
              "&7do nível &a&l{min_level}&r&7 de {enchant_name}."
            ]
          },
          // O menu da pá, que abre com Shift + botão direito com ela na mão.
          "weapon": {
            "title": "{weapon_name}",
            "items": {
              // 15: o que sobe com o nível da pá e não se compra (a Inteligência). 16: o de um nível só, já adquirido
              // (o Indestrutível). Os dois são do desenho dos baús de referência do Kekitoox.
              "15": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_progress}",
                  " {level_bar} &7({level_percent}%)",
                  "",
                  "&cA melhoria desse encantamento não é comprável!"
                ]
              },
              "16": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "&cVocê já adquiriu esse encantamento!"
                ]
              },
              // 0: o encantamento que dá para evoluir. As linhas só com uma lista ({enchant_description},
              // {enchant_effect}, {enchant_shop}, {enchant_drops}) viram uma linha por item, e vazias somem.
              "0": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_levels}",
                  " &fPreço: {enchant_currency_color}{enchant_price} {enchant_currency}",
                  "",
                  "{enchant_shop}",
                  "&fBotão Esquerdo: &aEvoluir",
                  "{enchant_drops}"
                ]
              },
              // 2: o encantamento já no máximo.
              "2": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_effect}",
                  "&e Nível máximo atingido! &7({enchant_level})",
                  "{enchant_drops}"
                ]
              },
              // 3: o conserto, pago com diamantes do inventário.
              "3": {
                "name": "&aReparação",
                "lore": [
                  "&7Use esta função para",
                  "&7consertar sua pá em 100%.",
                  "",
                  "&a Custo:",
                  "   &b{repair_cost} &f{repair_currency}",
                  "",
                  "&dDica: &fTorne a durabilidade",
                  "&fda sua pá infinita ao",
                  "&fcomprar Indestrutível.",
                  "",
                  "{repair_state}"
                ]
              },
              // 5: o ranking das pás, com a posição de quem abre.
              "5": {
                "name": "&aRanking de {weapon_plural}",
                "lore": [
                  "&7Acompanhe o ranking de pás e veja",
                  "&7quem mais escavou e quem mais",
                  "&7investiu tokens nelas!",
                  "",
                  "&f Sua posição:",
                  "&f  Blocos escavados: &e{blocks_position}",
                  "&f  Tokens investidos: &e{invested_position}",
                  "",
                  "&aClique para visualizar."
                ]
              },
              // 6 e 11: o que se liga e desliga em vez de se comprar. A pá não tem nenhum hoje.
              "6": {
                "name": "&a{enchant_name} &a&lATIVADA",
                "lore": [
                  "{enchant_description}",
                  "",
                  " &fEstado: &a&lATIVADA",
                  "",
                  "&cClique para desativar."
                ]
              },
              "11": {
                "name": "&7{enchant_name} &c&lDESATIVADA",
                "lore": [
                  "{enchant_description}",
                  "",
                  " &fEstado: &c&lDESATIVADA",
                  "",
                  "&aClique para ativar."
                ]
              },
              // 7: a exclusão da pá.
              "7": {
                "name": "&cExcluir item",
                "lore": [
                  "&8Ação irreversível.",
                  "",
                  "&7Ao clicar neste item, sua pá será",
                  "&7excluída, e todo o progresso e os",
                  "&7encantamentos serão perdidos.",
                  "",
                  "&eClique para excluir a pá."
                ]
              },
              // 8: o encantamento que pede prestígio. A pá não tem prestígio hoje.
              "8": {
                "name": "&c{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_progress}",
                  "{enchant_effect}",
                  "",
                  " &cRequisitos:",
                  " &fPrestígio &b&l{enchant_prestige} &fnecessário.",
                  "",
                  "&cNão é possível evoluir este encantamento."
                ]
              },
              // 9: o encantamento que dá para evoluir, mas o saldo não chega.
              "9": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_levels}",
                  " &fPreço: {enchant_currency_color}{enchant_price} {enchant_currency}",
                  "",
                  "{enchant_shop}",
                  "&cVocê não tem saldo suficiente!",
                  "{enchant_drops}"
                ]
              },
              // 10: o nível que o grupo leva de graça. A pá não tem upgrade de graça hoje.
              "10": {
                "name": "&a{enchant_name} &l{enchant_level}",
                "lore": [
                  "{enchant_description}",
                  "",
                  "{enchant_progress}",
                  "{enchant_effect}",
                  "",
                  "&aUpgrade VIP disponível!",
                  "&eClique para adquirir de graça."
                ]
              },
              // 12: as informações.
              "12": {
                "name": "&eInformações",
                "lore": [
                  "&7Evolua sua pá com encantamentos",
                  "&7que rendem itens na escavação!",
                  "",
                  "&7Escave com ela para ganhar tokens,",
                  "&7e use os tokens para evoluir",
                  "&7os encantamentos."
                ]
