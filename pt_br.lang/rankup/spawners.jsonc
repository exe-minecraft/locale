                  "&apor {sale_value}&a!",
                  "&8(Espera de {cooldown} nos seus",
                  "&8spawners deste tipo)"
                ]
              },
              "cooldown": {
                "name": "&aVender Tudo",
                "lore": [
                  "&7Com esta opção você vende todos os",
                  "&7drops deste spawner com um toque!",
                  "&7",
                  "&cAguarde {time} para vender tudo",
                  "&cde novo nos seus spawners deste tipo."
                ]
              },
              "empty": {
                "name": "&aVender Tudo",
                "lore": [
                  "&7Com esta opção você vende todos os",
                  "&7drops deste spawner com um toque!",
                  "&7",
                  "&cNão há drops para vender."
                ]
              },
              "buy": {
                "name": "&aVender Tudo",
                "lore": [
                  "&7Com esta opção você vende todos os",
                  "&7drops de um spawner com um toque!",
                  "&7",
                  "&f Preço: &6{price} ✪",
                  "&7",
                  "{shop}",
                  "&aClique para adquirir!",
                  "&8(Espera de {cooldown})"
                ]
              },
              "not-enough": {
                "name": "&aVender Tudo",
                "lore": [
                  "&7Com esta opção você vende todos os",
                  "&7drops de um spawner com um toque!",
                  "&7",
                  "&f Preço: &6{price} ✪",
                  "&7",
                  "{shop}",
                  "&cVocê não tem saldo suficiente!",
                  "&8(Espera de {cooldown})"
                ]
              }
            }
          }
        },
        // O menu das melhorias (os baús "menu melhorias" e "opções melhorias"). O {price} é o total, que é o
        // {unit_price} da lista vezes os {quantity} spawners do bloco.
        "upgrades": {
          "title": "Melhorias do Spawner",
          "items": {
            "upgrade": {
              "upgrade": {
                "name": "&d{upgrade} &d&l{level}",
                "lore": [
                  "{description}",
                  "&7",
                  "&f Nível &f&l{level} &8» &dNível &d&l{next_level}",
                  "&f  {label}: &c&m{value}&r &7» &d{next_value}",
                  "&7",
                  "&f Preço: {price}",
                  "&8  {quantity}x {unit_price}",
                  "&7",
                  "&aClique para evoluir!"
                ]
              },
              "not-enough": {
                "name": "&d{upgrade} &d&l{level}",
                "lore": [
                  "{description}",
                  "&7",
                  "&f Nível &f&l{level} &8» &dNível &d&l{next_level}",
                  "&f  {label}: &c&m{value}&r &7» &d{next_value}",
                  "&7",
                  "&f Preço: {price}",
                  "&8  {quantity}x {unit_price}",
                  "&7",
                  "&cVocê não tem saldo suficiente!"
                ]
              },
              "maximum": {
                "name": "&d{upgrade} &d&l{level}",
                "lore": [
                  "{description}",
                  "&7",
                  "&f {label}: &d{value}",
                  "&7",
                  "&cNível máximo atingido!"
                ]
              }
            }
          }
        },
        // O /gaiolas (o baú "menu gaiolas").
        "cages": {
          "title": "Gaiolas",
          "items": {
            "cage": {
              "merge": {
                "name": "{cage}",
                "lore": [
                  "&7Junte {cost} da {previous} &7para",
                  "&7poder fabricar esta gaiola.",
                  "&7",
                  " {previous}: &f{amount}",
                  "&7",
                  "&aClique com o botão esquerdo para juntar!",
                  "&eClique com o botão direito para",
                  "&eescolher a quantidade!"
                ]
              },
              "not-enough": {
                "name": "{cage}",
                "lore": [
                  "&7Junte {cost} da {previous} &7para",
                  "&7poder fabricar esta gaiola.",
                  "&7",
                  " {previous}: &f{amount}",
                  "&7",
                  "&cVocê não tem gaiolas suficientes!"
                ]
              }
            }
          }
        },
        // O /setspawn.
        "set-spawn": {
          "title": "Ponto de Spawn",
          "items": {
            "spawner": {
              "name": "{mob_color}Spawner de {mob_name}",
              "lore": [
                "&7",
                "&7 Quantidade: &f{quantity}x",
                "&7 Distância: &f{distance} {distance_unit}",
                "&7",
                "&7O mob deste spawner passa a nascer",
                "&7no lugar onde você está agora, a até",
                "&7{radius} {radius_unit} do spawner.",
                "&7",
                "&aClique para definir o ponto de spawn!"
              ]
            },
            "spawner-far": {
              "name": "{mob_color}Spawner de {mob_name}",
              "lore": [
                "&7",
                "&7 Quantidade: &f{quantity}x",
                "&7 Distância: &f{distance} {distance_unit}",
                "&7",
                "&7O ponto de spawn tem de ficar a até",
                "&7{radius} {radius_unit} do spawner.",
                "&7",
                "&cChegue mais perto deste spawner."
              ]
            }
          }
        },
        // O /heads armazenar (o baú "menu heads armazenar"). O {action} só aparece no menu do próprio jogador.
        "heads": {
          "title": "Cabeças de {target_name}",
          "items": {
            "total": {
              "name": "&9Cabeças de {target_name}",
              "lore": [
                "&7As cabeças guardadas de cada tipo.",
                "&7",
                "&7 Total: &9{total}",
                "&7",
                "&eClique para ver o histórico!"
              ]
            },
            // O total para quem olha as cabeças de outro jogador sem a chave do histórico. O clique não faz nada.
            "total-view": {
              "name": "&9Cabeças de {target_name}",
              "lore": [
                "&7As cabeças guardadas de cada tipo.",
                "&7",
                "&7 Total: &9{total}"
              ]
            },
            "head": {
              "name": "{mob_color}Cabeça de {mob_name}",
              "lore": [
                "&7Esse item é utilizado e necessário",
                "&7para a evolução do seu rank!",
                "&7",
                "&7 Quantidade: &f{amount}",
                "&7",
                "{action}"
              ],
              "actions": [
                "&aClique com o botão esquerdo para",
                "&aguardar as do inventário! &7({held})",
                "&eClique com o botão direito para retirar!"
              ]
            }
          }
        },
        // O histórico das cabeças (os baús "menu historico" e "menu historico 2").
        "head-history": {
          "title": "Histórico de {target_name}",
          "items": {
            "added": {
              "name": "&a+{amount} {unit}",
              "lore": [
                "&7",
                "&7Motivo: &f{reason}",
                "&7Data: &f{date}",
                "&7Saldo Final: &f{balance}"
              ]
            },
            "removed": {
              "name": "&c-{amount} {unit}",
              "lore": [
                "&7",
                "&7Motivo: &f{reason}",
                "&7Data: &f{date}",
                "&7Saldo Final: &f{balance}"
              ]
            },
            "reasons": {
              "deposit": "Depósito de {target_name_with_color}",
              "withdraw": "Retirada de {target_name_with_color}",
              "overflow": "Sobra do inventário cheio",
              "returned": "Devolução às guardadas"
            }
          }
        },
        // A confirmação da compra do Vender Tudo, no molde da dos terrenos.
        "purchase": {
          "title": "Adquirir o Vender Tudo?",
          "items": {
            "sell-all": {
              "name": "&aVender Tudo",
              "lore": [
                "&7Com esta opção você vende todos os",
                "&7drops de um spawner com um toque!",
                "&7Vale para todos os seus spawners.",
                "&7",
                "&f Preço: &6{price} ✪"
              ]
            }
          }
        }
      },
      "commands": {
        "spawners": {
          "description": "abrir a loja de spawners",
          "usage": {
            "menu": { "syntax": "", "description": "abrir a loja de spawners" }
