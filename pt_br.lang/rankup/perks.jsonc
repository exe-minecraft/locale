{
  "plugins": {
    // As perks do rankup (10/11/2026). São nove perks com nível e progresso, que evoluem pelo uso. Seis o jogador liga
    // e desliga até o limite do grupo dele, e três já vêm ligadas. O nome, a cor e a descrição de cada uma são os dos
    // baús de referência do Kekitoox, com o português corrigido ("necessidade", "itens", "XP"). Desde a Atualização
    // Perks de 21/11/2026 cada perk vai do nível 0 ao 50 ou ao 500, com marcos, e tem um menu próprio. As perks do
    // P4Free têm o arquivo delas, e são outro sistema.
    "perks": {
      // As palavras que acompanham um número montado no código (o Plural do core), com o 1 no singular.
      "units": {
        "active-perk": { "singular": "perk ativa", "plural": "perks ativas" },
        "enemy": { "singular": "inimigo", "plural": "inimigos" },
        // O custo do conserto e o alcance da Supressão no menu de cada perk, com a maiúscula dos baús.
        "diamond": { "singular": "Diamante", "plural": "Diamantes" },
        "block": { "singular": "Bloco", "plural": "Blocos" }
      },
      // A barra de dez segmentos do menu e da Velocidade carregando. Cada segmento aceso vale 10%.
      "bar": {
        "symbol": "▬",
        "done-color": "&a",
        "left-color": "&7"
      },
      // name é o nome com a cor da perk, e color é só a cor, para o número do nível no menu.
      "types": {
        "attack": {
          "name": "&bAtaque",
          "color": "&b",
          "description": ["&7Receba buff de dano em golpes aplicados", "&7no chão, sem necessidade de critar."]
        },
        "regeneration": {
          "name": "&dRegeneração",
          "color": "&d",
          "description": ["&7Receba a maçã dourada de", "&7volta ao ser consumida."]
        },
        "blacksmith": {
          "name": "&7Ferreiro",
          "color": "&7",
          "description": ["&7Diminua a chance de falha e o consumo", "&7de diamantes ao reparar seus itens."]
        },
        "speed": {
          "name": "&bVelocidade",
          "color": "&b",
          "description": ["&7Ao agachar-se por alguns segundos,", "&7receba velocidade extra temporária."]
        },
        "suppression": {
          "name": "&3Supressão",
          "color": "&3",
          "description": ["&7Ao defender com a espada/machado,", "&7desligue as perks dos seus inimigos."]
        },
        "resistance": {
          "name": "&9Resistência",
          "color": "&9",
          "description": ["&7Receba efeito de resistência temporariamente", "&7ao defender golpes com a espada cruzada."]
        },
        "alchemist": {
          "name": "&5Alquimista",
          "color": "&5",
          "description": ["&7Receba buffs ao craftar poções, como,", "&7tempo adicional, efeitos melhores, etc..."]
        },
        "farmer": {
          "name": "&eFazendeiro",
          "color": "&e",
          "description": ["&7Diminua o tempo de spawn das plantações,", "&7que estejam plantadas nos seus terrenos."]
        },
        "slayer": {
          "name": "&8Matador",
          "color": "&8",
          "description": ["&7Diminua o tempo de spawn dos spawners,", "&7que estejam colocados nos seus terrenos."]
        }
      },

      "views": {
        "perks": {
          "title": "Perks",
          // A cabeça do jogador, em cima. {rank} é uma das três linhas de rank abaixo. As linhas em branco são "&7", como
          // nos baús de referência, para o item sair igual ao de lá. O clique abre o ranking do nível total, e a última
          // linha é a da imagem do dono de 17/11/2026.
          "profile": {
            "name": "&ePerks de {player_name}",
            "lore": [
              "&7",
              "&f Nível Total: &e&l{total_level}",
              "&f Rank: {rank}",
              "&7",
              "&eVocê tem &f&l{active} &ede &f&l{limit} &e{limit_unit} atualmente!",
              "&aClique para acessar o ranking!"
            ]
          },
          "rank": {
            "position": "&c&l#{position}",
            // A staff não entra no ranking.
            "unranked": "&7fora do ranking",
            // O banco não respondeu a tempo.
            "unknown": "&7indisponível"
          },
          // O ícone de cada perk. {description}, {progress} e {status} são listas, e cada uma vira as linhas que tiver.
          // A {progress} não deixa linha nenhuma no nível máximo. O clique direito abre o menu da perk.
          "item": {
            "name": "{perk}",
            "lore": [
              "{description}",
              "&7",
              "&f Nível Atual: {color}&l{level}",
              "{progress}",
              "&7",
              "{status}",
              "&7Clique direito para ver os marcos!"
            ],
            "progress": ["&7 {bar} ({percent}%)"]
          },
          // A última parte do ícone, que é sempre a resposta que o clique dá. No nível máximo a "maximum" vem antes
          // da linha do estado. A trava de troca e o combate têm uma linha para a perk ligada e outra para a
          // desligada, para o ícone seguir dizendo de que lado ela está.
          "status": {
            "standard": ["&8(Essa perk já vem ativada por padrão)"],
            "active": ["&eClique esquerdo para desativar essa perk!"],
            "inactive": ["&aClique esquerdo para ativar essa perk!"],
            "limit": ["&cVocê já tem o máximo de perks ativas!"],
            "locked-active": ["&cAguarde {time} para desativar essa perk!"],
            "locked-inactive": ["&cAguarde {time} para ativar essa perk!"],
            "in-combat-active": ["&cVocê não pode desativar essa perk em combate!"],
            "in-combat-inactive": ["&cVocê não pode ativar essa perk em combate!"],
            "maximum": ["&cNível máximo atingido!"]
          }
        },
        // O menu de cada perk, aberto pelo clique direito no /perks (a Atualização Perks de 21/11/2026), no desenho dos
        // baús de referência do Kekitoox. O título é o types.<perk>.title, que o Java põe no {title}. {stats} são as
        // linhas da perk (types.<perk>.stats) com os números do marco, na cabeça e em cada marco.
        "perk": {
          "title": "{title}",
          // A cabeça do jogador, com o que a perk dá agora. {progress} é a linha da barra, ou a do nível máximo.
          "profile": {
            "lore": [
              "&7Status atuais da perk:",
              "&7",
              "&8 &8 ▶ &7Nível: &f{level}",
              "{stats}",
              "&8 &8 ▶ &7Ativa: {active}",
              "&7",
              "{progress}"
            ]
          },
          "active": {
            "yes": "&aSim",
            "no": "&cNão",
            // As três padrão.
            "always": "&eSempre"
          },
          // {next} é o nível seguinte, e {percent} o progresso até ele.
          "progress": ["{bar} {color}Nv. {next} &7({percent}%)"],
          "maximum": ["&aNível máximo atingido!"],
          // Os marcos, verdes e brilhando os alcançados e vermelhos os outros. {perk} é o types.<perk>.label.
          "milestone": {
            "reached": {
              "name": "&a{perk} Nv. &a&l{level}",
              "lore": ["&7", "{stats}", "&7", "&aVocê já alcançou esse nível!"]
            },
            "locked": {
              "name": "&c{perk} Nv. &c&l{level}",
              "lore": ["&7", "{stats}", "&7", "&cAlcance o nível &c&l{level} &cpara desbloquear!"]
            }
          },
          "words": {
            // Os efeitos da Alquimista, o das poções de Velocidade e de Força, e o da Berserker.
            "speed-strength": "&bV &fe &5F",
            "berserker": "&dBerserker",
            // A passiva da Velocidade na Soul Sand. {percent} é o que o /speed do mesmo nível soma ao andar.
            "passive": "&b+{percent}% &7(Soul Sand)",
            "no-passive": "&7Nenhuma"
          },
          // O título, o nome da cabeça, o nome dos marcos e a cor do nível de cada perk, como nos baús.
          "types": {
            "attack": {
              "title": "Perk de Ataque",
              "name": "&bPerk de Ataque",
              "label": "Ataque",
              "color": "&b",
              "stats": ["&8 &8 ▶ &7Ativação: &f{activation}%", "&8 &8 ▶ &7Multiplicador: &f{multiplier}x"]
            },
            "regeneration": {
              "title": "Perk de Regeneração",
              "name": "&dPerk de Regeneração",
              "label": "Regeneração",
              "color": "&d",
              "stats": ["&8 &8 ▶ &7Ativação: &f{activation}%"]
            },
            "blacksmith": {
              "title": "Perk de Ferreiro",
              "name": "&8Perk de Ferreiro",
              "label": "Ferreiro",
              "color": "&8",
              // {cost} são os diamantes do conserto pelo desgaste do item, do mais gasto ao menos gasto ("4/3/2/1").
              "stats": ["&8 &8 ▶ &7Falho: &f{fail}%", "&8 &8 ▶ &7Custo: &f{cost} {cost_unit}"]
            },
            "speed": {
              "title": "Perk de Velocidade",
              "name": "&bPerk de Velocidade",
              "label": "Velocidade",
              "color": "&b",
              "stats": ["&8 &8 ▶ &7Duração: &f{duration}", "&8 &8 ▶ &7Cooldown: &f{cooldown}", "&8 &8 ▶ &7Passiva: {passive}"]
            },
            "suppression": {
              "title": "Perk de Supressão",
              "name": "&3Perk de Supressão",
              "label": "Supressão",
              "color": "&3",
              "stats": [
                "&8 &8 ▶ &7Alvos: &f{targets}",
                "&8 &8 ▶ &7Alcance: &f{radius} {radius_unit}",
                "&8 &8 ▶ &7Duração: &f{duration}",
                "&8 &8 ▶ &7Cooldown: &f{cooldown}"
              ]
            },
            "resistance": {
              "title": "Perk de Resistência",
              "name": "&9Perk de Resistência",
              "label": "Resistência",
              "color": "&9",
              "stats": ["&8 &8 ▶ &7Ativação: &f{activation}%", "&8 &8 ▶ &7Duração: &f{duration}"]
            },
            "alchemist": {
              "title": "Perk de Alquimia",
              "name": "&5Perk de Alquimia",
              "label": "Alquimista",
              "color": "&5",
              // Do marco da Berserker em diante, a linha dos efeitos, o nível e a duração são os dela.
              "stats": [
                "&8 &8 ▶ &7Efeitos: {effects}",
                "&8 &8 ▶ &7Nv. Efeitos: &f{effect_level}",
                "&8 &8 ▶ &7Duração: &f{duration}",
                "&8 &8 ▶ &7Falho: &f{fail}%",
                "&8 &8 ▶ &7Poções: &f{potions} &7(simultâneas)"
              ]
            },
            "farmer": {
              "title": "Perk de Fazendeiro",
              "name": "&ePerk de Fazendeiro",
              "label": "Fazendeiro",
              "color": "&e",
              "stats": ["&8 &8 ▶ &7Velocidade: &a+{speed}%"]
            },
            "slayer": {
              "title": "Perk de Matador",
              "name": "&8Perk de Matador",
              "label": "Matador",
              "color": "&8",
              "stats": ["&8 &8 ▶ &7Velocidade: &a+{speed}%"]
            }
          }
        }
      },

      "messages": {
        "activated": "&aVocê ativou a perk {perk}&a.",
        "deactivated": "Você desativou a perk {perk}&e.",
        // As recusas do clique no menu, uma para cada estado do ícone.
        "toggle-refused": {
          "standard": "Essa perk vem ativada por padrão e não pode ser desativada.",
          "limit": "Você já tem {limit} {limit_unit}, que é o seu máximo. Desative uma antes de ativar outra.",
          "locked": "Aguarde {time} para trocar essa perk de novo.",
          "in-combat": "Você não pode trocar de perk enquanto estiver em combate."
        },
        // O limite do grupo, conferido na entrada, ao abrir o menu e de tempos em tempos enquanto o jogador está online.
        "limit-raised": "&aAgora você pode manter &f{limit} &a{limit_unit}.",
        "limit-lowered": "Seu limite agora é de {limit} {limit_unit}, e o que passava dele foi desativado.",

        // O XP de uma fabricação de poções, que é sorteado. Diz quanto deu, como os do ferreiro, e sai antes do aviso
        // de nível novo.
        "brew-xp": "&7Sua perk {perk} &7ganhou &f{xp}% &7de XP.",
        // A junção e o conserto com sucesso do ferreiro, que também dizem ao jogador quanto deram.
        "blacksmith-xp": "&7Sua perk {perk} &7ganhou &f{xp}% &7de XP.",
        // Na barra de ação, a cada nível. O chat fica para o marco e para o nível máximo.
        "level-up": "&aSua perk {perk} &asubiu para o nível &f{level}&a!",
        // A subida que para num marco. O que mudou se vê no /perks, com o clique direito na perk.
        "level-milestone": "&aSua perk {perk} &aalcançou o marco do nível &f{milestone}&a! Veja o que mudou com o clique direito nela, no /perks.",
        // A subida que passa de um marco de uma vez (a junção do ferreiro, o XP da staff), com o nível em que parou.
        "level-milestone-passed": "&aSua perk {perk} &achegou ao nível &f{level} &ae passou o marco do nível &f{milestone}&a! Veja o que mudou com o clique direito nela, no /perks.",
        "level-maximum": "&aSua perk {perk} &achegou ao nível &f{level}&a, que é o máximo!",
        // O jar de antes da Atualização Perks ainda manda esta, e ela fica até a janela de 21/11/2026 trocar os três
        // servidores do rankup. O jar novo não a usa, e ela sai do locale depois da janela.
        "suppression-missed": "A perk {perk} &enão está ativa, por isso não ganhou XP com esta subida de nível.",

        "regeneration-returned": "&aVocê recuperou a sua maçã dourada.",
        "resistance-activated": "&aResistência ativada por &f{time}&a.",
        "speed-activated": "&aVelocidade extra ativada por &f{time}&a.",
        // Na barra de ação, enquanto o jogador segura o agachar.
        "charging": "{perk} {bar}",
        // Na barra de ação, para a perk de clique ou de postura que ainda está em recarga.
        "in-cooldown": "{perk} &cestará disponível novamente em {time}.",

        "suppression-activated": "&aVocê desligou as perks de &f{amount} &a{amount_unit} por &f{time}&a.",
        // Na barra de ação, só para quem está em combate.
        "suppression-empty": "&cNão há inimigos por perto para suprimir.",
        "suppressed": "Suas perks foram desligadas por {time}.",
        "suppression-ended": "&aSuas perks voltaram a funcionar.",

        // O nome que a staff digitou num comando e não é de perk. {perks} são os nove nomes que o comando aceita.
        "unknown-perk": "&cA perk {perk} não existe. As perks são {perks}."
      },

      "commands": {
        "perks": {
          "still-loading": "Suas perks ainda estão carregando. Tente de novo em instantes.",
          "load-failed": "Não foi possível carregar suas perks. Entre de novo no servidor para tentar outra vez.",
          "usage": {
            "menu": { "syntax": "", "description": "abrir o menu das suas perks" }
          },
          "admin": {
            "description": "mexer nas perks de um jogador",
            // O jogador não está neste servidor do rankup, ou as perks dele ainda não carregaram aqui.
            "elsewhere": "{target_name_with_color} &cnão está neste servidor. O comando só age em quem está aqui.",
            "level": {
              "description": "definir o nível de uma perk",
              "arguments": {
                "target": { "name": "jogador", "description": "Jogador que está neste servidor" },
                "perk": { "name": "perk", "description": "O nome da perk, como ataque ou regeneração" },
                "level": { "name": "nível", "description": "O nível novo, de 0 até o máximo da perk" }
              },
              "invalid": "Nível inválido. Use um número entre 0 e {max}.",
              "success": "&aVocê definiu a perk {perk} &ade {target_name_with_color} &apara o nível &f{level}&a.",
              "already": "A perk {perk} &cde {target_name_with_color} &cjá está no nível {level}, sem progresso."
            },
            "xp": {
              "description": "dar XP a uma perk",
              "arguments": {
                "target": { "name": "jogador", "description": "Jogador que está neste servidor" },
                "perk": { "name": "perk", "description": "O nome da perk, como ataque ou regeneração" },
                "percent": { "name": "porcentagem", "description": "Quanto do nível somar, acima de 0 e até 100" }
              },
              "invalid": "Porcentagem inválida. Use um número acima de 0 e até {max}.",
              "maximum": "A perk {perk} &cde {target_name_with_color} &cjá está no nível máximo.",
              "success": "&aVocê deu &f{percent}% &ade XP à perk {perk} &ade {target_name_with_color}&a. Ela agora está no nível &f{level} &acom &f{progress}%&a."
            },
            "reset": {
              "description": "voltar uma perk, ou todas, ao nível 0",
              "arguments": {
                "target": { "name": "jogador", "description": "Jogador que está neste servidor" },
                "perk": { "name": "perk", "description": "Uma perk só. Sem ela, todas" }
              },
              "all": {
                "success": "&aAs perks de {target_name_with_color} &avoltaram ao nível 0.",
                "nothing": "As perks de {target_name_with_color} &cjá estão todas no nível 0, sem progresso."
              },
              "one": {
                "success": "&aA perk {perk} &ade {target_name_with_color} &avoltou ao nível 0.",
                "nothing": "A perk {perk} &cde {target_name_with_color} &cjá está no nível 0, sem progresso."
              }
            }
          }
        }
      }
    }
  }
}
