        "staff-reset-failed": "&cA limpeza do terreno de {player_name_with_color} &cfalhou, e o erro foi para o painel.",
        "staff-reset-spawners": "&cO terreno {plot} &cde {player_name_with_color} &cnão foi limpo, porque tem spawners colocados. Só o dono os retira, pelo menu de cada spawner.",
        "staff-cleared": "&aO terreno {plot} &ade {player_name_with_color} &afoi limpo.",
        "cleared-by-staff": "&eSeu terreno {plot} &efoi limpo pela equipe e voltou ao ponto inicial.",
        "cleared-by-staff-listed": "&eSeu terreno {plot} &efoi limpo pela equipe e voltou ao ponto inicial. O anúncio dele saiu da Imobiliária, e as ofertas foram canceladas.",
        "cleaner-done": "&aA limpeza do terreno {plot} &afoi concluída com sucesso!",
        "cleaner-resumed": "&eA limpeza do terreno havia sido pausada devido a um reinício do servidor, a mesma foi retomada com sucesso!",
        "schematic-done": "&aA Schematic do terreno {plot} &afoi aplicada com sucesso!",
        "schematic-resumed": "&eA Schematic do terreno {plot} &efoi pausada por um reinício do servidor e já foi retomada.",
        "schematic-busy": "&cO terreno {plot} &cestá recebendo uma Schematic. Tente de novo quando ela terminar.",
        "deleted": "&aO terreno {plot} &afoi excluído e está livre de novo.",
        "reset-failed": "&cA limpeza do terreno {plot} &cfalhou. A equipe foi avisada, tente de novo mais tarde.",
        // O reset animado leva minutos: um restart no meio deixa o terreno pela metade, e o arranque avisa o dono.
        "reset-interrupted": "&eA limpeza do terreno {plot} &efoi interrompida porque o servidor reiniciou, e o terreno continua seu. Se quiser, peça de novo pelo menu do terreno."
      },
      // O Limpador de Terrenos (o pedido do dono de 09/11): o clique direito dentro do próprio terreno, no servidor de
      // terrenos, abre a confirmação, e confirmar tira toda a terra e a grama do terreno.
      "items": {
        "clear": {
          "display-name": "&eLimpador de Terrenos",
          "name": "&eLimpador de Terrenos",
          "lore": ["&7Esse item limpa seu plot até à bedrock,", "&7para usar, clique com o botão direito", "&7dentro de um terreno que seja seu!", "&7", "&8(Apenas as terras/gramas são eliminadas)"],
          "messages": {
            "world": "&cVocê não pode usar o limpador neste mundo!",
            "outside": "&cVocê precisa estar dentro de um terreno!",
            "not-yours": "&cEste terreno não é seu!",
            "active": "&cVocê já tem um limpador ativo. Aguarde a conclusão para usar outro!",
            "schematic-active": "&cVocê tem uma Schematic sendo aplicada. Aguarde a conclusão para usar o limpador!",
            "empty": "&cEste terreno não tem blocos para limpar!",
            "cancelled": "&cLimpeza cancelada!",
            "started": "&aLimpeza iniciada com sucesso!",
            "missing": "&cO Limpador precisa estar no seu inventário quando você confirma.",
            "save-failed": "&cOcorreu um erro ao iniciar a limpeza. O item não foi consumido.",
            // No criativo o cliente clona o item com o mesmo lote (a regra 23 de segurança).
            "creative": "&cVocê não pode usar o Limpador no modo criativo.",
            // A resposta do banco se perdeu e ninguém sabe se a limpeza começou: o item não volta sozinho.
            "unknown": "&cNão deu para confirmar se a limpeza do terreno {plot} &ccomeçou. A equipe foi avisada e vai conferir o seu Limpador.",
            "failed": "&cOcorreu um erro inesperado. Contate um administrador."
          }
        }
      },
      // O progresso do Limpador: a actionbar do dono, o holograma na entrada do terreno e o title do fim. A barra tem 10
      // partes, uma verde a cada 10%, e a porcentagem tem a cor da faixa (no limite exato vale a de cima). O desenho é o da
      // Schematic do Plot (o pedido do dono de 20/11: "trocar o holograma e a actionbar do limpador para este novo formato").
      "cleaner": {
        "actionbar": "&e&lLIMPADOR ATIVO &8({bar}&8) &f- {percent}",
        "hologram": [
          "&e&lLIMPADOR ATIVO",
          "&7Dono: {owner_name_with_color}",
          "&7B. Quebrados: &f{done}/{total}",
          "&8({bar}&8) &f- {percent}"
        ],
        "bar": { "done": "&a▬", "left": "&7▬" },
        "colors": { "0": "&4", "10": "&c", "30": "&6", "40": "&e", "60": "&a", "80": "&2" },
        "title": "&e&lLIMPEZA FINALIZADA",
        "subtitle": ""
      },
      "preferences": {
        "cleaner-actionbar": {
          "name": "&eProgresso do Limpador e da Schematic",
          "description": [
            "&7Mostra na actionbar o progresso",
            "&7do seu Limpador de Terrenos e",
            "&7da sua Schematic do Plot.",
            "&7O mesmo que o /cp actionbar."
          ]
        }
      },
      // A Schematic do Plot (o documento do dono de 20/11/2026, com os baús do Kekitoox no rankup-plots-1): o item, as linhas
      // dos blocos, os nomes dos blocos (os do baú, em inglês, com o id), as mensagens dos menus e do uso, e o progresso,
      // no desenho que o dono mandou (o holograma e a actionbar da imagem).
      "schematic": {
        "units": {
          "block": { "singular": "bloco", "plural": "blocos" }
        },
        // Cada parte com as preposições das mensagens: "Você adicionou X às paredes", "das paredes", "nas paredes".
        "parts": {
          "walls": { "name": "Paredes", "to": "às paredes", "from": "das paredes", "in": "nas paredes" },
          "floor": { "name": "Chão", "to": "ao chão", "from": "do chão", "in": "no chão" },
          "ceiling": { "name": "Teto", "to": "ao teto", "from": "do teto", "in": "no teto" },
          "dome": { "name": "Cúpula", "to": "à cúpula", "from": "da cúpula", "in": "na cúpula" }
        },
        // O {sections} são as partes, cada uma com o título, os blocos e uma linha vazia (o "lines" de baixo). O "confirm" é
        // o item de baixo do menu principal, que finaliza.
        "item": {
          "display-name": "&dSchematic do Plot",
          "name": "&dSchematic do Plot",
          "lore": {
            "open": ["&7Esse item guarda os blocos da Schematic:", "&7", "{sections}", "&dClique com o botão direito para configurar!"],
            "finished": ["&7Esse item guarda os blocos da Schematic:", "&7", "{sections}", "&dClique com o botão direito dentro do seu terreno para usar!", "&8(Ação com confirmação e irreversível)"],
            "confirm": ["&7Esse item guarda os blocos da Schematic:", "&7", "{sections}", "&aClique para confirmar a configuração!", "&8(Ação com confirmação e irreversível)"]
          }
        },
        "lines": {
          "blank": ["&8 ▶ &cSem configuração atualmente", "&7"],
          "title": "&d {part} ({count})",
          "space": "&7",
          "block": "&8 &8 ▶ &f{block} &7({id})",
          "copy": {
            "walls": "&8 &8 ▶ &fBlocos da cúpula",
            "floor": "&8 &8 ▶ &fBlocos das paredes"
          },
          "empty": {
            "walls": "&8 &8 ▶ &cSem paredes",
            "floor": "&8 &8 ▶ &cSem chão",
            "ceiling": "&8 &8 ▶ &cSem teto",
            "dome": "&8 &8 ▶ &cSem cúpula"
          },
          "top-closed": "&8 &8 ▶ &fTopo fechado"
        },
        // Os nomes dos blocos, pelo id e o dado do config (35-14 é o 35:14). Bloco novo no config precisa do nome aqui.
        "blocks": {
          "35-0": "White Wool", "35-1": "Orange Wool", "35-2": "Magenta Wool", "35-3": "Light Blue Wool",
          "35-4": "Yellow Wool", "35-5": "Lime Wool", "35-6": "Pink Wool", "35-7": "Gray Wool",
          "35-8": "Light Gray Wool", "35-9": "Cyan Wool", "35-10": "Purple Wool", "35-11": "Blue Wool",
          "35-12": "Brown Wool", "35-13": "Green Wool", "35-14": "Red Wool", "35-15": "Black Wool",
          "155-0": "Quartz Block", "87": "Netherrack", "112": "Nether Brick", "80": "Snow Block",
          "20": "Glass",
          "95-0": "White Glass", "95-1": "Orange Glass", "95-2": "Magenta Glass", "95-3": "Light Blue Glass",
          "95-4": "Yellow Glass", "95-5": "Lime Glass", "95-6": "Pink Glass", "95-7": "Gray Glass",
          "95-8": "Light Gray Glass", "95-9": "Cyan Glass", "95-10": "Purple Glass", "95-11": "Blue Glass",
          "95-12": "Brown Glass", "95-13": "Green Glass", "95-14": "Red Glass", "95-15": "Black Glass"
        },
        "messages": {
          "added": "&aVocê adicionou {block} {part_to}.",
          "removed": "&eVocê removeu {block} {part_from}.",
          "limit": "&cVocê atingiu o limite de {limit} {blocks} {part_in}. Remova um para adicionar outro.",
          "ceiling-with-dome": "&cNão é possível ter teto e cúpula ao mesmo tempo.",
          "copy-needs-dome": "&cConfigure a cúpula antes de usar a opção de paredes iguais à cúpula.",
          "copy-needs-walls": "&cConfigure as paredes antes de usar a opção de chão igual às paredes.",
          "copy-walls-copying": "&cO chão não pode copiar as paredes enquanto elas usam os blocos da cúpula.",
          "top-needs-dome": "&cEscolha os vidros da cúpula antes de fechar o topo.",
          "already-walls": "&eAs paredes já usam os blocos da cúpula.",
          "already-floor": "&eO chão já usa os blocos das paredes.",
          "copied-walls": "&aAs paredes agora usam os blocos da cúpula.",
          "copied-floor": "&aO chão agora usa os blocos das paredes.",
          "top-closed": "&aA cúpula vai fechar em cima, na última camada.",
          "top-opened": "&eA cúpula vai ficar aberta em cima.",
          "finalized-now": "&aSua Schematic do Plot foi finalizada! Use-a dentro do seu terreno.",
          "needs-structure": "&cÉ preciso ter paredes ou cúpula. Configure pelo menos uma delas.",
          "part-confirmed": "&aA configuração {part_from} foi confirmada.",
          "saved": "&7Sua configuração foi guardada no item.",
          "moved": "&cA Schematic saiu do lugar onde você a abriu. Pegue ela na mão e abra de novo.",
          "invalid": "&cEsta Schematic tem uma configuração que não vale mais. Contate a staff.",
          "finalized": "&cEsta Schematic já foi finalizada e não pode mais ser configurada.",
          // O que saiu junto com uma escolha.
          "cleared": {
            "ceiling": "&eO teto foi removido, porque não é possível ter teto e cúpula ao mesmo tempo.",
            "walls-copy": "&eAs paredes deixaram de usar os blocos da cúpula.",
            "floor-copy": "&eO chão deixou de usar os blocos das paredes.",
            "dome-top": "&eSem vidros na cúpula, o topo voltou a ficar aberto."
          },
          "world": "&cVocê só pode usar a Schematic no servidor dos terrenos, dentro do seu terreno.",
          "outside": "&cVocê só pode usar a Schematic dentro do seu terreno.",
          "not-yours": "&cEste terreno não é seu.",
          "active": "&cVocê já tem uma Schematic sendo aplicada. Aguarde a conclusão para usar outra!",
          "cleaner-active": "&cVocê tem um limpador ativo. Aguarde a conclusão para usar a Schematic!",
          "cancelled": "&eAção cancelada. Sua Schematic não foi usada.",
          // O que a construção não destrói barra o começo, e o item fica com o jogador (a resposta do dono, 20/11).
          "blocked-spawner": "&cHá um spawner em {x}, {y}, {z}, onde a Schematic vai construir. Retire-o pelo menu do spawner antes de usá-la.",
          "blocked-container": "&cHá um bloco com itens em {x}, {y}, {z}, onde a Schematic vai construir. Tire os itens dele antes de usá-la.",
          "blocked-frame": "&cHá uma moldura com item em {x}, {y}, {z}, onde a Schematic vai construir. Tire o item dela antes de usá-la.",
          "spawners": "&cHá um spawner onde a Schematic vai construir. Retire-o pelo menu do spawner antes de usá-la.",
          "empty": "&cSeu terreno já está com essa Schematic, e não há nada para construir.",
          "started": "&aA Schematic está sendo aplicada ao seu terreno.",
          "missing": "&cA Schematic precisa estar no seu inventário quando você confirma.",
          "save-failed": "&cOcorreu um erro ao iniciar a Schematic. O item não foi consumido.",
          // No criativo o cliente escreve o NBT que quiser e clona o item (a regra 23 de segurança): nem configura nem usa.
          "creative": "&cVocê não pode configurar nem usar a Schematic no modo criativo.",
          // A resposta do banco se perdeu e ninguém sabe se a construção começou: o item não volta sozinho.
          "unknown": "&cNão deu para confirmar se a Schematic do terreno {plot} &ccomeçou. A equipe foi avisada e vai conferir a sua Schematic.",
          "failed": "&cOcorreu um erro inesperado. Contate um administrador."
        },
        // O progresso, com o desenho da imagem do dono: a actionbar do dono, o holograma na entrada do terreno e o title do fim.
        "progress": {
          "actionbar": "&d&lSCHEMATIC ATIVA &8({bar}&8) &f- {percent}",
          "hologram": [
            "&d&lSCHEMATIC ATIVA",
            "&7Dono: {owner_name_with_color}",
            "&7B. Colocados: &f{done}/{total}",
            "&8({bar}&8) &f- {percent}"
          ],
          "bar": { "done": "&a▬", "left": "&7▬" },
          "colors": { "0": "&4", "10": "&c", "30": "&6", "40": "&e", "60": "&a", "80": "&2" },
          "title": "&d&lSCHEMATIC APLICADA",
          "subtitle": ""
        }
