        "sell": {
          "title": "Vender Terreno #{index}",
          "items": {
            "currency": {
              "cash": {
                "name": "&6Cash",
                "lore": ["&7", "&7 Escolha a economia para vender!", "&7 Atual: &6Cash", "&7", "&6Clique para alterar!"]
              },
              "tokens": {
                "name": "&eTokens",
                "lore": ["&7", "&7 Escolha a economia para vender!", "&7 Atual: &eTokens", "&7", "&eClique para alterar!"]
              }
            },
            "offers": {
              "on": {
                "name": "&aOfertas",
                "lore": ["&7", "&7 Escolha se quer ativar ou desativar", "&7 as ofertas de outros jogadores!", "&7", "&7 Ofertas: &aLigadas"]
              },
              "off": {
                "name": "&cOfertas",
                "lore": ["&7", "&7 Escolha se quer ativar ou desativar", "&7 as ofertas de outros jogadores!", "&7", "&7 Ofertas: &cDesligadas"]
              }
            },
            "confirm": {
              "name": "&aConfirmar",
              "lore": ["&7", "&7 Depois digite o valor no chat e", "&7 confirme, e o terreno entra", "&7 na Imobiliária."]
            }
          }
        },
        "market": {
          "title": "Imobiliária",
          "items": {
            "listing": {
              "offers-on": {
                "name": "&6Terreno de {seller_name}",
                "lore": ["&7", "&7 Economia: {currency_icon}", "&7 Valor: &f{price}", "&7 ID: &f{id}", "&7 Ofertas: &aLigadas", "&7", "&fBotão Esquerdo &7para visitar esse terreno!", "&fBotão Direito &7para comprar esse terreno!"]
              },
              "offers-off": {
                "name": "&6Terreno de {seller_name}",
                "lore": ["&7", "&7 Economia: {currency_icon}", "&7 Valor: &f{price}", "&7 ID: &f{id}", "&7 Ofertas: &cDesligadas", "&7", "&fBotão Esquerdo &7para visitar esse terreno!", "&fBotão Direito &7para comprar esse terreno!"]
              },
              // No alto da confirmação de compra: o valor exato, com o símbolo, e sem as linhas de clique.
              "preview": {
                "name": "&6Terreno de {seller_name}",
                "lore": ["&7", "&7 Valor: {price}", "&7 ID: &f{id}"]
              }
            },
            "offers": {
              "name": "&3Ofertas",
              "lore": ["&7", "&7Clique para ver as ofertas", "&7que deram nos seus terrenos!"]
            }
          }
        },
        "buy": {
          "title": "Comprar ou ofertar",
          "items": {
            "buy": {
              "name": "&aComprar",
              "lore": ["&7", "&7Clique para comprar esse terreno diretamente!"]
            },
            "offer": {
              "name": "&eOfertar",
              "lore": ["&7", "&7Clique para oferecer uma quantia nesse terreno!", "&7A oferta mínima é {minimum}&7."]
            }
          }
        },
        "offers": {
          "title": "Ofertas recebidas",
          "items": {
            "offer": {
              "low": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Economia: {currency_icon}", "&7 Oferta: &f{amount}", "&7 Valor: &c{percent}%", "&7", "&7Clique para avaliar essa oferta!"]
              },
              "mid": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Economia: {currency_icon}", "&7 Oferta: &f{amount}", "&7 Valor: &e{percent}%", "&7", "&7Clique para avaliar essa oferta!"]
              },
              "high": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Economia: {currency_icon}", "&7 Oferta: &f{amount}", "&7 Valor: &a{percent}%", "&7", "&7Clique para avaliar essa oferta!"]
              }
            },
            // No alto da avaliação: a oferta exata, com o símbolo, e sem a linha de clique.
            "preview": {
              "low": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Oferta: {amount}", "&7 Valor: &c{percent}%"]
              },
              "mid": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Oferta: {amount}", "&7 Valor: &e{percent}%"]
              },
              "high": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Oferta: {amount}", "&7 Valor: &a{percent}%"]
              }
            }
          }
        },
        "confirmation": {
          "items": {
            "accept": { "name": "&aConfirmar", "lore": [] },
            "deny": { "name": "&cRecusar", "lore": [] }
          },
          "clear": {
            "title": "Limpar o terreno?",
            "name": "&8Limpar o terreno {plot}",
            "lore": ["&7", "&7 Tudo o que está no terreno some,", "&7 e ele volta ao ponto inicial.", "&7 Essa ação é irreversível!"]
          },
          "delete": {
            "title": "Excluir o terreno?",
            "name": "&cExcluir o terreno {plot}",
            "lore": ["&7", "&7 O terreno é limpo e deixa de", "&7 ser seu, com tudo o que tem nele.", "&7 Essa ação é irreversível!"]
          },
          // O título do inventário no 1.8 tem teto de 32 caracteres, então o valor vai no item, e não no título.
          "list": {
            "title": "Anunciar o terreno?",
            "name": "&2Anunciar o terreno {plot}",
            "lore": ["&7", "&7 Valor: {value}", "&7 Ofertas: {offers}", "&7", "&7 Confira o valor antes de confirmar.", "&7 O terreno entra na Imobiliária", "&7 exatamente por ele."],
            "offers-on": "&aLigadas",
            "offers-off": "&cDesligadas"
          },
          "offer-send": {
            "title": "Enviar a oferta?",
            "name": "&eOfertar pelo terreno {plot}",
            "lore": ["&7", "&7 Oferta: {value}", "&7 Preço: {price}", "&7", "&7 Confira o valor antes de confirmar.", "&7 Ele é cobrado quando o vendedor", "&7 aceitar a oferta."]
          },
          "unlist": {
            "title": "Cancelar a venda?",
            "name": "&2Cancelar a venda do terreno {plot}",
            "lore": ["&7", "&7 O terreno sai da Imobiliária, e", "&7 as ofertas por ele são canceladas."]
          },
          "purchase": {
            "title": "Comprar o terreno?"
          },
          "offer": {
            "title": "Avaliar a oferta",
            "items": {
              "accept": {
                "name": "&aAceitar",
                "lore": ["&7", "&7 O comprador paga a oferta,", "&7 e o terreno passa para ele."]
              },
              "deny": {
                "name": "&cRecusar",
                "lore": ["&7", "&7 A oferta sai, e o comprador", "&7 recebe um aviso."]
              }
            }
          }
        }
      }
    }
  }
}
