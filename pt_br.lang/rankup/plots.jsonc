                  "&7",
                  "&7Extras:",
                  "&7",
                  "&8 ▶ &fNão é possível ter teto e cúpula simultaneamente",
                  "&8 ▶ &fA cúpula pode tomar o lugar das paredes mas não ao contrário",
                  "&8 ▶ &fNão é possível não ter paredes e cúpula simultaneamente",
                  "&8 ▶ &fÉ possível ter apenas paredes e apenas cúpula",
                  "&7",
                  "&eQualquer dúvida, contate um staff para suporte!"
                ]
              },
              "walls": {
                "name": "&9Paredes",
                "lore": ["&7As paredes são a borda do seu plot", "&7das camadas 1 à 65, antes da cúpula.", "&7", "&9 Paredes Atuais ({count})", "&7", "{blocks}", "&7", "&9Clique para configurar as paredes!"]
              },
              "floor": {
                "name": "&9Chão",
                "lore": ["&7O chão cobre toda a camada 1 do", "&7seu plot, excluindo as bordas.", "&7", "&9 Chão Atual ({count})", "&7", "{blocks}", "&7", "&9Clique para configurar o chão!"]
              },
              "ceiling": {
                "name": "&9Teto",
                "lore": ["&7O teto é usado quando não há cúpula e", "&7cobre a camada 65, excluindo as bordas.", "&7", "&9 Teto Atual ({count})", "&7", "{blocks}", "&7", "&9Clique para configurar o teto!"]
              },
              "ceiling-unavailable": {
                "name": "&9Teto",
                "lore": ["&7O teto é usado quando não há cúpula e", "&7cobre a camada 65, excluindo as bordas.", "&7", "&cCúpula ativada, teto indisponível!"]
              },
              "dome": {
                "name": "&9Cúpula",
                "lore": ["&7A cúpula é a borda do seu plot das", "&7camadas 66 à 255, depois das paredes.", "&7", "&9 Cúpula Atual ({count})", "&7", "{blocks}", "&7", "&9Clique para configurar a cúpula!"]
              }
            }
          },
          "walls": {
            "title": "Paredes",
            "items": {
              "free": {
                "configure": { "name": "&9Paredes", "lore": ["&7Escolha os blocos das paredes", "&7até esgotar o limite predefinido.", "&7", "&eClique para configurar os blocos!"] },
                "activate": { "name": "&9Paredes", "lore": ["&7Escolha os blocos das paredes", "&7até esgotar o limite predefinido.", "&7", "&aClique para ativar essa configuração!"] }
              },
              "copy": {
                "activate": { "name": "&9Paredes", "lore": ["&7Use a mesma configuração da cúpula.", "&7", "&aClique para ativar essa configuração!"] },
                "active": { "name": "&9Paredes", "lore": ["&7Use a mesma configuração da cúpula.", "&7", "&eVocê tem essa configuração ativa!"] },
                "unavailable": { "name": "&9Paredes", "lore": ["&7Use a mesma configuração da cúpula.", "&7", "&cConfigure primeiro a cúpula para ativar!"] }
              }
            }
          },
          "floor": {
            "title": "Chão",
            "items": {
              "free": {
                "configure": { "name": "&9Chão", "lore": ["&7Escolha os blocos do chão até", "&7esgotar o limite predefinido.", "&7", "&eClique para configurar os blocos!"] },
                "activate": { "name": "&9Chão", "lore": ["&7Escolha os blocos do chão até", "&7esgotar o limite predefinido.", "&7", "&aClique para ativar essa configuração!"] }
              },
              "copy": {
                "activate": { "name": "&9Chão", "lore": ["&7Use a mesma configuração das paredes.", "&7", "&aClique para ativar essa configuração!"] },
                "active": { "name": "&9Chão", "lore": ["&7Use a mesma configuração das paredes.", "&7", "&eVocê tem essa configuração ativa!"] },
                "unavailable": { "name": "&9Chão", "lore": ["&7Use a mesma configuração das paredes.", "&7", "&cConfigure primeiro as paredes para ativar!"] },
                // As paredes iguais à cúpula não emprestam os vidros ao chão (o documento).
                "walls-copying": { "name": "&9Chão", "lore": ["&7Use a mesma configuração das paredes.", "&7", "&cIndisponível com as paredes iguais à cúpula!"] }
              }
            }
          },
          // As informações de cada parte. O {limit} da cópia é 1, porque ela conta como 1 de 1.
          "info": {
            "name": "&eInformações",
            "lore": ["&7Veja as informações {part_from}:", "&7", "&8 ▶ &7Configuração: &f{mode}", "&8 ▶ &7Blocos: &f{count} de {limit}", "&8 ▶ &7Status: {status}", "&7", "&eClique para confirmar a configuração!"],
            "modes": { "none": "Nenhuma", "free": "Livre", "only": "Apenas e Livre", "copy-walls": "Cúpula", "copy-floor": "Paredes" },
            "status": { "inactive": "&cInativo", "building": "&eEm Construção", "complete": "&aCompleto" },
            "top": { "open": "Aberto", "closed": "Fechado" }
          },
          "info-dome": {
            "name": "&eInformações",
            "lore": ["&7Veja as informações {part_from}:", "&7", "&8 ▶ &7Configuração: &f{mode}", "&8 ▶ &7Blocos: &f{count} de {limit}", "&8 ▶ &7Topo: &f{top}", "&8 ▶ &7Status: {status}", "&7", "&eClique para confirmar a configuração!"]
          },
          "blocks": {
            "title": "Blocos {part_from}",
            "items": {
              // O bloco fica com o nome do jogo; só a descrição diz o estado, e o ativado brilha.
              "block": {
                "available": ["&eClique para ativar esse bloco!"],
                "selected": ["&aVocê tem esse bloco ativado!"],
                "full": ["&cRemova algum bloco antes para ativar!"]
              },
              // O topo da cúpula, a escolha do jogador (a resposta do dono, 20/11).
              "top": {
                "open": { "name": "&9Topo da Cúpula", "lore": ["&7Escolha se a cúpula fecha em cima,", "&7na última camada.", "&7", "&8 ▶ &7Topo: &fAberto", "&7", "&eClique para fechar o topo!"] },
                "closed": { "name": "&9Topo da Cúpula", "lore": ["&7Escolha se a cúpula fecha em cima,", "&7na última camada.", "&7", "&8 ▶ &7Topo: &fFechado", "&7", "&eClique para abrir o topo!"] },
                "unavailable": { "name": "&9Topo da Cúpula", "lore": ["&7Escolha se a cúpula fecha em cima,", "&7na última camada.", "&7", "&cEscolha os vidros da cúpula antes!"] }
              }
            }
          },
          "glass": {
            "title": "Vidros {part_from}"
          }
        },
        "confirmation": {
          "items": {
            "accept": { "name": "&aConfirmar", "lore": [] },
            "deny": { "name": "&cRecusar", "lore": [] }
          },
          "clear": {
            "title": "Limpar o terreno?",
            "name": "&8Limpar o terreno {plot}",
            "lore": ["&7", "&7 Tudo o que está no terreno some,", "&7 e ele volta ao ponto inicial.", "&7 Essa ação é irreversível!"]
          },
          // O Limpador de Terrenos, que tira só a terra e a grama (o "clear" de cima é o Limpar do menu, que reinicia).
          "cleaner": {
            "title": "Usar o Limpador de Terrenos?",
            "name": "&eLimpar o terreno {plot}",
            "lore": ["&7", "&7 Toda a terra e a grama do terreno", "&7 somem, da bedrock até o topo.", "&7 O resto fica onde está.", "&7", "&7 O Limpador é gasto ao confirmar."]
          },
          // A Schematic do Plot: usar no terreno, e o finalizar do menu principal.
          "schematic": {
            "title": "Usar a Schematic do Plot?",
            "name": "&dAplicar a Schematic no terreno {plot}",
            "lore": ["&7", "&7 As paredes, o chão, o teto e a cúpula", "&7 escolhidos são construídos no terreno.", "&7 Os blocos que estiverem no caminho", "&7 são substituídos e se perdem.", "&7", "&7 A Schematic é gasta ao confirmar.", "&7 Essa ação é irreversível!"]
          },
          "schematic-finish": {
            "title": "Finalizar a Schematic?",
            "name": "&aFinalizar a Schematic do Plot",
            "lore": ["&7", "&7 Depois de confirmar, você não pode", "&7 mais configurar esta Schematic.", "&7", "&7 Ela passa a ser usada com o botão", "&7 direito dentro do seu terreno."]
          },
          // O /plot clear da equipe, em pé no terreno de outro jogador.
          "staff-clear": {
            "title": "Limpar o terreno?",
            "name": "&8Limpar o terreno {plot} &8de {owner_name_with_color}",
            "lore": ["&7", "&7 Tudo o que está no terreno some,", "&7 e ele volta ao ponto inicial.", "&7 Se estiver à venda, o anúncio sai.", "&7 O dono recebe um aviso.", "&7 Essa ação é irreversível!"]
          },
          "delete": {
            "title": "Excluir o terreno?",
            "name": "&cExcluir o terreno {plot}",
            "lore": ["&7", "&7 O terreno é limpo e deixa de", "&7 ser seu, com tudo o que tem nele.", "&7 Essa ação é irreversível!"]
          },
          // O título do inventário no 1.8 tem teto de 32 caracteres, então o valor vai no item, e não no título.
          "list": {
            "title": "Anunciar o terreno?",
            "name": "&2Anunciar o terreno {plot}",
            "lore": ["&7", "&7 Valor: {value}", "&7 Ofertas: {offers}", "&7", "&7 Confira o valor antes de confirmar.", "&7 O terreno entra na Imobiliária", "&7 exatamente por ele."],
            "offers-on": "&aLigadas",
            "offers-off": "&cDesligadas"
          },
          "offer-send": {
            "title": "Enviar a oferta?",
            "name": "&eOfertar pelo terreno {plot} &ede {seller_name_with_color}",
            "lore": ["&7", "&7 Oferta: {value}", "&7 Preço: {price}", "&7", "&7 Confira o valor antes de confirmar.", "&7 Ele é cobrado quando o vendedor", "&7 aceitar a oferta."]
          },
          "unlist": {
            "title": "Cancelar a venda?",
            "name": "&2Cancelar a venda do terreno {plot}",
            "lore": ["&7", "&7 O terreno sai da Imobiliária, e", "&7 as ofertas por ele são canceladas."]
          },
          "purchase": {
            "title": "Comprar o terreno?"
          },
          "offer": {
            "title": "Avaliar a oferta",
            "items": {
              "accept": {
                "name": "&aAceitar",
                "lore": ["&7", "&7 O comprador paga a oferta,", "&7 e o terreno passa para ele."]
              },
              "deny": {
                "name": "&cRecusar",
                "lore": ["&7", "&7 A oferta sai, e o comprador", "&7 recebe um aviso."]
              }
            }
          }
        }
      }
    }
  }
