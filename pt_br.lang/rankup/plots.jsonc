// Os terrenos do rankup (08/11/2026). Os itens dos menus seguem os baús de referência do dono no mundo teste do rankup-1,
// com o texto passado para o português do Brasil. As texturas das cabeças ficam no plugin (PlotItems).
{
  "plugins": {
    "plots": {
      "units": {
        "plot": { "singular": "terreno", "plural": "terrenos" },
        "player": { "singular": "jogador", "plural": "jogadores" },
        "notice": { "singular": "aviso", "plural": "avisos" }
      },
      "roles": {
        "none": "Nenhuma",
        "trusted": "Confiável",
        "added": "Adicionado",
        "denied": "Negado"
      },
      "commands": {
        "plot": {
          "description": "abrir o menu dos terrenos",
          "add": {
            "description": "deixar um jogador farmar no seu terreno",
            "arguments": { "target": { "name": "jogador", "description": "Jogador que vai poder farmar" } }
          },
          "remove": {
            "description": "tirar um jogador da lista do seu terreno",
            "arguments": { "target": { "name": "jogador", "description": "Jogador que sai da lista" } }
          },
          "trust": {
            "description": "deixar um jogador fazer tudo no seu terreno",
            "arguments": { "target": { "name": "jogador", "description": "Jogador de confiança" } }
          },
          "untrust": {
            "description": "tirar a confiança de um jogador",
            "arguments": { "target": { "name": "jogador", "description": "Jogador que deixa de ser confiável" } }
          },
          "deny": {
            "description": "impedir um jogador de entrar no seu terreno",
            "arguments": { "target": { "name": "jogador", "description": "Jogador que não vai poder entrar" } }
          },
          "allow": {
            "description": "liberar a entrada de um jogador negado",
            "arguments": { "target": { "name": "jogador", "description": "Jogador que volta a poder entrar" } }
          },
          "members": {
            "description": "abrir o menu dos membros e das permissões do seu terreno"
          },
          "claim": {
            "description": "pegar o terreno livre onde você está"
          },
          "auto": {
            "description": "adquirir o terreno livre mais perto do centro"
          },
          "clear": {
            "description": "limpar o terreno onde você está, ou o único que você tem, de volta ao ponto inicial"
          },
          "dispose": {
            "description": "excluir o terreno onde você está, ou o único que você tem"
          },
          "home": {
            "description": "ir até o seu terreno, ou visitar o de outro jogador (o /plot h:2 leva ao seu terreno #2)",
            "arguments": { "target": { "name": "posição ou jogador", "description": "A posição do terreno no menu, o nick de quem você quer visitar, ou o nick com a posição (Shawzyy:2)" } }
          },
          // O /plot info: o terreno onde o jogador está, ou o dele fora de um terreno. Cada nick da lista sai na cor do
          // papel, como no menu de membros, e os nicks de um papel são separados pelo "separator".
          "info": {
            "description": "ver o dono, os membros e a venda do terreno onde você está",
            "lines": [
              "",
              "&eTerreno {plot} &ede {owner_name_with_color}",
              "&7 Nome: &f{name}",
              "&7 Confiáveis: {trusted}",
              "&7 Adicionados: {added}",
              "&7 Negados: {denied}",
              "&7 Sem permissão: {none}",
              "&7 Situação: {sale}",
              ""
            ],
            "member": {
              "none": "&f{target_name}",
              "trusted": "&a{target_name}",
              "added": "&e{target_name}",
              "denied": "&c{target_name}"
            },
            "separator": "&7, ",
            "nobody": "&7ninguém",
            "no-name": "Nenhum",
            "sale": {
              "none": "&fNão está à venda",
              "listed": "&6À venda por {value}"
            },
            "free": "&eEste terreno está livre. Use /plot claim para pegar ele."
          }
        },
        "imobiliaria": {
          "description": "abrir a Imobiliária dos terrenos"
        },
        // O /clearplot e o /cp, do Limpador de Terrenos.
        "clearplot": {
          "description": "ver os comandos do Limpador de Terrenos",
          "give": {
            "description": "entregar Limpadores de Terrenos a um jogador",
            "arguments": {
              "target": { "name": "jogador", "description": "Jogador que recebe, neste servidor" },
              "amount": { "name": "quantidade", "description": "Quantos Limpadores, de 1 a 36" }
            }
          },
          "actionbar": {
            "description": "mostrar ou esconder o progresso do Limpador na actionbar"
          }
        }
      },
      "messages": {
        "no-permission": "&cVocê não tem permissão para fazer isto neste terreno.",
        "loading": "&cOs terrenos ainda estão carregando. Tente de novo em instantes.",
        "denied-entry": "&cVocê foi impedido de entrar neste terreno.",
        "resetting-entry": "&cEste terreno está sendo limpo. Espere a limpeza terminar para entrar.",
        "cleaning": "&cO Limpador está tirando a terra deste terreno. Espere a limpeza terminar para mexer nele.",
        "cleaner-given": "&aEntregado &eLimpador de Terreno &7[&f{amount}x&7] &aao jogador {target_name_with_color}",
        "cleaner-received": "&aRecebido &eLimpador de Terreno &7[&f{amount}x&7] &acom sucesso!",
        "cleaner-full": "&cO inventário de {target_name_with_color} &cnão tem espaço para &eLimpador de Terreno &7[&f{amount}x&7]&c, e nada foi entregue.",
        "cleaner-elsewhere": "&c{target_name_with_color} &cnão está neste servidor. O Limpador é entregue no servidor onde o jogador está.",
        "cleaner-amount": "&cQuantidade inválida. Use um número inteiro de 1 a {max}!",
        "cleaner-actionbar-on": "&aAs mensagens do limpador na actionbar foram ativadas!",
        "cleaner-actionbar-off": "&cAs mensagens do limpador na actionbar foram desativadas!",
        "cleaner-actionbar-failed": "&cNão foi possível salvar a sua escolha agora. Tente de novo em instantes.",
        "server-offline": "&cO servidor de terrenos está indisponível agora. Tente de novo daqui a pouco.",
        "storage-soon": "&eO armazém ainda está em construção e chega junto com as plantações.",
        "no-plot": "&cVocê ainda não tem terreno. Use /plot para adquirir um.",
        "choose-plot": "&cVocê tem mais de um terreno. Entre no terreno que você quer, ou use o menu do /plot.",
        "no-such-plot": "&cVocê não tem o terreno #{index}. Você tem {count} {unit}.",
        "target-no-plot": "&c{target_name_with_color} &cnão tem terreno.",
        "target-no-such-plot": "&c{target_name_with_color} &cnão tem o terreno #{index}, porque tem só {count} {unit}.",
        "claim-not-here": "&cFique dentro de um terreno livre, no servidor de terrenos, para pegar ele. Ou use o menu do /plot.",
        "claim-taken": "&cEsse terreno já tem dono.",
        "claim-own": "&cEsse terreno já é seu.",
        "claimed": "&aVocê adquiriu o terreno {plot}! Agora você tem {count} de {limit}.",
        "teleport-own": "&aIndo para o seu terreno {plot}&a.",
        "teleport": "&aIndo para o terreno {plot} &ade {owner_name_with_color}&a.",
        "limit": "&cVocê já tem {limit} {unit}, que é o limite.",
        "name-invalid": "&cEsse nome não vale. Use até {max} caracteres, entre letras, números, espaço, hífen e sublinhado, com pelo menos uma letra.",
        "not-owner": "&cO terreno {plot} &cnão é mais seu.",
        "renamed": "&aO terreno agora se chama {plot}&a.",
        "clear-started": "&eA limpeza do terreno {plot} &ecomeçou. Você recebe um aviso quando ela terminar.",
        "delete-started": "&eA exclusão do terreno {plot} &ecomeçou. Ele é limpo e sai da sua lista quando terminar.",
        "clear-requested": "&eA limpeza do terreno {plot} &efoi pedida ao servidor de terrenos. Você recebe um aviso quando ela terminar, ou se não puder começar.",
        "delete-requested": "&eA exclusão do terreno {plot} &efoi pedida ao servidor de terrenos. Você recebe um aviso quando ela terminar, ou se não puder começar.",
        "clear-not-yours": "&cEste terreno não é seu. Para limpar um terreno seu, entre nele ou use o menu do /plot.",
        "clear-outranked": "&cVocê não pode limpar o terreno de {owner_name_with_color}&c, porque o cargo do dono é igual ou maior que o seu.",
        "staff-clear-started": "&eA limpeza do terreno {plot} &ede {owner_name_with_color} &ecomeçou. Você recebe um aviso quando ela terminar.",
        "member-already": "&c{target_name_with_color} &cjá está na lista do terreno {plot}&c.",
        "member-none": "&a{target_name_with_color} &aentrou na lista do terreno {plot}&a, ainda sem permissão. Clique na cabeça dele para mudar.",
        "member-trusted": "&a{target_name_with_color} &aagora é confiável no terreno {plot}&a.",
        "member-added": "&a{target_name_with_color} &aagora pode farmar no terreno {plot}&a.",
        "member-denied": "&a{target_name_with_color} &anão pode mais entrar no terreno {plot}&a.",
        "member-unchanged": "&c{target_name_with_color} &cjá está com a permissão {role} &cno terreno {plot}&c.",
        "members-full": "&cA lista do terreno {plot} &cjá tem {max} {unit}, que é o máximo.",
        "member-absent": "&c{target_name_with_color} &cnão está na lista do terreno {plot}&c.",
        "member-not-trusted": "&c{target_name_with_color} &cnão é confiável no terreno {plot}&c.",
        "member-not-denied": "&c{target_name_with_color} &cnão está negado no terreno {plot}&c.",
        "member-removed": "&a{target_name_with_color} &asaiu da lista do terreno {plot}&a.",
        "price-too-high": "&cEsse valor passa do máximo desta moeda, que é {max}&c.",
        "price-invalid": "&c\"{typed}\" não é um valor válido. Digite o número sem pontos, como 1000, ou com a letra do milhar, como 50K ou 2.5M.",
        "listed": "&aO terreno {plot} &afoi anunciado na Imobiliária por {value}&a.",
        "unlisted": "&aO terreno {plot} &asaiu da Imobiliária, e as ofertas por ele foram canceladas.",
        "trade-busy": "&cHá uma compra do terreno {plot} &cem andamento. Tente de novo em instantes.",
        "offer-sent": "&aSua oferta de {value} &apelo terreno {plot} &ade {seller_name_with_color} &afoi enviada.",
        "offer-gone": "&cEste terreno não está mais disponível.",
        "offer-busy": "&cHá uma compra deste terreno em andamento. Tente ofertar de novo em instantes.",
        "deny-gone": "&cEssa oferta não está mais de pé.",
        "offer-closed": "&cO vendedor não está aceitando ofertas por este terreno.",
        "offer-own": "&cEste terreno é seu.",
        "offer-too-low": "&cA oferta mínima por este terreno é {minimum}&c.",
        "offer-too-high": "&cSua oferta chega ao preço do terreno ({price}&c). Compre direto pela Imobiliária.",
        "bought": "&aVocê comprou o terreno {plot} &ade {seller_name_with_color} &apor {value}&a! Agora ele é o seu terreno #{position}.",
        "bought-unplaced": "&aVocê comprou o terreno {plot} &ade {seller_name_with_color} &apor {value}&a! Ele já está no seu /plot.",
        "buy-no-funds": "&cVocê não tem saldo suficiente. O terreno custa {value}&c.",
        "buy-gone": "&cEste terreno não está mais disponível.",
        "buy-own": "&cEste terreno é seu.",
        "buy-limit": "&cVocê já tem {limit} {unit}, que é o limite.",
        "buy-busy": "&cOutro jogador está comprando este terreno agora.",
        "buy-processing": "&eO pagamento está demorando para confirmar. A compra termina sozinha, e você recebe um aviso.",
        "offer-accepted": "&aVocê aceitou a oferta de {value} &apelo terreno {plot}&a.",
        "accept-no-funds": "&cO comprador não tinha saldo para esta oferta de {value}&c, e a venda não aconteceu.",
        "accept-processing": "&eO pagamento do comprador está demorando para confirmar. Se a venda passar, você recebe o aviso de venda.",
        "accept-gone": "&cA oferta não está mais de pé, ou o terreno mudou. Nada foi vendido.",
        "accept-limit": "&cO comprador já chegou ao limite de terrenos, e a oferta foi retirada.",
        "offer-denied": "&aOferta recusada. O comprador foi avisado.",
        "notices": {
          "header": "&eVocê tem {count} {unit} de terreno.",
          "more": {
            "singular": "&7O aviso mais antigo ficou de fora.",
            "plural": "&7Os {count} avisos mais antigos ficaram de fora."
          }
        }
      },
      // O [plot] do chat: o terreno de quem escreveu, clicável. O texto vai no meio da mensagem e volta à cor dela depois.
      "chat": {
        "text": "&a[Terreno {plot} de {owner_name}]",
        "hover": ["&aTerreno {plot} &ade {owner_name_with_color}", "&7 Jogadores: &f{players}", "", "&fClique &7para visitar!"]
      },
      // O title de quem entra num terreno com dono. O Java manda o dono inteiro ({owner_*}) e o {name} do terreno, vazio quando ele não tem nome.
      "titles": {
        "entry": {
          "title": "&c&lEXE",
          "subtitle": "&7Terreno de {owner_name_with_color}"
        }
      },
      "notices": {
        "offer-received": "&e{player_name_with_color} &efez uma oferta de {value} &epelo terreno {plot}&e. Veja no /plot, em Imobiliária.",
        "offer-cancelled": "&cSua oferta pelo terreno {plot} &cde {player_name_with_color} &cfoi cancelada, porque o anúncio mudou ou saiu.",
        "offer-denied": "&cSua oferta de {value} &cpelo terreno {plot} &cde {player_name_with_color} &cfoi recusada.",
        "offer-sold": "&cO terreno {plot} &cde {player_name_with_color}&c, pelo qual você ofertou, foi vendido para outro jogador.",
        "sold": "&aSeu terreno {plot} &afoi vendido para {player_name_with_color} &apor {value}&a.",
        "offer-accepted": "&aSua oferta de {value} &apelo terreno {plot} &ade {player_name_with_color} &afoi aceita! Agora ele é o seu terreno #{position}.",
        "bought": "&aA compra do terreno {plot} &ade {player_name_with_color} &aterminou. Você pagou {value}&a, e agora ele é o seu terreno #{position}.",
        "failed": "&cA compra do terreno {plot} &cde {player_name_with_color} &cnão terminou, e nada foi cobrado.",
        // Os dois seguintes saem quando o terreno deixou de ser do vendedor antes de a compra terminar, e não há rótulo dele.
        "failed-gone": "&cA compra de um terreno de {player_name_with_color} &cnão terminou, e nada foi cobrado.",
        "refunded-gone": "&eA compra de um terreno de {player_name_with_color} &enão terminou, e o valor de {value} &efoi devolvido.",
        "refunded": "&eA compra do terreno {plot} &ede {player_name_with_color} &enão terminou, e o valor de {value} &efoi devolvido.",
        "no-funds": "&cA compra do terreno {plot} &cde {player_name_with_color} &cnão terminou, porque faltou saldo para {value}&c.",
        "offer-no-funds": "&cSua oferta de {value} &cpelo terreno {plot} &cde {player_name_with_color} &cfoi retirada, porque faltou saldo quando o dono aceitou.",
        "offer-limit": "&cSua oferta pelo terreno {plot} &cde {player_name_with_color} &cfoi retirada, porque você já chegou ao limite de terrenos.",
        "offer-withdrawn": "&cA oferta de {value} &cque {player_name_with_color} &cfez pelo terreno {plot} &cfoi retirada, porque faltou saldo ao comprador quando você aceitou.",
        "reset-busy": "&cO terreno {plot} &cjá está sendo limpo, ou tem uma compra em andamento. Tente de novo em instantes.",
        "reset-not-owner": "&cA limpeza não foi feita, porque o terreno não é mais seu.",
        "delete-busy": "&cO terreno {plot} &cnão foi excluído, porque está sendo limpo ou tem uma compra em andamento. Tente de novo em instantes.",
        "delete-not-owner": "&cA exclusão não foi feita, porque o terreno não é mais seu.",
        "delete-failed": "&cA exclusão do terreno {plot} &cfalhou. A equipe foi avisada, tente de novo mais tarde.",
        "cleared": "&aO terreno {plot} &afoi limpo.",
        // A limpeza que a equipe pede no terreno de outro (o /plot clear em pé nele): os avisos vão a quem pediu, com o
        // dono em {player_*}, e o dono recebe o "cleared-by-staff" (o "-listed" quando o terreno estava à venda).
        "staff-reset-not-owner": "&cA limpeza do terreno de {player_name_with_color} &cnão foi feita, porque o terreno mudou de dono.",
        "staff-reset-busy": "&cO terreno {plot} &cde {player_name_with_color} &cjá está sendo limpo, ou tem uma compra em andamento. Tente de novo em instantes.",
        "staff-reset-failed": "&cA limpeza do terreno de {player_name_with_color} &cfalhou, e o erro foi para o painel.",
        "staff-cleared": "&aO terreno {plot} &ade {player_name_with_color} &afoi limpo.",
        "cleared-by-staff": "&eSeu terreno {plot} &efoi limpo pela equipe e voltou ao ponto inicial.",
        "cleared-by-staff-listed": "&eSeu terreno {plot} &efoi limpo pela equipe e voltou ao ponto inicial. O anúncio dele saiu da Imobiliária, e as ofertas foram canceladas.",
        "cleaner-done": "&aA limpeza do terreno {plot} &afoi concluída com sucesso!",
        "cleaner-resumed": "&eA limpeza do terreno havia sido pausada devido a um reinício do servidor, a mesma foi retomada com sucesso!",
        "deleted": "&aO terreno {plot} &afoi excluído e está livre de novo.",
        "reset-failed": "&cA limpeza do terreno {plot} &cfalhou. A equipe foi avisada, tente de novo mais tarde."
      },
      // O Limpador de Terrenos (o pedido do dono de 09/11): o clique direito dentro do próprio terreno, no servidor de
      // terrenos, abre a confirmação, e confirmar tira toda a terra e a grama do terreno.
      "items": {
        "clear": {
          "display-name": "&eLimpador de Terrenos",
          "name": "&eLimpador de Terrenos",
          "lore": ["&7Esse item limpa seu plot até à bedrock,", "&7para usar, clique com o botão direito", "&7dentro de um terreno que seja seu!", "&7", "&8(Apenas as terras/gramas são eliminadas)"],
          "messages": {
            "world": "&cVocê não pode usar o limpador neste mundo!",
            "outside": "&cVocê precisa estar dentro de um terreno!",
            "not-yours": "&cEste terreno não é seu!",
            "active": "&cVocê já tem um limpador ativo. Aguarde a conclusão para usar outro!",
            "empty": "&cEste terreno não tem blocos para limpar!",
            "cancelled": "&cLimpeza cancelada!",
            "started": "&aLimpeza iniciada com sucesso!",
            "missing": "&cO Limpador precisa estar no seu inventário quando você confirma.",
            "save-failed": "&cOcorreu um erro ao iniciar a limpeza. O item não foi consumido.",
            "failed": "&cOcorreu um erro inesperado. Contate um administrador."
          }
        }
      },
      // O progresso do Limpador: a actionbar do dono, o holograma na entrada do terreno e o title do fim. A barra tem 10
      // partes, uma verde a cada 10%, e a porcentagem tem a cor da faixa (no limite exato vale a de cima).
      "cleaner": {
        "actionbar": "&e&lLIMPADOR ATIVO &8({bar}&8) &7- {percent}",
        "hologram": [
          "&e&lLIMPADOR ATIVO",
          "&7Dono: {owner_name_with_color}",
          "&7B. Quebrados: &f{done}/{total}",
          "&8({bar}&8) &f- {percent}"
        ],
        "bar": { "done": "&a▍", "left": "&7▍" },
        "colors": { "0": "&4", "10": "&c", "30": "&6", "40": "&e", "60": "&a", "80": "&2" },
        "title": "&e&lLIMPEZA FINALIZADA",
        "subtitle": ""
      },
      "preferences": {
        "cleaner-actionbar": {
          "name": "&eProgresso do Limpador",
          "description": [
            "&7Mostra na actionbar o progresso",
            "&7do seu Limpador de Terrenos.",
            "&7O mesmo que o /cp actionbar."
          ]
        }
      },
      "prompts": {
        "name": "Digite o nome do terreno (até {max} caracteres).",
        "player": "Digite o nick do jogador.",
        "price": {
          "cash": "Por quanto cash você quer vender o terreno {plot}?",
          "tokens": "Por quantos tokens você quer vender o terreno {plot}?"
        },
        "offer": "Quanto você oferece pelo terreno {plot} de {seller_name_with_color}&e? O preço é {price}&e, e a oferta mínima é {minimum}&e."
      },
      "views": {
        "main": {
          "title": "Terrenos",
          "items": {
            "my-plots": {
              "name": "&aMeus Terrenos",
              "lore": ["&7", "&7 Aqui você acessa seus", "&7 terrenos, configura as", "&7 permissões e muito mais!", "&7", "&eClique para acessar!"]
            },
            "real-estate": {
              "name": "&6Imobiliária",
              "lore": ["&7", "&7 Consulte os terrenos que estão", "&7 sendo vendidos, com opção de", "&7 comprar, vender e visitar!", "&7", "&6Clique para acessar a imobiliária!"]
            },
            "storage": {
              "name": "&eArmazém",
              "lore": ["&7", "&7 O armazém guarda todos", "&7 os drops de plantações!", "&7", "&eClique para acessar o armazém!"]
            }
          }
        },
        "list": {
          "title": "Meus Terrenos",
          "items": {
            "no-name": "Nenhum",
            "plot": {
              "name": "&aTerreno &l#{index}",
              "lore": ["&7", "&7 Jogadores: &f{players}", "&7 Nome: &f{name}", "&7", "&fBotão Esquerdo &7para se teleportar!", "&fBotão Direito &7para configurar o terreno!"]
            },
            "plot-listed": {
              "name": "&aTerreno &l#{index}",
              "lore": ["&7", "&7 Jogadores: &f{players}", "&7 Nome: &f{name}", "&7 Situação: &6À venda", "&7", "&fBotão Esquerdo &7para se teleportar!", "&fBotão Direito &7para configurar o terreno!"]
            },
            "acquire": {
              "low": {
                "name": "&2Adquirir um Terreno",
                "lore": ["&7", "&7 Ao clicar, você adquire um", "&7 novo terreno na hora!", "&7", "&fLimite de Terrenos (&a{count}/{limit}&f)"]
              },
              "mid": {
                "name": "&2Adquirir um Terreno",
                "lore": ["&7", "&7 Ao clicar, você adquire um", "&7 novo terreno na hora!", "&7", "&fLimite de Terrenos (&2{count}/{limit}&f)"]
              },
              "high": {
                "name": "&2Adquirir um Terreno",
                "lore": ["&7", "&7 Ao clicar, você adquire um", "&7 novo terreno na hora!", "&7", "&fLimite de Terrenos (&e{count}/{limit}&f)"]
              },
              "full": {
                "name": "&2Adquirir um Terreno",
                "lore": ["&7", "&7 Você chegou ao limite", "&7 de terrenos.", "&7", "&fLimite de Terrenos (&c{count}/{limit}&f)"]
              }
            }
          }
        },
        "manage": {
          "title": "Terreno #{index}",
          "items": {
            "manage": {
              "name": "&9Gerenciar",
              "lore": ["&7", "&7 Configure os membros que", "&7 podem entrar e construir", "&7 no seu terreno!", "&7", "&eClique para gerenciar!"]
            },
            "rename": {
              "name": "&eRenomear",
              "lore": ["&7", "&7 Renomeie o terreno do jeito que", "&7 preferir, lembrando que há", "&7 um limite de 15 caracteres!", "&7", "&eClique para renomear!"]
            },
            "clear": {
              "name": "&8Limpar",
              "lore": ["&7", "&7 Ao confirmar, o seu terreno volta", "&7 ao ponto inicial. Essa ação é", "&7 permanente e irreversível!", "&7", "&eClique para limpar o seu terreno!"]
            },
            "sell": {
              "name": "&2Vender",
              "lore": ["&7", "&7 Anuncie seu terreno para venda,", "&7 escolha a economia, o valor e", "&7 receba ofertas dos jogadores!", "&7", "&eClique para vender seu terreno!"]
            },
            "listed": {
              "name": "&2À venda",
              "lore": ["&7", "&7 Seu terreno está anunciado", "&7 na Imobiliária por {value}&7.", "&7", "&eClique para cancelar a venda!"]
            },
            "delete": {
              "name": "&cExcluir o Terreno",
              "lore": ["&7", "&7 Ao confirmar, você perde", "&7 o seu terreno para sempre.", "&7 Essa ação é irreversível!", "&7", "&cClique para excluir o seu terreno!"]
            }
          }
        },
        "members": {
          "title": "Membros do Terreno #{index}",
          "items": {
            "add": {
              "name": "&aAdicionar",
              "lore": ["&7", "&7 Digite o nick no chat, e o jogador", "&7 entra na lista sem permissão.", "&7", "&eClique para adicionar!"]
            },
            "member": {
              "none": {
                "name": "&f{target_name}",
                "lore": ["&7", "&7 Permissão: &fNenhuma", "&7", "&fClique para alterar!", "&7Shift + Botão Esquerdo para remover."]
              },
              "trusted": {
                "name": "&a{target_name}",
                "lore": ["&7", "&7 Permissão: &aConfiável", "&7", "&aClique para alterar!", "&7Shift + Botão Esquerdo para remover."]
              },
              "added": {
                "name": "&e{target_name}",
                "lore": ["&7", "&7 Permissão: &eAdicionado", "&7", "&eClique para alterar!", "&7Shift + Botão Esquerdo para remover."]
              },
              "denied": {
                "name": "&c{target_name}",
                "lore": ["&7", "&7 Permissão: &cNegado", "&7", "&cClique para alterar!", "&7Shift + Botão Esquerdo para remover."]
              }
            }
          }
        },
        "sell": {
          "title": "Vender Terreno #{index}",
          "items": {
            "currency": {
              "cash": {
                "name": "&6Cash",
                "lore": ["&7", "&7 Escolha a economia para vender!", "&7 Atual: &6Cash", "&7", "&6Clique para alterar!"]
              },
              "tokens": {
                "name": "&eTokens",
                "lore": ["&7", "&7 Escolha a economia para vender!", "&7 Atual: &eTokens", "&7", "&eClique para alterar!"]
              }
            },
            "offers": {
              "on": {
                "name": "&aOfertas",
                "lore": ["&7", "&7 Escolha se quer ativar ou desativar", "&7 as ofertas de outros jogadores!", "&7", "&7 Ofertas: &aLigadas"]
              },
              "off": {
                "name": "&cOfertas",
                "lore": ["&7", "&7 Escolha se quer ativar ou desativar", "&7 as ofertas de outros jogadores!", "&7", "&7 Ofertas: &cDesligadas"]
              }
            },
            "confirm": {
              "name": "&aConfirmar",
              "lore": ["&7", "&7 Depois digite o valor no chat e", "&7 confirme, e o terreno entra", "&7 na Imobiliária."]
            }
          }
        },
        "market": {
          "title": "Imobiliária",
          "items": {
            "listing": {
              "offers-on": {
                "name": "&6Terreno {plot} &6de {seller_name}",
                "lore": ["&7", "&7 Economia: {currency_icon}", "&7 Valor: &f{price}", "&7 Ofertas: &aLigadas", "&7", "&fBotão Esquerdo &7para visitar esse terreno!", "&fBotão Direito &7para comprar esse terreno!"]
              },
              "offers-off": {
                "name": "&6Terreno {plot} &6de {seller_name}",
                "lore": ["&7", "&7 Economia: {currency_icon}", "&7 Valor: &f{price}", "&7 Ofertas: &cDesligadas", "&7", "&fBotão Esquerdo &7para visitar esse terreno!", "&fBotão Direito &7para comprar esse terreno!"]
              },
              // No alto da confirmação de compra: o valor exato, com o símbolo, e sem as linhas de clique.
              "preview": {
                "name": "&6Terreno {plot} &6de {seller_name}",
                "lore": ["&7", "&7 Valor: {price}"]
              }
            },
            "offers": {
              "name": "&3Ofertas",
              "lore": ["&7", "&7Clique para ver as ofertas", "&7que deram nos seus terrenos!"]
            }
          }
        },
        "buy": {
          "title": "Comprar ou ofertar",
          "items": {
            "buy": {
              "name": "&aComprar",
              "lore": ["&7", "&7Clique para comprar esse terreno diretamente!"]
            },
            "offer": {
              "name": "&eOfertar",
              "lore": ["&7", "&7Clique para oferecer uma quantia nesse terreno!", "&7A oferta mínima é {minimum}&7."]
            }
          }
        },
        "offers": {
          "title": "Ofertas recebidas",
          "items": {
            "offer": {
              "low": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Economia: {currency_icon}", "&7 Oferta: &f{amount}", "&7 Valor: &c{percent}%", "&7", "&7Clique para avaliar essa oferta!"]
              },
              "mid": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Economia: {currency_icon}", "&7 Oferta: &f{amount}", "&7 Valor: &e{percent}%", "&7", "&7Clique para avaliar essa oferta!"]
              },
              "high": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Economia: {currency_icon}", "&7 Oferta: &f{amount}", "&7 Valor: &a{percent}%", "&7", "&7Clique para avaliar essa oferta!"]
              }
            },
            // No alto da avaliação: a oferta exata, com o símbolo, e sem a linha de clique.
            "preview": {
              "low": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Oferta: {amount}", "&7 Valor: &c{percent}%"]
              },
              "mid": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Oferta: {amount}", "&7 Valor: &e{percent}%"]
              },
              "high": {
                "name": "&3Oferta de {buyer_name}",
                "lore": ["&7", "&7 Terreno: &f{plot}", "&7 Oferta: {amount}", "&7 Valor: &a{percent}%"]
              }
            }
          }
        },
        "confirmation": {
          "items": {
            "accept": { "name": "&aConfirmar", "lore": [] },
            "deny": { "name": "&cRecusar", "lore": [] }
          },
          "clear": {
            "title": "Limpar o terreno?",
            "name": "&8Limpar o terreno {plot}",
            "lore": ["&7", "&7 Tudo o que está no terreno some,", "&7 e ele volta ao ponto inicial.", "&7 Essa ação é irreversível!"]
          },
          // O Limpador de Terrenos, que tira só a terra e a grama (o "clear" de cima é o Limpar do menu, que reinicia).
          "cleaner": {
            "title": "Usar o Limpador de Terrenos?",
            "name": "&eLimpar o terreno {plot}",
            "lore": ["&7", "&7 Toda a terra e a grama do terreno", "&7 somem, da bedrock até o topo.", "&7 O resto fica onde está.", "&7", "&7 O Limpador é gasto ao confirmar."]
          },
          // O /plot clear da equipe, em pé no terreno de outro jogador.
          "staff-clear": {
            "title": "Limpar o terreno?",
            "name": "&8Limpar o terreno {plot} &8de {owner_name_with_color}",
            "lore": ["&7", "&7 Tudo o que está no terreno some,", "&7 e ele volta ao ponto inicial.", "&7 Se estiver à venda, o anúncio sai.", "&7 O dono recebe um aviso.", "&7 Essa ação é irreversível!"]
          },
          "delete": {
            "title": "Excluir o terreno?",
            "name": "&cExcluir o terreno {plot}",
            "lore": ["&7", "&7 O terreno é limpo e deixa de", "&7 ser seu, com tudo o que tem nele.", "&7 Essa ação é irreversível!"]
          },
          // O título do inventário no 1.8 tem teto de 32 caracteres, então o valor vai no item, e não no título.
          "list": {
            "title": "Anunciar o terreno?",
            "name": "&2Anunciar o terreno {plot}",
            "lore": ["&7", "&7 Valor: {value}", "&7 Ofertas: {offers}", "&7", "&7 Confira o valor antes de confirmar.", "&7 O terreno entra na Imobiliária", "&7 exatamente por ele."],
            "offers-on": "&aLigadas",
            "offers-off": "&cDesligadas"
          },
          "offer-send": {
            "title": "Enviar a oferta?",
            "name": "&eOfertar pelo terreno {plot} &ede {seller_name_with_color}",
            "lore": ["&7", "&7 Oferta: {value}", "&7 Preço: {price}", "&7", "&7 Confira o valor antes de confirmar.", "&7 Ele é cobrado quando o vendedor", "&7 aceitar a oferta."]
          },
          "unlist": {
            "title": "Cancelar a venda?",
            "name": "&2Cancelar a venda do terreno {plot}",
            "lore": ["&7", "&7 O terreno sai da Imobiliária, e", "&7 as ofertas por ele são canceladas."]
          },
          "purchase": {
            "title": "Comprar o terreno?"
          },
          "offer": {
            "title": "Avaliar a oferta",
            "items": {
              "accept": {
                "name": "&aAceitar",
                "lore": ["&7", "&7 O comprador paga a oferta,", "&7 e o terreno passa para ele."]
              },
              "deny": {
                "name": "&cRecusar",
                "lore": ["&7", "&7 A oferta sai, e o comprador", "&7 recebe um aviso."]
              }
            }
          }
        }
      }
    }
  }
}
