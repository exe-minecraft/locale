{
  "plugins": {
    "essentials": {
      // As categorias do rankup, as do kits/config.yml do rankup-1 e do rankup-plots-1 (o pacote
      // docs/deploy/rankup-kits-20261121 do exe). Os kits vivem no banco, e a equipe os muda com o /kit admin.
      "kits": {
        "categories": {
          "basicos": {
            "name": "&eKits Básicos"
          },
          "vip": {
            "name": "&6Kits VIPs"
          },
          // As do documento de 21/11/2026 que não aparecem no /kits: a dos ranks abre pelo clique direito do /ranks, e a
          // de ativação pelo item. O nome de cada kit está no banco, e a equipe o muda com o /kit admin editar.
          "ranks": {
            "name": "&fKits dos Ranks"
          },
          "ativacao": {
            "name": "&aKits de Ativação"
          }
        }
      }
    }
  }
}
