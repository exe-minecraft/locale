            ]
          },
          "vip": {
            "name": "&6Kits VIP",
            "description": [
              "&7Os kits do &aSamurai&7 e do &4Imperial&7.",
              "&7O Imperial coleta os do Samurai também."
            ]
          }
        },
        "types": {
          "basico": {
            "name": "&fKit Básico"
          },
          "samurai_diario": {
            "name": "&aKit Samurai Diário"
          },
          "samurai_semanal": {
            "name": "&aKit Samurai Semanal"
          },
