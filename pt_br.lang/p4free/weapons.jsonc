{
  "plugins": {
    // A espada e o machado especiais do P4Free. Os dois são o mesmo sistema, e a
    // diferença entre eles vive aqui e no config.yml do módulo.
    "weapons": {
      // As palavras que acompanham um número montado no código (o Plural do core): 1 no singular.
      "units": {
        "kill": { "singular": "abate", "plural": "abates" },
        "duplicate-weapon": { "singular": "arma duplicada", "plural": "armas duplicadas" },
        "entry": { "singular": "registro", "plural": "registros" }
      },
      "espada": {
        "item": {
          "name": "&cEspada Especial",
          "investment": "&fInvestimento: &e{tokens} Tokens",
          "enchant-owned": "&6 {enchant} &l{level}",
          "enchant-missing": "&8 {enchant} ✖",
          "kills": "&fAbates: &c{kills}"
        },
        "broken": "&cA sua espada especial se partiu.",
        // O {weapon_plural} da bancada: o "Ranking de Espadas".
        "plural": "Espadas"
      },
      "machado": {
        "item": {
          "name": "&cMachado Especial",
          "investment": "&fInvestimento: &e{tokens} Tokens",
          "enchant-owned": "&6 {enchant} &l{level}",
          "enchant-missing": "&8 {enchant} ✖",
          "kills": "&fAbates: &c{kills}"
        },
        "broken": "&cO seu machado especial se partiu.",
        "plural": "Machados"
      },
      "commands": {
        "enchant-book": {
          "target-offline": "Esse jogador não está online.",
          "target-inventory-full": "O inventário desse jogador está cheio.",
          "invalid-enchant": "Arma ou encantamento inválido. Use /darencantamento <jogador> <espada|machado> <encantamento> <níveis>",
          "given": "Você deu um livro de {enchant} {levels} a {player}.",
          "arguments": {
            "target": {
              "name": "jogador",
              "description": "Jogador online que recebe o livro"
            },
            "weapon": {
              "name": "espada|machado",
              "description": "A arma em que o encantamento entra"
            },
            "enchant": {
              "name": "encantamento",
              "description": "O id do encantamento, como sharpening ou skull-cracker"
            },
            "levels": {
              "name": "níveis",
              "description": "Quantos níveis o livro dá, de 1 em diante"
            }
          }
        },
        "espada": {
          "still-loading": "Sua espada ainda está carregando. Tente de novo em instantes.",
          "inventory-full": "Libere um espaço no inventário antes de resgatar a espada.",
          "already-have": "Você já tem a espada especial na mochila.",
          "in-vault": "Sua espada especial está guardada no seu /cofre.",
          "vault-busy": "Seu cofre está aberto ou ainda sendo salvo. Tente de novo em instantes.",
          "cooldown": "Aguarde para resgatar a espada de novo.",
          "retrieved": [
            "",
            " &aVocê resgatou a espada especial!",
            " &7Prestígio &f{prestige}&7, &f{kills}&7 {kills_unit}.",
            " &eShift + botão direito com ela na mão abre a bancada.",
            ""
          ],
          // /espada historico <jogador>, da staff. Abre o mesmo menu do /machado historico.
          "historico": {
            "description": "Mostra o histórico das armas especiais de um jogador",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "O jogador, online ou não, cujo histórico você quer ver"
              }
            }
          }
        },
        "machado": {
          "still-loading": "Seu machado ainda está carregando. Tente de novo em instantes.",
          "inventory-full": "Libere um espaço no inventário antes de resgatar o machado.",
          "already-have": "Você já tem o machado especial na mochila.",
          "in-vault": "Seu machado especial está guardado no seu /cofre.",
          "vault-busy": "Seu cofre está aberto ou ainda sendo salvo. Tente de novo em instantes.",
          "cooldown": "Aguarde para resgatar o machado de novo.",
          "retrieved": [
            "",
            " &aVocê resgatou o machado especial!",
            " &7Prestígio &f{prestige}&7, &f{kills}&7 {kills_unit}.",
            " &eShift + botão direito com ele na mão abre a bancada.",
            ""
          ],
          "historico": {
            "description": "Mostra o histórico das armas especiais de um jogador",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "O jogador, online ou não, cujo histórico você quer ver"
              }
            }
          }
        }
      },
      "messages": {
        "profile-loading": "Seu perfil ainda está carregando. Tente de novo em instantes.",
        "duplicates-removed": "Removemos {amount} {amount_unit} do seu inventário.",
        "skull-cracker": "&6Crítico! &eQuebra-Crânio ativado.",
        "armor-breaker": {
          "attacker": "&4Quebra-Armadura ativado.",
          "victim": "&cSua armadura está se desgastando mais rápido."
        },
        "drainage": {
          "killer": "&eVocê drenou &a{amount}&e tokens de &f{player}&e.",
          "victim": "&cVocê perdeu &e{amount}&c tokens para &f{player}&c."
        },
        "in-combat": "Você não pode abrir a bancada em combate.",
        "not-in-hand": "Segure a arma na mão para mexer nela.",
        "already-max-level": "Este encantamento já está no nível máximo.",
        "prestige-required": "Este encantamento pede prestígio {prestige}.",
        "not-enough": "Você não tem {currency} suficientes.",
        "enchant-bought": "&a{enchant} &fsubiu para o nível &a{level}&f.",
        "already-repaired": "Esta arma não precisa de conserto.",
        "repaired": "Arma consertada.",
        "cannot-drop": "A arma não se larga no chão.",
        "cannot-move": "Você só pode guardar a arma no seu próprio /cofre.",
        "prestige-maximum": "Esta arma já está no prestígio máximo.",
        "prestige-not-invested": "Você precisa ter {required} tokens investidos nesta arma.",
        "prestige-done": "&aPrestígio &l{prestige}&r&a. Os encantamentos foram zerados.",
        "book-wrong-weapon": "Este livro não é para esta arma.",
        "deleted": "&cSua arma foi excluída.",
        "free-upgrade": "&aParabéns! &f{enchant} &asubiu para o nível &f{level}&a de graça, pelo seu grupo.",
        "history": {
          "empty": "{player} não tem nada no histórico das armas.",
          "failed": "Não deu para carregar o histórico agora. Tente de novo em instantes."
        }
      },
      // Os nomes dos encantamentos. Ficam aqui e não no config.yml porque são texto
      // visível: no config saíam sem acento e sem cor.
      // A descrição e o efeito saem no ícone da bancada, como no exe-p4free-core. O texto é
      // o mesmo para a espada e para o machado. O efeito é o rótulo do número que o nível
      // mexe; o Indestrutível e a Repulsão não têm número, e por isso não têm efeito.
      // Os nomes não levam cor: cada item e mensagem define a sua, inclusive o dourado
      // dos adquiridos e o cinza escuro dos ausentes na lore original das armas.
      "enchants": {
        "sharpening": {
          "name": "Afiação",
          "description": [
            "&7Aumenta o dano causado",
            "&7e acelera a quebra da",
            "&7armadura inimiga."
          ],
          "effect": "Afiação"
        },
        "unbreakable": {
          "name": "Indestrutível",
          "description": [
            "&7Torna a arma inquebrável,",
            "&7deixando-a com durabilidade infinita."
          ]
        },
        "fortune": {
          "name": "Fortuna",
          "description": [
            "&7Chance de conseguir tokens",
            "&7em dobro em cada golpe ou abate."
          ],
          "effect": "Chance"
        },
        "amplifier": {
          "name": "Amplificador",
          "description": [
            "&7Aumenta a quantidade de",
            "&7tokens recebidos por golpe",
            "&7e por abate."
          ],
          "effect": "Tokens a mais"
        },
        "repair": {
          "name": "Reparador",
          "description": [
            "&7Chance de ganhar um Reparador",
            "&7ao abater um inimigo."
          ],
          "effect": "Chance"
        },
        "efficiency": {
          "name": "Eficiência",
          "description": [
            "&7Aumenta a velocidade de",
            "&7quebrar blocos como teia."
          ],
          "effect": "Eficiência"
        },
        "drainage": {
          "name": "Drenagem",
          "description": [
            "&7Chance de roubar tokens",
            "&7do oponente ao abatê-lo."
          ],
          "effect": "Chance"
        },
        "skull-cracker": {
          "name": "Quebra-Crânio",
          "description": [
            "&7Chance de um golpe crítico,",
            "&7com mais dano no inimigo."
          ],
          "effect": "Chance"
        },
        "knockback": {
          "name": "Repulsão",
          "description": [
            "&7Empurra o oponente",
            "&7para longe ao atacar."
          ]
        },
        "armor-breaker": {
          "name": "Quebra-Armadura",
          "description": [
            "&7Pequena chance de quebrar",
            "&7a armadura do oponente",
            "&7mais rápido durante {seconds}s."
          ],
          "effect": "Chance"
        }
      },
      // A bancada, o menu que gasta tokens para subir encantamento.
      "views": {
        "weapon": {
          "title": "{weapon_name}",
          "items": {
            // Os ícones dos encantamentos seguem o desenho do exe-p4free-core: o nome na cor
            // do estado (verde quando dá para evoluir), a descrição, o nível com o próximo, o
            // número que ele mexe e o que falta. As linhas só com uma lista ({enchant_description},
            // {enchant_effect}, {enchant_shop}) viram uma linha por item, e vazias somem.
            // 0: o encantamento que dá para evoluir.
            "0": {
              "name": "&a{enchant_name} &l{enchant_level}",
              "lore": [
                "{enchant_description}",
                "",
                "{enchant_progress}",
                "{enchant_effect}",
                "",
                " &fPreço: {enchant_currency_color}{enchant_price} {enchant_currency}",
                "",
                "{enchant_shop}",
                "&aClique para adquirir."
              ]
            },
            // 2: o encantamento já no máximo.
            "2": {
              "name": "&c{enchant_name} &l{enchant_level}",
              "lore": [
                "{enchant_description}",
                "",
                "{enchant_progress}",
                "{enchant_effect}",
                "",
                "&cEste encantamento já está no nível máximo."
              ]
            },
            // Os itens fixos (3, 4, 5, 7, 12, 13 e 14) também são os do exe-p4free-core, com
            // "arma" onde lá era "espada" ou "machado": estes itens são os mesmos para as duas.
            // 3: o conserto.
            "3": {
              "name": "&aReparação",
              "lore": [
                "&7Use esta função para",
                "&7reparar sua arma",
                "&7em 100%.",
                "",
                "&a Custos:",
                "   {repair_currency_color}{repair_cost} &f{repair_currency}",
                "",
                "&dDica: &fTorne a durabilidade",
                "&fda sua arma infinita ao",
                "&fcomprar Indestrutível.",
                "",
                "{repair_state}"
              ]
            },
            // 4: o prestígio. O {prestige_state} é uma lista: os requisitos e a última linha.
            "4": {
              "name": "{prestige_title}",
              "lore": [
                "&7Resete os encantamentos para",
                "&7desbloquear mais níveis máximos",
                "&7e mais encantamentos!",
                "",
                "{prestige_state}"
              ]
            },
            // 6 e 11: o que se liga e desliga em vez de se comprar, ativado e desativado.
            "6": {
              "name": "&a{enchant_name} &a&lATIVADA",
              "lore": [
                "{enchant_description}",
                "",
                " &fEstado: &a&lATIVADA",
                "",
                "&cClique para desativar."
              ]
            },
            "11": {
              "name": "&7{enchant_name} &c&lDESATIVADA",
              "lore": [
                "{enchant_description}",
                "",
                " &fEstado: &c&lDESATIVADA",
                "",
                "&aClique para ativar."
              ]
            },
            // 7: a exclusão da arma.
            "7": {
              "name": "&cExcluir a arma",
              "lore": [
                "&8Ação irreversível.",
                "",
                "&7Ao clicar neste item, você irá excluir",
                "&7a sua arma, perdendo todo o progresso",
                "&7e os encantamentos atuais dela.",
                "",
                "&eClique para excluir a arma."
              ]
            },
            // 8: o encantamento que ainda pede prestígio. Sem ele o ícone convidava a
            // evoluir e só o clique é que dizia que não.
            "8": {
              "name": "&c{enchant_name} &l{enchant_level}",
              "lore": [
                "{enchant_description}",
                "",
                "{enchant_progress}",
                "{enchant_effect}",
                "",
                " &cRequisitos:",
                " &fPrestígio &b&l{enchant_prestige} &fnecessário.",
                "",
                "&cNão é possível evoluir este encantamento."
              ]
            },
            // 9: o encantamento que dá para evoluir, mas o saldo não chega.
            "9": {
              "name": "&c{enchant_name} &l{enchant_level}",
              "lore": [
                "{enchant_description}",
                "",
                "{enchant_progress}",
                "{enchant_effect}",
                "",
                " &fPreço: {enchant_currency_color}{enchant_price} {enchant_currency}",
                "",
                "{enchant_shop}",
                "&cVocê não possui {enchant_currency} suficientes."
              ]
            },
            // 10: o nível que o grupo leva de graça (o upgrade VIP do sistema antigo).
            "10": {
              "name": "&a{enchant_name} &l{enchant_level}",
              "lore": [
                "{enchant_description}",
                "",
                "{enchant_progress}",
                "{enchant_effect}",
                "",
                "&aUpgrade VIP disponível!",
                "&eClique para adquirir de graça."
              ]
            },
            // 5: o ranking das armas deste tipo, com a posição de quem abre.
            "5": {
              "name": "&aRanking de {weapon_plural}",
              "lore": [
                "&7Acompanhe o ranking e veja",
                "&7quem possui mais abates",
                "&7e tokens investidos!",
                "",
                "&f Sua posição:",
                "&f  Abates: &c{kills_position}",
                "&f  Tokens gastos: &e{invested_position}",
                "",
                "&aClique para visualizar."
              ]
            },
            // 12: as informações.
            "12": {
              "name": "&eInformações",
              "lore": [
                "&7Customize sua arma com",
                "&7encantamentos únicos!",
                "",
                "&e Como ganhar tokens?",
                "  &8- &fAcertar golpes",
                "  &8- &fAbater inimigos",
                "",
                "&7Use os tokens para evoluir ou",
                "&7desbloquear encantamentos."
              ]
            },
            // 13: o saldo de tokens.
            "13": {
              "name": "&eTokens",
              "lore": [
                "&7Acompanhe a quantidade de",
                "&7tokens que você possui.",
                "",
                "&f Tokens: &a{tokens_balance}"
              ]
            },
            // 14: o ranking de tokens, com a posição de quem abre.
            "14": {
              "name": "&bRanking de Tokens",
              "lore": [
                "&7Acompanhe o ranking de tokens",
                "&7e veja os jogadores que mais",
                "&7possuem essa moeda.",
                "",
                "&f Sua posição: &b{tokens_position}",
                "",
                "&aClique para visualizar."
              ]
            }
          },
          // O "Sua posição" dos rankings (5 e 14) e o que aparece enquanto a posição e o saldo
          // não chegaram. Fora do ranking é a arma sem abates (o ranking só leva quem tem) e quem
          // não está no top das moedas, que o módulo recalcula a cada 3 minutos.
          "position": {
            "ranked": "{position}º",
            "unranked": "fora do ranking",
            "unavailable": "indisponível"
          },
          "loading": "carregando",
          // O {enchant_progress} dos ícones: o nível de hoje e o seguinte, ou o máximo.
          "progress": {
            "next": " &fNível &l{level} &8➟ &bNível &l{next}",
            "maximum": " &fNível Máximo!"
          },
          // O {enchant_effect}: o número de hoje riscado e o do próximo nível, ou só o de
          // hoje no máximo. {effect} é o "effect" do encantamento.
          "effect": {
            "next": "  &f{effect}: &c&m{from}&7 ➟ &b{to}",
            "current": "  &f{effect}: &7{from}"
          },
          // O {enchant_shop}: só no que se paga em cash. A linha em branco do fim é dele, para
          // não sobrar uma no que se paga em tokens.
          "shop": [
            "&e Adquira &f&lCASH&e e outros",
            "&e produtos em nossa loja!",
            "&e Acesse &floja.rede-exe.com",
            ""
          ],
          // As últimas linhas do conserto e do prestígio, que mudam com o estado da arma, e o
          // nome do prestígio, com a seta para o próximo só quando ele já dá para fazer.
          "states": {
            "repair": {
              "ready": "&aClique para reparar.",
              "repaired": "&cA arma já está com a durabilidade máxima.",
              "not-enough": "&cVocê não possui {repair_currency} suficientes."
            },
            "prestige": {
              "ready": [
                "&a Requisitos:",
                " {investment_currency_color}{prestige_required} &f{investment_currency} de investimento.",
                " &7Investido: {investment_currency_color}{weapon_invested}",
                "",
                "&aClique para prosseguir."
              ],
              "maximum": [
                "&cNível máximo de prestígio atingido."
              ],
              "not-invested": [
                "&c Requisitos:",
                " {investment_currency_color}{prestige_required} &f{investment_currency} de investimento.",
                " &7Investido: {investment_currency_color}{weapon_invested}",
                "",
                "&cVocê não possui os requisitos necessários."
              ]
            },
            "prestige-title": {
              "ready": "&aPrestígio &l{prestige} &r&8➟ &b&l{next}",
              "maximum": "&cPrestígio &l{prestige}",
              "not-invested": "&cPrestígio &l{prestige}"
            }
          }
        },
        "delete": {
          "title": "Excluir a arma"
        },
        // O histórico das duas armas, que a staff abre com /espada historico ou /machado historico.
        // Um item por registro, do mais novo para o mais velho; a data é no horário de Brasília.
        "history": {
          "title": "Histórico de {target}",
          "free": "&anada",
          "cost": "&b{amount} {currency}",
          // Por onde o nível subiu.
          "sources": {
            "menu": "a bancada",
            "book": "um livro de encantamento",
            "free": "o upgrade do grupo",
            "toggle": "o interruptor da bancada"
          },
          "retrieve": {
            "created": "&aArma nova, sem registro anterior.",
            "existing": "&eA arma que ele já tinha."
          },
          "items": {
            "enchant-upgrade": {
              "name": "&aEncantamento melhorado",
              "lore": [
                "",
                "&7Arma: {weapon}",
                "&7Encantamento: {enchant} &f{level}",
                "&7Por: &f{source}",
                "&7Custo: {cost}",
                "",
                "&8{date}"
              ]
            },
            "prestige": {
              "name": "&6Prestígio",
              "lore": [
                "",
                "&7Arma: {weapon}",
                "&7Prestígio novo: &f{prestige}",
                "&7Investido: &b{invested} {invested_currency}",
                "",
                "&8{date}"
              ]
            },
            "retrieve": {
              "name": "&ePegou a arma pelo comando",
              "lore": [
                "",
                "&7Arma: {weapon}",
                "{retrieve}",
                "&7Prestígio: &f{prestige}",
                "&7Abates: &f{kills}",
                "",
                "&8{date}"
              ]
            },
            "delete": {
              "name": "&4Excluiu a arma",
              "lore": [
                "",
                "&7Arma: {weapon}",
                "&7Prestígio: &f{prestige}",
                "&7Investido: &b{invested} {invested_currency}",
                "&7Abates: &f{kills}",
                "",
                "&7Encantamentos:",
                "{enchants}",
                "",
                "&8{date}"
              ]
            },
            "repair": {
              "name": "&dConsertou a arma",
              "lore": [
                "",
                "&7Arma: {weapon}",
                "&7Custo: {cost}",
                "",
                "&8{date}"
              ]
            },
            "broken": {
              "name": "&cA arma quebrou",
              "lore": [
                "",
                "&7Arma: {weapon}",
                "&7Prestígio: &f{prestige}",
                "&7Investido: &b{invested} {invested_currency}",
                "&7Abates: &f{kills}",
                "",
                "&7Encantamentos:",
                "{enchants}",
                "",
                "&8{date}"
              ]
            },
            // Aparece quando a consulta trouxe o máximo que a plataforma devolve de uma vez.
            "truncated": {
              "name": "&eSó os mais recentes",
              "lore": [
                "",
                "&7Aqui aparecem os {limit} {limit_unit}",
                "&7mais recentes. Os anteriores estão",
                "&7nos Logs do painel."
              ]
            }
          }
        }
      },
      // O livro de encantamento, o segundo caminho para subir um nível.
      "enchant-book": {
        "display-name": "Evolução de Nível",
        "level": {
          "singular": "nível",
          "plural": "níveis"
        },
        "weapons": {
          "sword": {
            "description": "em sua espada.",
            "hint-start": "&eArraste este item até a",
            "hint-end": "&esua espada para evoluir."
          },
          "axe": {
            "description": "em seu machado.",
            "hint-start": "&eArraste este item até o",
            "hint-end": "&eseu machado para evoluir."
          }
        },
        "item": {
          "name": "&bEvolução de Nível &8(+{levels})",
          "lore": [
            "&fTipo: &7{enchant}",
            "",
            "&7 Evolua &e+{levels} {levels_word} &7do encantamento",
            "&d {enchant}&7 {weapon_description}",
            "",
            "{weapon_hint_start}",
            "{weapon_hint_end}"
          ]
        }
      },

      // O Reparador, o prêmio do encantamento Reparo da espada.
      "repairer": {
        "item": {
          "name": "&cReparador",
          "lore": [
            "&7Repara sua armadura do",
            "&7corpo ao clicar com o botão direito."
          ]
        },
