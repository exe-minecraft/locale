            "start": "&aClique para começar.",
            "challenge": "&aClique e digite o nick no chat.",
            "leave": "&aClique para sair."
          },
          "items": {
            "leader": {
              "name": "&6Party de {player}",
              "lore": [
                "&8 ▸ &fMembros: &f{party_size} de {party_max}"
              ],
              "none": {
                "name": "&6Você não está numa party",
                "lore": [
                  "&7Só VIPs podem criar e liderar.",
                  "&7Samurai permite até 8 membros,",
                  "&7Imperial até 16, contando o líder.",
                  "&7Convidados não precisam de VIP.",
                  "&7Ela nasce no primeiro convite aceito."
                ]
              }
            },
            "member": {
              "name": "&f{player}",
              "lore": [
                "{role}",
                "{activity}",
                "{actions}"
              ],
              "leader": "&6Líder",
              "actions": [
                "",
                "&7Clique esquerdo: &fpassar a liderança",
                "&7Shift + clique: &fexpulsar"
              ]
            },
            "back": {
              "name": "&6Voltar",
              "lore": [ "&7Volta ao menu Duelos." ]
            },
            "invite": {
              "name": "&6Convidar",
              "lore": [
                "&7Convite de 60 segundos.",
                "",
                "{invite_action}"
              ]
            },
            "split": {
              "name": "&6Split",
              "lore": [
                "&7Divide a party ao acaso em dois",
                "&7times, e eles lutam entre si.",
                "",
                "&8 ▸ &fTimes: &f{split_first} contra {split_second}",
                "",
                "{fight_action}"
              ]
            },
            "all": {
              "name": "&6Todos contra todos",
              "lore": [
                "&7Cada um por si; o último vivo",
                "&7vence.",
                "",
                "&8 ▸ &fNa luta: &f{party_size}",
                "",
                "{fight_action}"
              ]
            },
            "challenge-party": {
              "name": "&6Desafiar outra party",
              "lore": [
                "&7Sua party contra a de outro",
                "&7jogador. O convite mostra o",
                "&7tamanho das duas.",
                "",
                "{challenge_action}"
              ]
            },
            "leave": {
              "name": "&cSair da party",
              "lore": [
                "&7Se você é o líder, a liderança",
                "&7passa ao membro mais antigo.",
                "",
                "{leave_hint}",
                "{leave_action}"
              ],
              "leader-hint": "&cShift + clique desfaz a party."
            }
          }
        },
        "cabin": {
          "title": "Camarote",
          "actions": {
            "watch": "&aClique para assistir."
          },
          "items": {
            "empty": {
              "name": "&7Nenhuma luta acontecendo agora",
              "lore": [
                "&7Volte daqui a pouco, ou comece",
                "&7uma pelo menu Duelos."
              ]
            },
            "back": {
              "name": "&6Voltar",
              "lore": [ "&7Volta ao menu Duelos." ]
            },
            "match": {
              "name": "&6{format}",
              "lore": [
                "{teams}",
                "",
                "&8 ▸ &fTempo: &f{time}",
                "&8 ▸ &fAssistindo: &f{watching}",
                "",
                "{action}"
              ],
              "team": "&f{players} &8(vivos: {alive} de {size})",
              // No 1v1 cada lado é um jogador só: sem a contagem de vivos.
              "solo": "&f{players}",
              "clan-team": "&f{tag} &8(vivos: {alive} de {size})"
            }
          }
        },
        "cxc": {
          // O título do inventário no 1.8 cabe em 32 caracteres.
          "title": "Escolha o mapa do CxC",
          "actions": {
            "challenge": "&aClique para desafiar."
          },
          "items": {
            "arena": {
              "name": "&6{arena}",
              "lore": [
                "&7Desafiar o clã {tag} &7neste mapa.",
                "",
                "&8 ▸ &fCópias livres: &f{free}",
                "",
                "{action}"
              ]
            }
          }
        },
        "kit": {
          // O título do inventário no 1.8 cabe em 32 caracteres.
          "title": "Clique na peça e no destino",
          "items": {
            "back": {
              "name": "&6Voltar",
              "lore": [ "&7Volta ao menu Duelos, sem salvar." ]
            },
            "standard": {
              "name": "&6Padrão",
              "lore": [ "&7Volta a espada, as maçãs e as", "&7poções para os slots 1 a 4." ]
            },
            "save": {
              "name": "&aSalvar",
              "lore": [ "{selected}", "&7Grava o arranjo e fecha." ]
            },
            "close": {
              "name": "&cFechar",
              "lore": [ "&7Fecha sem salvar." ]
            }
          },
          "pieces": {
            "sword": "&bEspada",
            "apple": "&6Maçãs douradas",
            "speed": "&bPoções de velocidade",
            "strength": "&cPoções de força"
          },
          "piece": [ "&7Clique para escolher esta peça." ],
          "piece-selected": [ "&aEscolhida. Clique no slot para", "&aonde ela vai, ou aqui para soltar." ],
          "empty": {
            "name": "&7Slot vazio",
            "lore": [ "&7Escolha uma peça antes." ],
            "target": [ "&aClique para trazer a peça escolhida." ]
          },
          "selected": "&8 ▸ &fEscolhida: {piece}",
          "saved": "&aArranjo do kit salvo. Vale a partir da próxima luta.",
          "unchanged": "&cO arranjo é o mesmo que já está salvo. Mude uma peça de lugar antes de salvar."
        },
        // A foto do inventário de quem lutou, aberta pelo clique no nome do resultado: só o kit da partida, no instante
        // em que a luta acabou para ele (a morte, a saída ou o fim).
        "inventory": {
          // O título do inventário no 1.8 cabe em 32 caracteres: com o nick mais longo (16), este fica em 30.
          "title": "Inventário de {player}",
          "unavailable": "&cEsse inventário não está mais disponível.",
          // Acrescentada à lore do que gasta (armadura, espada, arco).
          "durability": [ "&7Durabilidade: &f{current}&7/&f{max}" ],
          "items": {
              "health": {
                "name": "&cVida: &f{health} ❤",
                "lore": [ "&7No instante em que a luta", "&7terminou para este jogador." ],
                "dead": {
                  "name": "&cMorto",
                  "lore": [ "&7Este jogador morreu na luta.", "&7Vida: &f{health} ❤" ]
                }
              },
              "previous": {
                "name": "&eInventário anterior",
                "lore": [ "&7Jogador: &f{previous}", "", "&eClique para ver o inventário." ]
              },
              "next": {
                "name": "&ePróximo inventário",
                "lore": [ "&7Jogador: &f{next}", "", "&eClique para ver o inventário." ]
            },
            "effects": {
              "name": "&dEfeitos",
              "lore": [ "{effects}" ]
            }
          },
          "effects": {
            "line": "&8 ▸ &f{effect} {level} &7({time})",
            "none": "&7Nenhum efeito ativo.",
            "names": {
              "speed": "Velocidade",
              "slow": "Lentidão",
              "fast-digging": "Pressa",
              "slow-digging": "Cansaço",
              "increase-damage": "Força",
              "heal": "Vida instantânea",
              "harm": "Dano instantâneo",
              "jump": "Super pulo",
              "confusion": "Náusea",
              "regeneration": "Regeneração",
              "damage-resistance": "Resistência",
              "fire-resistance": "Resistência ao fogo",
              "water-breathing": "Respiração aquática",
              "invisibility": "Invisibilidade",
              "blindness": "Cegueira",
              "night-vision": "Visão noturna",
              "hunger": "Fome",
              "weakness": "Fraqueza",
              "poison": "Veneno",
              "wither": "Decomposição",
              "health-boost": "Vida extra",
              "absorption": "Absorção",
              "saturation": "Saturação"
            }
          }
        }
      },
      "commands": {
        "elo": {
          "description": "ver os elos do x1; com um nick, o elo de outro jogador",
          "arguments": { "target": { "name": "jogador", "description": "De quem você quer ver o elo." } },
          "target": "{target_name_with_color} &7está no elo {tier_tag} {tier_name}&7, com &f{elo} {points} &8(partidas 1v1: {matches})&7.",
          "failed": "&cNão foi possível ler o elo desse jogador agora. Tente de novo em instantes.",
          "history": {
            "description": "ver o histórico do elo 1v1; com um nick, o de outro jogador",
            "arguments": { "target": { "name": "jogador", "description": "De quem você quer ver o histórico." } }
          },
          "history-duo": {
            "description": "ver o histórico dos duelos 2v2; com um nick, o de outro jogador",
            "arguments": { "target": { "name": "jogador", "description": "De quem você quer ver o histórico." } }
          }
        },
        "x1": {
          "description": "abrir o menu dos duelos",
          "challenge": {
            "description": "desafiar um jogador para um x1 casual",
            "arguments": { "player": { "name": "jogador", "description": "Quem você quer desafiar." } }
          },
          "accept": {
            "description": "aceitar o desafio de um jogador",
            "arguments": { "player": { "name": "jogador", "description": "Quem te desafiou." } }
          },
          "decline": {
            "description": "recusar o desafio de um jogador",
            "arguments": { "player": { "name": "jogador", "description": "Quem te desafiou." } }
          },
          "queue": {
            "description": "entrar na fila ranqueada",
            "arguments": { "mode": { "name": "1v1|2v2", "description": "Escolha a fila 1v1 ou 2v2 (sozinho ou com a party de 2)." } }
          },
          "close": {
            "description": "fechar as filas 1v1 e 2v2 do x1"
          },
          "open": {
            "description": "abrir as filas 1v1 e 2v2 do x1"
          },
          "leave": {
            "description": "sair da fila"
          },
          "cabin": {
            "description": "assistir às lutas; com um nick, a luta dele",
            "arguments": { "player": { "name": "jogador", "description": "Quem está lutando." } },
            "leave": {
              "description": "sair do camarote"
            }
          },
          "kit": {
            "description": "arrumar o kit dos duelos"
          },
          "inventory": {
            "description": "ver o inventário de quem lutou (o clique no nome do resultado)",
            "arguments": {
              // O "id" é do jar de antes do fight-inventory; sai depois que ele deixar o ar.
              "id": { "name": "id", "description": "O código que o clique no nome do resultado traz." },
              "code": { "name": "código", "description": "O código que o clique no nome do resultado traz." }
            }
          },
          "arena": {
            "description": "gerenciar as arenas dos duelos",
            "create": {
              "description": "criar uma arena da schematic plugins/duels/arenas/<nome>.schematic",
              "arguments": {
                "name": { "name": "nome", "description": "O nome da schematic, sem a extensão." },
                "size": { "name": "pequena|grande|cla", "description": "Use pequena para até 4 jogadores, grande para party ou cla para CxC." }
              }
            },
            "spawn": {
              "description": "marcar um spawn onde você está, na primeira cópia",
              "arguments": {
                "name": { "name": "nome", "description": "A arena." },
                "side": { "name": "a|b", "description": "O lado." }
              }
            },
            "copies": {
              "description": "definir quantas cópias a arena tem",
              "arguments": {
                "name": { "name": "nome", "description": "A arena." },
                "count": { "name": "quantidade", "description": "De 1 a 50." }
              }
            },
            "icon": {
              "description": "trocar o ícone da arena pelo item na sua mão",
              "arguments": { "name": { "name": "nome", "description": "A arena." } }
            },
            "teleport": {
              "description": "ir ao spawn A de uma cópia da arena",
              "arguments": {
                "name": { "name": "nome", "description": "A arena." },
                "copy": { "name": "cópia", "description": "O número da cópia, a partir de 1. Sem ele, a primeira." }
              }
            },
            "list": {
              "description": "listar as arenas"
            },
            "disable": {
              "description": "tirar uma arena das lutas novas",
              "arguments": { "name": { "name": "nome", "description": "A arena." } }
            },
            "enable": {
              "description": "devolver uma arena às lutas",
              "arguments": { "name": { "name": "nome", "description": "A arena." } }
            }
          }
        },
        "party": {
          "description": "abrir o menu da party",
          "invite": {
            "description": "convidar um jogador para a party (líder VIP)",
            "arguments": { "player": { "name": "jogador", "description": "Quem você quer convidar." } }
          },
          "join": {
            "description": "entrar na party de quem te convidou",
            "arguments": { "player": { "name": "jogador", "description": "Quem te convidou." } }
          },
          "decline": {
            "description": "recusar um convite de party",
            "arguments": { "player": { "name": "jogador", "description": "Quem te convidou." } }
          },
          "leave": {
            "description": "sair da party"
          },
          "kick": {
            "description": "tirar um membro da party",
            "arguments": { "player": { "name": "jogador", "description": "O membro." } }
          },
          "promote": {
            "description": "passar a liderança da party para outro VIP",
            "arguments": { "player": { "name": "jogador", "description": "O novo líder." } }
          },
          "disband": {
            "description": "desfazer a party"
          },
          "challenge": {
            "description": "desafiar a party de um jogador",
            "arguments": { "player": { "name": "jogador", "description": "Alguém da party desafiada." } }
          },
          "accept": {
            "description": "aceitar o desafio de outra party",
            "arguments": { "player": { "name": "jogador", "description": "O líder que desafiou." } }
          },
          "decline-challenge": {
            "description": "recusar o desafio de outra party",
            "arguments": { "player": { "name": "jogador", "description": "O líder que desafiou." } }
          },
          "split": {
            "description": "dividir a party em dois times e lutar"
          },
          "all": {
            "description": "todos da party contra todos"
          }
        },
        "cxc": {
          "description": "abrir o menu dos duelos de clãs",
          "history": {
            "description": "ver o histórico de CxC de um clã; sem tag, o do seu",
            "arguments": { "tag": { "name": "tag", "description": "A tag do clã." } }
          },
          "fights": {
            "description": "ver os CxC em que você lutou; com um nick, os de outro jogador",
            "arguments": { "target": { "name": "jogador", "description": "De quem você quer ver as lutas." } }
          },
          "challenge": {
            "description": "desafiar outro clã (líder ou capitão VIP)",
            "arguments": { "tag": { "name": "tag", "description": "A tag do clã desafiado." } }
          },
          "accept": {
            "description": "aceitar o desafio de outro clã",
            "arguments": { "tag": { "name": "tag", "description": "A tag do clã que desafiou." } }
          },
          "decline": {
            "description": "negar o desafio de outro clã",
            "arguments": { "tag": { "name": "tag", "description": "A tag do clã que desafiou." } }
          },
          "cabin": {
            "description": "assistir ao CxC de um clã",
            "arguments": { "tag": { "name": "tag", "description": "A tag de um dos clãs lutando." } }
          },
          "leave": {
            "description": "sair do camarote do CxC"
          },
          "kit": {
            "description": "gravar o seu inventário e a sua armadura como o kit do CxC"
          }
        }
      }
    }
