{
  "plugins": {
    // Os duelos do P4Free (módulo p4free/duels; spec docs/superpowers/specs/2026-09-30-p4free-duels-design.md
    // no exe). Sem prefixo de marca. Contagem pelo Plural (units) ou no formato "rótulo: valor".
    "duels": {
      "modes": {
        "challenge": "Desafio 1v1",
        "ranked-solo": "Ranqueada 1v1",
        "ranked-duo": "Ranqueada 2v2",
        "party-versus": "Party contra party",
        "party-split": "Split",
        "party-all": "Todos contra todos"
      },
      // As palavras que acompanham um número montado no código (o Plural do core): 1 no singular.
      "units": {
        "copy": { "singular": "cópia", "plural": "cópias" },
        "elo-point": { "singular": "ponto de elo", "plural": "pontos de elo" },
        "player": { "singular": "jogador", "plural": "jogadores" }
      },
      // Os botões dos convites no chat. A mensagem os mostra pelos placeholders {accept} e {decline}, e o clique
      // é ligado ao texto deles: mudar aqui muda nos dois lugares.
      "buttons": {
        "accept": "&a[Aceitar]",
        "join": "&a[Entrar]",
        "decline": "&c[Recusar]"
      },
      // O que cada jogador está fazendo, na cabeça dele no menu da party.
      "activities": {
        "queue-solo": "&eNa fila ranqueada 1v1",
        "queue-duo": "&eNa fila ranqueada 2v2",
        "match": "&cNum duelo",
        "cabin": "&bNo camarote"
      },
      // Por que não dá: "self" é o texto ao próprio jogador (e a linha vermelha do ícone do menu); "other" é o
      // texto aos outros quando o motivo é de alguém. Curtos: também cabem numa linha de lore.
      "refusals": {
        "self": {
          "offline": "&cVocê precisa estar neste servidor.",
          "dead": "&cVocê está morto.",
          "in-combat": "&cVocê está em combate.",
          "busy-queue-solo": "&cVocê está na fila 1v1.",
          "busy-queue-duo": "&cVocê está na fila 2v2.",
          "busy-match": "&cVocê está num duelo.",
          "busy-cabin": "&cVocê está no camarote.",
          "no-arena": "&cNenhuma arena de duelo está ativa.",
          "no-free-arena": "&cTodas as arenas estão ocupadas agora.",
          "unavailable": "&cOs duelos estão indisponíveis agora.",
          "loading": "&cSeus dados de duelo ainda estão carregando.",
          "stash-failed": "&cNão deu para guardar seus itens agora. Nada foi tirado de você.",
          "match-ended": "&cEssa luta já acabou.",
          "self": "&cVocê não pode desafiar a si mesmo.",
          "not-in-party": "&cVocê não está numa party.",
          "not-leader": "&cSó o líder da party pode fazer isso.",
          "same-party": "&cVocês estão na mesma party.",
          "too-few": "&cA party precisa de pelo menos 2 jogadores.",
          "party-too-big": "&cNa fila 2v2 a party tem de ter 2 jogadores.",
          "not-duo-leader": "&cSó o líder da dupla entra na fila 2v2.",
          "partner-offline": "&cSua dupla não está neste servidor.",
          "partner-busy": "&cSua dupla não está livre.",
          "partner-loading": "&cOs dados da sua dupla ainda estão carregando."
        },
        "other": {
          "offline": "&c{player} não está neste servidor.",
          "dead": "&c{player} está morto.",
          "in-combat": "&c{player} está em combate.",
          "busy-queue-solo": "&c{player} está na fila 1v1.",
          "busy-queue-duo": "&c{player} está na fila 2v2.",
          "busy-match": "&c{player} está num duelo.",
          "busy-cabin": "&c{player} está no camarote.",
          "loading": "&cOs dados de duelo de {player} ainda estão carregando.",
          "stash-failed": "&cNão deu para guardar os itens de {player} agora. Nada foi tirado de ninguém.",
          "not-in-party": "&c{player} não está numa party."
        }
      },
      "titles": {
        "countdown": { "title": "&e{seconds}", "subtitle": "&7Prepare-se" },
        "fight": { "title": "&cValendo!", "subtitle": "&7Boa luta" }
      },
      "messages": {
        "command-blocked": "&cEsse comando não pode ser usado nos duelos.",
        // Só na ranqueada, para o servidor inteiro: a cada 5 vitórias seguidas, e a quebra de uma de 10 ou mais.
        "streak": "&6{player} &7chegou a &e{streak} vitórias seguidas &7na ranqueada.",
        "streak-broken": "&7A sequência de &e{streak} vitórias &7de &6{player} &7acabou.",
        // O resultado vai aos participantes e ao camarote da luta. {winners} e {losers} viram os nomes, cada um com
        // as estatísticas da luta no hover.
        "result": {
          "duel": "&6{winners} &7venceu &f{losers} &8({format})&7, com &c{health} ❤&7.",
          "team": "&7Vitória de &6{winners} &8({format})&7 contra &f{losers}&7.",
          "draw": "&7A luta terminou empatada &8({format})&7.",
          "elo-won": "&a+{amount} {points} &8(agora {elo})",
          "elo-lost": "&c-{amount} {points} &8(agora {elo})",
          "hover": [
            "&6{player}",
            "&8 ▸ &fGolpes: &f{hits}",
            "&8 ▸ &fMaior combo: &f{combo}",
            "&8 ▸ &fMaçãs comidas: &f{apples}",
            "&8 ▸ &fGolpes defendidos: &f{blocked}"
          ]
        }
      },
      "queue": {
        "joined": "&aVocê entrou na fila: &f{mode}&a.",
        "already": "&cVocê já está nessa fila.",
        "left": "&7Você saiu da fila.",
        "partner-left": "&c{player} saiu da fila, e a dupla saiu junto.",
        "dropped": "&cVocê saiu da fila: a partida encontrada não pôde começar.",
        "found": "&aPartida encontrada! Preparando a arena.",
        "actionbar": "&7Fila: &f{mode} &8/ &f{waited} &8/ &7procurando &f±{radius} de elo",
        "invalid-mode": "&cA fila é 1v1 ou 2v2.",
        "not-queued": "&cVocê não está em nenhuma fila."
      },
      "challenge": {
        "sent": "&aDesafio enviado a &f{player} &8(expira em {time})&a.",
        "received": [
          "&6{player} &7te desafiou para um x1 casual.",
          "{accept} {decline} &8(expira em {time})"
        ],
        "already-sent": "&cVocê já tem um desafio pendente para {player}.",
        "none": "&c{player} não te desafiou, ou o desafio expirou.",
        "declined": "&7Você recusou o desafio de {player}.",
        "declined-by": "&c{player} recusou o seu desafio.",
        "expired-sender": "&7O seu desafio para {player} expirou.",
        "expired-target": "&7O desafio de {player} expirou."
      },
      "party": {
        "invite-sent": "&aConvite enviado a &f{player} &8(expira em {time})&a.",
        "invite-received": [
          "&6{player} &7te convidou para a party.",
          "{accept} {decline} &8(expira em {time})"
        ],
        "invite-declined": "&7Você recusou o convite de {player}.",
        "invite-declined-by": "&c{player} recusou o seu convite.",
        "invite-expired-sender": "&7O convite para {player} expirou.",
        "invite-expired-target": "&7O convite de {player} expirou.",
        "joined": "&a{player} entrou na party.",
        "left": "&7Você saiu da party.",
        "member-left": "&7{player} saiu da party.",
        "member-quit": "&7{player} saiu do servidor e deixou a party.",
        "kicked": "&c{player} tirou você da party.",
        "member-kicked": "&7{player} saiu da party por ordem do líder.",
        "promoted": "&6{player} &7agora é o líder da party.",
        "new-leader": "&6{player} &7assumiu a liderança da party.",
        "disbanded": "&c{player} desfez a party.",
        "dissolved": "&7{player} saiu, e a party acabou: sobrou só você.",
        // As respostas da PartyService (PartyService.Result).
        "results": {
          "self": "&cVocê não pode fazer isso consigo mesmo.",
          "not-leader": "&cSó o líder da party pode fazer isso.",
          "not-in-party": "&cVocê não está numa party.",
          "target-in-party": "&c{player} já está numa party.",
          "already-in-party": "&cVocê já está numa party. Saia dela antes.",
          "already-invited": "&cVocê já convidou {player}, e o convite ainda vale.",
          "no-invite": "&c{player} não te convidou, ou o convite expirou.",
          "not-member": "&c{player} não está na sua party.",
          "full": "&cA party já está no limite de jogadores."
        },
        "challenge": {
          "sent": "&aDesafio enviado à party de &f{player} &8(expira em {time})&a.",
          "received": [
            "&7A party de &6{player} &7({their_size}) desafiou a sua ({your_size}): &f{yours} contra {theirs}&7.",
