{
  "plugins": {
    // Os duelos do P4Free (módulo p4free/duels; spec docs/superpowers/specs/2026-09-30-p4free-duels-design.md
    // no exe). Sem prefixo de marca. Contagem pelo Plural (units) ou no formato "rótulo: valor".
    "duels": {
      "preferences": {
        "results": {
          "name": "&eResultados dos duelos",
          "description": [
            "&7Mostra os resultados dos x1 e do CxC,",
            "&7as winstreaks e as trocas de elo dos",
            "&7outros. Os seus aparecem sempre."
          ]
        }
      },
      "modes": {
        "challenge": "Desafio 1v1",
        "ranked-solo": "Ranqueada 1v1",
        "ranked-duo": "Ranqueada 2v2",
        "party-versus": "Party contra party",
        "party-split": "Split",
        "party-all": "Todos contra todos",
        "clan": "CxC"
      },
      // As palavras que acompanham um número montado no código (o Plural do core): 1 no singular.
      "units": {
        "copy": { "singular": "cópia", "plural": "cópias" },
        "elo-point": { "singular": "ponto de elo", "plural": "pontos de elo" },
        "kill": { "singular": "abate", "plural": "abates" },
        "piece": { "singular": "peça", "plural": "peças" },
        "player": { "singular": "jogador", "plural": "jogadores" }
      },
      // Os elos do exe-p4free-core sobre o elo da ranqueada 1v1 (o EloTier do duels diz onde cada um começa). A tag
      // entra no chat de todo jogador menos a staff (Moderador para cima), antes das equipadas, e o hover dela é o "chat-description". Os símbolos de
      // pictograma do antigo (☮ ☪ ☫ ☬ ☯ ☣) e o travessão do Starter foram trocados, porque não vão em texto do jogador.
      "elo": {
        "chat-description": "&7Elo {tier_name} &7no x1, com &f{elo} {points}&7. &eClique para ver o histórico.",
        // O fim da lore de cada cabeça do ranking de elo 1v1 no /top: o clique abre o histórico dela.
        "ranking-click": ["", "&eClique para ver o histórico."],
        "tiers": {
          "starter": { "name": "&8Starter", "tag": "&8[-]" },
          "primary": { "name": "&7Primary", "tag": "&7[=]" },
          "advanced": { "name": "&dAdvanced", "tag": "&d[✧]" },
          "expert": { "name": "&5Expert", "tag": "&5[❖]" },
          "silver": { "name": "&9Silver", "tag": "&9[✦]" },
          "gold": { "name": "&3Gold", "tag": "&3[✩]" },
          "diamond": { "name": "&bDiamond", "tag": "&b[♦]" },
          "emerald": { "name": "&aEmerald", "tag": "&a[❂]" },
          "cristal": { "name": "&2Cristal", "tag": "&2[✶]" },
          "sapphire": { "name": "&eSapphire", "tag": "&e[✷]" },
          "elite": { "name": "&6Elite", "tag": "&6[✹]" },
          "master": { "name": "&cMaster", "tag": "&c[❋]" },
          "legendary": { "name": "&4Legendary", "tag": "&4[✪]" }
        }
      },
      // Os botões dos convites no chat. A mensagem os mostra pelos placeholders {accept} e {decline}, e o clique
      // é ligado ao texto deles: mudar aqui muda nos dois lugares.
      "buttons": {
        "accept": "&a[Aceitar]",
        "join": "&a[Entrar]",
        "decline": "&c[Recusar]",
        // O que cada botão diz ao passar o mouse.
        "accept-hover": "&aClique para aceitar.",
        "join-hover": "&aClique para entrar.",
        "decline-hover": "&cClique para recusar."
      },
      // O que cada jogador está fazendo, na cabeça dele no menu da party.
      "activities": {
        "queue-solo": "&eNa fila ranqueada 1v1",
        "queue-duo": "&eNa fila ranqueada 2v2",
        "match": "&cNum duelo",
        "cabin": "&bNo camarote"
      },
      // Por que não dá: "self" é o texto ao próprio jogador (e a linha vermelha do ícone do menu); "other" é o
      // texto aos outros quando o motivo é de alguém. Curtos: também cabem numa linha de lore.
      "refusals": {
        "self": {
          // {action_name_gerund} é o "reiniciando" ou o "desligando" do core (plugins.core.actions.types).
          "restarting": "&cO servidor está {action_name_gerund}. Não dá para começar duelos agora.",
          "offline": "&cVocê precisa estar neste servidor.",
          "dead": "&cVocê está morto.",
          "in-combat": "&cVocê está em combate.",
          "vanished": "&cDesative o /v para jogar duelos ou entrar nas filas.",
          "partner-vanished": "&cSua dupla precisa desativar o /v para entrar na fila.",
          "busy-queue-solo": "&cVocê está na fila 1v1.",
          "busy-queue-duo": "&cVocê está na fila 2v2.",
          "busy-match": "&cVocê está num duelo.",
          "busy-cabin": "&cVocê está no camarote.",
          "no-arena": "&cNenhuma arena de duelo está ativa.",
          "no-free-arena": "&cTodas as arenas estão ocupadas agora.",
          "unavailable": "&cOs duelos estão indisponíveis agora.",
          "queue-closed": "&cAs filas do x1 estão fechadas. Aguarde a reabertura.",
          "loading": "&cSeus dados de duelo ainda estão carregando.",
          "stash-failed": "&cNão deu para guardar seus itens agora. Nada foi tirado de você.",
          "match-ended": "&cEssa luta já acabou.",
          "self": "&cVocê não pode desafiar a si mesmo.",
          "not-in-party": "&cVocê não está numa party.",
          "not-leader": "&cSó o líder da party pode fazer isso.",
          "same-party": "&cVocês estão na mesma party.",
          "too-few": "&cA party precisa de pelo menos 2 jogadores.",
          "party-too-big": "&cNa fila 2v2 a party tem de ter 2 jogadores.",
          "party-full": "&cA party já está no limite de jogadores do VIP do líder.",
          "party-vip-required": "&cSó VIPs podem criar e liderar parties.",
          // A permissão do VIP ainda carregando: não cresce a party, e o motivo não é o "Só VIPs".
          "party-loading": "&cAinda estamos carregando suas vantagens. Tente de novo em instantes.",
          "not-duo-leader": "&cSó o líder da dupla entra na fila 2v2.",
          "partner-offline": "&cSua dupla não está neste servidor.",
          "partner-busy": "&cSua dupla não está livre.",
          "partner-loading": "&cOs dados da sua dupla ainda estão carregando."
        },
        "other": {
          "restarting": "&cO servidor está {action_name_gerund}. Não dá para começar duelos agora.",
          "offline": "&c{player}&c não está neste servidor.",
          "dead": "&c{player}&c está morto.",
          "in-combat": "&c{player}&c está em combate.",
          "vanished": "&c{player}&c precisa desativar o /v para jogar duelos.",
          "busy-queue-solo": "&c{player}&c está na fila 1v1.",
          "busy-queue-duo": "&c{player}&c está na fila 2v2.",
          "busy-match": "&c{player}&c está num duelo.",
          "busy-cabin": "&c{player}&c está no camarote.",
          "loading": "&cOs dados de duelo de {player}&c ainda estão carregando.",
          "stash-failed": "&cNão deu para guardar os itens de {player}&c agora. Nada foi tirado de ninguém.",
          "not-in-party": "&c{player}&c não está numa party."
        }
      },
      "titles": {
        "countdown": { "title": "&e{seconds}", "subtitle": "&7Prepare-se" },
        "fight": { "title": "&cValendo!", "subtitle": "&7Boa luta" }
      },
      "messages": {
        "command-blocked": "&cEsse comando não pode ser usado nos duelos.",
        // O /v da staff ligado numa fila ou num duelo (MatchListener.onVanish).
        "vanish-blocked": "&cVocê não pode ativar o /v enquanto estiver numa fila ou num duelo. No camarote ele continua permitido.",
        // Só na ranqueada, para o servidor inteiro: a cada 5 vitórias seguidas, e a quebra de uma de 10 ou mais.
        "streak": "&6{player} &7chegou a &e{streak} vitórias seguidas &7na ranqueada.",
        "streak-broken": "&7A sequência de &e{streak} vitórias &7de &6{player} &7acabou.",
        // Quem mudou de elo na ranqueada 1v1, para o servidor inteiro, como no exe-p4free-core.
        "elo-promoted": "&a&l▸ &r{player} &asubiu para o ELO {tier_name}&a.",
        "elo-demoted": "&c&l▸ &r{player} &ccaiu para o ELO {tier_name}&c.",
        // O hover dos dois de cima. O clique roda o /elo historico de quem mudou de elo.
        "elo-hover": [
          "&6{player}",
          "&8 ▸ &fElo 1v1: &7{elo_before} &8→ &f{elo_after}",
          "&8 ▸ &fElo anterior: {from_tag} {from_name}",
          "&8 ▸ &fPartidas 1v1: &f{matches}",
          "&8 ▸ &fVitórias seguidas: &f{streak}",
          "&eClique para ver o histórico de elo."
        ],
        // O abate nas lutas com mais de dois jogadores (2v2 e party), para quem luta e para o camarote. Os nicks vão na
        // cor do lado como quem lê os vê, e {kills} é a conta de quem matou nesta luta ("2 abates").
        "kill": {
          "by": "{victim} &7foi eliminado por {killer} &7({health}&c❤&7, {kills}).",
          "alone": "{victim} &7morreu."
        },
        // O resultado vai a todos no P4Free local. {winners} e {losers} viram os nomes, cada um com
        // as estatísticas da luta no hover.
        "result": {
          "duel": "&6&lX1 &r&f{winners} &7({health}&c❤&7) &evenceu o duelo contra &f{losers}&e.",
          "team": "&6&lX1 &r&eVitória de &f{winners} &econtra &f{losers} &7({format})&e.",
          "draw": "&7A luta terminou empatada &8({format})&7.",
          "elo-won": "&a+{amount} {points} &8(agora {elo})",
          "elo-lost": "&c-{amount} {points} &8(agora {elo})",
          "hover": [
            "&6{player}",
            "&8 ▸ &fGolpes: &f{hits}",
            "&8 ▸ &fMaior combo: &f{combo}",
            "&8 ▸ &fMaçãs comidas: &f{apples}",
            "&8 ▸ &fGolpes defendidos: &f{blocked}"
          ],
          // A última linha do hover do nome: o clique abre a foto do inventário dele (views.inventory), por 5 minutos.
          "inventory": "&eClique para ver o inventário."
        }
      },
      "queue": {
        "opened": "&e{player}&e abriu as filas do x1.",
        "closed": "&e{player}&e fechou as filas do x1.",
        "already-open": "&cAs filas do x1 já estão abertas.",
        "already-closed": "&cAs filas do x1 já estão fechadas.",
        "joined": "&aVocê entrou na fila de &f{mode}&a.",
        "already": "&cVocê já está nessa fila.",
        "left": "&7Você saiu da fila.",
        "partner-left": "&c{player}&c saiu da fila, e a dupla saiu junto.",
        "dropped": "&cVocê saiu da fila porque a partida encontrada não pôde começar.",
        "found": "&aPartida encontrada! Preparando a arena.",
        "actionbar": "&7Fila: &f{mode} &8/ &f{waited} &8/ &7procurando &f±{radius} de elo",
        "invalid-mode": "&cA fila é 1v1 ou 2v2.",
        "not-queued": "&cVocê não está em nenhuma fila."
      },
      "challenge": {
        "sent": "&aDesafio enviado a &f{player} &8(expira em {time})&a.",
        "received": [
          "&6{player} &7te desafiou para um x1 casual.",
          "{accept} {decline} &8(expira em {time})"
        ],
        "already-sent": "&cVocê já tem um desafio pendente para {player}&c.",
        "none": "&c{player}&c não te desafiou, ou o desafio expirou.",
        "declined": "&7Você recusou o desafio de {player}&7.",
        "declined-by": "&c{player}&c recusou o seu desafio.",
        "expired-sender": "&7O seu desafio para {player}&7 expirou.",
        "expired-target": "&7O desafio de {player}&7 expirou."
      },
      "party": {
        "invite-sent": "&aConvite enviado a &f{player} &8(expira em {time})&a.",
        "invite-received": [
          "&6{player} &7te convidou para a party.",
          "{accept} {decline} &8(expira em {time})"
        ],
        "invite-declined": "&7Você recusou o convite de {player}&7.",
        "invite-declined-by": "&c{player}&c recusou o seu convite.",
        "invite-expired-sender": "&7O convite para {player}&7 expirou.",
        "invite-expired-target": "&7O convite de {player}&7 expirou.",
        "joined": "&a{player}&a entrou na party.",
        "left": "&7Você saiu da party.",
        "member-left": "&7{player}&7 saiu da party.",
        "member-quit": "&7{player}&7 saiu do servidor e deixou a party.",
        "kicked": "&c{player}&c tirou você da party.",
        "member-kicked": "&7{player}&7 saiu da party por ordem do líder.",
        "promoted": "&6{player} &7agora é o líder da party.",
        "new-leader": "&6{player} &7assumiu a liderança da party.",
        "disbanded": "&c{player}&c desfez a party.",
        "dissolved": "&7{player}&7 saiu. A party acabou porque sobrou só você.",
        "eligibility-dissolved": "&7A party acabou porque nenhum membro tem um VIP com limite para liderar o grupo.",
        // As respostas da PartyService (PartyService.Result).
        "results": {
          "self": "&cVocê não pode fazer isso consigo mesmo.",
          "not-leader": "&cSó o líder da party pode fazer isso.",
          "not-in-party": "&cVocê não está numa party.",
          "target-in-party": "&c{player}&c já está numa party.",
          "already-in-party": "&cVocê já está numa party. Saia dela antes.",
          "already-invited": "&cVocê já convidou {player}&c, e o convite ainda vale.",
          "no-invite": "&c{player}&c não te convidou, ou o convite expirou.",
          "not-member": "&c{player}&c não está na sua party.",
          "full": "&cA party já está no limite de jogadores do VIP do líder.",
          "vip-required": "&cSó VIPs podem criar e liderar parties. Samurai permite até 8 membros e Imperial até 16, incluindo o líder.",
          "target-vip-required": "&c{player}&c precisa ser VIP para liderar a party.",
          "target-limit": "&cO limite do VIP de {player}&c não comporta todos os membros da party.",
          // A permissão de quem lidera, ou de quem receberia a liderança, ainda carregando.
          "loading": "&cAinda estamos carregando suas vantagens. Tente de novo em instantes.",
          "target-loading": "&cAinda estamos carregando as vantagens de {player}&c. Tente de novo em instantes."
        },
        "challenge": {
          "sent": "&aDesafio enviado à party de &f{player} &8(expira em {time})&a.",
          "received": [
            "&7A party de &6{player} &7({their_size}) desafiou a sua ({your_size}) para uma luta de &f{yours} contra {theirs}&7.",
            "{accept} {decline} &8(expira em {time})"
          ],
          "already-sent": "&cVocê já desafiou a party de {player}&c.",
          "none": "&cA party de {player}&c não desafiou a sua, ou o desafio expirou.",
          "declined": "&7Você recusou o desafio da party de {player}&7.",
          "declined-by": "&c{player}&c recusou o desafio da sua party.",
          "expired-sender": "&7O desafio para a party de {player}&7 expirou.",
          "expired-target": "&7O desafio da party de {player}&7 expirou."
        }
      },
      "cabin": {
        "entered": "&aVocê está no camarote. Para sair, use &f/x1 camarote sair&a.",
        "entered-cxc": "&aVocê está no camarote. Para sair, use &f/cxc sair&a.",
        "left": "&7Você saiu do camarote.",
        "not-watching": "&cVocê não está no camarote.",
        "not-fighting": "&c{player}&c não está lutando agora."
      },
      // O CxC, duelo de clãs (spec docs/superpowers/specs/2026-10-10-p4free-cxc-design.md no exe).
      "cxc": {
        "refusals": {
          "restarting": "&cO servidor está {action_name_gerund}. Não dá para começar um CxC agora.",
          "no-clan": "&cVocê não está num clã.",
          "not-officer": "&cSó o líder ou um capitão responde pelo clã no CxC.",
          "not-vip": "&cO CxC é uma vantagem dos VIPs.",
          "unknown-clan": "&cNenhum clã com a tag {tag}.",
          "same-clan": "&cVocê não pode desafiar o próprio clã.",
          "in-cxc": "&cSeu clã já está num CxC.",
          "other-in-cxc": "&cO clã {tag} &cjá está num CxC.",
          "pending": "&cSeu clã já tem um convite de CxC pendente.",
          "other-pending": "&cO clã {tag} &cjá tem um convite de CxC pendente.",
          "no-vip-online": "&cO clã {tag} &cnão tem nenhum VIP online agora.",
          "no-arena": "&cNenhuma arena de CxC está ativa.",
          "no-free-arena": "&cTodas as cópias deste mapa estão ocupadas agora.",
          "no-kit": "&cO kit do CxC ainda não foi gravado pela staff.",
          "no-invite": "&cO clã {tag} &cnão desafiou o seu, ou o convite expirou.",
          "arena-gone": "&cO mapa escolhido saiu do ar. O convite foi cancelado.",
          "empty-side": "&cO CxC não começou porque o clã {tag}&c não tem nenhum VIP livre.",
          "not-fighting": "&cO clã {tag} &cnão está lutando agora.",
          "kit-busy": "&cSaia dos duelos e do camarote antes de gravar o kit.",
          "kit-empty": "&cSeu inventário está vazio. Monte o kit antes."
        },
        "invite": {
          "sent": [
            "",
            "&eSeu clã acaba de enviar um convite de duelo para o clã {tag}&e.",
            "&eEles têm &a{time} &epara aceitar o duelo. Apenas &bjogadores VIPs &eserão puxados para a arena.",
            ""
          ],
          "received": [
            "",
            "&eO clã {tag} &eacabou de desafiar o seu clã para um duelo!",
            "&8 ▸ &fMapa: &7{arena}",
            "&8 ▸ &fVIPs online: &a{challengers} &7contra &a{defenders}",
            "{accept} {decline}",
            "",
            "&eO convite expira em {time}.",
            ""
          ],
          "declined": "&7{player}&7 recusou o desafio do clã {tag}&7.",
          "declined-by": "&cO clã {tag} &crecusou o desafio do seu clã.",
          "expired-sender": "&7O convite de CxC para o clã {tag} &7expirou.",
          "expired-target": "&7O convite de CxC do clã {tag} &7expirou."
        },
        "left-out": {
          "not-vip": [
            "",
            "&cVocê não foi puxado para o CxC do seu clã.",
            "&fApenas &cjogadores VIPs &fsão puxados e participam do CxC.",
            "&fNão perca a próxima batalha. Acesse &ewww.rede-exe.com",
            ""
          ],
          "busy": "&cVocê ficou de fora do CxC do seu clã:"
        },
        "kit-saved": "&aKit do CxC gravado com {pieces}. Vale a partir do próximo duelo.",
        "opening": [
          "",
          "&e&l Duelo de Clãs",
          "&7 {first} &7contra {second}",
          "&7 Elimine o clã adversário para vencer!",
          ""
        ],
        "countdown": "&aO combate inicia em {seconds}s",
        "titles": {
          "count-5": { "title": "&4➎ &8➍ &8➌ &8➋ &8➊", "subtitle": "" },
          "count-4": { "title": "&8➎ &c➍ &8➌ &8➋ &8➊", "subtitle": "" },
          "count-3": { "title": "&8➎ &8➍ &6➌ &8➋ &8➊", "subtitle": "" },
          "count-2": { "title": "&8➎ &8➍ &8➌ &e➋ &8➊", "subtitle": "" },
          "count-1": { "title": "&8➎ &8➍ &8➌ &8➋ &a➊", "subtitle": "" },
          "fight": { "title": "&a&lLUTE!", "subtitle": "" }
        },
        "strength": {
          "warning": "&e&lAVISO: &eEm &c{time} &etodos os jogadores vivos receberão &c&lForça III&e!",
          "applied": [
            "",
            "&c&l FORÇA III ATIVADA",
            "&7 Todos os jogadores vivos receberam &c&lForça III&7!",
            ""
          ]
        },
        "kill": {
          "colors": { "ally": "&a", "enemy": "&c", "neutral": "&e" },
          "by": "{victim_color}[{victim_tag}] {victim} &ffoi &c&lELIMINADO &fpor {killer_color}[{killer_tag}] {killer} &7({kills})&f.",
          "alone": "{victim_color}[{victim_tag}] {victim} &7foi eliminado."
        },
        // O resultado vai a quem lutou e ao camarote; {winners} e {losers} viram os nomes, com as estatísticas no hover.
        "result": {
          "win": "&7Vitória do clã {winner} &7contra {loser}&7: &6{winners} &8(abates: {winner_kills}) &7contra &f{losers} &8(abates: {loser_kills})&7. Duração: &f{duration}&7.",
          "draw": "&7O CxC entre {first} &7e {second} &7terminou empatado. Duração: &f{duration}&7.",
          // Um lado inteiro saiu antes do "LUTE!": não houve luta, e a vitória não é gravada.
          "cancelled": "&7O CxC entre {first} &7e {second} &7acabou antes da luta começar."
        },
        "broadcast": {
          // Uma linha para o backend local: início da contagem com camarote clicável e término, inclusive cancelamento.
          "start": "&6CxC &fentre os clãs {first} &8({first_size}) &fe {second} &8({second_size})&f. {watch}",
          "watch": "&e[Assistir no camarote]",
          "watch-hover": "&eClique para assistir a este CxC do camarote.",
          "win": "&fO clã {winner} &fvenceu o clã {loser} &fno &6CxC&f.",
          "draw": "&fO &6CxC &fentre {first} &fe {second} &fterminou empatado.",
          "cancelled": "&fO &6CxC &fentre {first} &fe {second} &ffoi cancelado antes de começar."
        },
        "scoreboard": {
          "lines": [
            "{build_mode_status}",
            "",
            "&f Duração: &a{cxc_time}",
            "{cxc_kills}",
            "",
            "&f Jogadores restantes:",
