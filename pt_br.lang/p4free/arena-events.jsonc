{
  "plugins": {
    // O ClanFight e o FastGlad no padrão do Gladiador (events.jsonc): as faixas riscadas em volta dos anúncios, o
    // [evento] em vermelho-escuro nas entradas, saídas e abates, e a tag do clan em [cinza]. Toda mensagem das arenas
    // tem o {event} (ClanFight, FastGlad), o {event_title} (o mesmo em maiúsculas, para a faixa) e o {event_tag} (a tag
    // que o clan vencedor ganha); o stash-failed, o not-in-event e as respostas da staff só têm o {event}, e as do
    // expulsar também o {player} ou o {clan}. Cada bloco que abre com linha em branco fecha com outra.
    "arena-events": {
      "arguments": {
        "location": {
          "name": "entry|cabin|pos1|pos2|deathmatch",
          "description": "O ponto do mapa do evento a gravar onde você está"
        },
        "player": {
          "name": "jogador",
          "description": "Jogador a reviver no evento"
        },
        "kick-player": {
          "name": "jogador",
          "description": "Jogador a expulsar do evento"
        },
        "clan": {
          "name": "tag",
          "description": "A tag do clan a expulsar do evento"
        },
        "coins-player": {
          "name": "jogador",
          "description": "Quem luta no FastGlad e ganha ou perde as moedas"
        },
        "coins": {
          "name": "moedas",
          "description": "Quantas moedas de abate dar ou tirar"
        }
      },
      // A tag de um clan nos abates, pintada para cada um que lê: verde para o próprio clan, vermelha para os outros.
      "clan-tag": {
        // Nos abates, como no exe-gladiador: verde para o clã de quem lê e vermelho para os outros, com a tag na cor
        // do clã dentro (o &7 só pinta a tag sem cor). Nas outras mensagens os colchetes são &7.
        "own": "&a[&7{tag}&a]",
        "other": "&c[&7{tag}&c]"
      },
      // O que o "AQUI" da abertura e da espera diz ao passar o mouse.
      "join-hover": "&eClique para entrar no {event}.",
      // O status do FastGlad a cada 600 segundos de luta, inclusive no deathmatch, como no exe-fastgladiator.
      "status": [
        "",
        "&2&l&m      &a&l&m      &r &f&lSTATUS DO FASTGLAD &a&l&m      &2&l&m     ",
        "",
        "&eTempo: &f{time}",
        "",
        "&eClans Participando:",
        "{event_clan_list}",
        "",
        "&2&l&m      &a&l&m      &r &f&lSTATUS DO FASTGLAD &a&l&m      &2&l&m     ",
        ""
      ],
      // A abertura, com o tempo inteiro da espera. O "AQUI" leva o clique do entrar.
      "start": [
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        "",
        "&fO Evento {event} foi &a&lINICIADO&f!",
        "&6 ► &fUse &e/{command} entrar &fou clique &e&lAQUI&f.",
        "",
        "&e&lPremiações do evento",
        "&6• &fTag {event_tag} &fpara os jogadores do clan vencedor",
        "",
        "&c► &fO evento começará em &a{time}&f.",
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        ""
      ],
      // A contagem da espera, a cada 30 s.
      "waiting": [
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        "",
        "&fO Evento {event} começará em &a{time}&f!",
        "&6 ► &fUse &e/{command} entrar &fou clique &e&lAQUI&f.",
        "",
        "&7 Participantes: &f{event_players_size}",
        "&7 Clans confirmados: &f{event_clans_size}",
        "&7 {event_clan_list}",
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        ""
      ],
      "cancelled": [
        "",
        "&4&l&m       &c&l&m       &r &f&l{event_title} &c&l&m       &4&l&m       ",
        "",
        "&c&lEVENTO CANCELADO!",
        "&fO evento foi cancelado por falta de jogadores",
        "&fou por um membro da &eStaff&f.",
        "",
        "&4&l&m       &c&l&m       &r &f&l{event_title} &c&l&m       &4&l&m       ",
        ""
      ],
      // A todos os apps do P4Free; quem está no evento recebe logo a seguir o bloco do preparing-time.
      "locked": "&4[{event}] &cAs entradas do evento foram fechadas!",
      "preparing-time": [
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        "",
        "&fO PvP irá começar em &a{time}&f.",
        "&fJunte os membros e boa sorte!",
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        ""
      ],
      "fight": [
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        "",
        "&c&lPVP ATIVO!",
        "&fO PvP foi &aativado&f. Que comecem as batalhas!",
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        ""
      ],
      // A contagem na barra de ação, a cada segundo, para quem está na arena e no camarote, como a do Gladiador.
      "actionbar": {
        "waiting": "&aComeçando em {time}...",
        "preparing": "&aO PvP vai ser ativo em {time}..."
      },
      // O (N) das entradas e saídas é quantos ainda estão no evento.
      "join": "&4[{event}] &cO jogador &7[{clan_tag}&7] &f{player_name} &centrou no evento. &f({event_players})",
      "quit": "&4[{event}] &cO jogador &7[{clan_tag}&7] &f{player_name} &csaiu do evento. &f({event_players})",
      // O revive da staff no ClanFight fora da espera, como o "foi revivido" do Gladiador. No FastGlad, como no
      // exe-fastgladiator, e na espera, o revivido sai com o "entrou no evento" (o join).
      "revived": "&4[{event}] &cO jogador &7[{clan_tag}&7] &f{player_name} &cfoi revivido. &f({event_players})",
      // O aviso a quem o revive da staff traz de volta ao ClanFight, antes da contagem de 5 s no title (os algarismos e o
      // "Você será ressuscitado!" são os do Gladiador). O FastGlad, como o exe-fastgladiator, revive sem contagem.
      "revive-countdown": [
        "",
        "&eVocê será ressuscitado no evento {event} em &e&l5 segundos&e, prepare-se!",
        ""
      ],
      // O expulsar e o expulsar clan da staff, como o /fastglad kick e kickclan do exe-fastgladiator.
      "kicked": "&4[{event}] &cO jogador &7[{clan_tag}&7] &f{player_name} &cfoi expulso do evento. &f({event_players})",
      "clan-kicked": "&4[{event}] &cO clan &7[{clan_tag}&7] &cfoi expulso do evento.",
      "kicked-notice": "&cVocê foi expulso do {event} por um membro da Staff!",
      "kill": "&4[{event}] {victim_clan} {victim_name} &7foi &c&lELIMINADO &7por {killer_clan} {killer_name} &7({killer_kills} {killer_kills_unit}).",
      // A morte sem matador (queda, lava, borda).
      "death": "&4[{event}] {victim_clan} {victim_name} &7foi &c&lELIMINADO &7do evento.",
      // Só para quem matou, logo depois do anúncio do abate.
      "kills": "&eVocê agora tem &6{kills} &e{kills_unit}.",
      "eliminated": "&4[{event}] &cO clan &7[{clan_tag}&7] &cfoi eliminado do evento! &f{remaining_verb} {remaining_clans} {remaining_clans_unit}.",
      // O duelo do ClanFight, como o rush do Gladiador: o (N) é quantos de cada clan estão vivos.
      "round": [
        "",
        "&4&l&m      &c&l&m      &r &f&lBATALHA &c&l&m      &4&l&m      ",
        "",
        "&e&l UMA BATALHA COMEÇOU!",
        " &7[{first}&7] &7({first_alive}) &fvs &7[{second}&7] &7({second_alive})",
        "",
        "&4&l&m      &c&l&m      &r &f&lBATALHA &c&l&m      &4&l&m      ",
        ""
      ],
      "round-timeout": "&4[{event}] &cOs dois clans da batalha foram eliminados por exceder o tempo limite.",
      // Os titles do exe-clanfight, com o mesmo som de antes. Entre dois duelos: 5 s de pausa, o draw (um par qualquer
      // dos vivos a cada segundo, para todos na arena e no camarote) 5 vezes, o drawn com o par de verdade, a contagem de
      // 5 a 1 e o fight só para quem vai lutar. O win-event é dos dois eventos, como o do Gladiador.
      "title": {
        "draw": {
          "title": "&bSorteando batalha...",
          "subtitle": "&7[{first}&7] &cvs &7[{second}&7]"
        },
        "drawn": {
          "title": "&f",
          "subtitle": "&7[{first}&7] &fx &7[{second}&7]"
        },
        // O número da vez em cor e os outros apagados, como os ➎ ➍ ➌ ➋ ➊ do original, em algarismos (o 1.8 desenha
        // esses símbolos com outra fonte, de outro tamanho).
        "countdown": {
          "5": {
            "title": "&45 &84 &83 &82 &81",
            "subtitle": "&7[{first}&7] &fvs &7[{second}&7]"
          },
          "4": {
            "title": "&85 &c4 &83 &82 &81",
            "subtitle": "&7[{first}&7] &fvs &7[{second}&7]"
          },
          "3": {
            "title": "&85 &84 &63 &82 &81",
            "subtitle": "&7[{first}&7] &fvs &7[{second}&7]"
          },
          "2": {
            "title": "&85 &84 &83 &e2 &81",
            "subtitle": "&7[{first}&7] &fvs &7[{second}&7]"
          },
          "1": {
            "title": "&85 &84 &83 &82 &a1",
            "subtitle": "&7[{first}&7] &fvs &7[{second}&7]"
          }
        },
        "fight": {
          "title": "&a&lLUTEM!",
          "subtitle": "&7[{first}&7] &fvs &7[{second}&7]"
        },
        "win-event": {
          "title": "&c{event_title} ACABOU",
          "subtitle": "&7[{clan}&7] &fvenceu o evento!"
        },
        // A borda do FastGlad, como a do Gladiador: o número dos 5 s antes de cada redução (com o clique) e o aviso que
        // fica na tela enquanto ela fecha (com o wither).
        "border-warn": {
          "title": "&c{seconds}",
          "subtitle": "&fA borda vai fechar!"
        },
        "border-change": {
          "title": "&4Borda fechando!",
          "subtitle": "&fMovam-se para dentro da nova área!"
        },
        // A chegada do Mercador Sombrio do FastGlad, com o som do wither, como no exe-fastgladiator.
        "merchant-arrive": {
          "title": "&9O Mercador Sombrio chegou!",
          "subtitle": "&fCurvem-se perante ao seu rei."
        },
        // O deathmatch do FastGlad começou, com a explosão: o title tira da tela o "Borda fechando!".
        "deathmatch": {
          "title": "&4&lDEATHMATCH",
          "subtitle": "&fA luta final vai começar!"
        }
      },
      // O fim de cada duelo: o {round_result} é uma das linhas do round-result, e o {round_hits} a linha do round-hits,
      // que some quando ninguém acertou ninguém. O {round_inventories} é a linha do round-inventories, só para quem estava
      // na arena e no camarote e para quem lutou. Cada nome abre a foto do inventário de quem lutou, como no x1. O clique
      // se acha pelo nome já pintado do "player", então ele precisa da cor na frente do {player}.
      "round-finished": [
        "",
        "&4&l&m      &c&l&m      &r &f&lBATALHA &c&l&m      &4&l&m      ",
        "",
        "&e&l BATALHA FINALIZADA!",
        "",
        "{round_result}",
        "{round_hits}",
        "{round_inventories}",
        "",
        "&4&l&m      &c&l&m      &r &f&lBATALHA &c&l&m      &4&l&m      ",
        ""
      ],
      "round-result": {
        "won": "&7 Vencedor: &7[{winner}&7] contra &7[{loser}&7].",
        "none": "&7 Nenhum clan ficou de pé nesta batalha."
      },
      "round-hits": [
        "&7 Mais hits na batalha: &7[{clan}&7] &f{player} &7({hits} {hits_unit})"
      ],
      "round-inventories": {
        "line": "&7 Inventários: {players}",
        "player": "&f{player}",
        "separator": "&7, ",
        "hover": "&eClique para ver o inventário de {player}."
      },
      // A borda do FastGlad, como a do Gladiador.
      "border": [
        "",
        "&4&l&m       &c&l&m       &r &f&lBORDA FECHANDO &c&l&m       &4&l&m       ",
        "",
        "&c  &4&lATENÇÃO, JOGADORES!",
        "&c  &fA borda está se fechando!",
        "",
        "    &4• &fNovo tamanho da borda: &c{size} x {size}",
        "    &4• &fTempo para fechar: &c{time}",
        "",
        "&c  &fPreparem-se e movam-se para dentro da nova área!",
        "",
        "&4&l&m       &c&l&m       &r &f&lBORDA FECHANDO &c&l&m       &4&l&m       ",
        ""
      ],
      "deathmatch": [
        "",
        "&4&l&m       &c&l&m       &r &f&lDEATHMATCH &c&l&m       &4&l&m       ",
        "",
        "&4&lDEATHMATCH INICIADO!",
        "&6 ► &fOs jogadores foram puxados para a arena de",
        "&f deathmatch e terão que batalhar até restar um só clan!",
        "",
        "&4&l&m       &c&l&m       &r &f&lDEATHMATCH &c&l&m       &4&l&m       ",
        ""
      ],
      // O Mercador Sombrio do FastGlad, com o texto do exe-fastgladiator: um wither no centro do mapa (o ponto entry, o
      // centro da borda), e o clique direito nele, a até 6 blocos, abre a loja. O {time} é a duração da visita na
      // chegada e quanto falta para a próxima na despedida; a última visita se despede com o merchant-gone.
      "merchant-name": "&9Mercador Sombrio",
      "merchant-open": [
        "",
        "&9 [Mercador Sombrio] &7Aaah, esses meros mortais de novo! Utilizem suas &6moedas de abate &7para comprar itens comigo, quem sabe assim deixam de ser tão insignificantes...",
        "",
        "&f Estou no &acentro do mapa&f. Cliquem em mim com o botão direito.",
        "&f Fiquem atentos, eu vou embora em &a{time}&f.",
        ""
      ],
      "merchant-leave": [
        "",
        "&9 [Mercador Sombrio] &7Já cansei de vocês, mortais medíocres. Meu tempo aqui acabou, mas não chorem demais...",
        "",
        "&f Eu voltarei em &a{time} &fpara oferecer meus itens, caso ainda queiram tentar ser alguém neste mundo.",
        ""
      ],
      "merchant-gone": [
        "",
        "&9 [Mercador Sombrio] &7Já cansei de vocês, mortais medíocres. Meu tempo aqui acabou, agora podem chorar...",
        "",
        "&f Eu não voltarei mais para este lugar!",
        ""
      ],
      "winner": [
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        "",
        "&fO Evento {event} foi &c&lFINALIZADO&f!",
        "&6 ► &fO clan &7[{clan}&7] &ffoi o grande vencedor!",
        "",
        "&6• &fTodos os membros do clan receberão a tag {event_tag}",
        "",
        "&4&l&m      &c&l&m      &r &f&l{event_title} &c&l&m      &4&l&m      ",
        ""
      ],
      // Logo depois do vencedor do ClanFight: os 3 que mais deram hits, somados todos os duelos.
      "hits-ranking": [
        "",
        "&e&l Quem mais deu hits no {event}:",
        ""
      ],
      "hits-ranking-entry": "&6 {position}º &7[{clan}&7] &f{player} &7com &b{hits} &7{hits_unit}",
      "hits-ranking-footer": [""],
      // Logo depois do vencedor do FastGlad, como o exe-fastgladiator: os 3 que mais abateram na partida.
      "kills-ranking": [
        "",
        "&e&l Quem mais abateu no {event}:",
        ""
      ],
      "kills-ranking-entry": "&6 {position}º &7[{clan}&7] &f{player} &7com &c{kills} &7{kills_unit}",
      "kills-ranking-footer": [""],
      "cannot-join": "&cNão foi possível entrar no {event}. Confira o seu clan e o limite de membros do evento.",
      "combat-leave": "&cVocê não pode sair do {event} em combate!",
      "command-blocked": "&cVocê não pode usar comandos durante o {event}.",
      "not-in-event": "&cVocê não está no {event}!",
      "already-in-event": "&cVocê já está participando do {event}.",
      // O /entrar de quem a staff expulsou na espera, até o fim da partida.
      "kicked-cannot-join": "&cVocê não pode entrar de novo, pois foi expulso desta partida do {event}.",
      // As respostas do revive da staff que dizem o nome do evento. As outras (o sucesso, a falha, o "já está no processo",
      // sem clan, o /v e o "não está online no P4Free") são as do /glad revive, que servem aos três.
      "revive": {
        "bringing": "&eO jogador está sendo levado ao {event} para ser revivido.",
        "not-arrived": "&cO jogador não chegou ao {event} a tempo de ser revivido.",
        "not-running": "&cNão há um {event} em andamento para reviver alguém.",
        "alive": "&cEste jogador ainda está lutando no {event}!",
        "clan-changed": "&cEste jogador trocou de clan depois de entrar no {event} e não pode voltar pelo clan antigo.",
        // Só no ClanFight, como no exe-clanfight, onde o revive traz quem é de um clan da partida, mesmo eliminado.
        "clan-not-in-match": "&cO clan deste jogador não está participando do {event}."
      },
      "stash-failed": "&cNão foi possível guardar seu inventário agora. Tente entrar no {event} de novo.",
      "action-success": "&aAção aplicada ao evento com sucesso!",
      "kick-success": "&aVocê expulsou {player} do {event}.",
      "kick-failed": "&c{player} não está no {event}.",
      // O expulsar e o expulsar clan com a partida acabando, quando a saída de todos já está em curso.
      "kick-ending": "&cO {event} já está acabando. Ninguém pode ser expulso agora.",
      "kick-clan-success": "&aVocê expulsou o clan {clan} do {event}.",
      "kick-clan-failed": "&cO clan {clan} não tem ninguém lutando no {event}.",
      "clan-not-found": "&cNão existe nenhum clan com a tag {clan}.",
      "action-failed": "&cNão foi possível aplicar esta ação no estado atual do evento.",
      // O menu do /clanfight e do /fastglad, como o do Gladiador (views.gladiator.primary do events.jsonc). O layout
      // de cada um fica no server-menus (events/clan-fight/primary e events/fast-glad/primary).
      "views": {
        "primary": {
          "title": "{event}",
          "items": {
            "ranking": {
              "name": "&eRanking",
              "lore": [
                "&7Clique com o botão esquerdo para",
                "&7abrir o ranking do &6{event}&7."
              ]
            },
            "commands": {
              "name": "&eComandos",
              "lore": [
                "&7Clique com o botão esquerdo para saber",
                "&7todos os comandos do &6{event}&7!"
              ]
            },
            "history": {
              "name": "&eHistórico",
              "lore": [
                "&7Clique com o botão esquerdo para",
                "&7ver as edições anteriores do &6{event}&7."
              ]
            },
            "event": {
              "inactive": {
                "name": "&cNenhum evento rolando",
                "lore": [
                  "&7Nenhum evento está acontecendo nesse",
                  "&7momento. Fique ligado em nosso &fDiscord&7."
                ]
              },
              "waiting": {
                "name": "&6{event}",
                "lore": [
                  "&fO evento está {event_status}&f!",
                  "",
                  "&c• &fTag {event_tag} &fpara o clan vencedor",
                  "",
                  "&7Participantes: &f{event_players}",
                  "&7Clans: &f{event_clans}",
                  "",
                  "&7Clique com o botão esquerdo para entrar",
                  "&7Clique com o botão direito para assistir"
                ]
              },
              "running": {
                "name": "&6{event}",
                "lore": [
                  "&fO evento está {event_status}&f!",
                  "",
                  "&7Participantes vivos: &f{event_players}",
                  "&7Clans vivos: &f{event_clans}",
                  "",
                  "&7Clique com o botão direito para assistir"
                ]
              }
            }
          }
        },
        // A lista das edições, a mesma vista da do Gladiador: por isso o "mais abates" vem no {event_myth}. O layout é
        // um só para as duas arenas (events/arena/history e events/arena/history-detail no server-menus).
        "history": {
          "title": "Histórico do {event}",
          "items": {
            "entry": {
              "name": "&a{event} de {event_date}",
              "lore": [
                "&7Data: &f{event_date}",
                "&7Tempo de evento: &f{event_duration}",
                "&7Jogadores participantes: &f{event_players}",
                "&cClan vencedor: &f{clan_winner}",
                "&7Mais abates: &f{event_myth} &8({event_myth_kills} {event_myth_kills_unit})",
                "",
                "&eClique para ver os detalhes!"
              ]
            },
            "back": {
              "name": "&cVoltar",
              "lore": [
                "&7Volta à central do {event}."
              ]
            }
          }
        },
        "history-detail": {
          "title": "Detalhes do {event}",
          "items": {
            "overview": {
              "name": "&6&lResumo do evento",
              "lore": [
                "&7Estado: &f{event_status}",
                "&7Data: &f{event_date}",
                "&7Tempo de evento: &f{event_duration}",
                "",
                "&7Participantes: &f{event_players}",
                "&7Clans: &f{event_clans}"
              ]
            },
            // A formação vencedora sai uma linha por jogador; sem vencedor, a linha some.
            "winner": {
              "name": "&a&lClan vencedor",
              "lore": [
                "",
                "&a{clan_winner}",
                "&7• &f{event_winners}",
                "",
                "&7Resultado desta edição do {event}."
              ]
            },
            "killer": {
              "name": "&e&lMais abates",
              "lore": [
                "",
                "&f{top_killer} &8(&f{top_killer_kills} {top_killer_kills_unit}&8)",
                "",
                "&7Jogador com mais abates nesta edição."
              ]
            },
            "kills": {
              "name": "&4&lAbates",
              "lore": [
                "&7Total de abates: &f{event_kills}"
              ]
            },
            "hitter": {
              "name": "&b&lMais hits",
              "lore": [
                "",
                "&f{top_hitter} &8(&f{top_hitter_hits} {top_hitter_hits_unit}&8)",
                "",
                "&7Jogador que mais acertou golpes nesta edição."
              ]
            },
            "back": {
              "name": "&cVoltar ao histórico",
              "lore": [
                "&7Volta ao histórico do {event}."
              ]
            }
          }
        }
      },
      "history": {
        "loading": "Consultando o histórico do {event}..."
      }
    }
  }
}
