{
  "plugins": {
    "batatadas": {
      "broadcast": "&6{player} batatou! &7Total: {amount} {amount_unit}.",
      "balance": "&e{player} tem {amount} {amount_unit}.",
      "units": {
        "batatada": {
          "singular": "batatada",
          "plural": "batatadas"
        }
      },
      "no-permission": "&cVocê não pode alterar as batatadas.",
      "usage": {
        "self": {
          "syntax": "",
          "description": "ver as suas batatadas"
        },
        "other": {
          "syntax": "<jogador>",
          "description": "ver as batatadas de um jogador"
        },
        "top": {
          "syntax": "top",
          "description": "ver o ranking de batatadas"
        },
        "set": {
          "syntax": "set <jogador> <quantidade>",
          "description": "definir as batatadas de um jogador, zero ou mais"
        }
      },
      "updated": "&aContagem atualizada.",
      "failed": "&cNão foi possível consultar ou atualizar as batatadas agora.",
      "reset-done": "&aSuas batatadas foram zeradas.",
      "reset-failed": "&cNão foi possível zerar as batatadas agora. O item voltou para o seu inventário.",
      "items": {
        "reset": {
          "display-name": "&6Resetar batatadas",
          "name": "&6Resetar batatadas",
          "lore": [
            "&7Zera todas as batatadas que você",
            "&7tem no servidor.",
            "",
            "&6O item é gasto no reset.",
            "",
            "&eClique com o botão direito para usar."
          ]
        }
      }
    }
  }
}
