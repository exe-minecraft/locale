{
  "plugins": {
    // As perks do P4Free. Sete vantagens que o jogador compra por níveis e mantém
    // ligadas nos slots que tem. A descrição de cada uma vive na chave dela: é o único
    // texto que muda entre elas, e por isso é o único que não está no menu.
    "perks": {
      // As palavras que acompanham um número montado no código (o Plural do core): 1 no singular.
      "units": {
        "enemy": { "singular": "inimigo", "plural": "inimigos" },
        "active-perk": { "singular": "perk ativa", "plural": "perks ativas" },
        "given-item": { "singular": "item entregue", "plural": "itens entregues" }
      },
      "types": {
        "attack": {
          "name": "Ataque",
          "menu-lore": [
            "&7Em golpes dados no chão, sem pular,",
            "&7pode multiplicar o dano.",
            "",
            "&7Nível: &f{level}&7/&f{max_level}",
            "&7Próximo nível: &b{next_price}",
            "&7Desbloqueio: &b{unlock_price}",
            "",
            "&7Dano do crítico: {damage_multiplier}x",
            "&7Chance de ativar: {chance}%",
            "",
            "{status}"
          ],
          "upgrade-lore": [
            "&7Dano do crítico: &f{damage_multiplier}x",
            "&7Chance de ativar: &f{chance}%",
            "",
            "&7Custo: &b{price}",
            "",
            "{status}"
          ]
        },
        "resistance": {
          "name": "Resistência",
          "menu-lore": [
            "&7Ao levar um golpe defendendo,",
            "&7ganha Resistência.",
            "",
            "&7Nível: &f{level}&7/&f{max_level}",
            "&7Próximo nível: &b{next_price}",
            "&7Desbloqueio: &b{unlock_price}",
            "",
            "&7Amplificador: {power}",
            "&7Duração: {duration}",
            "&7Chance de ativar: {chance}%",
            "",
            "{status}"
          ],
          "upgrade-lore": [
            "&7Amplificador: &f{power}",
            "&7Duração: &f{duration}",
            "&7Chance de ativar: &f{chance}%",
            "",
            "&7Custo: &b{price}",
            "",
            "{status}"
          ]
        },
        "regeneration": {
          "name": "Regeneração",
          "menu-lore": [
            "&7A maçã dourada encantada pode",
            "&7voltar depois de comida.",
            "",
            "&7Nível: &f{level}&7/&f{max_level}",
            "&7Próximo nível: &b{next_price}",
            "&7Desbloqueio: &b{unlock_price}",
            "",
            "&7Chance de devolver: {chance}%",
            "",
            "{status}"
          ],
          "upgrade-lore": [
            "&7Chance de devolver: &f{chance}%",
            "",
            "&7Custo: &b{price}",
            "",
            "{status}"
          ]
        },
        "repair": {
          "name": "Reparação",
          "menu-lore": [
            "&7Ao matar alguém, sua armadura e a",
            "&7do seu clã no mundo são reparadas.",
            "",
            "&7Nível: &f{level}&7/&f{max_level}",
            "&7Próximo nível: &b{next_price}",
            "&7Desbloqueio: &b{unlock_price}",
            "",
            "&7Quanto repara: {repair_percentage}%",
            "",
            "{status}"
          ],
          "upgrade-lore": [
            "&7Quanto repara: &f{repair_percentage}%",
            "",
            "&7Custo: &b{price}",
            "",
            "{status}"
          ]
        },
        "speed": {
          "name": "Velocidade",
          "menu-lore": [
            "&7Agachado por alguns segundos,",
            "&7ganha Velocidade.",
            "",
            "&7Nível: &f{level}&7/&f{max_level}",
            "&7Próximo nível: &b{next_price}",
            "&7Desbloqueio: &b{unlock_price}",
            "",
            "&7Amplificador: {power}",
            "&7Duração: {duration}",
            "&7Recarga: {cooldown}",
            "",
            "{status}"
          ],
          "upgrade-lore": [
            "&7Amplificador: &f{power}",
            "&7Duração: &f{duration}",
            "&7Recarga: &f{cooldown}",
            "",
            "&7Custo: &b{price}",
            "",
            "{status}"
          ]
        },
        "suppression": {
          "name": "Supressão",
          "menu-lore": [
            "&7Agachado por alguns segundos,",
            "&7desliga as perks dos inimigos",
            "&7por perto.",
            "",
            "&7Nível: &f{level}&7/&f{max_level}",
            "&7Próximo nível: &b{next_price}",
            "&7Desbloqueio: &b{unlock_price}",
            "",
            "&7Alcance: {radius} &7blocos",
            "&7Alvos: {targets}",
            "&7Duração: {duration}",
            "&7Recarga: {cooldown}",
            "",
            "{status}"
          ],
          "upgrade-lore": [
            "&7Alcance: &f{radius} blocos",
            "&7Alvos: &f{targets}",
            "&7Duração: &f{duration}",
            "&7Recarga: &f{cooldown}",
            "",
            "&7Custo: &b{price}",
            "",
            "{status}"
          ]
        },
        "knockback": {
          "name": "Empurrão",
          "menu-lore": [
            "&7Defendendo com a espada por alguns",
            "&7segundos, seus golpes passam a",
            "&7empurrar mais.",
            "",
            "&7Nível: &f{level}&7/&f{max_level}",
            "&7Próximo nível: &b{next_price}",
            "&7Desbloqueio: &b{unlock_price}",
            "",
            "&7Força do empurrão: {power}",
            "&7Duração: {duration}",
            "&7Recarga: {cooldown}",
            "",
            "{status}"
          ],
          "upgrade-lore": [
            "&7Força do empurrão: &f+{power}",
            "&7Duração: &f{duration}",
            "&7Recarga: &f{cooldown}",
            "",
            "&7Custo: &b{price}",
            "",
            "{status}"
          ]
        }
      },

      "views": {
        "perks": {
          "title": "Perks ({slots_used}/{slots_total})",
          "item": {
            "name": "&b{perk}"
          },
          // Os cinco estados do ícone. Cada um deles é uma resposta que o clique pode dar:
          // enquanto forem os mesmos, o menu não convida para uma ação que ele recusa.
          "status": {
            "0": "&eClique para desbloquear.",
            "1": ["&cVocê não tem o suficiente", "&cpara desbloquear."],
            "2": ["&eClique para ativar.", "&7Use o botão direito para ver os níveis."],
            "3": ["&cSeus slots estão cheios.", "&cDesative outra antes."],
            "4": "&aAtivada. &7Clique para desativar."
          },
          // Os números da perk no ícone, como nas armas: o de hoje riscado e o do próximo nível.
          // Sem a perk, o que o primeiro nível dá; no máximo, só o de hoje.
          "effect": {
            "next": "&c&m{from}&7 » &b{to}",
            "current": "&f{from}"
          },
          "info": {
            "name": "&eComo funciona",
            "lore": [
              "&7Você tem &f{slots_used}&7/&f{slots_total} &7perks ativas.",
              "",
              "&7Clique numa perk para ligar ou desligar.",
              "&7Botão direito abre os níveis dela.",
              "",
              "&7Mais slots vêm do seu grupo",
              "&7e do item de slot."
            ]
          }
        },
        "upgrades": {
          "title": "{perk} ({level}/{max_level})",
          "item": {
            "name": "&bNível {level}"
          },
          "status": {
            "0": "&aVocê já tem este nível.",
            "1": "&eClique para comprar.",
            "2": "&cVocê não tem o suficiente.",
            "3": ["&eClique para comprar todos", "&eos níveis até aqui."],
            "4": ["&cVocê não tem o suficiente", "&cpara chegar até aqui."]
          },
          "items": {
            "0": {
              "name": "&eVoltar",
              "lore": [
                "&7Volta para a lista de perks."
              ]
            }
          }
        }
      },

      "items": {
        "perk": {
          "display-name": "&bItem de perk",
          "name": "&bPerk {perk} {level}",
          "lore": [
            "&7Desbloqueia &f{perk} &7no nível &f{level}&7.",
            "",
            "&eClique com o botão direito para usar."
          ]
        },
        "slot": {
          "display-name": "&bSlot de Perk",
          "name": "&bSlot de Perk",
          "lore": [
            "&7Dá &f+1 &7espaço para manter",
            "&7mais uma perk ativa.",
            "",
            "&eClique com o botão direito para usar."
          ]
        },
        "reset": {
          "display-name": "&bResetar evolução",
          "name": "&bResetar evolução",
          "lore": [
            "&7Zera a evolução de todas as suas perks.",
            "",
            "&eVocê recebe de volta &l{percentage}%&e do que",
            "&einvestiu para evoluir cada perk.",
            "&7Os slots comprados continuam seus.",
            "",
            "&eClique com o botão direito para usar."
          ]
        }
      },

      "messages": {
        "bar": {
          "symbol": "▋",
          "done-color": "&a",
          "left-color": "&c"
        },
        "charging": "{bar} &e{perk}...",
        "in-cooldown": "Aguarde {time} para usar {perk} de novo.",

        "speed-activated": "&aVelocidade ativada por &f{seconds}s&a.",

        "suppressed": "Suas perks foram desligadas por um inimigo.",
        "suppression-activated": "&aVocê desligou as perks de &f{amount} &a{amount_unit}.",
        "suppression-empty": "Nenhum inimigo no alcance.",
        "suppression-ended": "&aSuas perks voltaram.",

        "knockback-activated": "&aEmpurrão ativado por &f{seconds}s&a.",
        "knockback-ended": "O empurrão acabou.",

        "attack-critical": "&aCrítico! &fDano multiplicado.",
        "attack-received": "Você levou um dano crítico.",
        "resistance-activated": "&aResistência ativada.",
        "repair": "&aSua armadura foi reparada.",
        "repair-clan": "&aSua armadura foi reparada pelo clã.",
        "regeneration-refunded": "&aA maçã dourada voltou.",

        "selected": "&a{perk} &fativada.",
        "deselected": "{perk} desativada.",
        "slots-full": "Você só pode manter {slots} {slots_unit}. Desative outra antes.",
        "slots-maximum": "Você já tem o máximo de slots.",
        "slot-redeemed": "&aAgora você pode manter &f{slots} &a{slots_unit}.",
        "reset-nothing": "&cVocê não tem nenhuma perk para resetar.",
        "reset-done": "&aSua evolução de perks foi resetada.",
        "reset-refunded": "&aSua evolução de perks foi resetada e você recebeu de volta &f{refund}&a.",
        "reset-refund-failed": "&cSua evolução foi resetada, mas a devolução não passou. Abra um ticket com este horário que a staff devolve.",
        "reset-failed": "&cNão foi possível resetar agora. Suas perks continuam como estavam e o item voltou para o seu inventário.",
        "selection-trimmed": "Algumas perks foram desativadas. Você mantém {slots} {slots_unit}.",

        "already-owned": "Você já tem {perk} neste nível ou acima.",
        "level-invalid": "Esta perk vai até o nível {max_level}.",
        "currency-missing": "A moeda desta perk não existe neste servidor. Avise a equipe.",
        "not-enough": "Você não tem {price} {currency}.",
        "charge-failed": "Não deu para confirmar a cobrança, e a perk não subiu. Se o valor saiu da sua conta, ele volta sozinho.",
        // O salto é sempre de dois níveis ou mais: a compra de um só vai para "bought".
        "bought": "&a{perk} &fsubiu para o nível &a{level} &fpor &a{price} {currency}&f.",
        "bought-many": "&a{perk} &fsubiu {levels} níveis, até o nível &a{level}&f, por &a{price} {currency}&f.",

        "item-invalid": "Este item de perk não vale.",
        "item-already-owned": "Você já tem {perk} {level} ou acima.",
        "item-redeemed": "&a{perk} {level} &fdesbloqueada."
      },

      "commands": {
        "perks": {
          "still-loading": "Suas perks ainda estão carregando. Tente de novo em instantes.",
          "arguments": {
            "target": { "name": "jogador", "description": "Quem você quer ver (Samurai ou acima)" }
          },
          // /perks <jogador>, do Samurai para cima. A lista abre e fecha com uma linha em branco, como o /build list.
          "others": {
            "none": "{target_name_with_color} &enão tem nenhuma perk ativa.",
            "header": ["", " &ePerks ativas de {target_name_with_color}&e:"],
            "entry": " &7• &b{perk} &7nível &f{level}",
            "footer": [""]
          }
        },
        "perkadmin": {
          "usage": {
            "dar": { "syntax": "dar <jogador> <perk> <nível>", "description": "dar uma perk no nível escolhido" },
            "tirar": { "syntax": "tirar <jogador> <perk>", "description": "tirar uma perk" },
            "zerar": { "syntax": "zerar <jogador>", "description": "zerar perks, slots extras e cooldowns" },
            "cooldowns": { "syntax": "cooldowns <jogador>", "description": "limpar os cooldowns das perks" },
            "item": { "syntax": "item <jogador> <perk> <nível> [quantidade]", "description": "entregar o item de uma perk" },
            "slot": { "syntax": "slot <jogador> [quantidade]", "description": "entregar o item de slot extra" }
          },
          "target-offline": "{name} não está online neste servidor.",
          "perk-invalid": "Perk inválida. Escolha entre {perks}.",
          "level-invalid": "Esta perk vai até o nível {max_level}.",
          "given": "{name} agora tem {perk} no nível {level}.",
          "already-level": "{name} já tem {perk} no nível {level}.",
          "taken": "{perk} foi tirada de {name}.",
          "not-owned": "{name} não tem {perk}.",
          "reset": "As perks de {name} foram zeradas.",
          "reset-nothing": "{name} não tem perk, slot extra nem cooldown para zerar.",
          "cooldowns-cleared": "Os cooldowns de {name} foram limpos.",
          "cooldowns-nothing": "{name} não tem cooldown de perk correndo.",
          "target-inventory-full": "O inventário de {name} está cheio.",
          "item-given": "{amount} {amount_unit} a {name}."
        }
      }
    }
  }
}
