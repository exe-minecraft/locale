{
  "plugins": {
    "currencies": {
      "types": {
        "souls": {
          "name": {
            "singular": "Alma",
            "plural": "Almas"
          },
          "visualization": "&d{currency_formatted_value}",
          "features": {
            "check": {
              "visualization": "&d{currency_formatted_value}"
            }
          }
        }
      }
    },
    "souls": {
      "reward": "&d+{amount} almas &7pelo abate de {victim}.",
      "streak": "&dSua sequência de abates ativou o bônus de almas!"
    },
    "batatadas": {
      "broadcast": "&6{player} batatou! &7Total: {amount} batatada(s).",
      "balance": "&e{player} tem {amount} batatada(s).",
      "no-permission": "&cVocê não pode alterar as batatadas.",
      "usage": {
        "self": { "syntax": "", "description": "ver as suas batatadas" },
        "other": { "syntax": "<jogador>", "description": "ver as batatadas de um jogador" },
        "top": { "syntax": "top", "description": "ver o ranking de batatadas" },
        "set": { "syntax": "set <jogador> <quantidade>", "description": "definir as batatadas de um jogador, zero ou mais" }
      },
      "updated": "&aContagem atualizada.",
      "failed": "&cNão foi possível consultar ou atualizar as batatadas agora."
    },
    "currency-boosters": {
      "types": {
        "souls": "Almas",
        "tokens": "Tokens"
      },
      "scopes": {
        "global": "Global",
        "individual": "Individual"
      },
      "item": {
        "display-name": "Booster",
        "name": "&eBooster de {currency} &7({scope})",
        "lore": [
          "&7Multiplicador: &f{multiplier}x",
          "&7Duração: &f{minutes} minutos",
          "&aClique direito para ativar."
        ]
      },
      "commands": {
        "boosters": {
          "usage": {
            "view": { "syntax": "", "description": "ver os seus boosters e o global ativos" },
            "give": { "syntax": "dar <jogador> <almas|tokens> <global|individual> <multiplicador> <minutos> <quantidade>", "description": "entregar itens de booster" }
          }
        }
      },
      "messages": {
        "different-multiplier": "&cJá existe um booster ativo com outro multiplicador. Seu item foi devolvido.",
        "failed": "&cNão foi possível ativar o booster. Seu item foi devolvido.",
        "activated": "&aBooster ativado. Boosters iguais somam duração.",
        "active": "&e{currency} &7({scope}): &f{multiplier}x &7por mais {seconds}s.",
        "no-permission": "&cVocê não pode entregar boosters.",
        "given": "&aBooster entregue.",
        "full": "&cO inventário do jogador está cheio.",
        "retry-activation": "&eA confirmação está pendente. Use o item devolvido para confirmar a mesma ativação.",
        "recovery-owner": "&cSomente o jogador que iniciou esta ativação pode confirmá-la.",
        "none-active": "&7Você não possui boosters ativos e não há booster global ativo."
      }
    }
  }
}
