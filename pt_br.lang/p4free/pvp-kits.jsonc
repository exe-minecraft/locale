{
  "plugins": {
    "pvp-kits": {
      "title": "Itens de combate",
      "berserker": {
        "display-name": "Berserker",
        "name": "{color}Berserker &8({time})",
        "lore": [
          "&7Força II e Velocidade II",
          "&7Duração: {seconds} segundos."
        ],
        "menu-title": "Escolha sua poção",
        "menu-lore": [
          "&7Tenha acesso ilimitado a poção",
          "&7berserker de &f{minutes} minutos&7.",
          "",
          "&b Esta vantagem funcionará",
          "&b até o fim desta temporada.",
          ""
        ],
        // A Berserker de 2 minutos de quem impulsiona o Discord, com espera própria (o /boostdiscord da staff dá).
        "booster-lore": [
          "",
          "&dVantagem de booster do Discord",
          "&7Tem espera própria, separada",
          "&7das outras poções.",
          "",
          "&aClique para pegar.",
          ""
        ],
        "booster-lore-locked": [
          "",
          "&dVantagem de booster do Discord",
          "&7Tem espera própria, separada",
          "&7das outras poções.",
          "",
          "&cImpulsione o Discord da rede e abra um",
          "&cticket para liberar: &fdiscord.rede-exe.com",
          ""
        ],
        "color": {
          "long": "&6",
          "medium": "&b",
          "short": "&a"
        }
      },
      // O vale da Berserker de 5 ou 6 minutos, vendido na loja e sorteado nas caixas. Desde 17/10 o
      // vendido é o da temporada (name-season e lore-season); o de dias ficou para os já entregues.
      "entitlement": {
        "display-name": "Vale da Berserker",
        "name": "&bBerserker &8({time}) &7por {days} {days_word}",
        "lore": [
          "&7Libera a poção Berserker de &f{minutes} minutos",
          "&7no /berserker por &f{days} {days_word}&7.",
          "",
          "&eClique com o botão direito para usar."
        ],
        "name-season": "&bBerserker &8({time}) &7da temporada",
        "lore-season": [
          "&7Libera a poção Berserker de &f{minutes} minutos",
          "&7no /berserker até o fim da temporada.",
          "",
          "&eClique com o botão direito para usar."
        ]
      },
      "commands": {
        "kit": {
          "arguments": {
            "kit": {
              "name": "pvp|membro|imperial|samurai",
              "description": "O kit a pegar; sem ele abre o menu"
            }
          }
        },
        "boostdiscord": {
          "description": "dar ou tirar a Berserker de booster do Discord",
          "give": {
            "description": "libera a Berserker de booster no /berserker",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que impulsionou o Discord"
              },
              "days": {
                "name": "dias",
                "description": "Dias de duração; em branco ou 0 = permanente"
              }
            },
            "negative-days": "Os dias não podem ser negativos.",
            "error": "Não foi possível liberar a Berserker de booster agora. Tente novamente.",
            "success": "Você liberou a Berserker de booster para {target_name_with_color} &apor {days} {days_word}.",
            "success-permanent": "Você liberou a Berserker de booster para {target_name_with_color} &apermanentemente.",
            // O mesmo permanente de novo: nada mudou. Com dias, o prazo é trocado e vale o success.
            "already": "{target_name_with_color} &cjá tem a Berserker de booster permanente."
          },
          "remove": {
            "description": "tira a Berserker de booster do /berserker",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que perde a vantagem"
              }
            },
            "error": "Não foi possível tirar a Berserker de booster agora. Tente novamente.",
            "success": "Você tirou a Berserker de booster de {target_name_with_color}&a.",
            "not-found": "{target_name_with_color} &anão tinha a Berserker de booster."
          }
        },
        "givekit": {
          "arguments": {
            "kit": {
              "name": "pvp|gladiador|clanfight|fastglad|x1",
              "description": "O kit a entregar"
            },
            "target": {
              "name": "jogador",
              "description": "Jogador deste servidor que recebe o kit"
            },
            "mark": {
              "name": "marca",
              "description": "A marca da partida gravada em cada peça (quem manda é o evento)"
            },
            "layout": {
              "name": "arranjo",
              "description": "Os slots da espada, das maçãs, da velocidade e da força no kit do x1, como 0,1,2,3"
            }
          }
        }
      },
      "messages": {
        "wrong-world": "&cEste comando não pode ser usado aqui.",
        "full": "&eSeu inventário está cheio!",
        "given": "&aSeu inventário foi preenchido com o {kit}&a.",
        "offline": "&cO jogador precisa estar neste servidor.",
        "unavailable": "&cNão foi possível carregar seu kit agora. Tente novamente.",
        "tier-denied": "&cVocê não possui permissão para pegar este kit!",
        "berserker-denied": "&c&l[EXE] &cVocê não possui permissão para adquirir essa poção.",
        "berserker-cooldown": "&c&l[EXE] &cVocê precisa aguardar mais tempo para pegar outra poção!",
        "berserker-given": "&aVocê adquiriu a Berserker com sucesso!",
        "booster-denied": "&cEssa Berserker é de quem impulsiona o Discord da rede. Impulsione e abra um ticket para liberar.",
        "berserker-removed": "&cAs Berserker mais longas do que o seu grupo libera foram tiradas do seu inventário.",
        "berserker-pickup-denied": "&cEssa Berserker é exclusiva de quem tem acesso a ela no /berserker ou no kit VIP.",
        "entitlement-owned": "&cVocê já tem essa Berserker no /berserker. Guarde o vale para quando acabar.",
        "entitlement-failed": "&cNão foi possível liberar a Berserker agora. O vale voltou para o seu inventário.",
        "entitlement-used": "&aA Berserker de &f{minutes} minutos &aestá liberada no /berserker por &f{days} {days_word}&a.",
        // {ends_at}: a data de fim da temporada, no formato de plugins.core.time.date-time-pattern.
        "entitlement-used-season": "&aA Berserker de &f{minutes} minutos &aestá liberada no /berserker até o fim da temporada (&f{ends_at}&a).",
        "entitlement-pending": "&aA Berserker de &f{minutes} minutos &aentra no /berserker quando a próxima temporada abrir.",
        "entitlement-no-season": "&cAinda não há temporada aberta. Guarde o vale para quando a primeira começar.",
        "entitlement-spent": "&cEste vale já foi usado e a Berserker dele já foi liberada."
      },
      "menu": {
        "main": {
          "title": "&8Menu de Kits"
        },
        "vip": {
          "title": "&8Menu de Kits VIP"
        },
        "pieces": {
          "title": "&8Itens Separados"
        },
        "preview": {
          "title": "&8Pré-visualização: {kit}"
        },
        "decoration": "&c&lEXE",
        "items": {
          "default": {
            "name": "&eKit Membro",
            "lore": [
              "&7Clique esquerdo para pegar o kit.",
              "&7Clique direito para pré-visualizar."
            ]
          },
          "imperial": {
            "name": "&4Kit Imperial",
            "lore": [
              "&7Clique esquerdo para pegar o kit.",
              "&7Clique direito para pré-visualizar."
            ]
          },
          "samurai": {
            "name": "&6Kit Samurai",
            "lore": [
              "&7Clique esquerdo para pegar o kit.",
              "&7Clique direito para pré-visualizar."
            ]
          },
          "pieces": {
            "name": "&bItens Separados",
            "lore": [
              "&7Clique para ver itens separados."
            ]
          },
          "vip": {
            "name": "&6Kits VIP",
            "lore": [
              "&7Clique para ver os kits VIP disponíveis."
            ]
          },
          "back": {
            "name": "&aVoltar ao Menu Principal",
            "lore": [
              "&7Clique para voltar."
            ]
          }
        }
      }
    }
  }
}
