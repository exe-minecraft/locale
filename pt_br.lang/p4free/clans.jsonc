{
  "plugins": {
    "clans": {
      "placeholders": {
        "tag-brackets": "&7[{clan_colored_tag}&7]",
        // O [TAG] Nome clicável das mensagens (o clique abre o /clan info, o mouse mostra o cartão). É a âncora do
        // clique, então a mensagem o escreve inteiro pelo {clan_label}, e não por tag e nome soltos.
        "clan-label": "&7[{clan_colored_tag}&7] &f{clan_name}"
      },
      // As palavras que acompanham um número montado no código (o Plural do core): 1 no singular.
      "units": {
        "member": { "singular": "membro", "plural": "membros" },
        "clan": { "singular": "clã", "plural": "clãs" },
        "pending-invite": { "singular": "convite de clã parado", "plural": "convites de clã parados" }
      },
      // O bloco do exe-scoreboard em Documents: tag sem cor e nome juntos, membros logo abaixo.
      // Com a tag sem cor, até o nome de 16 letras cabe na linha do protocolo 1.8.
      "scoreboard": {
        "clan": [
          "&f [&7{tag}&f] {name}",
          "&f Membros: &7{members}/{max_members}"
        ],
        "no-clan": [
          "&f &cVocê não tem um clã"
        ]
      },
      "roles": {
        "leader": {
          "name": "Líder",
          "prefix": "&6#"
        },
        "captain": {
          "name": "Capitão",
          "prefix": "&c*"
        },
        "member": {
          "name": "Membro",
          "prefix": "&7+"
        }
      },
      "statistics": {
        "kills": {
          "name": "Abates"
        },
        "deaths": {
          "name": "Mortes"
        },
        "points": {
          "name": "Pontos"
        },
        "gladiator_wins": {
          "name": "Vitórias no Gladiador"
        },
        "cxc_wins": {
          "name": "Vitórias no CxC"
        }
      },
      "settings": {
        "event_authorization": {
          "on": "&aautorizado",
          "off": "&cnão autorizado"
        }
      },
      "reports": {
        "administrator": "&7Um administrador",
        "all": {
          "name": "Todos"
        },
        "promotion": {
          "name": "Promoção",
          "message": "{executor_name_with_color} &fpromoveu {target_name_with_color} &fa &7{role_name}&f."
        },
        "demotion": {
          "name": "Rebaixamento",
          "message": "{executor_name_with_color} &frebaixou {target_name_with_color} &fa &7{role_name}&f."
        },
        "member_join": {
          "name": "Entrada",
          "message": "{target_name_with_color} &fentrou no clã."
        },
        "member_leave": {
          "name": "Saída",
          "message": "{target_name_with_color} &fsaiu do clã."
        },
        "member_kick": {
          "name": "Expulsão",
          "message": "{executor_name_with_color} &fexpulsou {target_name_with_color} &fdo clã."
        },
        "mod_tag": {
          "name": "Modificação de tag",
          "message": "{executor_name_with_color} &falterou a tag do clã para {clan_colored_tag}&f."
        },
        "leader_transfer": {
          "name": "Transferência de líder",
          "message": "{executor_name_with_color} &ftransferiu a liderança para {target_name_with_color}&f."
        }
      },
      "errors": {
        "changed-meanwhile": "&cO clã mudou enquanto isso. Confira e tente de novo.",
        "without-clan": "&cVocê não faz parte de um clã.",
        "clan-load-failed": "&cNão foi possível carregar as informações do clã.",
        "clan-not-found": "&cNão existe nenhum clã com essa tag.",
        "member-not-found": "&cNão foi possível encontrar informações sobre esse jogador.",
        "need-leader-role": "&cApenas o líder do clã pode fazer isso.",
        "need-more-role": "&cVocê não tem um cargo alto o suficiente para fazer isso.",
        // Sair, expulsar e desfazer esperam quem está jogando um evento (inscrito na espera, vivo, ou
        // caído com rejoin) sair dele: tirar do clã tirava do evento sem morte, sem drops e sem abate.
        "target-in-event": "{target_name_with_tag} &cestá jogando um evento. Só dá para tirá-lo do clã depois que ele sair do evento ou o evento acabar.",
        "self-in-event": "&cVocê está jogando um evento. Só dá para sair do clã depois de sair do evento ou de o evento acabar.",
        "members-in-event": "&cHá membros do clã jogando um evento. O clã só pode ser desfeito depois que eles saírem do evento ou o evento acabar."
      },
      "items": {
        "member-head": {
          "name": "{member_name_with_tag}",
          "lore": [
            "",
            "&eSuas informações:",
            " &8▸ &fCargo: &7{member_role_prefix}{member_role_name}",
            " &8▸ &fKDR: &7{member_kdr}",
            " &8▸ &fAbates: &7{member_kills}",
            " &8▸ &fMortes: &7{member_deaths}",
            " &8▸ &fGladiadores: &7{member_gladiator_wins}",
            " &8▸ &fCxC: &7{member_cxc_wins}",
            "",
            "&8Última entrada em {member_last_seen_at}"
          ]
        },
        "clan-banner": {
          "name": "&7[{clan_colored_tag}&7] {clan_name}",
          "lore": [
            "",
            " &eInformações do clã:",
            " &8▸ &fLíder: &7{clan_leader_name_with_tag}",
            " &8▸ &fMembros: &7({clan_members_size}/{clan_max_members_size}) {clan_online_members_size} online",
            " &8▸ &fPontos: &7{clan_points}",
            " &8▸ &fGladiadores: &7{clan_gladiator_wins}",
            " &8▸ &fCxC: &7{clan_cxc_wins}",
            " &8▸ &fKDR: &7{clan_kdr}",
            " &8▸ &fAbates: &7{clan_kills}",
            " &8▸ &fMortes: &7{clan_deaths}",
            "",
            " &8▸ &fEventos: {clan_authorized}",
            "",
            "&8Criado em {clan_created_at}"
          ]
        },
        "empty-item": {
          "name": "&cVazio!",
          "lore": [
            "&7Nada encontrado por aqui :("
          ]
        }
      },
      "commands": {
        "restrict": {
          "clan-command-restrict": {
            "error": "&cVocê não faz parte de um clã."
          },
          "clan-out-command-restrict": {
            "error": "&cVocê já faz parte de um clã."
          }
        },
        "clan": {
          "usage": {
            "chat": { "syntax": "/. <mensagem>", "description": "falar no chat do clã" },
            "authorize-list": { "syntax": "autorizar listar", "description": "ver os clãs autorizados nos eventos" },
            "delete-all": { "syntax": "excluir todos", "description": "apagar todos os clãs (pede confirmação)" }
          },
          "create": {
            "description": "criar um clã com tag e nome",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag de 3 caracteres, com uma cor por letra se quiser (&aK&bN&cN)"
              },
              "name": {
                "name": "nome",
                "description": "Nome de 5 a 16 caracteres"
              }
            },
            "errors": {
              "tag-with-formatting": "&cA tag do clã pode ter cor, mas não negrito, itálico, sublinhado, riscado nem texto mágico.",
              "tag-length": "&cA tag precisa ter exatamente 3 caracteres, sem contar as cores.",
              "tag-too-long": "&cA tag com as cores passa de 9 caracteres e não cabe acima da cabeça. Use no máximo uma cor por letra.",
              "name-length": "&cO nome do clã precisa ter de 5 a 16 caracteres.",
              "invalid-pattern": "&cA tag e o nome só aceitam letras e números.",
              "tag-in-use": "&cJá existe um clã com essa tag.",
              "name-in-use": "&cJá existe um clã com esse nome."
            },
            "success": "&aVocê criou o clã &7[{clan_colored_tag}&7] {clan_name}&a."
          },
          "help": {
            "description": "abrir o guia de comandos do clã",
            "arguments": {
              "section": {
                "name": "seção",
                "description": "Seção do guia que você quer abrir"
              }
            },
            "index": [
              "",
              " &eEscolha a seção e clique para abrir o guia:",
              ""
            ],
            "index-entry": "  &8• &b{section_name}",
            "index-entry-hover": "&eClique para abrir esta seção.",
            "sections": {
              "clan-player-name": "Comandos clã, jogador",
              "player-clan-name": "Comandos jogador, clã",
              "clan-admin-name": "Comandos clã, liderança",
              "admin-clan-name": "Comandos administração"
            }
          },
          "info": {
            "description": "ver as informações de um clã",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã que você quer consultar"
              }
            },
            "member-format": "{target_role_prefix}&a{target_name_with_color}",
            "member-separator": "&7, ",
            "no-online-members": "&7Nenhum",
            "success": [
              "",
              " &eInformações do clã:",
              "",
              "  &fClã: &7[{clan_colored_tag}&7] {clan_name}",
              "  &fLíder: {clan_leader_name_with_tag}",
              "  &fEventos: {clan_authorized}",
              "  &fPontos: &7{clan_points}",
              "  &fGladiadores: &7{clan_gladiator_wins}",
              "  &fCxC: &7{clan_cxc_wins}",
              "",
              "  &fMembros: &7{clan_members_size}/{clan_max_members_size} ({clan_online_members_size} online)",
              "  {clan_online_members}",
              "",
              "  &fKDR: &7{clan_kdr}",
              "  &fAbates: &7{clan_kills}",
              "  &fMortes: &7{clan_deaths}",
              ""
            ]
          },
          "profile": {
            "unknown-joined-clan-at": "sem registro",
            "description": "ver as informações de um jogador",
            "arguments": {
              "name": {
                "name": "jogador",
                "description": "Nome do jogador que você quer consultar"
              }
            },
            "success-with-clan": [
              "",
              " &eInformações do jogador:",
              "",
              "  &fJogador: {target_name_with_tag}",
              "  &fClã: {target_clan_label}",
              "  &fCargo: &7{target_role_prefix}{target_role_name}",
              "  &fNo clã desde: &7{target_joined_clan_at}",
              "",
              "  &fKDR: &7{target_kdr}",
              "  &fAbates: &7{target_kills}",
              "  &fMortes: &7{target_deaths}",
              "  &fGladiadores: &7{target_gladiator_wins}",
              "  &fCxC: &7{target_cxc_wins}",
              "",
              "  &8Última entrada em {target_last_seen_at}",
              ""
            ],
            "success-without-clan": [
              "",
              " &eInformações do jogador:",
              "",
              "  &fJogador: {target_name_with_tag}",
              "  &fClã: &7Sem clã.",
              "",
              "  &fKDR: &7{target_kdr}",
              "  &fAbates: &7{target_kills}",
              "  &fMortes: &7{target_deaths}",
              "  &fGladiadores: &7{target_gladiator_wins}",
              "  &fCxC: &7{target_cxc_wins}",
              "",
              "  &8Última entrada em {target_last_seen_at}",
              ""
            ]
          },
          "members": {
            "description": "ver os membros de um clã",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã cujos membros você quer ver"
              }
            }
          },
          "list": {
            "description": "listar todos os clãs criados",
            "arguments": {
              "page": {
                "name": "página",
                "description": "Página da lista, 5 clãs por página"
              }
            },
            "errors": {
              "load-failed": "&cNão foi possível carregar a lista de clãs agora. Tente de novo em instantes.",
              "empty": "&cAinda não há nenhum clã criado."
            },
            "header": [
              "",
              " &bClãs criados &7(página {page}/{total_pages}, {total_clans} no total)",
              " &7Clique no clã para ver as informações dele.",
              ""
            ],
            "entry": " &7{position}º &7[{clan_colored_tag}&7] &f{clan_name} &8({clan_members_size} {clan_members_unit})",
            "entry-hover": "&e/clan info {clan_tag}",
            "footer": [
              "",
              " &8Página {page} de {total_pages}",
              ""
            ]
          },
          "top": {
            "description": "ver o ranking dos clãs"
          },
          "reports": {
            "description": "ver o histórico de mudanças do seu clã"
          },
          "invite": {
            "description": "convidar um jogador para o clã",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que você quer convidar"
              }
            },
            "errors": {
              "need-more-role": "&cSó o líder e os capitães convidam jogadores.",
              "clan-max-members-exceeded": "&cO clã já está cheio.",
              "target-always-have-clan": "&cEsse jogador já faz parte de um clã.",
              "already-invited": "&cEsse jogador já foi convidado para o seu clã."
            },
            "success": "&aConvite enviado para {target_name_with_tag}&a."
          },
          "invites": {
            "description": "ver os convites recebidos ou enviados"
          },
          "join": {
            "description": "aceitar um convite",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã que te convidou"
              }
            },
            "errors": {
              "clan-not-invited": "&cVocê não tem convite desse clã.",
              "clan-max-members-exceeded": "&cO clã que te convidou já está cheio."
            },
            "success": "&aVocê entrou no clã &7[{clan_colored_tag}&7] {clan_name}&a."
          },
          "deny": {
            "description": "negar um convite",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã cujo convite você quer negar"
              }
            },
            "errors": {
              "clan-not-invited": "&cVocê não tem convite desse clã."
            },
            "success": "&cVocê negou o convite do clã &7[{clan_colored_tag}&7] {clan_name}&c."
          },
          "recruit": {
            "description": "anunciar o clã para recrutar jogadores",
            "errors": {
              "need-more-role": "&cSó o líder e os capitães anunciam o clã.",
              "clan-max-members-exceeded": "&cO clã já está cheio.",
              "in-cooldown": "&cO clã já foi anunciado há pouco. Aguarde {remaining_time} para anunciar de novo."
            }
          },
          "apply": {
            "description": "pedir para entrar num clã",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã em que você quer entrar"
              }
            },
            "errors": {
              "clan-max-members-exceeded": "&cEsse clã já está cheio.",
              "already-applied": "&cVocê já pediu para entrar nesse clã. Aguarde a resposta do líder ou de um capitão.",
              "recently-denied": "&cEsse clã recusou seu pedido há pouco. Você pode pedir de novo {application_duration} depois da recusa."
            },
            "success": "&aSeu pedido para entrar no clã &7[{clan_colored_tag}&7] {clan_name}&a foi enviado. O líder ou um capitão online tem {application_duration} para aceitar."
          },
          "acceptrequest": {
            "description": "aceitar o pedido de um jogador para entrar no clã",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que pediu para entrar"
              }
            },
            "errors": {
              "need-more-role": "&cSó o líder e os capitães aceitam pedidos.",
              "no-application": "{target_name_with_tag} &cnão tem pedido para entrar no clã, ou o pedido já venceu.",
              "clan-max-members-exceeded": "&cO clã já está cheio.",
              "target-always-have-clan": "{target_name_with_tag} &cjá faz parte de um clã."
            },
            "success": "&aVocê aceitou o pedido de {target_name_with_tag}&a."
          },
          "denyrequest": {
            "description": "recusar o pedido de um jogador para entrar no clã",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que pediu para entrar"
              }
            },
            "errors": {
              "need-more-role": "&cSó o líder e os capitães recusam pedidos.",
              "no-application": "{target_name_with_tag} &cnão tem pedido para entrar no clã, ou o pedido já venceu."
            },
            "success": "&cVocê recusou o pedido de {target_name_with_tag}&c."
          },
          "promote": {
            "description": "promover um membro a capitão",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Membro que você quer promover"
              }
            },
            "errors": {
              "not-same-clan": "&cEsse jogador não faz parte do seu clã.",
              "target-in-upper-role": "&cSó dá para promover um membro. Para passar a liderança, use /clan transferir."
            },
            "success": "&aVocê promoveu {target_name_with_tag} &aa &7{target_role_name}&a."
          },
          "demote": {
            "description": "rebaixar um capitão a membro",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Membro que você quer rebaixar"
              }
            },
            "errors": {
              "not-same-clan": "&cEsse jogador não faz parte do seu clã.",
              "target-in-lowest-role": "&cEsse jogador já está no cargo mais baixo."
            },
            "success": "&cVocê rebaixou {target_name_with_tag} &ca &7{target_role_name}&c."
          },
          "kick": {
            "description": "expulsar um jogador do clã",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Jogador que você quer expulsar"
              }
            },
            "errors": {
              "not-same-clan": "&cEsse jogador não faz parte do seu clã.",
              "need-more-role": "&cVocê não tem cargo para expulsar esse jogador."
            },
            "success": "&cVocê expulsou {target_name_with_tag} &cdo clã."
          },
          "transfer": {
            "description": "passar a liderança para outro membro",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Membro que vai receber a liderança"
              }
            },
            "errors": {
              "not-same-clan": "&cEsse jogador não faz parte do seu clã."
            },
            "success": "&aVocê transferiu a liderança do clã para {target_name_with_tag}&a."
          },
          "leave": {
            "description": "sair do clã",
            "errors": {
              "is-leader": "&cO líder não sai do clã. Transfira a liderança, ou use /clan desfazer."
            }
          },
          "disband": {
            "description": "desfazer o clã"
          },
          "modtag": {
            "description": "mudar as cores da tag",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "A mesma tag, com as cores que você quer (uma por letra), ou sem cor para tirá-las"
              }
            },
            "errors": {
              "tag-with-formatting": "&cA tag do clã pode ter cor, mas não negrito, itálico, sublinhado, riscado nem texto mágico.",
              "tag-too-long": "&cA tag com as cores passa de 9 caracteres e não cabe acima da cabeça. Use no máximo uma cor por letra.",
              "tag-length": "&cAs letras da tag não mudam, só as cores.",
              "invalid-pattern": "&cAs letras da tag não mudam, só as cores.",
              "letters-changed": "&cAs letras da tag não mudam, só as cores.",
              "no-change": "&cA tag já está assim."
            }
          },
          "membertag": {
            "description": "dar uma tag a um membro no chat do clã",
            "arguments": {
              "target": {
                "name": "jogador",
                "description": "Membro que vai receber a tag"
              },
              "tag": {
                "name": "tag",
                "description": "A tag, com cor e negrito se quiser (&4&lDONO), ou remover para tirar"
              }
            },
            "errors": {
              "need-more-role": "&cSó o líder e os capitães dão tag, e o capitão só na dele e na dos membros.",
              "not-same-clan": "&cEsse jogador não faz parte do seu clã.",
              "tag-with-formatting": "&cA tag pode ter cor e negrito, mas não itálico, sublinhado, riscado nem texto mágico.",
              "invalid-pattern": "&cA tag só aceita letras e números, sem espaço.",
              "tag-length": "&cA tag precisa ter de 1 a {max_letters} letras, sem contar as cores.",
              "tag-too-long": "&cA tag tem códigos de cor demais. Use menos cores.",
              "no-change": "&cA tag desse membro já está assim."
            },
            "success": "&aVocê deu a tag &7[{custom_tag}&7] &aa {target_name_with_tag}&a.",
            "success-removed": "&cVocê tirou a tag de {target_name_with_tag}&c."
          },
          "authorize": {
            "description": "liberar o clã para os eventos",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã que você quer autorizar"
              }
            },
            "errors": {
              "already-in-state": "&cO clã &7[{clan_colored_tag}&7]&c já está autorizado."
            },
            "success": "&aVocê autorizou o clã &7[{clan_colored_tag}&7] {clan_name}&a nos eventos.",
            "list": {
              "description": "ver os clãs autorizados nos eventos",
              "errors": {
                "empty": "&cNenhum clã está autorizado nos eventos."
              },
              "header": [
                "",
                " &bClãs autorizados nos eventos &7({total_clans} no total)",
                " &7Clique num clã para escrever o /clan desautorizar dele.",
                ""
              ],
              "entry": " &8• &7[{clan_colored_tag}&7] &f{clan_name}",
              "entry-hover": "&c/clan desautorizar {clan_tag}",
              "footer": [
                ""
              ]
            }
          },
          "unauthorize": {
            "description": "tirar o clã dos eventos",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã que você quer desautorizar"
              }
            },
            "errors": {
              "already-in-state": "&cO clã &7[{clan_colored_tag}&7]&c já está desautorizado."
            },
            "success": "&cVocê desautorizou o clã &7[{clan_colored_tag}&7] {clan_name}&c nos eventos. Quem já está num evento continua nele até o fim."
          },
          "delete": {
            "description": "apagar um clã",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã que você quer apagar"
              }
            },
