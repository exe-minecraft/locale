// O que o clã tem do P4Free (07/11/2026): a autorização para os eventos, que só existe onde há eventos, e as
// versões do perfil, do /clan info, da lore e do reset com o Gladiador, o CxC e os eventos. O resto do clã está
// no global, e o rankup tem as versões dele na pasta rankup.
{
  "plugins": {
    "clans": {
      // O bloco do exe-scoreboard em Documents: tag e nome juntos, membros logo abaixo. A {tag} já vem com a
      // cor do clã (cinza quando ela não tem cor), desde 17/10, e os colchetes em cinza (o dono, 19/10). O espaço
      // do começo vai sem cor para os colchetes não gastarem mais da linha do protocolo 1.8: com uma cor na tag,
      // até o nome de 15 letras cabe; com duas, 12, e com três, 11.
      "scoreboard": {
        "clan": [
          " &7[{tag}&7] &f{name}",
          "&f Membros: &7{members}/{max_members}"
        ],
        "no-clan": [
          "&f &cVocê não tem um clã"
        ]
      },
      "commands": {
        "clan": {
          "authorize": {
            "description": "liberar o clã para os eventos",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã que você quer autorizar"
              }
            },
            "errors": {
              "already-in-state": "&cO clã &7[{clan_colored_tag}&7]&c já está autorizado."
            },
            "success": "&aVocê autorizou o clã &7[{clan_colored_tag}&7] {clan_name}&a nos eventos.",
            "list": {
              "description": "ver os clãs autorizados nos eventos",
              "errors": {
                "empty": "&cNenhum clã está autorizado nos eventos."
              },
              "header": [
                "",
                " &bClãs autorizados nos eventos &7({total_clans} no total)",
                " &7Clique num clã para escrever o /clan desautorizar dele.",
                ""
              ],
              "entry": " &8• &7[{clan_colored_tag}&7] &f{clan_name}",
              "entry-hover": "&c/clan desautorizar {clan_tag}",
              "footer": [
                ""
              ]
            }
          },
          "delete": {
            "all": {
              "success": [
                "",
                " &fApagados: &a{deleted}",
                " &fMantidos por ter membro jogando um evento: &e{in_event}",
                " &fCom falha: &c{failed}",
                ""
              ]
            }
          },
          "info": {
            "success": [
              "",
              " &eInformações do clã:",
              "",
              "  &fClã: &7[{clan_colored_tag}&7] {clan_name}",
              "  &fLíder: {clan_leader_name_with_tag}",
              "  &fEventos: {clan_authorized}",
              "  &fPontos: &7{clan_points}",
              "  &fGladiadores: &7{clan_gladiator_wins}",
              "  &fCxC: &7{clan_cxc_wins}",
              "",
              "  &fMembros: &7{clan_members_size}/{clan_max_members_size} ({clan_online_members_size} online)",
              "  {clan_online_members}",
              "  {clan_members_hint}",
              "",
              "  &fKDR: &7{clan_kdr}",
              "  &fAbates: &7{clan_kills}",
              "  &fMortes: &7{clan_deaths}",
              ""
            ]
          },
          "profile": {
            "success-with-clan": [
              "",
              " &eInformações do jogador:",
              "",
              "  &fJogador: {target_name_with_tag}",
              "  &fClã: {target_clan_label}",
              "  &fCargo: &7{target_role_prefix}{target_role_name}",
              "  &fNo clã desde: &7{target_joined_clan_at}",
              "",
              "  &fKDR: &7{target_kdr}",
              "  &fAbates: &7{target_kills}",
              "  &fMortes: &7{target_deaths}",
              "  &fGladiadores: &7{target_gladiator_wins}",
              "  &fCxC: &7{target_cxc_wins}",
              "",
              "  &8Última entrada em {target_last_seen_at}",
              ""
            ],
            "success-without-clan": [
              "",
              " &eInformações do jogador:",
              "",
              "  &fJogador: {target_name_with_tag}",
              "  &fClã: &7Sem clã.",
              "",
              "  &fKDR: &7{target_kdr}",
              "  &fAbates: &7{target_kills}",
              "  &fMortes: &7{target_deaths}",
              "  &fGladiadores: &7{target_gladiator_wins}",
              "  &fCxC: &7{target_cxc_wins}",
              "",
              "  &8Última entrada em {target_last_seen_at}",
              ""
            ]
          },
          "reset": {
            "confirm-all": [
              "",
              " &cIsto zera {total_clans} {total_clans_unit} (pontos, abates, mortes, vitórias, autorização e boletim) e apaga o que todas as tags guardam de clãs desfeitos, sem volta.",
              " &cPara zerar, use &f/clan resetar todos confirmar &cnos próximos {confirm_seconds} segundos.",
              ""
            ],
            "confirm-clan": [
              "",
              " &cIsto apaga os pontos, abates, mortes, vitórias, a autorização dos eventos e o boletim do clã {clan_label}&c, sem volta. Membros e cargos ficam.",
              " &cPara zerar, use &f/clan resetar {tag} confirmar &cnos próximos {confirm_seconds} segundos.",
              ""
            ],
            "confirm-tag": [
              "",
              " &cNão existe clã com a tag {tag} agora. Isto apaga o que ela guarda de um clã desfeito (pontos, vitórias e autorização), e quem a criar de novo começa do zero.",
              " &cPara apagar, use &f/clan resetar {tag} confirmar &cnos próximos {confirm_seconds} segundos.",
              ""
            ],
            "errors": {
              "already-reset": "&cO clã {clan_label} &cjá está zerado. Não tem pontos, abates, mortes, vitórias, autorização nem boletim."
            }
          },
          "unauthorize": {
            "description": "tirar o clã dos eventos",
            "arguments": {
              "tag": {
                "name": "tag",
                "description": "Tag do clã que você quer desautorizar"
              }
            },
            "errors": {
              "already-in-state": "&cO clã &7[{clan_colored_tag}&7]&c já está desautorizado."
            },
            "success": "&cVocê desautorizou o clã &7[{clan_colored_tag}&7] {clan_name}&c nos eventos. Quem já está num evento continua nele até o fim."
          },
          "usage": {
            "authorize-list": { "syntax": "autorizar listar", "description": "ver os clãs autorizados nos eventos" }
          }
        }
      },
      "items": {
        "clan-banner": {
          "lore": [
            "",
            " &eInformações do clã:",
            " &8▸ &fLíder: &7{clan_leader_name_with_tag}",
            " &8▸ &fMembros: &7({clan_members_size}/{clan_max_members_size}) {clan_online_members_size} online",
            " &8▸ &fPontos: &7{clan_points}",
            " &8▸ &fGladiadores: &7{clan_gladiator_wins}",
            " &8▸ &fCxC: &7{clan_cxc_wins}",
            " &8▸ &fKDR: &7{clan_kdr}",
            " &8▸ &fAbates: &7{clan_kills}",
            " &8▸ &fMortes: &7{clan_deaths}",
            "",
            " &8▸ &fEventos: {clan_authorized}",
            "",
            "&8Criado em {clan_created_at}"
          ]
        },
        "member-head": {
          // A lore-without-clan logo abaixo repete esta sem o cargo, então mude as duas.
          "lore": [
            "",
            "&eSuas informações:",
            " &8▸ &fCargo: &7{member_role_prefix}{member_role_name}",
            " &8▸ &fKDR: &7{member_kdr}",
            " &8▸ &fAbates: &7{member_kills}",
            " &8▸ &fMortes: &7{member_deaths}",
            " &8▸ &fGladiadores: &7{member_gladiator_wins}",
            " &8▸ &fCxC: &7{member_cxc_wins}",
            "",
            "&8Última entrada em {member_last_seen_at}"
          ],
          // A mesma lore sem o cargo, para quem não tem clã (a cabeça do menu "Sem clã").
          "lore-without-clan": [
            "",
            "&eSuas informações:",
            " &8▸ &fKDR: &7{member_kdr}",
            " &8▸ &fAbates: &7{member_kills}",
            " &8▸ &fMortes: &7{member_deaths}",
            " &8▸ &fGladiadores: &7{member_gladiator_wins}",
            " &8▸ &fCxC: &7{member_cxc_wins}",
            "",
            "&8Última entrada em {member_last_seen_at}"
          ]
        }
      },
      "messages": {
        "cards": {
          "clan": [
            "{clan_label}",
            "",
            "&7Membros: &f{clan_members_size}/{clan_max_members_size}",
            "&7Vagas: &a{clan_free_slots}",
            "&7Pontos: &f{clan_points}",
            "&7KDR: &f{clan_kdr}",
            "&7Eventos: {clan_authorized}",
            "",
            "&eClique para ver o clã."
          ]
        }
      }
    }
  }
}
