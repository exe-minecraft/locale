{
  "plugins": {
    "mystery-boxes": {
      // O holograma em cima da cabeça de cada caixa no spawn (o display do config.yml),
      // como no P4Free antigo. O clique mostra os prêmios; com a caixa na mão, abre.
      "display": {
        "basic": [
          "&a&lCAIXA BÁSICA",
          "&eClique para abrir"
        ],
        "advanced": [
          "&b&lCAIXA AVANÇADA",
          "&eClique para abrir"
        ]
      },
      "types": {
        "basic": "&aCaixa Misteriosa &7(Básica)",
        "advanced": "&bCaixa Misteriosa &7(Avançada)"
      },
      "rarities": {
        "common": "&7Comum",
        "rare": "&dRara",
        "legendary": "&6Lendária",
        "mystic": "&bMística"
      },
      "item-lore": [
        "&7Clique direito para abrir.",
        "&7Agache e clique direito para ver os prêmios."
      ],
      "unavailable": "&cAs caixas estão indisponíveis no momento.",
      "failed": "&cNão foi possível entregar o prêmio. Sua caixa foi devolvida.",
      "won": "&aVocê ganhou {amount}x {reward} &7({rarity}&7).",
      // O anúncio do exe-mystery-box.jar no P4Free e nos eventos, quando o prêmio não é comum, com o destaque das
      // mensagens automáticas. O {reward} e o {rarity} já vêm na cor da raridade, e o {box} na cor da caixa. Também
      // há {player_name} e {player_name_with_color}. Vale com o mystery-boxes do cc0720643.
      "broadcast": [
        "",
        "&6&l CAIXAS: {player_name_with_tag} &fabriu a {box}",
        " &fe ganhou {amount}x {reward} &f({rarity}&f)!",
        ""
      ],
      "preview-title": "Prêmios da caixa",
      "result-title": "Seu prêmio",
      "chance": "&7Chance: {chance}% | Raridade: {rarity}",
      "no-permission": "&cVocê não pode entregar caixas.",
      "given": "&aCaixas entregues.",
      "full": "&cO inventário do jogador está cheio.",
      "commands": {
        "caixas": {
          "usage": {
            "view": {
              "syntax": "ver <tipo>",
              "description": "ver os prêmios de uma caixa"
            },
            "top": {
              "syntax": "top",
              "description": "ver o ranking de caixas abertas"
            },
            "give": {
              "syntax": "dar <jogador> <tipo> <quantidade>",
              "description": "entregar caixas, de 1 a 64"
            }
          }
        }
      },
      "items": {
        "basic": {
          "lore": [
            "&fRaridade: &e✫&7✫✫✫✫",
            "",
            "&7Uma caixa misteriosa cheia de",
            "&7surpresas. Clique com o botão direito",
            "&7para descobrir o que há dentro!",
            "",
            "&7Agache e clique direito para ver os prêmios."
          ]
        },
        "advanced": {
          "lore": [
            "&fRaridade: &e✫✫&7✫✫✫",
            "",
            "&7Uma caixa misteriosa cheia de",
            "&7surpresas. Clique com o botão direito",
            "&7para descobrir o que há dentro!",
            "",
            "&7Agache e clique direito para ver os prêmios."
          ]
        }
      },
