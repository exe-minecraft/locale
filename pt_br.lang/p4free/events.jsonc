              "hits": ["&a{winner_clan} venceu &7nos hits (abates empatados)", "", "&7Hits: &f{first_hits} &7x &f{second_hits}", "&7Quem mais hitou: &f{top_hitter} ({top_hitter_hits})", "&7Quem mais levou: &f{top_victim} ({top_victim_hits})", "&7Viradas: &f{first_reversals} &7x &f{second_reversals}", "&7Duração: &f{duration}"],
              "forfeit": ["&a{winner_clan} venceu &7por W.O.", "", "&7Hits: &f{first_hits} &7x &f{second_hits}", "&7Quem mais hitou: &f{top_hitter} ({top_hitter_hits})", "&7Quem mais levou: &f{top_victim} ({top_victim_hits})", "&7Viradas: &f{first_reversals} &7x &f{second_reversals}", "&7Duração: &f{duration}"],
              "won": ["&a{winner_clan} venceu", "", "&7Hits: &f{first_hits} &7x &f{second_hits}", "&7Quem mais hitou: &f{top_hitter} ({top_hitter_hits})", "&7Quem mais levou: &f{top_victim} ({top_victim_hits})", "&7Viradas: &f{first_reversals} &7x &f{second_reversals}", "&7Duração: &f{duration}"],
              "draw": ["&eEmpate nos abates e nos hits", "", "&7Hits: &f{first_hits} &7x &f{second_hits}", "&7Quem mais hitou: &f{top_hitter} ({top_hitter_hits})", "&7Quem mais levou: &f{top_victim} ({top_victim_hits})", "&7Viradas: &f{first_reversals} &7x &f{second_reversals}", "&7Duração: &f{duration}"]
            }
