      },
      // O texto do Gladiador segue o do exe-gladiador (Rede-EXE): as faixas riscadas em volta dos anúncios, o
      // [Gladiador] em vermelho-escuro nas entradas, saídas e abates, e a tag do clan em [cinza]. Cada bloco que abre
      // com linha em branco fecha com outra.
      "messages": {
        "commands": {
          "exit-failed": "Não foi possível levar você de volta ao spawn. Reconecte para sair do evento.",
          // O &c porque esta chega também pelo Echo, do app de eventos, onde a mensagem não leva a cor do erro.
          "already-stopped": "&cEsse evento já está parado.",
          // O /parar e o /forcestart que o app de eventos recusa: o estágio que o comando leu era velho.
          "already-ending": "&cO {event} já está terminando.",
          "already-started": "&cO {event} já começou.",
          "cant-start": "&cJá existe um evento em andamento!",
          "map-not-found": "&cO mapa {map} não existe ou não está carregado no P4Free Eventos.",
          "start-failed": "&cNão foi possível abrir o {event}. Confira os pontos gravados com setloc.",
          "need-clan": "Você precisa estar em um clan para participar do evento!",
          "vanished": "&cÉ necessário desativar o /v para jogar em eventos. O camarote continua permitido.",
          // O /v da staff ligado por quem está vivo num evento (EventsListener.onVanish).
          "vanish-blocked": "&cVocê não pode ativar o /v enquanto estiver lutando no {event}. No camarote ele continua permitido.",
          "clan-not-authorized": "&cPara entrar nos eventos o seu clan tem que estar autorizado!",
          "cant-join-event": "O {event} já começou ou não está disponível.",
          "target-in-event-app": "{player_name} já está no P4Free Eventos. Dê o comando de lá para colocá-lo no {event}.",
          // O forceentrar da staff num alvo com o /v ativado, em qualquer app (EventForceJoinCommand).
          "target-vanished": "&c{player_name} está com o /v ativado e não pode ser enviado ao {event}.",
          // O /kit, o /berserker, o /espada e o /machado no app de eventos (EventItemCommandListener).
          "item-command-blocked": "No P4Free Eventos os itens vêm só do evento.",
          // O /spawn de quem luta, espera o rejoin ou está no camarote (EventsListener.onSpawnRequest).
          "spawn-blocked": "Você não pode usar /spawn dentro de um evento. Saia pelo comando do evento, como o /glad sair.",
          // O /ec (e os apelidos) no camarote ou à espera do rejoin: lá os itens reais estão guardados (EventsListener).
          "cabin-ender-chest": "Você não pode abrir o baú enquanto estiver no camarote. Seus itens ficam guardados até você sair."
        },
        "events": {
          // A espera de um evento na barra de ação de todos no p4free (EventCountdownEchoListener), a cada segundo, como
          // o exe-gladiador fazia no servidor do evento.
          "waiting-bar": "&4[{event}] &aComeçando em {time}... &e/{command} entrar",
          "gladiator": {
            // A tag de um clan nos abates e nas mortes, pintada para cada um que lê na cor em que ele vê na name-tag o nick
            // de quem luta por esse clan. O nick vem logo depois e fica na mesma cor.
            "clan-tag": {
              // O próprio clan em verde, o caçado em amarelo, os outros em vermelho. No /glad verrush e no duelo do ClanFight,
              // quem não é de nenhum dos dois clans vê um em azul e o outro em rosa. A tag vai na cor do clan dentro (o &7 só
              // pinta a tag sem cor). Nas outras mensagens os colchetes são &7.
              "green": "&a[&7{tag}&a]",
              "yellow": "&e[&7{tag}&e]",
              "red": "&c[&7{tag}&c]",
              "blue": "&9[&7{tag}&9]",
              "light_purple": "&d[&7{tag}&d]"
            },
            // O que o "AQUI" da abertura e da espera diz ao passar o mouse.
            "join-hover": "&eClique para entrar no Gladiador.",
            // A cada 310 segundos de luta, inclusive no deathmatch, para quem está no app do evento.
            "status": [
              "",
              "&4&l&m       &c&l&m       &r &f&lSTATUS DO GLADIADOR &c&l&m       &4&l&m      ",
              "",
              "&eTempo: &f{time}",
              "",
              "&eJogadores vivos: &f{event_players}",
              "&eClans vivos: &f{event_clans}",
              "",
              "&eClans Participando:",
              "{event_clan_list}",
              "",
              "&4&l&m       &c&l&m       &r &f&lSTATUS DO GLADIADOR &c&l&m       &4&l&m      ",
              ""
            ],
            // A abertura, com o tempo inteiro da espera. O "AQUI" leva o clique do /glad entrar.
            "start": [
              "",
              "&4&l&m      &c&l&m      &r &f&lGLADIADOR &c&l&m      &4&l&m      ",
              "",
              "&fO Evento Gladiador foi &a&lINICIADO&f!",
              "&6 ► &fUse &e/glad entrar &fou clique &e&lAQUI&f.",
              "",
              "&e&lPremiações do evento",
              "&6• &fTag &4[Gladiador] &fpara os jogadores do clan vencedor",
              "&6• &fTag &5[Mito] &fpara o jogador que mais matar",
              "",
              "&c► &fO evento começará em &a{time}&f.",
              "",
              "&4&l&m      &c&l&m      &r &f&lGLADIADOR &c&l&m      &4&l&m      ",
              ""
            ],
            // A contagem da espera: a cada 30 s e em cada um dos últimos 10.
            "waiting-players": [
              "",
              "&4&l&m      &c&l&m      &r &f&lGLADIADOR &c&l&m      &4&l&m      ",
              "",
              "&fO Evento Gladiador começará em &a{time}&f!",
              "&6 ► &fUse &e/glad entrar &fou clique &e&lAQUI&f.",
              "",
              "&7 Participantes: &f{event_players_size}",
              "&7 Clans confirmados: &f{event_clans_size}",
              "&7 {event_clan_list}",
              "",
              "&4&l&m      &c&l&m      &r &f&lGLADIADOR &c&l&m      &4&l&m      ",
              ""
