{
  "plugins": {
    "events": {
      "preferences": {
        "announcements": {
          "name": "&eAnúncios dos eventos",
          "description": [
            "&7Mostra no chat quando um evento",
            "&7abre, tranca, é cancelado ou termina."
          ]
        },
        "countdown-bar": {
          "name": "&eContagem dos eventos",
          "description": [
            "&7Mostra na barra de ação quanto",
            "&7falta para o evento começar."
          ]
        }
      },
      // O /glad mapas. Dar nome a um mapa em "names" é o que o põe no menu: o nome é a chave do mundo no P4Free Eventos.
      "gladiator-maps": {
        "names": {
          "gladiador2": "Mapa 1 (Bússola)",
          "gladiador3": "Mapa 2 (End)",
          "gladiador4": "Mapa 3 (Dragão)",
          "gladiador5": "Mapa 4 (Espada)",
          "gladiador6": "Mapa 5 (Cogumelos)",
          "gladiador7": "Mapa 6 (Militar)"
        },
        "visiting": [
          "",
          "&aVocê está visitando o mapa &f{map}&a.",
          "&7Voe à vontade pelo mapa. Para sair, use &f/spawn&7.",
          ""
        ],
        "already-visiting": "Você já está visitando este mapa.",
        "event-running": "Não dá para visitar os mapas enquanto um evento está acontecendo. Volte quando ele acabar.",
        "not-found": "Este mapa não existe ou não pode ser visitado.",
        "event-started": "Um evento começou, e a visita aos mapas acabou. Você voltou ao spawn."
      },
      // As dicas do evento que está rodando, da espera ao fim, só no app do evento (a lista e o intervalo estão no
      // tips.yml do events-server). O destaque é o da dica do exe-souls, como as mensagens de sempre do essentials.
      "tips": {
        "gladiator": {
          "souls": [
            "",
            "&e&l DICA: &fAcumule &a5 abates&f, sem morrer, no Gladiador",
            " &fpara ativar o bônus de &a2x almas&f!",
            ""
          ],
          "rejoin": [
            "",
            "&e&l DICA: &fCaiu do Gladiador? Você tem &a5 minutos&f para voltar",
            " &fcom &a/glad rejoin&f. Quem sai em combate ou numa teia não volta.",
            ""
          ],
          "cabin": [
            "",
            "&e&l DICA: &fFicou de fora? Assista à luta pelo &a/glad camarote&f.",
            ""
          ],
          "info": [
            "",
            "&e&l DICA: &fVeja os inscritos, o tempo e os clãs no &a/glad info&f.",
            ""
          ]
        },
        "fast-glad": {
          "merchant": [
            "",
            "&e&l DICA: &fO &aMercador Sombrio&f aparece no centro do mapa. Clique",
            " &fnele com o botão direito para gastar as moedas dos seus abates.",
            ""
          ],
          "souls": [
            "",
            "&e&l DICA: &fAcumule &a5 abates&f, sem morrer, no FastGlad",
            " &fpara ativar o bônus de &a2x almas&f!",
            ""
          ],
          "cabin": [
            "",
            "&e&l DICA: &fFicou de fora? Assista à luta pelo &a/fg camarote&f.",
            ""
          ]
        },
        "clan-fight": {
          "cabin": [
            "",
            "&e&l DICA: &fFicou de fora? Assista à luta pelo &a/cf camarote&f.",
            ""
          ],
          "info": [
            "",
            "&e&l DICA: &fVeja os inscritos e os clãs do ClanFight no &a/cf info&f.",
            ""
          ]
        }
      },
      "types": {
        "mini-glad": { "name": "Mini Gladiador" },
        "gladiator": { "name": "Gladiador" },
        "cage": { "name": "Cage" },
        "koth": { "name": "Koth" },
        "clan-fight": { "name": "ClanFight" },
        "fast-glad": { "name": "FastGlad" }
      },
      "values": {
        "none": "nenhum",
        "cancelled": "cancelado",
        "finalized": "finalizado",
        // O tempo de uma edição sem o início gravado (a que não chegou a lutar, as arenas de antes de 18/10/2026).
        "unknown": "não registrado",
        "time": {
          "seconds": "{value}s",
          "minutes": "{value}min",
          "hours": "{value}h"
        }
      },
      // A palavra que acompanha um número (EventUnits): 1 no singular, 0 e o resto no plural.
      "units": {
        "player": { "singular": "jogador", "plural": "jogadores" },
        "clan": { "singular": "clan", "plural": "clans" },
        "remain": { "singular": "Resta", "plural": "Restam" },
        "kill": { "singular": "abate", "plural": "abates" },
        "rush": { "singular": "rush", "plural": "rushes" },
        "win": { "singular": "vitória", "plural": "vitórias" },
        "coin": { "singular": "moeda", "plural": "moedas" },
        "set": { "singular": "set", "plural": "sets" },
        "hit": { "singular": "hit", "plural": "hits" }
      },
      // O quadro do mundo do Gladiador. Os {event_*} são listas que ficam vazias fora do evento,
      // e levam a linha em branco de cima junto, como no exe-scoreboard.
      "scoreboard": {
        "title": "&c&lGLADIADOR",
        "lines": [
          "{build_mode_status}",
          "{event_clans}",
          "{event_kills}",
          "",
          "{clan_scoreboard}",
          "{event_border}",
          "{event_rushes}",
          "",
          "&ewww.rede-exe.com"
        ],
        "clans": "&f Clans restantes: &6{clans}",
        "kills": "&f Abates no evento: &c{kills}",
        "border": "&f Borda em &c{time}",
        "border-manual": "&f Borda &c&lMANUAL",
        "border-closing": "&f Borda &4Fechando...",
        "deathmatch": "&f &4&lDEATHMATCH",
        "rushes": "&f Rushes ativos ({rushes}):",
        "rush": " {first_tag} &7{first_alive} &fvs {second_tag} &7{second_alive}"
      },
      "arena-scoreboards": {
        "clanfight": {
          "lines": [
            "{build_mode_status}", "", "{arena_time}", "{arena_clans}", "",
            "{arena_kills}", "", "{clan_scoreboard}", "", "{arena_battle}", "", "&ewww.rede-exe.com"
          ],
          "time": "&f Duração: &a{time}",
          "clans": "&f Clans restantes: &6{clans}",
          "kills": "&f Abates no evento: &c{kills}",
          "battle": "&f Batalha em andamento:",
          // O duelo como o messageVersus do exe-clanfight: a tag de cada clã com as cores dele e os vivos.
          "versus": " {first} &7{first_alive} &cvs &f{second} &7{second_alive}",
          // Sem duelo, como no exe-clanfight: entre dois duelos (a pausa e o sorteio) e antes do primeiro.
          "drawing": " &eSorteando...",
          "waiting": " &bEsperando...",
          // A chance de vitória de cada lado, na ordem do "vs", como o winChance do exe-clanfight; quem tem 50% ou mais
          // sai no ahead.
          "odds": " {first} {first_chance} &7- {second} {second_chance}",
          "ahead": "&a{chance}%",
          "behind": "&c{chance}%"
        },
        "fastglad": {
          "lines": [
            "{build_mode_status}", "", "{arena_time}", "{arena_clans}", "",
            "{clan_scoreboard}", "", "{arena_points}", "{arena_merchant}", "", "&ewww.rede-exe.com"
          ],
          "time": "&f Duração: &a{time}",
          "clans": "&f Clans restantes: &6{clans}",
          "kills": "&f Abates no evento: &c{kills}",
          "points": "&f Moedas de abate: &6{points}",
          "merchant": "&fMercador Sombrio em: &9{time}",
          "merchant-open": "&fMercador Sombrio &aVIVO"
        }
      },
      "stages": {
        "waiting_players": "&adisponível para entrar",
        "preparing_time": "&eem preparação",
        "running": "&cem andamento",
        "deathmatch": "&4em deathmatch",
        "finalized": "&7finalizado"
      },
      // A lista do status periódico, como no exe-gladiator. O rush destaca os colchetes e a contagem em vermelho.
      "status": {
        "clan": "&8[&7{tag}&8] ({players})",
        "rush-clan": "&c[&7{tag}&c] ({players})",
        "separator": "&8, ",
        "no-clans": "&cNenhum clan participando...",
        // O hover de cada clã da lista para quem está no camarote.
        "teleport-hover": "&7Clique para ir até um membro vivo deste clan."
      },
      // O clique num clã do status, para quem está no camarote.
      "cabin-teleport": {
        "spectator-required": "Você precisa estar no camarote para ir até um clan.",
        "no-member": "O clan {tag} não tem nenhum membro vivo no evento agora."
      },
      "info": {
        "not-running": "O evento {event} ainda não começou!",
        "unavailable": "Não foi possível consultar {event} agora. Tente novamente em instantes.",
        "message": [
          "",
          "&4&l&m       &c&l&m       &r &f&l{event_title} &c&l&m       &4&l&m      ",
          "",
          "&eStatus: &f{event_status}",
          "",
          "&eInscritos: &f{event_participants}",
          "&eParticipando: &f{event_players}",
          "",
          "{event_details}",
          "",
          "&eClãs participando: &f{event_clans} {event_clans_unit}",
          "{event_clan_list}",
          "",
          "&4&l&m       &c&l&m       &r &f&l{event_title} &c&l&m       &4&l&m      ",
          ""
        ],
        "countdown": "&ePróxima fase em: &f{time}",
        "elapsed": "&eTempo de combate: &f{time}",
        "clan": "&7[{clan}&7] &7{players} {players_unit}",
        // O clan em rush, com os colchetes em vermelho como no status periódico.
        "rush-clan": "&c[{clan}&c] &7{players} {players_unit}",
        "no-clans": "&cNenhum clã participando...",
        "border": "&eBorda: &f{border} &7(estágio {stage})",
        "border-state": {
          "manual": "&c&lMANUAL",
          "changing": "&cAlterando...",
          "next": "Próxima redução em {time}",
          "last": "Último estágio",
          "deathmatch": "&4&lDEATHMATCH"
        },
        "rushes": "&eRushes acontecendo: &f{rushes} {rushes_unit}",
        "duel": "&eDuelo atual: &7[{first}&7] &fcontra &7[{second}&7]",
        "no-duel": "&eDuelo atual: &faguardando o próximo confronto",
        "merchant": {
          "open": "&eMercador Sombrio: &aaberto &7(no centro do mapa)",
          "next": "&eMercador Sombrio: &fchega em {time}",
          "closed": "&eMercador Sombrio: &ffechado, sem novas visitas nesta partida"
        }
      },
      "commands": {
        "armor": {
          "description": "ver os sets de armadura dos vivos de um clan no evento",
          "arguments": {
            "clan": { "name": "clan", "description": "Tag do clan." }
          }
        },
        "check-target": {
          "description": "ver quem acertou um jogador no evento, e quantas vezes",
          "arguments": {
            "player": { "name": "jogador", "description": "Nome do jogador." }
          }
        },
        "glad": {
          "event-start": {
            "description": "abrir as inscrições do Gladiador num mapa",
            "arguments": {
              "map": {
                "name": "mapa",
                "description": "O mundo do P4Free Eventos onde a partida acontece."
              }
            }
          },
          "event-force-start": {
            "description": "começar o Gladiador sem esperar"
          },
          "mapas": {
            "description": "visitar os mapas do Gladiador",
            "arguments": {
              "map": {
                "name": "mapa",
                "description": "O mapa que você quer visitar. Sem ele, abre o menu dos mapas."
              }
            },
            "unavailable": "&cO P4Free Eventos não está disponível agora. Tente de novo em instantes.",
            "failed": "Não foi possível ir ao mapa. Tente novamente."
          },
          "event-stop": {
            "description": "cancelar o Gladiador"
          },
          "deathmatch": {
            "description": "forçar o deathmatch"
          },
          "border": {
            "description": "alternar a borda entre manual e automática"
          },
          "skipborder": {
            "description": "avançar a borda para o próximo estágio"
          },
          "topwins": {
            "description": "ver o ranking de vitórias dos clans"
          },
          "topkills": {
            "description": "ver o ranking de abates dos jogadores"
          },
          "toprush": {
            "description": "ver o ranking de rushes vencidos"
          },
          "topviradas": {
            "description": "ver o ranking de viradas em rushes"
          },
          "event-force-join": {
            "description": "enviar um jogador ao Gladiador",
            "arguments": {
              "player": {
                "name": "jogador",
                "description": "Jogador que será enviado ao Gladiador."
              }
            },
            "user-not-found": "Este jogador não foi encontrado!",
            "unavailable": "Nenhuma instância do Gladiador está disponível.",
            "failed": "Não foi possível enviar o jogador ao Gladiador."
          },
          "event-join": {
            "description": "entrar no Gladiador com o seu clan",
            "unavailable": "&cO P4Free Eventos não está disponível agora. Tente de novo em instantes.",
            "failed": "Não foi possível entrar no Gladiador. Tente novamente."
          },
          "event-rejoin": {
            "description": "voltar ao Gladiador após desconectar",
            "processing": "Pedido de reentrada enviado. Aguarde."
          },
          "sair": {
            "description": "sair do Gladiador",
            "not-running": "Não há nenhum Gladiador ocorrendo.",
            "processing": "Processando sua saída do Gladiador..."
          },
          "camarote": {
            "description": "entrar ou sair do camarote",
            "cabin-join": {
              "description": "entrar no camarote para assistir",
              "unavailable": "&cO P4Free Eventos não está disponível agora. Tente de novo em instantes.",
              "failed": "Não foi possível entrar no camarote. Tente novamente.",
              "inventory-not-empty": "Você precisa estar com o inventário vazio para entrar no camarote!"
            },
            "exit": {
              "description": "sair do camarote",
              "not-running": "Não há nenhum Gladiador ocorrendo.",
              "processing": "Processando sua saída do camarote..."
            },
            "cabin-teleport": {
              "description": "ir até um membro vivo de um clan",
              "arguments": {
                "clan": {
                  "name": "clan",
                  "description": "Tag do clan até o qual deseja ir."
                }
              }
            }
          },
          "info": {
            "description": "ver as informações da partida do Gladiador",
            "title": "STATUS DO GLADIADOR"
          },
          "beast": {
            "description": "ver ou definir o Mito atual",
            "arguments": {
              "action": {
                "name": "top|set|reset",
                "description": "Sem ação mostra o Mito atual"
              },
              "player": {
                "name": "jogador",
                "description": "Jogador que receberá a tag Mito."
              },
              "record": {
                "name": "contar",
                "description": "Use count para somar ao ranking de Mitos."
              }
            },
            "no-permission": "Você não tem permissão para executar este comando!",
            "user-not-found": "Este jogador não existe!",
            "query-failed": "Não foi possível consultar esse jogador.",
            "processing": "Processando a alteração do Mito..."
          },
          "web-monitor": {
            "description": "ver as teias detectadas ao vivo",
            "loading": "Consultando as teias detectadas no Gladiador..."
          },
          "reversal-monitor": {
            "description": "ver as viradas dos rushes ativos",
            "loading": "Consultando as viradas dos rushes ativos..."
          },
          "stacked-control": {
            "description": "ajustar a detecção de empilhados",
            "arguments": {
              "action": {
                "name": "on|off|limite",
                "description": "Ligar, desligar, ou mudar o limite"
              },
              "value": {
                "name": "valor",
                "description": "Novo mínimo de jogadores empilhados."
              }
            },
            "invalid-value": "O valor informado é inválido! Use um número inteiro de pelo menos 2 jogadores.",
            "processing": "Atualizando o sistema de jogadores empilhados..."
          },
          "rush-list": {
            "description": "listar os rushes ativos",
            "query-failed": "Não foi possível consultar os rushes."
          },
          "rush-watch": {
            "description": "assistir ao rush de um clan ou parar de assistir",
            "arguments": {
              "clan-or-stop": {
                "name": "clan|sair",
                "description": "Tag do clan cujo rush deseja assistir, ou sair para parar de assistir."
              },
              "clan": {
                "name": "clan",
                "description": "Tag do clan cujo rush deseja assistir."
              },
              "second-clan": {
                "name": "segundo clan",
                "description": "Segunda tag opcional para /teleportrush."
              }
            },
            "query-failed": "Ocorreu um erro ao consultar esse clan!",
            "clan-not-found": "O clan especificado não existe!"
          },
          // O [TELEPORTAR] do anúncio do rush. Leva a um jogador do rush sem o verrush, e o camarote continua vendo todos.
          "rush-teleport": {
            "description": "teleportar até o rush de um clan sem o verrush",
            "arguments": {
              "clan": {
                "name": "clan",
                "description": "Tag do clan cujo rush deseja visitar."
              }
            },
            "query-failed": "Ocorreu um erro ao consultar esse clan!",
            "clan-not-found": "O clan especificado não existe!"
          },
          "history": {
            "description": "ver o histórico das edições",
            "arguments": {
              "id": {
                "name": "id",
                "description": "ID opcional da edição do Gladiador."
              }
            },
            "invalid-id": "ID de edição inválido.",
            "loading": "Consultando o histórico do Gladiador..."
          },
          "rush-score": {
            "description": "ver o placar de rushes por confronto",
            "arguments": {
              "clan": {
                "name": "clan ou todos",
                "description": "Tag do clan ou todos os confrontos."
              }
            },
            "loading": "Consultando o placar de rushes...",
            "clan-not-found": "Clan não encontrado no placar!",
            "query-failed": "Não foi possível consultar esse clan."
          },
          "recent-actions": {
            "description": "ver saídas e desconexões recentes",
            "loading": "Consultando os logs recentes do Gladiador..."
          },
          "revive": {
            "description": "reviver um jogador no evento",
            "arguments": {
              "player": {
                "name": "jogador",
                "description": "Jogador que será revivido."
              }
            }
          },
          "kick": {
            "description": "expulsar um jogador do Gladiador",
            "arguments": {
              "player": {
                "name": "jogador",
                "description": "Jogador que será expulso do Gladiador."
              }
            }
          },
          "kickclan": {
            "description": "expulsar um clan inteiro do evento",
            "arguments": {
              "clan": {
                "name": "clan",
                "description": "Tag do clan que será expulso."
              }
            }
          },
          "setrush": {
            "description": "iniciar ou parar um rush",
            "arguments": {
              "action": {
                "name": "iniciar|parar",
                "description": "Ação que será aplicada ao rush."
              },
              "first-clan": {
                "name": "primeiro clan",
                "description": "Primeira tag do confronto."
              },
              "second-clan": {
                "name": "segundo clan",
                "description": "Segunda tag do confronto."
              }
            }
          },
          "togglerejoin": {
            "description": "ligar ou desligar a reentrada",
            "arguments": {
              "action": {
                "name": "ativar|desativar",
                "description": "Novo estado da reentrada."
              }
            }
          },
          "maxmembers": {
            "description": "definir o limite de membros por clan",
            "arguments": {
              "amount": {
                "name": "quantia",
                "description": "Novo limite de participantes por clan."
              }
            }
          },
          "setloc": {
            "description": "salvar entrada, camarote ou deathmatch",
            "arguments": {
              "type": {
                "name": "tipo ou borda",
                "description": "entrada, camarote, deathmatch ou tipo legado de borda."
              },
              "location": {
                "name": "local",
                "description": "entrada, camarote ou deathmatch na sintaxe legada."
              }
            },
            "invalid-type": "Este tipo de local não existe. Use entrada, camarote ou deathmatch.",
            "processing": "Salvando a localização na instância do Gladiador..."
          },
          "deaths": {
            "description": "ver a última morte de um jogador",
            "arguments": {
              "player": {
                "name": "jogador",
                "description": "Jogador cuja última morte será consultada."
              }
            },
            "loading": "Consultando a última morte registrada..."
          },
          "control": {
            "processing": "Processando a ação na instância do Gladiador...",
            "query-failed": "Não foi possível consultar os dados solicitados.",
            "user-not-found": "Este jogador não foi encontrado!",
            "clan-not-found": "Este clan não foi encontrado!",
            "clans-not-found": "Um dos clans não existe!",
            "invalid-amount": "Valor inválido! Informe um número inteiro maior que zero."
          }
        },
        "clanfight": {
          "info": {
            "description": "ver as informações da partida do ClanFight",
            "title": "STATUS DO CLANFIGHT"
          },
          "event-start": {
            "description": "abrir as inscrições do ClanFight"
          },
          "event-force-start": {
            "description": "começar o ClanFight sem esperar"
          },
          "event-stop": {
            "description": "cancelar o ClanFight"
          },
          "event-join": {
            "description": "entrar no ClanFight com o seu clan",
            "unavailable": "&cO P4Free Eventos não está disponível agora. Tente de novo em instantes.",
            "failed": "Não foi possível entrar no ClanFight. Tente novamente."
          },
          "event-force-join": {
            "description": "enviar um jogador ao ClanFight",
            "arguments": {
              "player": {
                "name": "jogador",
                "description": "Jogador que será enviado ao ClanFight."
              }
            },
            "user-not-found": "Este jogador não foi encontrado!",
            "unavailable": "Nenhuma instância do ClanFight está disponível.",
            "failed": "Não foi possível enviar o jogador ao ClanFight."
          },
          "sair": {
            "description": "sair do ClanFight",
            "not-running": "Não há nenhum ClanFight ocorrendo.",
            "processing": "Processando sua saída do ClanFight..."
          },
          "camarote": {
            "description": "entrar ou sair do camarote",
            "cabin-join": {
              "description": "entrar no camarote para assistir",
              "unavailable": "&cO P4Free Eventos não está disponível agora. Tente de novo em instantes.",
