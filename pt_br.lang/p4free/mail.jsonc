{
  "plugins": {
    "mail": {
      "send": {
        "description": "enviar itens ao correio de um jogador ou de todos os online",
        "arguments": {
          "target": {
            "name": "jogador|todos",
            "description": "O jogador que recebe, ou todos os que estão online no P4Free"
          },
          "network": {
            "name": "rede",
            "description": "Com \"rede\", a entrega sai como da rede e não com o seu nome"
          }
        }
      },
      "units": {
        "entry": {
          "singular": "correio",
          "plural": "correios"
        },
        "item": {
          "singular": "item",
          "plural": "itens"
        },
        "player": {
          "singular": "jogador",
          "plural": "jogadores"
        }
      },
      "reasons": {
        "inventory-full": "Inventário cheio",
        "stash-entry": "Entrada num evento",
        "stash-return": "Volta do inventário guardado",
        "invsee": "Movido pelo /invsee",
        "mystery-box": "Caixa misteriosa",
        "mystery-box-refund": "Devolução da caixa misteriosa",
        "check-refund": "Devolução de cheque",
        "check-change": "Troco de cheque",
        "item-refund": "Devolução de item",
        "duel-grid": "Grade de criação do duelo",
        "virtual-chest-shrink": "Baú virtual reduzido",
        "collect-leftover": "Sobra de uma coleta",
        "staff": "Enviado pela staff"
      },
      "messages": {
        "arrived": "&7Chegou uma encomenda ao seu correio ({reason}). Use &f/correio&7.",
        "arrived-in-stash": "&7Chegou uma encomenda ao seu correio ({reason}).",
        "delayed": "&7O correio não respondeu agora. Sua encomenda ({reason}) está guardada e chega sozinha assim que ele voltar.",
        "received": {
          "title": "&6&lCORREIO",
          "subtitle": "&fVocê recebeu itens no correio!"
        },
        "reminder": "&7Você tem &f{count} {count_unit} &7por coletar. Use &f/correio&7.",
        "inventory-full": "&cLibere espaço no inventário para coletar este correio.",
        "claim-in-stash": "&cO correio só pode ser coletado fora de eventos.",
        "already-claimed": "&cEste correio já foi coletado.",
        "claimed": "&aVocê coletou os itens do correio.",
        "send": {
          "cancelled": "&cEnvio cancelado: nada foi enviado.",
          "success": "&aEnviado: &f{count} {count_unit} &apara &f{recipients} {recipients_unit}&a.",
          "not-allowed-item": "&cEste item não pode ser enviado pelo correio.",
          "unknown-player": "&cO jogador {name} não existe.",
          "platform-failed": "&cNão foi possível buscar os destinatários agora. Tente de novo em instantes."
        }
      },
      "views": {
        "inbox": {
          "title": "Correio",
          "network": "Rede",
          "entry": {
            "name": "&eDe: &f{sender}",
            "lore": [
              "&7Motivo: {reason}",
              "&7Itens: &f{count} {count_unit}",
              "&7Recebido em &f{date}",
              "",
              "&aClique para ver e coletar."
            ]
          },
          "empty": {
            "name": "&cNenhum correio por aqui",
            "lore": [
              "&7Você não tem itens por coletar."
            ]
          }
        },
        "claim": {
          "title": "Coletar correio",
          "items": {
            "claim": {
              "name": "&aColetar tudo",
              "lore": [
                "&7Passa todos os itens ao seu inventário.",
                "&7O que não couber volta para o correio.",
                "",
                "&aClique para coletar."
              ]
            }
          }
        },
        "send": {
          "title": "Enviar para {target}",
          "title-everyone": "Enviar para {recipients} {recipients_unit}"
        }
      }
    }
  }
}
