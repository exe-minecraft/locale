{
  "plugins": {
    "mail": {
      "send": {
        "description": "enviar itens ao correio de um jogador ou de todos os online",
        "arguments": {
          "target": {
            "name": "jogador|todos",
            "description": "O jogador que recebe, ou todos os que estão online no P4Free"
          },
          "network": {
            "name": "rede",
            "description": "Com \"rede\", a entrega sai como da rede e não com o seu nome"
          }
        }
      },
      "units": {
        "entry": {
          "singular": "correio",
          "plural": "correios"
        },
        "item": {
          "singular": "item",
          "plural": "itens"
        },
        "player": {
          "singular": "jogador",
          "plural": "jogadores"
        }
      },
      "reasons": {
        "inventory-full": "&7Seu inventário estava cheio: os itens foram para o seu correio. Use /correio.",
        "stash-entry": "&7Seus itens pessoais ficaram guardados ao entrar no camarote e foram para o seu correio. Use /correio.",
        "stash-return": "&7Seu inventário estava cheio ao sair do camarote: os itens foram para o seu correio. Use /correio.",
        "invsee": "&7Um item seu foi devolvido pela staff e foi para o seu correio. Use /correio.",
        "mystery-box": "&7Seu inventário estava cheio: o prêmio da caixa misteriosa foi para o seu correio. Use /correio.",
        "mystery-box-refund": "&7A caixa misteriosa não pôde ser aberta: o item de volta foi para o seu correio. Use /correio.",
        "check-refund": "&7O cheque foi devolvido e os itens foram para o seu correio. Use /correio.",
        "check-change": "&7O troco do cheque foi para o seu correio. Use /correio.",
        "item-refund": "&7Um item seu foi devolvido e foi para o seu correio. Use /correio.",
        "duel-grid": "&7Seu inventário estava cheio ao fim do duelo: os itens foram para o seu correio. Use /correio.",
        "virtual-chest-shrink": "&7O seu baú virtual diminuiu: os itens que não cabem mais foram para o seu correio. Use /correio.",
        "collect-leftover": "&7Seu inventário encheu ao coletar: o que não coube voltou para o seu correio. Use /correio.",
        "staff": "&7A staff enviou itens para você. Use /correio."
      },
      "messages": {
        "received": {
          "title": "&6&lCORREIO",
          "subtitle": "&fVocê recebeu itens no correio!"
        },
        "reminder": "&7Você tem &f{count} {count_unit} &7por coletar. Use &f/correio&7.",
        "inventory-full": "&cLibere espaço no inventário para coletar este correio.",
        "already-claimed": "&cEste correio já foi coletado.",
        "claimed": "&aVocê coletou os itens do correio.",
        "send": {
          "cancelled": "&cEnvio cancelado: nada foi enviado.",
          "success": "&aEnviado: &f{count} {count_unit} &apara &f{recipients} {recipients_unit}&a.",
          "not-allowed-item": "&cEste item não pode ser enviado pelo correio.",
          "unknown-player": "&cO jogador {name} não existe.",
          "platform-failed": "&cNão foi possível buscar os destinatários agora. Tente de novo em instantes."
        }
      },
      "views": {
        "inbox": {
          "title": "Correio",
          "network": "Rede",
          "entry": {
            "name": "&eDe: &f{sender}",
            "lore": [
              "&7Motivo: {reason}",
              "&7Itens: &f{count} {count_unit}",
              "&7Recebido em &f{date}",
              "",
              "&aClique para ver e coletar."
            ]
          },
          "empty": {
            "name": "&cNenhum correio por aqui",
            "lore": [
              "&7Você não tem itens por coletar."
            ]
          }
        },
        "claim": {
          "title": "Coletar correio",
          "items": {
            "claim": {
              "name": "&aColetar tudo",
              "lore": [
                "&7Passa todos os itens ao seu inventário.",
                "&7O que não couber volta para o correio.",
                "",
                "&aClique para coletar."
              ]
            }
          }
        },
        "send": {
          "title": "Enviar para {target}",
          "title-everyone": "Enviar para {recipients} {recipients_unit}"
        }
      }
    }
  }
}
